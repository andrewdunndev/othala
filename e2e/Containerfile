# othala e2e: prebaked Playwright test image.
#
# The e2e VM pulls registry images but cannot reliably reach the npm registry,
# so the specs and their npm dependencies are baked in at build time. ESM
# imports ignore NODE_PATH, so node_modules must sit next to the specs.

# Must match e2e/package.json's "@playwright/test" version exactly: the npm
# package hard-fails on a base image that ships other browser builds, and
# Renovate bumps only the npm package. Bump both together.
FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:9beb546099e11f52d62e505537914870e01a67e0e6b00ae41da4775324e73dbe

# The base image already has the browsers.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    CI=1

WORKDIR /test

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV PATH="/test/node_modules/.bin:${PATH}"

CMD ["bash"]
