# Browser-test edge for the e2e harness only (compose `browser` profile): one host in front of
# the app, Kratos and Hydra so a real browser can drive the human flow. Plain HTTP (the e2e
# issuer is http and Hydra runs --dev). Routing shape to copy: the app is the default and the
# Kratos browser paths are named, else static assets fall through to Kratos and 404.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

auth.othala.test:80 {
	# Rate limiting (n-rate-limits.spec.ts). Requests share one socket peer; the tests vary the client address through
	# X-Forwarded-For (the peer is trusted above). Each zone also requires the X-E2E-Flood-Probe header the flood tests set; only their bursts count.
	rate_limit {
		zone e2e_code_request {
			match {
				method GET
				path   /self-service/login/browser
				header X-E2E-Flood-Probe n1
			}
			key    {client_ip}
			window 1m
			events 5
		}
		zone e2e_wrong_password {
			match {
				method POST
				path   /self-service/login*
				header X-E2E-Flood-Probe n2
			}
			key    {client_ip}
			window 1m
			events 10
		}
	}

	# Hydra public OAuth2 surface + OIDC discovery.
	@hydra path /oauth2/auth /oauth2/token /oauth2/revoke /oauth2/sessions/logout /oauth2/fallbacks/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# App-owned Hydra challenge handlers.
	@portal_challenges path /oauth2/login /oauth2/consent /oauth2/logout
	handle @portal_challenges {
		# XFF overwrite: see caddy/Caddyfile.
		reverse_proxy othala:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Kratos browser endpoints.
	@kratos path /.well-known/ory/* /self-service/* /sessions/* /schemas/*
	handle @kratos {
		reverse_proxy kratos:4433
	}

	# Default -> the app (UI, pages, static assets). XFF overwrite: rationale in caddy/Caddyfile.
	reverse_proxy othala:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}

# A forward_auth app behind the portal's gate: the portal's /api/forward-auth checks the session and the
# group, 200 proxies on (here a stub), and any other status is returned to the client as is, with no
# login redirect on this route. ZI1 navigates here with a granted session.
proxywatch.othala.test:80 {
	forward_auth othala:8080 {
		uri /api/forward-auth?group=proxywatch-access
		copy_headers X-Kratos-Authenticated-Identity-Id
	}
	respond "proxywatch-stub" 200
}
