# Browser-test edge for the e2e harness ONLY (compose `browser` profile).
#
# Othala's golden e2e is deliberately EDGELESS (D10: the edge — Caddy/TLS/DNS — is
# an operator concern, outside Othala). But driving the HUMAN flow through a real
# browser needs everything on ONE host with routing. This minimal Caddy provides
# that, with the e2e compose service names. It exists only under `--profile browser`.
#
# Plain HTTP (no TLS): the e2e issuer is http and Hydra runs --dev, so a browser can
# complete the OAuth2 flow over HTTP without cert friction.
#
# ROUTING ORDER MATTERS. An edge that defaults to Kratos and names only
# / /auth* /admin* /apps* for the portal drops the app's STATIC ASSETS
# (/_astro/*.css, manifest.webmanifest, favicon.ico) through to Kratos, which
# 404s them or serves them as text/plain → an unstyled UI. This edge routes the
# APP as the default and names the Kratos browser paths explicitly, which is the
# shape a deployment should copy.
{
	auto_https off
	admin off
}

auth.othala.test:80 {
	# Hydra public OAuth2 surface + OIDC discovery.
	@hydra path /oauth2/auth /oauth2/token /oauth2/revoke /oauth2/fallbacks/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# The converged app owns the Hydra login/consent/logout CHALLENGE handlers.
	# Matched before the app default so they're explicit/auditable.
	@portal_challenges path /oauth2/login /oauth2/consent /oauth2/logout
	handle @portal_challenges {
		# DOS-1: overwrite inbound X-Forwarded-For with the real socket peer
		# so the portal rate-limiter sees the actual client IP, not a spoofed one.
		reverse_proxy othala:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Kratos browser endpoints: well-known ceremony scripts + the self-service flow
	# APIs the rendered forms POST to + session/schema endpoints.
	@kratos path /.well-known/ory/* /self-service/* /sessions/* /schemas/*
	handle @kratos {
		reverse_proxy kratos:4433
	}

	# Default -> the app: family UI, /auth/* + /admin/* pages, AND the static assets
	# (/_astro/*, favicon, webmanifest). The app is the catch-all, not Kratos.
	#
	# DOS-1: overwrite any client-supplied X-Forwarded-For with the real
	# socket peer IP. @astrojs/node resolves ctx.clientAddress from the leftmost
	# XFF entry; without this, an attacker can prepend a fake IP per request
	# and land in a fresh rate-limit bucket.
	reverse_proxy othala:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
