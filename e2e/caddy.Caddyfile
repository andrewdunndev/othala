# Test-only site Caddyfile for the e2e harness, outside the deployment contract: plain HTTP (the e2e issuer is http
# and Hydra runs --dev) and a stub app behind the gate. Everything else is the rendered othala.caddy, as shipped.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/othala/othala.caddy

auth.othala.test:80 {
	import othala-routes
}

# ZI1 navigates here with a granted session.
proxywatch.othala.test:80 {
	import othala-forward-auth 127.0.0.1 8081 proxywatch-access
}

:8081 {
	bind 127.0.0.1
	respond "proxywatch-stub" 200
}
