# Test-only site Caddyfile for the e2e harness, outside the deployment contract: an internal CA for the test
# hostnames and a stub app behind the gate. Everything else is the rendered othala.caddy, as shipped.
{
	skip_install_trust
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/othala/othala.caddy

auth.othala.test {
	tls internal
	import othala-routes
}

# ZI1 and T8/T10 reach the stub through the gate; it echoes the identity, spoof and cookie headers it was sent.
proxywatch.othala.test {
	tls internal
	import othala-forward-auth 127.0.0.1 8081 proxywatch-access
}

:8081 {
	bind 127.0.0.1
	respond "proxywatch-stub id={http.request.header.X-Kratos-Authenticated-Identity-Id} spoof={http.request.header.X-Remote-User}{http.request.header.Remote-User} cookie={http.request.header.Cookie}" 200
}
