# The test instance's values; validate.sh writes secrets.env with the image's gen-secrets.
OTHALA_PUBLIC_URL=https://auth.othala.test
OTHALA_APEX=othala.test
OTHALA_INSTANCE_NAME=Othala Lab
OTHALA_CONTACT_RECIPIENT=ops@othala.test
KRATOS_ADMIN_BIND_HOST=10.200.11.10
HYDRA_ADMIN_BIND_HOST=10.200.11.11
PORTAL_ADMIN_BIND_HOST=10.200.11.12
# Mailpit catches Kratos and contact-form mail. Kratos defaults to mandatory STARTTLS and drops every
# message to plain SMTP without disable_starttls.
OTHALA_SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true
