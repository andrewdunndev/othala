# glauth-kratos: LDAP-to-Kratos bridge.
#
# Two-stage: ci-go builder produces a static binary, ci-runtime-go
# (UBI 9 micro) runtime ships only the binary. Pinned to the dunn.dev
# pipeline catalog version; Renovate-watched.

ARG CATALOG_VERSION=2.3.2

FROM registry.gitlab.com/dunn.dev/pipeline/ci-go:${CATALOG_VERSION} AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY main.go config.go ./
COPY kratos/ ./kratos/

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o glauth-kratos .

FROM registry.gitlab.com/dunn.dev/pipeline/ci-runtime-go:${CATALOG_VERSION}

COPY --from=builder /build/glauth-kratos /usr/bin/glauth-kratos

# LDAPS port.
EXPOSE 636
# LDAP port (in-pod use only).
EXPOSE 389

ENTRYPOINT ["/usr/bin/glauth-kratos"]
CMD ["--config", "/etc/glauth/glauth.cfg"]
