# glauth-kratos: LDAP-to-Kratos bridge built directly via go build.

ARG GO_VERSION=1.22
ARG ALPINE_VERSION=3.19

FROM docker.io/library/golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY main.go config.go ./
COPY kratos/ ./kratos/

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o glauth-kratos .

FROM docker.io/library/alpine:${ALPINE_VERSION}

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/glauth-kratos /usr/bin/glauth-kratos

# LDAPS port
EXPOSE 636
# LDAP port (in-pod use only)
EXPOSE 389

ENTRYPOINT ["/usr/bin/glauth-kratos"]
CMD ["--config", "/etc/glauth/glauth.cfg"]
