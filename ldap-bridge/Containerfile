# glauth-kratos: LDAP-to-Kratos bridge.
#
# Two-stage: golang builder produces a static binary, runtime layer adds
# the binary onto UBI 9 minimal. Minimal (not micro) is used because the
# bridge needs an in-container HTTP client for its compose / quadlet
# healthcheck against its own /healthz admin endpoint on :6478 — UBI
# micro has no shell/curl/wget. Minimal is ~30 MB vs micro's ~12 MB; the
# bridge image stays small and gains self-validation (no `|| exit 0`
# soft-pass shenanigans).

ARG GO_VERSION=1.24

FROM docker.io/golang:${GO_VERSION} AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY main.go config.go ./
COPY kratos/ ./kratos/

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o glauth-kratos .

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

# HTTP healthcheck against the bridge's own /healthz admin endpoint
# (e2e smoke.sh execs `curl` inside this container). No other tools —
# bridge stays a single-binary surface.
# NOTE: ubi-minimal:9.8 already ships curl-minimal (provides /usr/bin/curl),
# so we do NOT install the full `curl` package — it conflicts with
# curl-minimal and microdnf has no --allowerasing to swap. curl-minimal
# handles the smoke's `curl -s -o /dev/null -w "%{http_code}"` fine.
RUN microdnf install -y --nodocs ca-certificates \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /build/glauth-kratos /usr/bin/glauth-kratos

# LDAPS port.
EXPOSE 636
# LDAP port (in-pod use only).
EXPOSE 389
# Bridge admin HTTP listener (cache flush + /healthz).
EXPOSE 6478

ENTRYPOINT ["/usr/bin/glauth-kratos"]
CMD ["--config", "/etc/glauth/glauth.cfg"]
