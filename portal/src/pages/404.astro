---
// 404 — Not found.
//
// Astro's special 404.astro is served for any unmatched route in SSR mode.
// Sets the response status to 404 and renders the branded StatusPage.

export const prerender = false;

import StatusPage from '../components/StatusPage.astro';
import { REASON_MAP } from '../lib/error-reasons';

const { title, message } = REASON_MAP['not-found'];

Astro.response.status = 404;
---
<StatusPage status={404} title={title} message={message} />
