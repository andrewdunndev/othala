---
// 404 — Not found.
//
// Astro's special 404.astro is served for any unmatched route in SSR mode.
// Sets the response status to 404 and renders the branded StatusPage.

export const prerender = false;

import StatusPage from '../components/StatusPage.astro';

Astro.response.status = 404;
---
<StatusPage
  status={404}
  title="We can't find that page"
  message="It may have moved, the link may be mistyped, or it may be an app you do not have yet. Go home to find what you were after."
/>
