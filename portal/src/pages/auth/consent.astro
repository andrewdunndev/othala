---
// Hydra consent screen redirect.
//
// We don't render consent here. The consent service co-located with
// Hydra on carmine handles the consent_challenge auto-accept (the 11
// OIDC clients in hydra/clients/ all set skip_consent: true). This
// page is just a fallback in case Hydra redirects here directly: we
// forward the challenge to the consent service.
//
// In v1, no consent UI is rendered. Future untrusted clients would
// render a consent prompt here.
//
// Status: skeleton.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const challenge = Astro.url.searchParams.get('consent_challenge');

if (challenge) {
  // Forward to the consent service on carmine. The service auto-accepts
  // for skip_consent clients and redirects back to Hydra to continue
  // the OAuth2 flow.
  return Astro.redirect(
    `https://dag.dunn.dev/consent?consent_challenge=${encodeURIComponent(challenge)}`
  );
}
---
<Layout title="Authorize — Dunn Family">
  <main class="shell shell-sm stack-lg">
    <h1>Missing consent challenge</h1>
    <p class="muted">This page is a redirect target for OAuth2 consent flows.</p>
  </main>
</Layout>
