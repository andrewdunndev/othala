---
// Hydra consent screen redirect.
//
// We don't render consent here. The consent service co-located with
// Hydra on carmine handles the consent_challenge auto-accept (since all
// 16 trusted clients have skip_consent: true). This page is just a
// fallback in case Hydra redirects here directly — we forward the
// challenge to the consent service.
//
// In v1, no consent UI is rendered. Future untrusted clients would
// render a consent prompt here.
//
// Status: skeleton.

export const prerender = false;

const challenge = Astro.url.searchParams.get('consent_challenge');

if (challenge) {
  // Forward to the consent service on carmine. The service auto-accepts
  // for skip_consent clients and redirects back to Hydra to continue
  // the OAuth2 flow.
  return Astro.redirect(
    `https://auth.dunn.dev/consent?consent_challenge=${encodeURIComponent(challenge)}`
  );
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Authorize — Dunn Family</title>
</head>
<body class="bg-paper text-ink">
  <main class="mx-auto max-w-md p-8">
    <h1 class="text-2xl font-mono">Missing consent challenge</h1>
    <p class="mt-4 text-secondary">This page is a redirect target for OAuth2 consent flows.</p>
  </main>
</body>
</html>
