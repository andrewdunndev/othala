---
// OAuth2 consent grant screen, shown for a client without skip_consent and for every device grant (with the code this
// browser entered). Names the app (logo and name from its manifest), says in plain words what it will see, and offers
// Allow or Deny, posting to /oauth2/consent (signed CSRF token + subject match). Consent is not a Kratos flow. In
// `astro dev`, `?dev-state=` renders a recorded request (lib/journey-fixtures.ts) with no Hydra.

export const prerender = false;

import FocusPage from '../../components/FocusPage.astro';
import AppIcon from '../../components/AppIcon.astro';
import { describeScopeList } from '../../lib/scope-descriptions';
import { getSession } from '../../lib/kratos';
import { signToken } from '../../lib/csrf';
import { hydraAdmin } from '../../lib/ory-fetch';
import { loadTiles } from '../../lib/tiles';
import { devViewer } from '../../lib/viewer';
import { monogram } from '../../lib/monogram';
import { DEV_CONSENT_STATES, devConsent, isIn } from '../../lib/journey-fixtures';
import { isDeviceRequest, readDeviceCode } from '../../lib/device';

const challenge = Astro.url.searchParams.get('consent_challenge');
const devState = import.meta.env.DEV ? Astro.url.searchParams.get('dev-state') : null;
const dev = isIn(DEV_CONSENT_STATES, devState) ? devConsent(devState) : null;

let clientId = '';
let clientName = '';
let requestedScopes: string[] = [];
let fetchError = false;
let ownershipError = false;
let csrfToken = '';
let deviceCode: string | null = null;

if (dev) {
  // The first app in the dev catalog stands in, so its real logo and description render.
  const stand = dev.clientId === 'dev-app' ? loadTiles().find((t) => t.authKind === 'oidc') : undefined;
  clientId = stand?.slug ?? dev.clientId;
  clientName = stand?.name ?? dev.clientName;
  requestedScopes = dev.scopes;
  fetchError = !!dev.fetchError;
} else if (!challenge) {
  fetchError = true;
} else {
  try {
    const oauth2 = hydraAdmin();
    const consent = await oauth2.getOAuth2ConsentRequest({ consentChallenge: challenge });

    // Both the session AND the consent request must resolve before anything renders: the ownership check compares
    // session.identity.id with consent.subject so user A never sees user B's client name or scope list. If the session
    // cannot be resolved (Kratos down) the form does not render, so no CSRF token is needed (fail-closed).
    const cookie = Astro.request.headers.get('cookie') ?? undefined;
    const session = await getSession(cookie);
    if (!session?.active || !session.identity?.id) {
      fetchError = true;
    } else if (session.identity.id !== consent.subject) {
      // Mirrors the POST-time subject match in handleConsentPost. Do NOT disclose the client name or scope list.
      ownershipError = true;
    } else if (isDeviceRequest(consent.request_url) && !(deviceCode = readDeviceCode(cookie))) {
      fetchError = true;
    } else {
      clientId = consent.client?.client_id ?? '';
      clientName = consent.client?.client_name ?? clientId;
      requestedScopes = consent.requested_scope ?? [];
      csrfToken = signToken(session.identity.id, 'consent');
    }
  } catch {
    fetchError = true;
  }
}

const failed = fetchError || ownershipError;
// The app as the household knows it: logo, name and one-line description from its manifest, else a monogram.
const tile = !failed ? loadTiles().find((t) => t.slug === clientId) : undefined;
const appName = tile?.name ?? (clientName || 'This app');
const failMessage = !challenge && !dev
  ? 'This page opens from an app that wants to sign you in. Open the app and choose sign in, and it will bring you here.'
  : ownershipError
  ? 'This request belongs to someone else, or has timed out. Go back to the app and start sign-in again.'
  : 'This request has timed out or was already answered. Go back to the app and start sign-in again.';
const scopeDescriptions = describeScopeList(requestedScopes, appName);
const plate = tile ?? { iconHref: undefined, icon: monogram(appName), iconBleed: false };
---
<FocusPage
  viewer={dev ? devViewer(true, 'member') : undefined}
  title={failed ? "That request can't be used" : deviceCode ? `Sign in ${appName} on a device?` : `Let ${appName} use your account?`}
  lede={failed ? failMessage : deviceCode ? 'Allow only if the device in front of you shows this code.' : 'You are signed in. This app is asking before it can sign you in.'}
  tabTitle="Allow access"
  description="Allow or deny an app's request to use your account."
>

  {failed ? (
    <div class="status-actions">
      <a href="/" class="button button-primary" data-astro-reload>Go home</a>
    </div>
  ) : (
    <section class="panel focus-card">
      <div class="consent-app">
        <AppIcon tile={plate} size="lg" />
        <div>
          <p class="consent-app-name">{appName}</p>
          {tile?.description && <p class="consent-app-desc">{tile.description}</p>}
        </div>
      </div>

      {deviceCode && <p class="device-code">{deviceCode}</p>}

      {!tile && (
        <div class="notice notice-warning" role="note">Not one of your household's apps. Only allow if an admin told you to.</div>
      )}

      {scopeDescriptions.length > 0 && (
        <div>
          <p class="consent-label">{appName} will see</p>
          <ul class="consent-list">
            {scopeDescriptions.map(({ description }) => <li>{description}</li>)}
          </ul>
        </div>
      )}

      <div class="consent-actions">
        <form method="POST" enctype="application/x-www-form-urlencoded" action="/oauth2/consent">
          <input type="hidden" name="consent_challenge" value={challenge ?? ''} />
          <input type="hidden" name="action" value="allow" />
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <button type="submit" class:list={['button', 'focus-btn', tile ? 'button-primary' : 'button-secondary']}>Allow</button>
        </form>
        <form method="POST" enctype="application/x-www-form-urlencoded" action="/oauth2/consent">
          <input type="hidden" name="consent_challenge" value={challenge ?? ''} />
          <input type="hidden" name="action" value="deny" />
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <button type="submit" class:list={['button', 'focus-btn', tile ? 'button-secondary' : 'button-primary']}>Deny</button>
        </form>
      </div>
      <p class="focus-note">{deviceCode ? "Deny stops the device from signing in." : "Deny returns you to the app without signing in."}</p>
    </section>
  )}

</FocusPage>
