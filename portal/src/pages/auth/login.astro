---
// Login flow handler. Reads ?flow=<id>; if absent or expired, redirects to
// Kratos's browser flow initiator. Three tiers: passkey (primary), email code
// (secondary; step 2 is detected by a "code" text node), password (tertiary,
// collapsed). ?aal=aal2 / ?refresh=true pass through to Kratos; the step-up
// form derives isAal2 from the landed flow, using the query only with no flow.

export const prerender = false;

import FocusPage from '../../components/FocusPage.astro';
import { browserFlows, getLoginFlow, getSession } from '../../lib/kratos';
import { getIdentity } from '../../lib/admin-api';
import { needsStepUp } from '../../lib/gate';
import { instanceName } from '../../lib/config';
import { csrfToken, nodesByGroup, asInput, scriptNodes, safeOnclick } from '../../lib/nodes';
import { deriveLoginTiers } from '../../lib/login-tiers';
import { CODE_SHAPE, journeyText, noticeClass, noticeRole, passwordRefused } from '../../lib/journey';
import { DEV_LOGIN_STATES, devLogin, isIn } from '../../lib/journey-fixtures';
import type { FlowMessage } from '../../lib/types';

const url = Astro.url;
const flowId = url.searchParams.get('flow');
let aal = (url.searchParams.get('aal') as 'aal1' | 'aal2' | null) ?? undefined;
const refresh = url.searchParams.get('refresh') === 'true';
const returnTo = url.searchParams.get('return_to') ?? undefined;
const isDev = import.meta.env.DEV;
const devState = isDev ? url.searchParams.get('dev-state') : null;
const devFlow = isIn(DEV_LOGIN_STATES, devState) ? devLogin(devState) : null;
const cookie = Astro.request.headers.get('cookie') ?? undefined;

// A live aal1 session that must step up (lib/gate.ts) gets an aal2 flow;
// otherwise Kratos returns the browser to return_to and forward-auth loops.
if (!flowId && !aal && !isDev) {
  try {
    const session = await getSession(cookie);
    if (session?.active && session.identity?.id && needsStepUp(session, await getIdentity(session.identity.id))) {
      aal = 'aal2';
    }
  } catch {
    // No step-up decision without Kratos; the plain flow below still works.
  }
}

// In dev, skip the flow redirect when Kratos is unreachable.
if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.login({ aal, refresh, returnTo }));
}

const result = !devFlow && flowId ? await getLoginFlow(flowId, cookie).catch(() => null) : null;

if (!devFlow && flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.login({ aal, refresh, returnTo }));
}

// Dev without a real flow renders a static preview.
const flow = devFlow ?? (result && result.kind === 'ok' ? result.flow : null);
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const scripts = ui ? scriptNodes(ui.nodes) : [];

// The identifier input sits in the default group (identifier_first) or under password.
const identifierInput = ui ? (
  nodesByGroup(ui.nodes, 'default').map(asInput).find((a) => a?.name === 'identifier') ||
  nodesByGroup(ui.nodes, 'password').map(asInput).find((a) => a?.name === 'identifier') ||
  null
) : null;

const passwordInput = ui
  ? nodesByGroup(ui.nodes, 'password').map(asInput).find((a) => a?.name === 'password') || null
  : null;

// Step 1 has no "code" text input in the code group; step 2 (email sent) has one.
const codeNodes = ui ? nodesByGroup(ui.nodes, 'code') : [];
const isCodeEntry = codeNodes.some((n) => {
  const a = asInput(n);
  return a?.name === 'code' && a.type === 'text';
});

// A refused password reopens the password form with the identifier kept, so the retry is in place.
const passwordFailed = ui
  ? passwordRefused((ui.messages ?? []).map((m: FlowMessage) => m.id)) ||
    nodesByGroup(ui.nodes, 'password').some((n) => n.messages?.some((m: FlowMessage) => m.type === 'error'))
  : false;

const refused = (n: { messages?: FlowMessage[] }) => (n.messages ?? []).some((m) => m.type === 'error');
const noticeId = (m: FlowMessage, id: string) => (m.type === 'error' ? id : undefined);

// Tier presence and AAL2 derivation live in login-tiers.ts (see there).
const { hasPasskey, hasCode, hasPassword, totpNodes, aal2WebauthnNodes, lookupNodes, isAal2, hasAal2Methods } =
  deriveLoginTiers(flow, aal);
---
<FocusPage
  back={{ href: '/', label: 'Home' }}
  title={isAal2 ? 'One more step' : isCodeEntry ? 'Check your email' : 'Sign in'}
  lede={isAal2
    ? totpNodes.length > 0
      ? 'Enter the code from your authenticator app to finish signing in.'
      : 'Confirm it is you with your security key to finish signing in.'
    : isCodeEntry
      ? identifierInput?.value
        ? `We emailed a sign-in code to ${String(identifierInput.value)}. Enter it below. Nothing yet? Check spam or junk, then send a new code.`
        : 'We emailed you a sign-in code. Enter it below. Nothing yet? Check spam or junk, then send a new code.'
      : 'Use the passkey on this device, or get a code by email.'}
  description={`Sign in to ${instanceName}.`}
>

  {ui?.messages?.map((m: FlowMessage) => <div id={noticeId(m, 'flow-error')} class={noticeClass(m.type)} role={noticeRole(m.type)}>{journeyText(m)}</div>)}

  {!flow && isDev && (
    <div class="notice notice-warning">Dev preview: no flow. Add <code>?dev-state=code|aal2|wrong-password</code>.</div>
  )}

  <section class="panel focus-card">

    {/* ── AAL2 STEP-UP ─────────────────────────────────────────────────── */}
    {/* One form per second-factor method, posting to ui.action; the primary tiers are hidden. */}
    {isAal2 && hasAal2Methods && (
      <div class="aal2-block focus-form">

        {totpNodes.length > 0 && (
          <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form aal2-form">
            <input type="hidden" name="csrf_token" value={csrf} />
            {totpNodes.map((n) => {
              const a = asInput(n);
              if (!a) return null;
              if (a.type === 'hidden') {
                return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
              }
              if (a.type === 'text' && a.name === 'totp_code') {
                return (
                  <div class="field">
                    <label for="totp-code">Authenticator code</label>
                    <input
                      id="totp-code"
                      name="totp_code"
                      type="text"
                      class="code-input"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      required
                      autofocus
                      maxlength={CODE_SHAPE.maxlength}
                      pattern={CODE_SHAPE.pattern}
                      title={CODE_SHAPE.title}
                      placeholder="123456"
                      aria-invalid={refused(n) ? 'true' : undefined}
                      aria-describedby={refused(n) ? 'totp-code-error' : undefined}
                    />
                    <div class="field-hint">The 6 digits your app shows. They change every 30 seconds.</div>
                    {n.messages?.map((m: FlowMessage) => <div id={noticeId(m, 'totp-code-error')} class={noticeClass(m.type)} role={noticeRole(m.type)}>{journeyText(m)}</div>)}
                  </div>
                );
              }
              if (a.type === 'submit') {
                return (
                  <button class="button button-primary focus-btn" type="submit" name={a.name} value={String(a.value ?? '')}>
                    Verify code
                  </button>
                );
              }
              return null;
            })}
          </form>
        )}

        {aal2WebauthnNodes.length > 0 && (
          <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form aal2-form">
            <input type="hidden" name="csrf_token" value={csrf} />
            {aal2WebauthnNodes.map((n) => {
              const a = asInput(n);
              if (!a) return null;
              if (a.type === 'hidden') {
                return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
              }
              if (a.type === 'submit' || a.type === 'button') {
                return (
                  <button
                    class={`button ${totpNodes.length > 0 ? 'button-secondary' : 'button-primary'} focus-btn`}
                    type={a.type}
                    name={a.name}
                    value={String(a.value ?? '')}
                    onclick={safeOnclick(a)}
                  >
                    Use a security key
                  </button>
                );
              }
              return null;
            })}
          </form>
        )}

        {lookupNodes.length > 0 && (
          <details class="disclosure">
            <summary>Use a backup code instead</summary>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form aal2-form">
              <input type="hidden" name="csrf_token" value={csrf} />
              {lookupNodes.map((n) => {
                const a = asInput(n);
                if (!a) return null;
                if (a.type === 'hidden') {
                  return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
                }
                if (a.type === 'text' && a.name === 'lookup_secret') {
                  return (
                    <div class="field">
                      <label for="lookup-secret">Backup code</label>
                      <input id="lookup-secret" name="lookup_secret" type="text" autocomplete="off" required placeholder="xxxxxxxxxx" />
                      <div class="field-hint">Each backup code works once.</div>
                    </div>
                  );
                }
                if (a.type === 'submit') {
                  return (
                    <button class="button button-secondary focus-btn" type="submit" name={a.name} value={String(a.value ?? '')}>
                      Use backup code
                    </button>
                  );
                }
                return null;
              })}
            </form>
          </details>
        )}

      </div>
    )}

    {/* An account that must step up but has no second factor enrols one in Settings. */}
    {isAal2 && !hasAal2Methods && flow && (
      <div class="notice notice-warning">
        This account has no second step set up yet. Add an authenticator app or a
        security key in <a href="/auth/settings">your account</a>, then sign in again.
      </div>
    )}

    {/* ── Passkey first ─────────────────────────────────────────────────── */}
    {!isAal2 && hasPasskey && !isCodeEntry && (
      <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form passkey-block">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="passkey" />

        {ui && nodesByGroup(ui.nodes, 'passkey').map((n) => {
          const a = asInput(n);
          if (!a) return null;
          if (a.type === 'hidden') {
            return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
          }
          if (a.type === 'submit' || a.type === 'button') {
            // safeOnclick validates against KNOWN_TRIGGERS before emitting a window.<trigger>() call.
            return (
              <button
                class="button button-primary focus-btn"
                type={a.type}
                name={a.name}
                value={String(a.value ?? '')}
                onclick={safeOnclick(a)}
              >
                Sign in with a passkey
              </button>
            );
          }
          return null;
        })}

        {!ui && (
          <button class="button button-primary focus-btn" type="button" disabled>Sign in with a passkey</button>
        )}

        <p class="focus-note">Face ID, Touch ID, or your device PIN. Nothing to remember.</p>
      </form>
    )}

    {/* ── Email code ────────────────────────────────────────────────────── */}
    {/* Step 1 (isCodeEntry=false): the identifier input and the code-group submit, inside one form so Kratos receives
        both. Step 2: the code input, verify, resend. Not rendered during an AAL2 step-up. */}
    {!isAal2 && hasCode && (
      <div class="email-code focus-form">
        {!isCodeEntry && hasPasskey && <p class="focus-or" aria-hidden="true">or</p>}

        {!isCodeEntry && (
          <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form code-form">
            <input type="hidden" name="csrf_token" value={csrf} />

            <div class="field">
              <label for="code-identifier">Email address</label>
              <input
                id="code-identifier"
                name="identifier"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                value={identifierInput?.value ? String(identifierInput.value) : ''}
                placeholder="you@example.com"
              />
            </div>

            {ui && codeNodes.map((n) => {
              const a = asInput(n);
              if (!a) return null;
              if (a.type === 'submit' && a.name === 'method') {
                return (
                  <button class="button button-secondary focus-btn code-submit" type="submit" name={a.name} value={String(a.value ?? 'code')}>
                    Email me a sign-in code
                  </button>
                );
              }
              if (a.type === 'hidden') {
                return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
              }
              return null;
            })}

            {!ui && (
              <button class="button button-secondary focus-btn code-submit" type="button" disabled>Email me a sign-in code</button>
            )}
          </form>
        )}

        {isCodeEntry && (
          <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form code-form">
            <input type="hidden" name="csrf_token" value={csrf} />

            {/* Hidden fields from the default group (state Kratos needs to verify the code), except the csrf token above. */}
            {ui && nodesByGroup(ui.nodes, 'default').map((n) => {
              const a = asInput(n);
              if (!a || a.type !== 'hidden' || a.name === 'csrf_token') return null;
              return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
            })}

            {codeNodes.map((n) => {
              const a = asInput(n);
              if (!a || a.type !== 'hidden') return null;
              return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
            })}

            {codeNodes.map((n) => {
              const a = asInput(n);
              if (!a || a.name !== 'code' || a.type !== 'text') return null;
              return (
                <div class="field">
                  <label for="login-code">Your code</label>
                  <input
                    id="login-code"
                    name="code"
                    type="text"
                    class="code-input"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    required
                    autofocus
                    maxlength={CODE_SHAPE.maxlength}
                    pattern={CODE_SHAPE.pattern}
                    title={CODE_SHAPE.title}
                    placeholder="123456"
                    aria-invalid={refused(n) ? 'true' : undefined}
                    aria-describedby={refused(n) ? 'login-code-error' : undefined}
                  />
                  {n.messages?.map((m: FlowMessage) => <div id={noticeId(m, 'login-code-error')} class={noticeClass(m.type)} role={noticeRole(m.type)}>{journeyText(m)}</div>)}
                </div>
              );
            })}

            <div class="consent-actions">
              {codeNodes.map((n) => {
                const a = asInput(n);
                if (!a || a.type !== 'submit' || a.name !== 'method') return null;
                return (
                  <button class="button button-primary focus-btn code-submit" type="submit" name={a.name} value={String(a.value ?? 'code')}>
                    Verify code
                  </button>
                );
              })}
              {codeNodes.map((n) => {
                const a = asInput(n);
                if (!a || a.type !== 'submit' || a.name !== 'resend') return null;
                return (
                  <button class="button button-secondary focus-btn code-resend" type="submit" name={a.name} value={String(a.value ?? 'code')} formnovalidate>
                    Send a new code
                  </button>
                );
              })}
            </div>
          </form>
        )}
      </div>
    )}

    {/* ── Password, last ────────────────────────────────────────────────── */}
    {/* Not rendered during an AAL2 step-up or the code step. */}
    {!isAal2 && !isCodeEntry && hasPassword && (
      <details class="disclosure password-disclosure" open={passwordFailed}>
        <summary><span class="password-summary-label">Use a password instead</span></summary>

        <form method="POST" enctype="application/x-www-form-urlencoded" action={ui?.action ?? '#'} class="focus-form password-form">
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="method" value="password" />

          {passwordFailed && identifierInput?.value ? (
            <input type="hidden" name="identifier" value={String(identifierInput.value)} />
          ) : (
            <div class="field">
              <label for="pw-identifier">Email or username</label>
              <input
                id="pw-identifier"
                name="identifier"
                type="text"
                autocomplete="username"
                required
                value={identifierInput?.value ? String(identifierInput.value) : ''}
              />
            </div>
          )}

          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete={passwordInput?.autocomplete ?? 'current-password'}
              required
              data-focus-on-load={passwordFailed ? '' : undefined}
              aria-invalid={passwordFailed ? 'true' : undefined}
              aria-describedby={passwordFailed ? 'flow-error' : undefined}
            />
          </div>

          <button class="button button-secondary focus-btn" type="submit" disabled={!ui}>
            Sign in with password
          </button>
          <p class="focus-note"><a href="/auth/recovery">Forgot your password?</a> We will email you a code instead.</p>
        </form>
      </details>
    )}

  </section>

  <nav class="focus-links" aria-label="Other options">
    {isAal2
      ? <span class="focus-aside">Lost your second step?&nbsp;<a href={`/?ask=problem&msg=${encodeURIComponent('I lost my second sign-in step. Please reset it.')}#get-in-touch`}>Ask a household admin</a>&nbsp;to reset it.</span>
      : isCodeEntry
      ? <a href="/auth/login" data-astro-reload>Use a different way to sign in</a>
      : null}
  </nav>

  <script>
    // Focus the retry field without scrolling, so the heading and the error stay in view.
    document.querySelector<HTMLInputElement>('#password[data-focus-on-load]')?.focus({ preventScroll: true });
  </script>

  {scripts.map((s) => (
    <script
      src={s.src}
      id={s.id}
      async
      is:inline
      integrity={s.integrity}
      crossorigin={s.crossorigin}
      referrerpolicy={s.referrerpolicy}
      nonce={s.nonce}
    ></script>
  ))}

</FocusPage>
