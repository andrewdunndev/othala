---
// /auth/error: branded denial page. The `reason` query param drives status,
// title and message; unknown reasons fall through to a generic 400. Reasons:
// not-admin, not-authorised, auth-unreachable, session-expired, forbidden,
// unavailable, flow-expired, app-misconfigured, sign-in-cancelled (grep `/auth/error?reason=` in src/); Hydra's ?error=
// and Kratos's ?id= map onto the same entries (lib/error-reasons.ts).

export const prerender = false;

import StatusPage from '../../components/StatusPage.astro';

import { resolveError, kratosReason } from '../../lib/error-reasons';
import { getFlowError } from '../../lib/kratos';

// Kratos sends ?id=<error id>, Hydra sends ?error=<code>; both read as a next step, never as raw text.
const kratosId = Astro.url.searchParams.get('id');
const kratos = kratosId ? kratosReason(await getFlowError(kratosId)) : undefined;
const { entry, reason } = resolveError(Astro.url.searchParams, kratos);

Astro.response.status = entry.status;
---
<StatusPage
  status={entry.status}
  title={entry.title}
  message={entry.message}
  reason={reason}
  retryHref="/"
/>
