---
// /auth/error: branded denial page. The `reason` query param drives status,
// title and message; unknown reasons fall through to a generic 400. Reasons:
// not-admin, not-authorised, auth-unreachable, session-expired, forbidden,
// unavailable (grep `/auth/error?reason=` in src/).

export const prerender = false;

import StatusPage from '../../components/StatusPage.astro';

import { resolveReason } from '../../lib/error-reasons';

const { entry, reason } = resolveReason(Astro.url.searchParams.get('reason'));

Astro.response.status = entry.status;
---
<StatusPage
  status={entry.status}
  title={entry.title}
  message={entry.message}
  reason={reason}
/>
