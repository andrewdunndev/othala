---
// Logout convenience page.
//
// Kratos's logout flow needs a CSRF-bound logout_token. We fetch
// /self-service/logout/browser to get it, then redirect the user to
// the logout_url which clears the cookie and 303s back to home.
//
// If we already have no session, just bounce home.

export const prerender = false;

import { getLogoutInfo, getSession } from '../../lib/kratos';

const cookie = Astro.request.headers.get('cookie') ?? undefined;

let session = null;
try {
  session = await getSession(cookie);
} catch {
  return Astro.redirect('/');
}

if (!session?.active) {
  return Astro.redirect('/');
}

const info = await getLogoutInfo(cookie);
if (info) {
  return Astro.redirect(info.logout_url);
}

return Astro.redirect('/');
---
