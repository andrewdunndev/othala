---
// Sign-out page. A GET renders a confirm form; only a POST whose token is bound
// to the caller's identity (lib/logout.ts) ends the session. On a verified POST
// we fetch Kratos's logout_url and 303 the browser to it; if that URL is not
// ours we revoke server-side and expire the session cookie. Nobody leaves still
// holding a live session.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getLogoutInfo, getSession, kratosBase } from '../../lib/kratos';
import type { LogoutInfo } from '../../lib/kratos';
import { publicUrl } from '../../lib/config';
import { logoutAuthorized, signLogoutToken } from '../../lib/logout';

const cookie = Astro.request.headers.get('cookie') ?? undefined;

const REVOKE_TIMEOUT_MS = 2000;

/**
 * Is this logout_url one of ours? A compromised Kratos response must not bounce
 * the user off-instance. Kratos builds the URL from its own public base_url,
 * while the portal may dial Kratos at an internal address, so accept either
 * configured origin (publicUrl or kratosBase()) and hardcode neither. Anything
 * else takes the fail-closed path below.
 */
function isOurLogoutUrl(raw: string): boolean {
  let url: URL;
  try {
    url = new URL(raw);
  } catch {
    return false;
  }
  // Non-http(s) schemes have an opaque origin.
  if (url.protocol !== 'https:' && url.protocol !== 'http:') return false;

  const allowed = new Set<string>();
  for (const base of [publicUrl, kratosBase()]) {
    try {
      allowed.add(new URL(base).origin);
    } catch {
      // An unparseable config value contributes no origin.
    }
  }
  return allowed.has(url.origin);
}

/**
 * Complete the logout server-side over the internal Kratos address, for when
 * logout_url could not be validated. Raw fetch: the SDK sends no Accept header,
 * so Kratos would answer 303 toward the public origin. Returns the HTTP status,
 * or null when the call could not be completed.
 */
async function revokeServerSide(token: string): Promise<number | null> {
  const base = kratosBase().replace(/\/+$/, '');
  const ctl = new AbortController();
  const t = setTimeout(() => ctl.abort(), REVOKE_TIMEOUT_MS);
  try {
    const res = await fetch(
      `${base}/self-service/logout?token=${encodeURIComponent(token)}`,
      {
        method: 'GET',
        headers: {
          accept: 'application/json',
          ...(cookie ? { cookie } : {}),
        },
        redirect: 'manual',
        signal: ctl.signal,
      },
    );
    return res.status;
  } catch {
    return null;
  } finally {
    clearTimeout(t);
  }
}

/**
 * OTHALA_APEX, the parent domain of Kratos's session cookie. Read through a
 * typed globalThis because the portal wires no @types/node.
 */
function apexDomain(): string | undefined {
  const env = (
    globalThis as { process?: { env?: Record<string, string | undefined> } }
  ).process?.env;
  return env?.OTHALA_APEX?.trim() || undefined;
}

/**
 * Redirect home with the Kratos session cookie expired on this device.
 * Name, Domain and Path must mirror the cookie Kratos set. `Secure` follows
 * OTHALA_PUBLIC_URL, not the request (behind the proxy the request is plain
 * http). Domain is omitted when OTHALA_APEX is unset.
 */
function signedOutLocally(): Response {
  const apex = apexDomain();
  const attrs = [
    'ory_kratos_session=',
    'Path=/',
    'Max-Age=0',
    'Expires=Thu, 01 Jan 1970 00:00:00 GMT',
    'HttpOnly',
    'SameSite=Lax',
  ];
  if (apex) attrs.push(`Domain=${apex}`);
  if (publicUrl.startsWith('https://')) attrs.push('Secure');

  return new Response(null, {
    status: 303,
    headers: {
      Location: '/',
      'Set-Cookie': attrs.join('; '),
    },
  });
}

const isPost = Astro.request.method.toUpperCase() === 'POST';
let form: FormData | null = null;
if (isPost) {
  try {
    form = await Astro.request.formData();
  } catch {
    form = null;
  }
}

let session = null;
let lookupFailed = false;
try {
  session = await getSession(cookie);
} catch {
  lookupFailed = true;
}

if (lookupFailed && isPost) {
  // Kratos is unreachable, so nothing can be checked or revoked; drop the cookie here.
  console.warn(
    '[othala/logout] session lookup failed; clearing the session cookie on this device. ' +
      'The Kratos-side session, if any, is untouched.',
  );
  return signedOutLocally();
}

const identityId = session?.active ? session.identity?.id : undefined;

if (!lookupFailed && !identityId) {
  return signedOutLocally();
}

if (identityId && logoutAuthorized(Astro.request.method, form?.get('csrf_token'), identityId)) {
  let info: LogoutInfo | null = null;
  try {
    info = await getLogoutInfo(cookie);
  } catch {
    // getLogoutInfo swallows only 401/403; fall through to the local clear rather than 500.
    console.warn('[othala/logout] could not create a logout flow; clearing locally.');
    info = null;
  }

  if (!info) {
    return signedOutLocally();
  }

  if (isOurLogoutUrl(info.logout_url)) {
    // 303 so the browser follows with a GET after the POST.
    return Astro.redirect(info.logout_url, 303);
  }

// Fail closed: complete the logout here instead of following a foreign URL.
  let seenOrigin = 'unparseable';
  try {
    // URL.origin is normalised and cannot carry CR/LF, so it is safe to log.
    seenOrigin = new URL(info.logout_url).origin;
  } catch {
    /* keep the placeholder */
  }
  console.warn(
    `[othala/logout] logout_url origin ${seenOrigin} is neither OTHALA_PUBLIC_URL nor ` +
      'KRATOS_PUBLIC_URL; refusing the redirect and completing the logout server-side.',
  );

  const status = await revokeServerSide(info.logout_token);
  if (status === null || status >= 400) {
    console.warn(
      `[othala/logout] server-side revoke did not confirm (status=${status ?? 'no response'}). ` +
        'The session cookie is cleared on this device, but the Kratos session may still be live.',
    );
  }
  return signedOutLocally();
}

// With Kratos unreachable there is no identity to bind a token to; the POST then clears this device.
const csrfToken = identityId ? signLogoutToken(identityId) : '';
const retry = isPost;
---
<Layout title="Sign out" description="Sign out of this device." bare>
  <PageHero
    title="Sign out?"
    eyebrow="sign out"
    lede={retry
      ? 'That sign-out request could not be confirmed. Press the button to sign out of this device.'
      : lookupFailed
      ? 'The sign-in service did not answer. Signing out clears this device only.'
      : 'Sign out of this device.'}
  >
    <form method="POST" action="/auth/logout" class="logout-form">
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <button type="submit" class="button button-primary">Sign out</button>
      <a href="/" class="button button-secondary">Cancel</a>
    </form>
  </PageHero>
</Layout>

<style>
  .logout-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
