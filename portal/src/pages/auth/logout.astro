---
// Logout convenience page.
//
// Kratos's logout flow needs a CSRF-bound logout_token. We fetch
// /self-service/logout/browser to get it, then redirect the user to
// the logout_url which clears the cookie and 303s back to home.
//
// If we already have no session, just bounce home.

export const prerender = false;

import { getLogoutInfo, getSession, kratosBase } from '../../lib/kratos';

const cookie = Astro.request.headers.get('cookie') ?? undefined;

let session = null;
try {
  session = await getSession(cookie);
} catch {
  return Astro.redirect('/');
}

if (!session?.active) {
  return Astro.redirect('/');
}

const info = await getLogoutInfo(cookie);
if (info) {
  // Defense-in-depth: assert the logout_url origin matches the configured
  // Kratos public origin so a compromised/unexpected Kratos response can't
  // redirect the user off-instance.
  try {
    const logoutOrigin = new URL(info.logout_url).origin;
    const kratosOrigin = new URL(kratosBase()).origin;
    if (logoutOrigin === kratosOrigin) return Astro.redirect(info.logout_url);
  } catch {
    // malformed URL — fall through to '/'
  }
  return Astro.redirect('/');
}

return Astro.redirect('/');
