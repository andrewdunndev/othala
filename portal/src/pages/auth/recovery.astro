---
// Recovery flow handler — code strategy.
//
// Audience: family members on a new device, with a lost passkey, or who
// have never set a password. The promoted path is email → one-time code →
// privileged session → /auth/settings where they can register a passkey
// on the current device.
//
// Phase 1: user enters email; Kratos sends a numeric code via Fastmail.
// Phase 2: user enters the code; Kratos issues a privileged session and
//          303s to /auth/settings to set a new password / register a passkey.
//
// Same template handles both phases: Kratos's flow.ui.nodes describes
// which inputs to surface (email -> code) so the rendering stays
// shape-driven.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { browserFlows, getRecoveryFlow } from '../../lib/kratos';
import { csrfToken, hasMethod } from '../../lib/nodes';
import FlowNodes from '../../components/FlowNodes.astro';
import type { FlowMessage } from '../../lib/types';

const flowId = Astro.url.searchParams.get('flow');
const isDev = import.meta.env.DEV;

if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const result = flowId ? await getRecoveryFlow(flowId, cookie).catch(() => null) : null;

if (flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const flow = result && result.kind === 'ok' ? result.flow : null;
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const hasCode = ui ? hasMethod(ui.nodes, 'code') : true;
const phase: 'request' | 'sent' = flow?.state === 'sent_email' ? 'sent' : 'request';
---
<Layout title="Get back in" description="Regain access to your account with a one-time email code." bare>

  <PageHero
    title={phase === 'request' ? 'Get back in' : 'Check your email'}
    eyebrow="recovery"
    lede={phase === 'request'
      ? 'Enter your email and we\'ll send you a one-time code. Once you\'re in, you can set up a passkey on this device for one-tap sign-in next time.'
      : 'We sent a code to your email. Enter it below to continue — it\'s only valid for a few minutes.'}
  />

  {ui?.messages?.map((m: FlowMessage) => (
    <div class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}>
      {m.text}
    </div>
  ))}

  {!flow && isDev && (
    <div class="notice notice-warning">
      Dev preview: no Kratos flow available. Submitting will not work
      without a live flow.
    </div>
  )}

  {phase === 'request' && (
    <p class="recovery-context">
      This works whether you got a new phone, lost your old one, or just
      want to get in without a passkey. No password needed.
    </p>
  )}

  <section class="recover-card">

    {hasCode && ui && (
      <form method="POST" action={ui.action} class="recover-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="code" />
        <FlowNodes
          nodes={ui.nodes}
          group="code"
          buttonClass="button button-primary recover-primary"
          submitLabel={phase === 'request' ? 'Send me a code' : 'Verify code'}
        />
      </form>
    )}

    {!ui && (
      /* Static dev preview — fields shown so the layout exercises both phases. */
      <form class="recover-form" onsubmit="return false;">
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@example.com" disabled />
        </div>
        <button class="button button-primary recover-primary" type="button" disabled>
          Send me a code
        </button>
      </form>
    )}

  </section>

  <footer class="recover-footer">
    <a href="/auth/login" class="recover-foot-link">Back to sign in</a>
  </footer>

</Layout>

<style>
  .recovery-context {
    max-width: 32rem;
    margin: 0 auto var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.5;
  }

  .recover-card {
    max-width: 32rem;
    margin: 0 auto;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .recover-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .recover-primary {
    width: 100%;
    padding: var(--space-4);
    font-size: var(--text-base);
  }

  .recover-footer {
    max-width: 32rem;
    margin: var(--space-5) auto 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .recover-foot-link { color: var(--text-muted); text-decoration: none; }
  .recover-foot-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .recover-card { padding: var(--space-5); }
  }
</style>
