---
// Recovery flow handler — code strategy (magic link is deprecated).
//
// Phase 1: user enters email; Kratos sends a numeric code via Fastmail.
// Phase 2: user enters the code; Kratos issues a privileged session and
//          303s to /auth/settings to set a new password / register a passkey.
//
// Same template handles both phases: Kratos's flow.ui.nodes describes
// which inputs to surface (email -> code) so the rendering stays
// shape-driven.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import markSvg from '@dunn.dev/reference/mark/mark.svg?raw';
import { browserFlows, getRecoveryFlow } from '../../lib/kratos';
import { csrfToken, hasMethod, nodesByGroup, asInput } from '../../lib/nodes';
import type { FlowMessage } from '../../lib/types';

const flowId = Astro.url.searchParams.get('flow');
const isDev = import.meta.env.DEV;

if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const result = flowId ? await getRecoveryFlow(flowId, cookie).catch(() => null) : null;

if (flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const flow = result && result.kind === 'ok' ? result.flow : null;
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const hasCode = ui ? hasMethod(ui.nodes, 'code') : true;
const phase: 'request' | 'sent' = flow?.state === 'sent_email' ? 'sent' : 'request';
---
<Layout title="Recover account" description="Recover access to your account." bare>

  <section class="hero">
    <span class="hero-mark" set:html={markSvg} />
    <div>
      <p class="hero-eyebrow">recover</p>
      <h1 class="hero-title">Account recovery</h1>
      <p class="hero-lede">
        {phase === 'request'
          ? 'Enter the email tied to your account. We will send you a one-time code.'
          : 'Check your email. Enter the code below to continue.'}
      </p>
    </div>
  </section>

  {ui?.messages?.map((m: FlowMessage) => (
    <div class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}>
      {m.text}
    </div>
  ))}

  {!flow && isDev && (
    <div class="notice notice-warning" style="margin-bottom: var(--space-6);">
      Dev preview: no Kratos flow available. Submitting will not work
      without a live flow.
    </div>
  )}

  <section class="recover-card">

    {hasCode && ui && (
      <form method="POST" action={ui.action} class="recover-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="code" />
        {nodesByGroup(ui.nodes, 'code').map((n) => {
          const a = asInput(n);
          if (!a) return null;
          if (a.type === 'hidden') {
            return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
          }
          if (a.type === 'submit' || a.type === 'button') {
            return (
              <button class="button button-primary recover-primary" type={a.type}
                      name={a.name} value={String(a.value ?? '')}>
                {n.meta?.label?.text ?? (phase === 'request' ? 'Send code' : 'Verify code')}
              </button>
            );
          }
          const id = a.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{n.meta?.label?.text ?? a.name}</label>
              <input
                id={id}
                name={a.name}
                type={a.type}
                required={a.required}
                autocomplete={a.autocomplete}
                value={a.value !== undefined ? String(a.value) : ''}
              />
            </div>
          );
        })}
      </form>
    )}

    {!ui && (
      /* Static dev preview — fields shown so the layout exercises both phases. */
      <form class="recover-form" onsubmit="return false;">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" disabled />
        </div>
        <button class="button button-primary recover-primary" type="button" disabled>
          Send code
        </button>
      </form>
    )}

  </section>

  <footer class="recover-footer">
    <a href="/auth/login" class="recover-foot-link">Back to sign in</a>
  </footer>

</Layout>

<style>
  .recover-card {
    max-width: 28rem;
    margin: 0 auto;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .recover-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .recover-primary {
    width: 100%;
    padding: var(--space-4);
    font-size: var(--text-base);
  }

  .recover-footer {
    max-width: 28rem;
    margin: var(--space-5) auto 0;
    display: flex;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .recover-foot-link { color: var(--text-muted); text-decoration: none; }
  .recover-foot-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .recover-card { padding: var(--space-5); }
  }
</style>
