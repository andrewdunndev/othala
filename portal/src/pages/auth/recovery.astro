---
// Recovery flow handler, code strategy, and how every new household member starts: a setup link (or an emailed code)
// opens the code step, the code starts a privileged session, and Kratos lands the person on /auth/settings to add a
// passkey. One template serves both phases; flow.ui.nodes drives the inputs and lib/journey.ts words them. In `astro dev`,
// `?dev-state=` renders a recorded flow (lib/journey-fixtures.ts) with no Kratos.

export const prerender = false;

import FocusPage from '../../components/FocusPage.astro';
import FlowNodes from '../../components/FlowNodes.astro';
import { browserFlows, getRecoveryFlow } from '../../lib/kratos';
import { csrfToken, hasMethod } from '../../lib/nodes';
import { journeyText, noticeClass, noticeRole, recoverySpecs } from '../../lib/journey';
import { DEV_RECOVERY_STATES, devRecovery, isIn } from '../../lib/journey-fixtures';
import type { FlowMessage } from '../../lib/types';

const flowId = Astro.url.searchParams.get('flow');
const isDev = import.meta.env.DEV;
const devState = isDev ? Astro.url.searchParams.get('dev-state') : null;
const devFlow = isIn(DEV_RECOVERY_STATES, devState) ? devRecovery(devState) : null;

if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const result = !devFlow && flowId ? await getRecoveryFlow(flowId, cookie).catch(() => null) : null;

if (!devFlow && flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.recovery());
}

const flow = devFlow ?? (result && result.kind === 'ok' ? result.flow : null);
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const hasCode = ui ? hasMethod(ui.nodes, 'code') : true;
const phase: 'request' | 'sent' = flow?.state === 'sent_email' ? 'sent' : 'request';
// The "a code was sent" info line is noise on a setup link: the person is already holding the code.
// The address the code went to, when the flow carries it (the resend node's value).
const sentTo = (() => {
  for (const n of ui?.nodes ?? []) {
    const a = n.attributes as { name?: string; value?: unknown };
    if (a.name === 'email' && typeof a.value === 'string' && a.value) return a.value;
  }
  return '';
})();
const messages = (ui?.messages ?? []).filter((m: FlowMessage) => !(phase === 'sent' && m.type === 'info'));
---
<FocusPage
  back={{ href: '/auth/login', label: 'Sign in' }}
  title={phase === 'request' ? 'Get back in' : 'Enter your code'}
  lede={phase === 'request'
    ? "Enter your email and we'll send you a one-time code. No password needed."
    : `${sentTo ? `We emailed a code to ${sentTo}. ` : ''}Enter the code from your email, or from the setup message that brought you here. It works once and expires soon.`}
  description="Start or regain access with a one-time code."
>

  {messages.map((m: FlowMessage) => <div class={noticeClass(m.type)} role={noticeRole(m.type)}>{journeyText(m)}</div>)}

  {!flow && isDev && (
    <div class="notice notice-warning">Dev preview: no flow. Add <code>?dev-state=request|code|code-prefilled|code-wrong</code>.</div>
  )}

  <section class="panel focus-card">
    {hasCode && ui && (
      <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="focus-form recover-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="code" />
        <FlowNodes
          nodes={ui.nodes}
          group="code"
          buttonClass="button button-primary focus-btn"
          submitLabel={phase === 'request' ? 'Get a code by email' : 'Verify code'}
          specs={recoverySpecs(phase)}
          inputLabelFallback={(n: string) => (n === 'code' ? 'Your code' : n)}
          messageText={journeyText}
        />
      </form>
    )}

    {phase === 'sent' && (
      <p class="focus-next">Next you'll land on your account, where you can add a passkey so signing in takes one tap.</p>
    )}
    {phase === 'request' && (
      <p class="focus-note">New phone or lost passkey? A code by email gets you in. Got a setup link? Open that link instead; it brings its own code.</p>
    )}
  </section>


</FocusPage>
