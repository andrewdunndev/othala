---
// Email verification flow handler, the two-phase code form mirroring recovery:
// enter an email, then the code, then Kratos 303s to default_browser_return_url.
// Disabled in production (flows.verification.enabled is per deployment), kept
// so the lab and any re-enablement don't hit a dead route.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { browserFlows, getVerificationFlow } from '../../lib/kratos';
import { csrfToken, hasMethod } from '../../lib/nodes';
import FlowNodes from '../../components/FlowNodes.astro';
import type { FlowMessage } from '../../lib/types';

const flowId = Astro.url.searchParams.get('flow');
const isDev = import.meta.env.DEV;

if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.verification());
}

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const result = flowId ? await getVerificationFlow(flowId, cookie).catch(() => null) : null;

if (flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.verification());
}

const flow = result && result.kind === 'ok' ? result.flow : null;
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const hasCode = ui ? hasMethod(ui.nodes, 'code') : true;
// Settings starts this flow with the address in the initiating URL, which Kratos keeps as request_url; it only seeds
// the empty email input, the person still sends the code.
const prefill = (() => {
  try {
    const v = flow ? new URL(flow.request_url).searchParams.get('email') : null;
    return v && v.length <= 254 && /^[^\s@]+@[^\s@]+$/.test(v) ? v : '';
  } catch {
    return '';
  }
})();
const codeNodes = (ui?.nodes ?? []).map((n) => {
  const a = n.attributes as { name?: string; value?: unknown };
  return prefill && a.name === 'email' && !a.value ? { ...n, attributes: { ...n.attributes, value: prefill } } : n;
});
// Kratos verification flow states: choose_method, sent_email, passed_challenge.
// Map to the two UI shapes recovery uses.
const phase: 'request' | 'sent' = flow?.state === 'sent_email' ? 'sent' : 'request';
---
<Layout title="Verify email" description="Verify your email address." bare>

  <PageHero
    title="Verify your email"
    eyebrow="verify"
    lede={phase === 'request'
      ? 'Enter the address you want verified. We will send you a one-time code.'
      : 'Check your email. Enter the code below to confirm the address.'}
  />

  {ui?.messages?.map((m: FlowMessage) => (
    <div class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}>
      {m.text}
    </div>
  ))}

  {!flow && isDev && (
    <div class="notice notice-warning" style="margin-bottom: var(--space-6);">
      Dev preview: no Kratos flow available. Submitting will not work
      without a live flow.
    </div>
  )}

  <section class="panel verify-card">

    {hasCode && ui && (
      <form method="POST" action={ui.action} class="verify-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="code" />
        <FlowNodes
          nodes={codeNodes}
          group="code"
          buttonClass="button button-primary verify-primary"
          submitLabel={phase === 'request' ? 'Send code' : 'Verify code'}
        />
      </form>
    )}

    {!ui && (
      <form class="verify-form" onsubmit="return false;">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" disabled />
        </div>
        <button class="button button-primary verify-primary" type="button" disabled>
          Send code
        </button>
      </form>
    )}

  </section>

  <footer class="verify-footer">
    <a href="/auth/login" class="verify-foot-link">Back to sign in</a>
  </footer>

</Layout>

<style>
  /* Surface via .panel. */
  .verify-card {
    max-width: 32rem;
    margin: 0 auto;
    padding: var(--space-6);
  }
  .verify-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .verify-primary {
    width: 100%;
    padding: var(--space-4);
    font-size: var(--text-base);
  }

  .verify-footer {
    max-width: 32rem;
    margin: var(--space-5) auto 0;
    display: flex;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .verify-foot-link { color: var(--text-muted); text-decoration: none; }
  .verify-foot-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .verify-card { padding: var(--space-5); }
  }
</style>
