---
// Email verification flow handler, the two-phase code form mirroring recovery:
// enter an email, then the code, then Kratos 303s to default_browser_return_url.
// Disabled in production (flows.verification.enabled is per deployment), kept
// so the lab and any re-enablement don't hit a dead route.

export const prerender = false;

import FocusPage from '../../components/FocusPage.astro';
import { browserFlows, getVerificationFlow } from '../../lib/kratos';
import { csrfToken, hasMethod } from '../../lib/nodes';
import FlowNodes from '../../components/FlowNodes.astro';
import { journeyText, noticeClass, noticeRole, verificationSpecs } from '../../lib/journey';
import { DEV_VERIFICATION_STATES, devVerification, isIn } from '../../lib/journey-fixtures';
import type { FlowMessage } from '../../lib/types';

const flowId = Astro.url.searchParams.get('flow');
const isDev = import.meta.env.DEV;
const devState = isDev ? Astro.url.searchParams.get('dev-state') : null;
const devFlow = isIn(DEV_VERIFICATION_STATES, devState) ? devVerification(devState) : null;

if (!flowId && !isDev) {
  return Astro.redirect(browserFlows.verification());
}

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const result = !devFlow && flowId ? await getVerificationFlow(flowId, cookie).catch(() => null) : null;

if (!devFlow && flowId && (!result || result.kind !== 'ok') && !isDev) {
  return Astro.redirect(browserFlows.verification());
}

const flow = devFlow ?? (result && result.kind === 'ok' ? result.flow : null);
const ui = flow?.ui;
const csrf = ui ? csrfToken(ui.nodes) : '';
const hasCode = ui ? hasMethod(ui.nodes, 'code') : true;
// Settings starts this flow with the address in the initiating URL, which Kratos keeps as request_url; it only seeds
// the empty email input, the person still sends the code.
const prefill = (() => {
  try {
    const v = flow ? new URL(flow.request_url).searchParams.get('email') : null;
    return v && v.length <= 254 && /^[^\s@]+@[^\s@]+$/.test(v) ? v : '';
  } catch {
    return '';
  }
})();
const codeNodes = (ui?.nodes ?? []).map((n) => {
  const a = n.attributes as { name?: string; value?: unknown };
  return prefill && a.name === 'email' && !a.value ? { ...n, attributes: { ...n.attributes, value: prefill } } : n;
});
// Kratos verification flow states: choose_method, sent_email, passed_challenge.
// Map to the two UI shapes recovery uses.
const phase: 'request' | 'sent' | 'done' = flow?.state === 'passed_challenge' ? 'done' : flow?.state === 'sent_email' ? 'sent' : 'request';
---
<FocusPage
  back={phase === 'done' ? undefined : { href: '/', label: 'Home' }}
  title={phase === 'done' ? 'Email verified' : phase === 'request' ? 'Verify your email' : 'Enter your code'}
  lede={phase === 'done'
    ? 'Thanks. You can use this address to get back in if you ever lose a device.'
    : phase === 'request'
    ? 'Enter the address you want verified and we will email you a one-time code.'
    : 'We emailed you a code. Enter it to confirm this address.'}
  description="Verify your email address."
>

  {(ui?.messages ?? []).filter((m: FlowMessage) => !(phase !== 'request' && m.type !== 'error')).map((m: FlowMessage) => (
    <div class={noticeClass(m.type)} role={noticeRole(m.type)}>{journeyText(m)}</div>
  ))}

  {!flow && isDev && (
    <div class="notice notice-warning">Dev preview: no flow. Add <code>?dev-state=request|code|code-wrong|done</code>.</div>
  )}

  {phase === 'done' ? (
    <div class="status-actions">
      <a href="/auth/settings" class="button button-primary" data-astro-reload>Back to your account</a>
    </div>
  ) : (
  <section class="panel focus-card">
    {hasCode && ui && (
      <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="focus-form verify-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="code" />
        <FlowNodes
          nodes={codeNodes}
          group="code"
          buttonClass="button button-primary focus-btn"
          submitLabel={phase === 'request' ? 'Get a code by email' : 'Verify email'}
          specs={verificationSpecs(phase)}
          inputLabelFallback={(n: string) => (n === 'code' ? 'Your code' : n)}
          messageText={journeyText}
        />
      </form>
    )}
    {phase === 'sent' && <p class="focus-next">Once it checks out you'll go straight back to where you were.</p>}
  </section>
  )}


</FocusPage>
