---
export const prerender = false;

// Keep TOTP QR/secret and backup codes out of the back/forward cache.
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');

import '../../styles/settings.css';
import Layout from '../../layouts/Layout.astro';
import {
  browserFlows,
  getSession,
  getSettingsFlow,
} from '../../lib/kratos';
import { csrfToken, nodesByGroup, asInput, scriptNodes, safeOnclick } from '../../lib/nodes';
import type { FlowNode, Session, SettingsFlow } from '../../lib/types';
import CredentialRows from '../../components/settings/CredentialRows.astro';
import PasswordField from '../../components/settings/PasswordField.astro';
import TotpKey from '../../components/settings/TotpKey.astro';
import ActionForm from '../../components/settings/ActionForm.astro';
import ConfirmCues from '../../components/settings/ConfirmCues.astro';
import { SECOND_FACTOR_KEEP } from '../../lib/second-factor-gate';
import HeaderActions from '../../components/HeaderActions.astro';
import { revokeSubject, RevokeError } from '../../lib/revoke';
import { getIdentity } from '../../lib/admin-api';
import { emailChangeLocked } from '../../lib/profile-gate';
import { parseIdentity } from '../../lib/identity-facts';
import { holdsElevatedRole } from '../../lib/gate';
import { loadTiles, userCanSeeTile } from '../../lib/tiles';
import { publicUrl } from '../../lib/config';
import { signToken, csrfRefusal } from '../../lib/csrf';
import { readPasskeyNames } from '../../lib/passkey-names';
import { readAvatar, avatarPath } from '../../lib/avatar';
import { DEV_AVATAR, DEV_AVATAR_SRC } from '../../lib/dev-avatar';
import AvatarEditor from '../../components/AvatarEditor.astro';
import {
  credentialItems,
  emailVerified,
  lookupView,
  privilegedLapsed,
  securityStatus,
  keyOnlyKeeper,
  totpView,
  passwordPanelOpen,
} from '../../lib/settings-view';
import { devSettings, isDevSettingsState } from '../../lib/settings-fixtures';
import { FLASH, LOST_KEYS, RENAME_ERROR_COOKIE, RENAME_ERRORS, AVATAR_FLASH, AVATAR_FLASH_COOKIE, messageText } from '../../lib/settings-flash';

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const devParam = import.meta.env.DEV ? Astro.url.searchParams.get('dev-state') : null;
const dev = isDevSettingsState(devParam) ? devSettings(devParam) : null;

/** A CSRF token for this identity and action; empty if minting fails (dev without CSRF_SECRET), so the form still renders. */
function mint(identityId: string, action: string): string {
  try {
    return signToken(identityId, action);
  } catch (err) {
    if (!dev) throw err;
    return '';
  }
}

let session: Session | null;
let flow: SettingsFlow;
let stored: Awaited<ReturnType<typeof getIdentity>> | null = null;
let signOutError: string | null = null;

if (dev) {
  const email = 'sam@example.test';
  session = {
    active: true,
    authentication_methods: [{ method: 'passkey' }],
    authenticated_at: new Date().toISOString(),
    identity: {
      id: 'dev-mock',
      traits: { username: 'sam', email, displayName: 'Sam Rivera' },
      verifiable_addresses: [{ value: email, verified: dev.emailVerified }],
      metadata_admin: { passkeyNames: dev.names, ...(dev.admin ? { admin: true } : {}), ...(dev.avatar ? { avatar: DEV_AVATAR } : {}) },
    },
  } as unknown as Session;
  flow = dev.flow;
  stored = session.identity as unknown as typeof stored;
} else {
  try {
    session = await getSession(cookie);
  } catch {
    return Astro.redirect('/auth/login');
  }
  if (!session?.active || !session.identity) {
    return Astro.redirect('/auth/login?return_to=' + encodeURIComponent('/auth/settings'));
  }

  // Unlike Kratos's browser logout, revokeSubject also ends Hydra's remembered login.
  if (Astro.request.method === 'POST') {
    const fd = await Astro.request.formData();
    if (String(fd.get('action') ?? '') === 'sign-out-everywhere') {
      const bad = csrfRefusal(String(fd.get('csrf_token') ?? ''), session.identity.id, 'sign-out-everywhere');
      if (bad !== null) return new Response(`CSRF: ${bad}`, { status: 403 });
      try {
        await revokeSubject(session.identity.id);
      } catch (err) {
        // Never show raw upstream errors.
        signOutError =
          err instanceof RevokeError
            ? err.message
            : 'Could not sign out everywhere; please retry.';
      }
      // revokeSubject ended every session, this browser's included.
      if (!signOutError) return Astro.redirect('/auth/login');
    }
  }

  const flowId = Astro.url.searchParams.get('flow');
  if (!flowId) {
    return Astro.redirect(browserFlows.settings(`${publicUrl}/auth/settings`));
  }
  const result = await getSettingsFlow(flowId, cookie);
  if (result.kind !== 'ok') {
    return Astro.redirect(browserFlows.settings(`${publicUrl}/auth/settings`));
  }
  flow = result.flow;
  // whoami omits metadata_admin and credentials. Display only: nothing is shown on error.
  try {
    stored = await getIdentity(session.identity.id);
  } catch (lookupErr) {
    console.error('[othala/settings] getIdentity failed; showing no names or apps:', lookupErr);
  }
}

// A refused rename leaves a one-minute cookie naming the passkey and the reason; read once, here, after the flow exists
// (the flow-less first request only redirects).
let renameError: { id: string; text: string } | null = null;
if (dev) {
  renameError = dev.renameError;
} else {
  const raw = Astro.cookies.get(RENAME_ERROR_COOKIE)?.value;
  if (raw) {
    const [id, code] = raw.split('.');
    renameError = { id: id ?? '', text: RENAME_ERRORS[code ?? ''] ?? RENAME_ERRORS.busy };
    Astro.response.headers.append('Set-Cookie', `${RENAME_ERROR_COOKIE}=; Path=/auth/settings; Max-Age=0; HttpOnly; SameSite=Lax${import.meta.env.PROD ? '; Secure' : ''}`);
  }
}

let avatarFlash: (typeof AVATAR_FLASH)[string] | null = dev?.avatarFlash ? AVATAR_FLASH[dev.avatarFlash] : null;
if (!dev) {
  const code = Astro.cookies.get(AVATAR_FLASH_COOKIE)?.value;
  if (code) {
    avatarFlash = Object.hasOwn(AVATAR_FLASH, code) ? AVATAR_FLASH[code] : AVATAR_FLASH.busy;
    Astro.response.headers.append('Set-Cookie', `${AVATAR_FLASH_COOKIE}=; Path=/auth/settings; Max-Age=0; HttpOnly; SameSite=Lax${import.meta.env.PROD ? '; Secure' : ''}`);
  }
}

const identity = session!.identity!;
const ui = flow.ui;
const nodes = ui.nodes;
const csrf = csrfToken(nodes);
const scripts = scriptNodes(nodes);
const traits = identity.traits;
const displayName = traits.displayName || traits.username || '';

// The email inputs go read-only when the profile gate would refuse a change from this session (display only; the gate
// stays the control). An unreadable identity leaves them editable and the gate decides.
const emailLocked = stored ? emailChangeLocked(stored, session!.authentication_methods) : false;
const isAdmin = parseIdentity(stored).isAdmin;
const names = readPasskeyNames(stored?.metadata_admin);
const passkeys = credentialItems(nodes, 'passkey_remove', names);
const keys = credentialItems(nodes, 'webauthn_remove');
const totp = totpView(nodes);
const lookup = lookupView(nodes);
const verified = emailVerified(stored ?? identity);
const status = securityStatus(nodes, { emailVerified: verified });

const has = (g: FlowNode['group']) => nodes.some((n) => n.group === g);
const hasNode = (name: string) => nodes.some((n) => asInput(n)?.name === name);
const nodeMessages = (name: string) => nodes.find((n) => asInput(n)?.name === name)?.messages ?? [];
const value = (name: string) => {
  const v = asInput(nodes.find((n) => asInput(n)?.name === name) as FlowNode)?.value;
  return v === undefined || v === null ? '' : String(v);
};
const kind = (t: string) => (t === 'error' ? 'danger' : t === 'success' ? 'success' : 'warning');

const reauth = dev ? dev.reauth : privilegedLapsed(session!.authenticated_at);
const reauthHref = browserFlows.login({ refresh: true, returnTo: '/auth/settings' });
const verifyHref = browserFlows.verification(`${publicUrl}/auth/settings`, traits.email);
const showBackupPrompt = flow.state === 'success' && status.twoStep && !status.backupCodes;
// The enrollment steps open on their own when a code was refused (or the fixture asks); otherwise they wait behind a button.
const setupOpen = totp.codeMessages.length > 0 || (dev?.setupOpen ?? false);
const pwOpen = passwordPanelOpen(nodes, parseIdentity(stored).hasPassword);
// The saved line belongs in the card that was edited. Script fills it on a live swap; the dev fixture renders it here.
const devFlash = dev?.flash ? FLASH[dev.flash] : null;
const devFlashCard = dev?.flash?.startsWith('lookup') ? 'recovery' : 'two-step';
// A person with no passkey yet is at the first step: it leads the page, and the Passkeys card keeps only its list.
const welcome = status.passkeys === 0 && has('passkey');
const keeper = isAdmin || holdsElevatedRole(stored);
const keepSecondFactor = keeper && status.securityKeys === 0;
const keyOnly = keyOnlyKeeper(nodes, keeper);
const lookupConfirm = nodesByGroup(nodes, 'lookup_secret').some((n) => asInput(n)?.name === 'lookup_secret_confirm');
const lookupOff = nodesByGroup(nodes, 'lookup_secret').map(asInput).find((a) => a?.name === 'lookup_secret_disable') ?? null;

const csrfSignOut = mint(identity.id, 'sign-out-everywhere');
const renameTokens = passkeys.map(() => mint(identity.id, 'passkey-name'));
const storedAvatar = readAvatar(stored?.metadata_admin);
const avatarSrc = storedAvatar ? (dev ? DEV_AVATAR_SRC : avatarPath(identity.id, storedAvatar)) : null;
const avatarToken = mint(identity.id, 'avatar');

const groups = parseIdentity(stored).groups;
const yourApps = dev ? [] : loadTiles().filter((t) => userCanSeeTile(t, groups));

const lookupLabel: Record<string, string> = {
  lookup_secret_regenerate: lookup.enrolled ? 'Make new codes' : 'Get backup codes',
  lookup_secret_reveal: 'Show my codes',
  lookup_secret_confirm: "I've saved these codes",
};
---
<Layout title="Account" description="Account settings." compact router>
  <Fragment slot="header-actions">
    <HeaderActions identityId={identity.id} isAdmin={isAdmin} />
  </Fragment>

  <div class="settings">
    {/* Owner of every disclosure checkbox: Enter on one submits this inert form, never the form it sits inside. */}
    <form id="disclosures" method="dialog" data-astro-reload hidden></form>
    <a class="back-link" href="/" data-astro-reload>← Home</a>
    <header class="page-header">
      <h1 class="page-title">Account</h1>
      <p class="page-lede">
        How you sign in, how to get back in, and how you appear in apps, for <strong>{displayName}</strong>.
      </p>
    </header>

    <div class="settings-status" role="status" aria-label="Account security summary">
      <span class={`badge ${status.twoStep ? '' : 'badge-warning'}`}>Two-step {status.twoStep ? 'on' : 'off'}</span>
      <span class={`badge ${status.passkeys > 0 ? '' : 'badge-warning'}`}>{status.passkeys} {status.passkeys === 1 ? 'passkey' : 'passkeys'}</span>
      <a class={`badge ${status.backupCodes || !status.twoStep ? '' : 'badge-warning'}`} href="#recovery">Backup codes {status.backupCodes ? 'saved' : 'not saved'}</a>
      {status.emailUnverified && <span class="badge badge-warning">Unverified email</span>}
      {reauth && (
        <span class="status-note" data-testid="reauth-notice">
          It has been a while, so changes ask you to confirm it's you first. <a href={reauthHref} data-astro-reload>Confirm it's you</a>
        </span>
      )}
    </div>

    <div class="settings-notices" role="status">
      {ui.messages?.filter((m) => !(devFlash && m.type === 'success')).map((m) => (
        <div class={`notice notice-${kind(m.type)}`} data-flow-success={m.type === 'success' ? '' : undefined}>{messageText(m)}</div>
      ))}
      {signOutError && <div class="notice notice-danger">{signOutError}</div>}
      {status.passkeys === 1 && (
        <div class="notice notice-warning">You have one passkey. Add one on your other devices too, so losing this one doesn't lock you out.</div>
      )}
      {status.emailUnverified && (
        <div class="notice notice-warning">
          Your email address is not verified yet. Verify it so you can get back in if you lose a device.
          <div class="actions"><a class="button button-secondary button-sm" href={verifyHref} data-astro-reload>Send verification code</a></div>
        </div>
      )}
    </div>
    {welcome && (
      <section class="panel welcome" aria-labelledby="h-welcome">
        <p class="welcome-step">Your first step</p>
        <h2 id="h-welcome">Add a passkey</h2>
        <p>Next time, sign in with your fingerprint, face or screen lock. No code to find, nothing to remember.</p>
        <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form wide">
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="method" value="passkey" />
          {nodesByGroup(nodes, 'passkey').map((n) => {
            const a = asInput(n);
            if (a?.type === 'hidden') return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
            if (a?.type === 'button') {
              return (
                <button class="button button-primary welcome-btn" type="button" name={a.name} value={String(a.value ?? '')} onclick={safeOnclick(a)}>
                  Add a passkey
                </button>
              );
            }
            return null;
          })}
        </form>
      </section>
    )}
    <div class="cards">
      <section class="panel card" id="sign-in" data-card aria-labelledby="h-signin">
        <h2 id="h-signin">Sign-in</h2>
        <div class="card-flash" data-flash tabindex="-1" role="status">{null}</div>

        {has('passkey') && (
          <div class="group">
            <h3>Passkeys <span class="badge">Recommended</span></h3>
            <p>Sign in with your fingerprint, face or screen lock. Add one on each device you use.</p>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form wide">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="passkey" />
              {nodesByGroup(nodes, 'passkey').map((n) => {
                const a = asInput(n);
                if (a?.type === 'hidden') return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
                return null;
              })}
              <CredentialRows items={passkeys} kind="passkey" noun="passkey" fallbackName="Passkey" rename={passkeys.length > 0} renameError={renameError} reauth={reauth} reauthHref={reauthHref} />
              {nodesByGroup(nodes, 'passkey').map((n) => {
                const a = asInput(n);
                if (a?.type === 'button' && !welcome) {
                  return (
                    <div class="form-actions">
                      <button class="button button-primary button-sm" type="button" name={a.name} value={String(a.value ?? '')} onclick={safeOnclick(a)}>
                        {passkeys.length > 0 ? 'Add another passkey' : (n.meta?.label?.text ?? 'Add a passkey')}
                      </button>
                    </div>
                  );
                }
                return null;
              })}
            </form>
            {passkeys.filter((p) => p.removable).map((p) => <ActionForm id={`rm-passkey-${p.id}`} action={ui.action} csrf={csrf} method="passkey" />)}
            {passkeys.map((p, i) => (
              <form id={`rename-${i}`} method="POST" enctype="application/x-www-form-urlencoded" action="/auth/passkey-name" hidden>
                <input type="hidden" name="csrf_token" value={renameTokens[i]} />
                <input type="hidden" name="credential_id" value={p.id} />
              </form>
            ))}
          </div>
        )}

        {has('password') && (
          <div class="group">
            <h3>Password</h3>
            <p>Only for places a passkey can't be used. Changing it signs out your other devices.</p>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="password" />
              <input type="checkbox" form="disclosures" class="disclose cb-setup" id="pw-open" checked={pwOpen} />
              <div class="form-actions">
                <label for="pw-open" class="button button-secondary button-sm toggle-label lbl-setup"><span class="on-closed">Change password</span><span class="on-open">Cancel</span></label>
              </div>
              <div class="panel-block panel-setup">
                {nodesByGroup(nodes, 'password').map((n) => {
                  const a = asInput(n);
                  if (!a) return null;
                  if (a.type === 'hidden') return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
                  if (a.type === 'submit') {
                    return (
                      <div class="form-actions">
                        <button class="button button-primary button-sm" type="submit" name={a.name} value={String(a.value ?? '')}>Save new password</button>
                      </div>
                    );
                  }
                  return (
                    <PasswordField username={traits.username} name={a.name} label={n.meta?.label?.text ?? 'New password'} required={a.required}>
                      {n.messages?.map((m) => <div class={`notice notice-${kind(m.type)}`}>{messageText(m)}</div>)}
                    </PasswordField>
                  );
                })}
              </div>
            </form>
          </div>
        )}
      </section>

      <section class="panel card" id="two-step" data-card aria-labelledby="h-2sv">
        <h2 id="h-2sv">Two-step verification</h2>
        <div class="card-flash" data-flash tabindex="-1" role="status">{devFlash && devFlashCard === 'two-step' && <div class="notice notice-success">{devFlash}{LOST_KEYS.has(dev?.flash ?? '') && <> Lost it? <a href="#signout-all" data-open="signout-all">Also sign out everywhere</a></>}</div>}</div>
        <p class="lede">A second check keeps others out even if they learn your password. Backup codes are under <a href="#recovery">Recovery</a>.</p>
        {showBackupPrompt && (
          <>
            <input type="checkbox" form="disclosures" class="disclose cb-dismiss" id="backup-dismiss" aria-label="Dismiss the backup codes reminder" />
            <div class="notice notice-warning prompt" data-testid="backup-prompt">
              <strong>Save your backup codes now.</strong> If you lose your phone or key, they are the way back in.
              <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="actions">
                <input type="hidden" name="csrf_token" value={csrf} />
                <input type="hidden" name="method" value="lookup_secret" />
                <button class="button button-primary button-sm" type="submit" name="lookup_secret_regenerate" value="true">Get backup codes</button>
                <label for="backup-dismiss" class="button button-secondary button-sm toggle-label">Later</label>
              </form>
            </div>
          </>
        )}

        {has('totp') && (
          <div class="group">
            <h3>Authenticator app</h3>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form wide">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="totp" />
              {totp.enrolled && totp.unlink && (
                <>
                  <p>An app on your phone shows a new 6-digit code every 30 seconds.</p>
                  <ul class="items">
                    <li>
                      <div class="item-id"><span class="item-name">Your app</span><span class="badge">On</span></div>
                      <input type="checkbox" form="disclosures" class="disclose cb-replace" id="totp-replace" aria-label="Replace authenticator app" />
                      <input type="checkbox" form="disclosures" class="disclose cb-remove" id="totp-remove" aria-label="Remove authenticator app" />
                      <div class="item-actions">
                        <label for="totp-replace" class="button button-secondary button-sm toggle-label lbl-replace"><span class="on-closed">Replace</span></label>
                        <label for="totp-remove" class="button button-secondary button-sm toggle-label lbl-remove"><span class="on-closed">Remove</span></label>
                      </div>
                      <div class="panel-row panel-replace">
                        {keepSecondFactor ? (
                          <span>{SECOND_FACTOR_KEEP} Add a security key first, then replace the app.</span>
                        ) : (
                          <>
                            <span>Replace the app? The current one stops working, then you scan a new code.</span>
                            <button type="submit" form="totp-unlink" name={totp.unlink.name} value={totp.unlink.value} class="button button-danger button-sm" data-flash-key="totp_replace">Replace app</button>
                            <ConfirmCues reauth={reauth} reauthHref={reauthHref} lost />
                          </>
                        )}
                        <label for="totp-replace" class="button button-secondary button-sm toggle-label">Keep it</label>
                      </div>
                      <div class="panel-row panel-remove">
                        {keepSecondFactor ? (
                          <span>{SECOND_FACTOR_KEEP} Add a security key first, then remove the app.</span>
                        ) : (
                          <>
                            <span>Remove the app? You won't be able to use it for the second step anymore.</span>
                            <button type="submit" form="totp-unlink" name={totp.unlink.name} value={totp.unlink.value} class="button button-danger button-sm" aria-label="Remove authenticator app">Remove app</button>
                            <ConfirmCues reauth={reauth} reauthHref={reauthHref} lost />
                          </>
                        )}
                        <label for="totp-remove" class="button button-secondary button-sm toggle-label">Keep it</label>
                      </div>
                    </li>
                  </ul>
                </>
              )}
              {!totp.enrolled && (
                <>
                  <input type="checkbox" form="disclosures" class="disclose cb-setup" id="totp-setup" checked={setupOpen} />
                  <p class="when-closed">Not set up. Get an authenticator app (Google Authenticator, Microsoft Authenticator or Aegis); it shows a new 6-digit code every 30 seconds.</p>
                  <div class="form-actions when-closed">
                    <label for="totp-setup" class="button button-secondary button-sm toggle-label lbl-setup">Set up authenticator app</label>
                  </div>
                  <ol class="steps panel-block panel-setup">
                    {totp.qr && (
                      <li>
                        <h4 tabindex="-1">Scan the code</h4>
                        <p>Scan this into your authenticator app. Scan it into every app you want to use now; each shows the same codes.</p>
                        <p class="field-hint narrow-only">On this phone? Copy the setup key into your app.</p>
                        <TotpKey qr={totp.qr} secret={totp.secret} />
                      </li>
                    )}
                    {totp.codeInput && (
                      <li>
                        <h4 tabindex="-1">Enter the 6-digit code</h4>
                        <p>Type the code your app shows now to finish.</p>
                        <div class={`field ${totp.codeMessages.length ? 'bad' : ''}`}>
                          <label for="totp-code">6-digit code</label>
                          <input
                            id="totp-code"
                            class="codeinput"
                            name={totp.codeInput.name}
                            type="text"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            maxlength="12"
                            pattern="[0-9]{6}"
                            title="Six digits, like 123456"
                            placeholder="000000"
                            required={totp.codeInput.required}
                            aria-invalid={totp.codeMessages.length ? 'true' : undefined}
                            aria-describedby={totp.codeMessages.length ? 'totp-code-error' : undefined}
                          />
                          {totp.codeMessages.map((m) => (
                            <p id="totp-code-error" class="field-error" role="alert">{messageText(m)} The QR code is still good.</p>
                          ))}
                        </div>
                        {totp.save && (
                          <div class="form-actions">
                            <button class="button button-primary button-sm" type="submit" name={totp.save.name} value={totp.save.value}>Verify and add</button>
                            <label for="totp-setup" class="button button-secondary button-sm toggle-label lbl-setup">Cancel</label>
                          </div>
                        )}
                      </li>
                    )}
                  </ol>
                </>
              )}
            </form>
            {totp.enrolled && totp.unlink && <ActionForm id="totp-unlink" action={ui.action} csrf={csrf} method="totp" />}
          </div>
        )}

        {has('webauthn') && (
          <div class="group">
            <h3>Security keys</h3>
            <p>A small key you plug in or tap. Name each one so you recognise it.</p>
            {keyOnly && <p>To add another key, set up an authenticator app first, add the key, then remove the app if you like.</p>}
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form wide">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="webauthn" />
              <CredentialRows items={keys} kind="webauthn" noun="security key" fallbackName="Security key" reauth={reauth} reauthHref={reauthHref} />
              <input type="checkbox" form="disclosures" class="disclose cb-setup" id="key-add" checked={nodesByGroup(nodes, 'webauthn').some((n) => (n.messages?.length ?? 0) > 0)} />
              <div class="form-actions">
                <label for="key-add" class="button button-secondary button-sm toggle-label lbl-setup"><span class="on-closed">{keys.length > 0 ? 'Add another security key' : 'Add a security key'}</span><span class="on-open">Cancel</span></label>
              </div>
              <div class="panel-block panel-setup">
                {nodesByGroup(nodes, 'webauthn').map((n) => {
                  if (n.attributes.node_type === 'script') return null;
                  const a = asInput(n);
                  if (!a || a.name === 'webauthn_remove') return null;
                  if (a.type === 'hidden') return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
                  if (a.type === 'button' || a.type === 'submit') {
                    return (
                      <div class="form-actions">
                        <button class="button button-primary button-sm" type={a.type} name={a.name} value={String(a.value ?? '')} onclick={safeOnclick(a)}>
                          Add this key
                        </button>
                      </div>
                    );
                  }
                  return (
                    <div class="field">
                      <label for="webauthn-register-displayname">Name for the new key</label>
                      <input id="webauthn-register-displayname" name={a.name} type={a.type} placeholder="e.g. Spare key in the drawer" value={a.value !== undefined ? String(a.value) : undefined} required={a.required} />
                      {n.messages?.map((m) => <div class={`notice notice-${kind(m.type)}`}>{messageText(m)}</div>)}
                    </div>
                  );
                })}
              </div>
            </form>
            {keys.filter((k) => k.removable).map((k) => <ActionForm id={`rm-webauthn-${k.id}`} action={ui.action} csrf={csrf} method="webauthn" />)}
          </div>
        )}
      </section>

      <section class="panel card" id="recovery" data-card aria-labelledby="h-rec">
        <h2 id="h-rec">Recovery</h2>
        <div class="card-flash" data-flash tabindex="-1" role="status">{devFlash && devFlashCard === 'recovery' && <div class="notice notice-success">{devFlash}</div>}</div>
        <p class="lede">For the day a phone is lost or broken.</p>

        {has('lookup_secret') && (
          <div class="group">
            <h3>Backup codes <span class={`badge ${status.backupCodes || !status.twoStep ? '' : 'badge-warning'}`}>{status.backupCodes ? 'Saved' : 'Not saved'}</span></h3>
            <p>{status.twoStep || lookup.enrolled ? 'Single-use codes for when nothing else works. Print or store them safely.' : 'Single-use codes for when a second step is lost. Add a passkey or an authenticator app first, then get your codes.'}</p>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form wide">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="lookup_secret" />
              {lookup.list.length > 0 && (
                <div class="lookup-codes" id="lookup-codes">
                  <ol class="lookup-grid" data-testid="backup-codes">
                    {lookup.list.map((c) => (
                      <li class={c.used ? 'used' : ''}>{c.used ? <span class="mono">used</span> : <code class="mono">{c.code}</code>}</li>
                    ))}
                  </ol>
                  <div class="form-actions" data-codes-tools hidden>
                    <button type="button" class="button button-secondary button-sm" data-copy-codes="lookup-codes">Copy codes</button>
                    <button type="button" class="button button-secondary button-sm" data-print-codes>Print</button>
                    <button type="button" class="button button-secondary button-sm" data-hide-codes aria-expanded="true">Hide codes</button>
                  </div>
                  {lookupConfirm && (
                    <div class="notice notice-warning">These codes only work after you press <strong>I've saved these codes</strong>. Until then, the old ones stay in use.</div>
                  )}
                </div>
              )}
              {lookupOff && <input type="checkbox" form="disclosures" class="disclose cb-remove" id="lookup-off" aria-label="Turn off backup codes" />}
              <div class="form-actions">
                {nodesByGroup(nodes, 'lookup_secret').map((n) => {
                  const a = asInput(n);
                  if (!a || a.name === 'lookup_secret_disable') return null;
                  if (a.type === 'hidden') return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
                  if (a.type === 'submit' || a.type === 'button') {
                    const primary = a.name === 'lookup_secret_confirm' || (a.name === 'lookup_secret_regenerate' && !lookup.enrolled && status.twoStep);
                    return (
                      <button
                        class={`button ${primary ? 'button-primary' : 'button-secondary'} button-sm`}
                        disabled={a.name === 'lookup_secret_regenerate' && !lookup.enrolled && !status.twoStep}
                        type={a.type}
                        name={a.name}
                        value={String(a.value ?? '')}
                      >
                        {lookupLabel[a.name] ?? n.meta?.label?.text ?? 'Save'}
                      </button>
                    );
                  }
                  const id = a.name.replace(/[^a-zA-Z0-9]+/g, '-');
                  return (
                    <div class="field">
                      <label for={id}>{n.meta?.label?.text ?? a.name}</label>
                      <input id={id} name={a.name} type={a.type} value={String(a.value ?? '')} />
                    </div>
                  );
                })}
                {lookupOff && (
                  <label for="lookup-off" class="button button-secondary button-sm toggle-label lbl-remove"><span class="on-closed">Turn off</span></label>
                )}
              </div>
              {lookupOff && (
                <div class="panel-row panel-remove">
                  <span>Turn off backup codes? Any you saved stop working.</span>
                  <button type="submit" form="lookup-off-form" name={lookupOff.name} value={String(lookupOff.value ?? '')} class="button button-danger button-sm">Turn off backup codes</button>
                  <label for="lookup-off" class="button button-secondary button-sm toggle-label">Keep it</label>
                </div>
              )}
            </form>
            {lookupOff && <ActionForm id="lookup-off-form" action={ui.action} csrf={csrf} method="lookup_secret" />}
          </div>
        )}

        {has('profile') && hasNode('traits.recoveryEmail') && (
          <div class="group">
            <h3>Recovery email</h3>
            <p>Optional second address, used if {traits.email} stops working.</p>
            <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form">
              <input type="hidden" name="csrf_token" value={csrf} />
              <input type="hidden" name="method" value="profile" />
              <input type="hidden" name="traits.username" value={traits.username} />
              {hasNode('traits.displayName') && <input type="hidden" name="traits.displayName" value={value('traits.displayName')} />}
              <input type="hidden" name="traits.email" value={value('traits.email') || traits.email} />
              {emailLocked ? (
                <>
                  <input type="hidden" name="traits.recoveryEmail" value={value('traits.recoveryEmail')} />
                  <div class="static">
                    <span class="static-label" id="recovery-email-label">Recovery email address</span>
                    <span class="static-value" aria-labelledby="recovery-email-label">{value('traits.recoveryEmail') || <span class="static-empty">None yet</span>}</span>
                  </div>
                  <div class="form-actions"><a class="button button-secondary button-sm" href={reauthHref} data-astro-reload>{value('traits.recoveryEmail') ? 'Change recovery email' : 'Add a recovery email'}</a></div>
                </>
              ) : (
                <>
                  <div class="field">
                    <label for="recovery-email">Recovery email address</label>
                    <input id="recovery-email" name="traits.recoveryEmail" type="email" value={value('traits.recoveryEmail')} />
                    {nodeMessages('traits.recoveryEmail').map((m) => <div class={`notice notice-${kind(m.type)}`}>{messageText(m)}</div>)}
                  </div>
                  <div class="form-actions"><button class="button button-secondary button-sm" type="submit" name="method" value="profile">Save email</button></div>
                </>
              )}
            </form>
          </div>
        )}
      </section>

      <section class="panel card" id="picture" data-card aria-labelledby="h-pic">
        <h2 id="h-pic">Picture</h2>
        {avatarFlash && <div class={`notice notice-${avatarFlash.tone}`} role="status">{avatarFlash.text}</div>}
        <p class="lede">Apps that show a picture use this one.</p>
        <AvatarEditor action="/auth/avatar" csrf={avatarToken} src={avatarSrc} name={displayName} />
      </section>

      {has('profile') && (
        <section class="panel card" id="profile" data-card aria-labelledby="h-prof">
          <h2 id="h-prof">Profile</h2>
          <div class="card-flash" data-flash tabindex="-1" role="status">{null}</div>
          <p class="lede">Your name and email. A new address is sent a verification code.</p>
          <form method="POST" enctype="application/x-www-form-urlencoded" action={ui.action} class="settings-form">
            <input type="hidden" name="csrf_token" value={csrf} />
            <input type="hidden" name="method" value="profile" />
            <input type="hidden" name="traits.username" value={traits.username} />
            {hasNode('traits.recoveryEmail') && <input type="hidden" name="traits.recoveryEmail" value={value('traits.recoveryEmail')} />}
            {hasNode('traits.displayName') && (
              <div class="field">
                <label for="display-name">Display name</label>
                <input id="display-name" name="traits.displayName" type="text" value={value('traits.displayName')} />
                {nodeMessages('traits.displayName').map((m) => <div class={`notice notice-${kind(m.type)}`}>{m.text}</div>)}
              </div>
            )}
            <div class="field">
              <label for="username-readonly">Username</label>
              <input id="username-readonly" type="text" value={traits.username} readonly aria-describedby="username-hint" />
              <p id="username-hint" class="field-hint">Only a household admin can change your username.</p>
              {nodeMessages('traits.username').map((m) => <div class={`notice notice-${kind(m.type)}`}>{m.text}</div>)}
            </div>
            <div class="field">
              <label for={emailLocked ? 'email-readonly' : 'email'}>Email</label>
              <div class="email-row">
                {emailLocked ? (
                  <>
                    <input type="hidden" name="traits.email" value={traits.email} />
                    <input id="email-readonly" type="text" value={traits.email} readonly aria-describedby="email-hint" />
                  </>
                ) : (
                  <input id="email" name="traits.email" type="email" value={value('traits.email') || traits.email} required />
                )}
                {verified !== null && <span class={`badge ${verified ? '' : 'badge-warning'}`}>{verified ? 'Verified' : 'Unverified'}</span>}
              </div>
              {verified === false && (
                <div class="actions"><a class="button button-secondary button-sm" href={verifyHref} data-astro-reload>Send verification code</a></div>
              )}
              {emailLocked && (
                <p id="email-hint" class="field-hint">
                  To change an email address, sign in again with your passkey or password.{' '}
                  <a href={reauthHref} data-astro-reload>Change email address</a>
                </p>
              )}
              {nodeMessages('traits.email').map((m) => <div class={`notice notice-${kind(m.type)}`}>{messageText(m)}</div>)}
            </div>
            <div class="form-actions">
              <button class="button button-primary button-sm" type="submit" name="method" value="profile">Save profile</button>
            </div>
          </form>
        </section>
      )}

      <section class="panel card card-wide" id="sessions" data-card aria-labelledby="h-ses">
        <h2 id="h-ses">Sessions and apps</h2>
        <div class="card-flash" data-flash tabindex="-1" role="status">{null}</div>
        <div class="group">
          <h3>Sessions</h3>
          <p>"Sign out everywhere" signs out every device and app, so none can quietly sign you back in.</p>
          <form id="signout-form" method="POST" enctype="application/x-www-form-urlencoded" action="/auth/settings" data-astro-reload hidden>
            <input type="hidden" name="action" value="sign-out-everywhere" />
            <input type="hidden" name="csrf_token" value={csrfSignOut} />
          </form>
          <div class="settings-form">
            <input type="checkbox" form="disclosures" class="disclose cb-remove" id="signout-all" aria-label="Sign out everywhere" />
            <div class="form-actions">
              <label for="signout-all" class="button button-danger button-sm toggle-label lbl-remove"><span class="on-closed">Sign out everywhere</span></label>
            </div>
            <div class="panel-row panel-remove">
              <span>Sign out of every device and app, this one included?</span>
              <button class="button button-danger button-sm" type="submit" form="signout-form">Sign out everywhere</button>
              <label for="signout-all" class="button button-secondary button-sm toggle-label">Keep it</label>
            </div>
          </div>
        </div>
        <div class="group">
          <h3>Your apps {isAdmin && <span class="badge badge-accent">Admin</span>}</h3>
          {yourApps.length > 0 ? (
            <div class="kv-chips" style="margin-top: var(--space-2)">
              {yourApps.map((t) => <span class="badge badge-muted">{t.name}</span>)}
            </div>
          ) : (
            <p>No apps yet. A household admin can add you.</p>
          )}
        </div>
      </section>
    </div>

  </div>

  {scripts.map((s) => (
    <script
      src={s.src}
      id={s.id}
      async
      is:inline
      integrity={s.integrity}
      crossorigin={s.crossorigin}
      referrerpolicy={s.referrerpolicy}
      nonce={s.nonce}
    ></script>
  ))}

</Layout>

<script>
  import '../../scripts/settings-enhance';
</script>
