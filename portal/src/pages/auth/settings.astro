---
// Settings flow handler.
//
// Requires an active session: redirects to /auth/login if absent.
// Reads ?flow=<id>; if absent or expired, redirects to Kratos's
// settings/browser initiator (which sets the anti-CSRF cookie and
// 303s back here with a fresh flow id).
//
// Renders sections from flow.ui.nodes per method group:
//   - profile:  username, email, displayName, recoveryEmail
//   - passkey:  list enrolled credentials + register new
//   - password: change password
//   (totp + lookup_secret deferred)
//
// Plus a logout-everywhere button sourced from /self-service/logout/browser.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import {
  browserFlows,
  getLogoutInfo,
  getSession,
  getSettingsFlow,
} from '../../lib/kratos';
import {
  asInput,
  csrfToken,
  hasMethod,
  nodesByGroup,
  scriptNodes,
} from '../../lib/nodes';
import { revokeSubject, RevokeError } from '../../lib/revoke';
import type { FlowNode, NodeInputAttributes, Session } from '../../lib/types';

const cookie = Astro.request.headers.get('cookie') ?? undefined;

let session: Session | null;
try {
  session = await getSession(cookie);
} catch {
  return Astro.redirect('/auth/login');
}
if (!session?.active || !session.identity) {
  return Astro.redirect('/auth/login?return_to=' + encodeURIComponent('/auth/settings'));
}

// Self-service "sign out everywhere" (CU3 B1 trigger). Routes through the
// in-process revoke fan-out (steps 2-6) on the CALLER'S OWN identity — NOT
// the Kratos browser-logout, which only drops the local Kratos session and
// leaves Hydra's 24h remembered-login window open. deactivate is false: the
// user is signing out, not deactivating themselves.
let signOutError: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (String(fd.get('action') ?? '') === 'sign-out-everywhere') {
    try {
      await revokeSubject(session.identity.id);
    } catch (err) {
      // Prescriptive on a hard-cut failure; do not leak raw upstream errors.
      signOutError =
        err instanceof RevokeError
          ? err.message
          : 'Could not sign out everywhere; please retry.';
    }
    if (!signOutError) {
      // Cut landed: bounce the caller's own browser session through Kratos
      // logout so the current cookie is dropped too.
      const info = await getLogoutInfo(cookie);
      if (info) {
        const logoutUrl = new URL(info.logout_url);
        logoutUrl.searchParams.set('token', info.logout_token);
        return Astro.redirect(logoutUrl.toString());
      }
      return Astro.redirect('/auth/login');
    }
  }
}

const flowId = Astro.url.searchParams.get('flow');
if (!flowId) {
  return Astro.redirect(browserFlows.settings('https://auth.dunn.dev/auth/settings'));
}

const result = await getSettingsFlow(flowId, cookie);
if (result.kind !== 'ok') {
  return Astro.redirect(browserFlows.settings('https://auth.dunn.dev/auth/settings'));
}

const flow = result.flow;
const ui = flow.ui;
const csrf = csrfToken(ui.nodes);
const scripts = scriptNodes(ui.nodes);

const hasProfile = hasMethod(ui.nodes, 'profile');
const hasPasskey = hasMethod(ui.nodes, 'passkey');
const hasPassword = hasMethod(ui.nodes, 'password');

interface InputBundle {
  node: FlowNode;
  attr: NodeInputAttributes;
}

function inputsFor(group: FlowNode['group']): InputBundle[] {
  const out: InputBundle[] = [];
  for (const node of nodesByGroup(ui.nodes, group)) {
    const attr = asInput(node);
    if (attr) out.push({ node, attr });
  }
  return out;
}

function fieldLabel(meta: { label?: { text?: string } } | undefined, fallback: string): string {
  return meta?.label?.text ?? fallback;
}

const logoutInfo = await getLogoutInfo(cookie);
const traits = session.identity.traits;
const groups = session.identity.metadata_admin?.groups ?? [];
const displayName = traits.displayName || traits.username || '';
const identityGroups = groups.filter((g) => !g.startsWith('access-'));
const accessGroups = groups.filter((g) => g.startsWith('access-'));
---
<Layout title="Settings" description="Account settings.">

  <header class="page-header">
    <p class="page-eyebrow">account</p>
    <h1 class="page-title">Settings</h1>
    <p class="page-lede">
      Profile details, passkeys, password, and active sessions for
      <strong>{displayName}</strong>.
    </p>
  </header>

  {ui.messages?.map((m) => (
    <div class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}>
      {m.text}
    </div>
  ))}

  {hasProfile && (
    <section class="section">
      <p class="section-subtitle">Profile</p>
      <p class="section-prose">
        Your display name, email address, and username. Email changes
        require verification before they take effect.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="profile" />
        {inputsFor('profile').map(({ node, attr }) => {
          if (attr.type === 'hidden') {
            return <input type="hidden" name={attr.name} value={String(attr.value ?? '')} />;
          }
          if (attr.type === 'submit' || attr.type === 'button') {
            return (
              <div class="form-actions">
                <button class="button button-primary" type={attr.type}
                        name={attr.name} value={String(attr.value ?? '')}>
                  {fieldLabel(node.meta, 'Save changes')}
                </button>
              </div>
            );
          }
          const id = attr.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{fieldLabel(node.meta, attr.name)}</label>
              <input
                id={id}
                name={attr.name}
                type={attr.type}
                value={attr.value !== undefined ? String(attr.value) : ''}
                required={attr.required}
                disabled={attr.disabled}
                autocomplete={attr.autocomplete}
              />
            </div>
          );
        })}
      </form>
    </section>
  )}

  {hasPasskey && (
    <section class="section">
      <p class="section-subtitle">Passkeys</p>
      <p class="section-prose">
        Register a passkey on each device you use. With a passkey,
        signing in is one tap, no password to remember.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="passkey" />
        {inputsFor('passkey').map(({ node, attr }) => {
          if (attr.type === 'hidden') {
            return <input type="hidden" name={attr.name} value={String(attr.value ?? '')} />;
          }
          if (attr.type === 'submit' || attr.type === 'button') {
            return (
              <div class="form-actions">
                <button class="button button-secondary" type={attr.type}
                        name={attr.name} value={String(attr.value ?? '')}
                        onclick={attr.onclick}>
                  {fieldLabel(node.meta, 'Register a passkey')}
                </button>
              </div>
            );
          }
          const id = attr.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{fieldLabel(node.meta, attr.name)}</label>
              <input
                id={id}
                name={attr.name}
                type={attr.type}
                value={attr.value !== undefined ? String(attr.value) : ''}
                autocomplete={attr.autocomplete}
              />
            </div>
          );
        })}
      </form>
    </section>
  )}

  {hasPassword && (
    <section class="section">
      <p class="section-subtitle">Password</p>
      <p class="section-prose">
        Change the password used as a fallback when a passkey isn't
        available.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="password" />
        {inputsFor('password').map(({ node, attr }) => {
          if (attr.type === 'hidden') {
            return <input type="hidden" name={attr.name} value={String(attr.value ?? '')} />;
          }
          if (attr.type === 'submit' || attr.type === 'button') {
            return (
              <div class="form-actions">
                <button class="button button-secondary" type={attr.type}
                        name={attr.name} value={String(attr.value ?? '')}>
                  {fieldLabel(node.meta, 'Change password')}
                </button>
              </div>
            );
          }
          const id = attr.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{fieldLabel(node.meta, attr.name)}</label>
              <input
                id={id}
                name={attr.name}
                type={attr.type}
                required={attr.required}
                autocomplete={attr.autocomplete ?? 'new-password'}
              />
            </div>
          );
        })}
      </form>
    </section>
  )}

  <section class="section">
    <p class="section-subtitle">Sessions</p>
    <p class="section-prose">
      Sign out of this device, or revoke every active session at once.
      "Sign out everywhere" cuts your Kratos sessions AND Hydra's
      remembered-login window, so no app can silently re-issue a token.
    </p>
    {signOutError && (
      <div class="notice notice-danger">{signOutError}</div>
    )}
    <form method="POST" action="/auth/settings" class="settings-form">
      <input type="hidden" name="action" value="sign-out-everywhere" />
      <div class="form-actions">
        <button class="button button-danger" type="submit">Sign out everywhere</button>
      </div>
    </form>
    {!logoutInfo && (
      <p class="muted text-sm">Local logout endpoint unavailable; the revoke still runs.</p>
    )}
  </section>

  <section class="section">
    <p class="section-subtitle">Membership</p>
    <dl class="kv">
      <div>
        <dt>Username</dt>
        <dd class="mono">{traits.username}</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd class="mono">{traits.email}</dd>
      </div>
      <div>
        <dt>Identity</dt>
        <dd class="kv-chips">
          {identityGroups.length
            ? identityGroups.map((g) => <span class="chip">{g}</span>)
            : <span class="muted text-sm">none</span>}
        </dd>
      </div>
      <div>
        <dt>App access</dt>
        <dd class="kv-chips">
          {accessGroups.length
            ? accessGroups.map((g) => <span class="chip chip-muted">{g}</span>)
            : <span class="muted text-sm">none</span>}
        </dd>
      </div>
    </dl>
  </section>

  <p style="margin-top: var(--space-7);">
    <a href="/" class="back-link mono">Back home</a>
  </p>

  {scripts.map((s) => (
    <script src={s.src} id={s.id} async is:inline></script>
  ))}

</Layout>

<style>
  /* Settings forms: column layout, hairline border between fields, labels
   * sit on their own line so checkboxes and selects align. */
  .settings-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
    margin-top: var(--space-3);
  }
  .form-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Key/value membership table without the heaviness of a real table.
   * Hairline rows, mono values, label in muted weight. */
  .kv {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .kv > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .kv dd {
    font-size: var(--text-sm);
    color: var(--text);
  }
  .kv-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .chip {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text);
    background: var(--bg);
    line-height: 1.4;
  }
  .chip-muted {
    color: var(--text-2);
    background: var(--surface);
  }

  .back-link {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .back-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .kv > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
