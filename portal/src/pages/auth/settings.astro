---
// Settings flow handler.
//
// Requires an active session: redirects to /auth/login if absent.
// Reads ?flow=<id>; if absent or expired, redirects to Kratos's
// settings/browser initiator (which sets the anti-CSRF cookie and
// 303s back here with a fresh flow id).
//
// Renders sections from flow.ui.nodes per method group:
//   - profile:       email, displayName, recoveryEmail; username read-only
//   - passkey:       list enrolled credentials + register new
//   - password:      change password
//   - totp:          authenticator app QR + verify code (enroll / already enrolled)
//   - lookup_secret: generate / reveal backup recovery codes
//   - webauthn:      register a hardware security key (MFA second factor)
//
// Plus a logout-everywhere button sourced from /self-service/logout/browser.

export const prerender = false;

// Bug fix: TOTP QR/secret and backup codes must not sit in the browser
// back/forward cache. Set no-store so every navigation fetches fresh.
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');

import Layout from '../../layouts/Layout.astro';
import {
  browserFlows,
  getLogoutInfo,
  getSession,
  getSettingsFlow,
} from '../../lib/kratos';
import {
  csrfToken,
  hasMethod,
  nodesByGroup,
  asInput,
  scriptNodes,
  safeOnclick,
} from '../../lib/nodes';
import type { NodeImageAttributes, NodeTextAttributes } from '../../lib/types';
import FlowNodes from '../../components/FlowNodes.astro';
import { revokeSubject, RevokeError } from '../../lib/revoke';
import { getGroupRegistry, isIdentityGroup } from '../../lib/group-registry';
import { getIdentity } from '../../lib/admin-api';
import { identityGroups as readIdentityGroups } from '../../lib/gate';
import { publicUrl } from '../../lib/config';
import { signToken, verifyToken, CSRFError } from '../../lib/csrf';
import type { Session } from '../../lib/types';

const cookie = Astro.request.headers.get('cookie') ?? undefined;

let session: Session | null;
try {
  session = await getSession(cookie);
} catch {
  return Astro.redirect('/auth/login');
}
if (!session?.active || !session.identity) {
  return Astro.redirect('/auth/login?return_to=' + encodeURIComponent('/auth/settings'));
}

// Self-service "sign out everywhere" (CU3 B1 trigger). Routes through the
// in-process revoke fan-out (steps 2-6) on the CALLER'S OWN identity — NOT
// the Kratos browser-logout, which only drops the local Kratos session and
// leaves Hydra's remembered login open. deactivate is false: the
// user is signing out, not deactivating themselves.
let signOutError: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (String(fd.get('action') ?? '') === 'sign-out-everywhere') {
    // Match the admin POST pattern: every state-changing POST carries a
    // per-request CSRF token bound to the caller's own identity. Verify
    // before any side effect; fails closed.
    try {
      verifyToken(String(fd.get('csrf_token') ?? ''), session.identity.id, 'sign-out-everywhere');
    } catch (err) {
      if (err instanceof CSRFError) {
        return new Response(`CSRF: ${err.message}`, { status: 403 });
      }
      throw err;
    }
    try {
      await revokeSubject(session.identity.id);
    } catch (err) {
      // Prescriptive on a hard-cut failure; do not leak raw upstream errors.
      signOutError =
        err instanceof RevokeError
          ? err.message
          : 'Could not sign out everywhere; please retry.';
    }
    // revokeSubject ended every session, this browser's included.
    if (!signOutError) return Astro.redirect('/auth/login');
  }
}

const flowId = Astro.url.searchParams.get('flow');
if (!flowId) {
  return Astro.redirect(browserFlows.settings(`${publicUrl}/auth/settings`));
}

const result = await getSettingsFlow(flowId, cookie);
if (result.kind !== 'ok') {
  return Astro.redirect(browserFlows.settings(`${publicUrl}/auth/settings`));
}

const flow = result.flow;
const ui = flow.ui;
const csrf = csrfToken(ui.nodes);
const scripts = scriptNodes(ui.nodes);

const hasProfile = hasMethod(ui.nodes, 'profile');
const hasPasskey = hasMethod(ui.nodes, 'passkey');
const hasPassword = hasMethod(ui.nodes, 'password');
const hasTotp = hasMethod(ui.nodes, 'totp');
const hasLookupSecret = hasMethod(ui.nodes, 'lookup_secret');
const hasWebAuthn = hasMethod(ui.nodes, 'webauthn');

const logoutInfo = await getLogoutInfo(cookie);
const csrfSignOut = signToken(session.identity.id, 'sign-out-everywhere');
const traits = session.identity.traits;
// The public whoami does NOT expose metadata_admin, so the user's real groups
// must come from a re-fetch of the FULL identity via the ADMIN API (same
// pattern as /api/forward-auth). This is DISPLAY-ONLY (the Membership chips),
// but we still re-fetch so the user sees their actual groups instead of an
// always-empty list. FAIL-CLOSED: on lookup failure show no groups.
let groups: string[] = [];
try {
  groups = readIdentityGroups(await getIdentity(session.identity.id));
} catch (lookupErr) {
  console.error('[othala/settings] getIdentity failed; showing no groups:', lookupErr);
}
const displayName = traits.displayName || traits.username || '';
// Username is admin-controlled: shown read-only and left out of the editable
// profile nodes. The schema requires it, so the stored value rides along
// hidden; the username gate (listen.mjs handleUsernameGate) refuses any other.
const isUsernameNode = (n: (typeof ui.nodes)[number]) => asInput(n)?.name === 'traits.username';
const profileNodes = ui.nodes.filter((n) => !isUsernameNode(n));
const usernameMessages = ui.nodes.find(isUsernameNode)?.messages ?? [];
// Split the user's own groups by the registry's binding-derived type, not an
// `access-` name prefix.
const groupRegistry = getGroupRegistry();
const identityGroups = groups.filter((g) => isIdentityGroup(groupRegistry, g));
const accessGroups = groups.filter((g) => !isIdentityGroup(groupRegistry, g));
---
<Layout title="Settings" description="Account settings.">

  <header class="page-header">
    <p class="page-eyebrow">account</p>
    <h1 class="page-title">Settings</h1>
    <p class="page-lede">
      Profile details, passkeys, authenticator app, backup codes, and active
      sessions for <strong>{displayName}</strong>.
    </p>
  </header>

  {ui.messages?.map((m) => (
    <div class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}>
      {m.text}
    </div>
  ))}

  {hasProfile && (
    <section class="section">
      <p class="section-subtitle">Profile</p>
      <p class="section-prose">
        Your display name and email address. A new email address is saved
        at once and sent a verification code.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="profile" />
        <input type="hidden" name="traits.username" value={traits.username} />
        <div class="field">
          <label for="username-readonly">Username</label>
          <input id="username-readonly" type="text" value={traits.username} readonly aria-describedby="username-hint" />
          <p id="username-hint" class="field-hint">Only an administrator can change your username.</p>
          {usernameMessages.map((m) => (
            <div class={`notice notice-${m.type === 'error' ? 'danger' : 'warning'}`}>{m.text}</div>
          ))}
        </div>
        <FlowNodes
          nodes={profileNodes}
          group="profile"
          buttonClass="button button-primary"
          submitLabel="Save changes"
          wrapActions
          passDisabled
        />
      </form>
    </section>
  )}

  {hasPasskey && (
    <section class="section">
      <p class="section-subtitle passkey-subtitle">
        Passkeys <span class="badge">recommended</span>
      </p>
      <p class="section-prose">
        Register a passkey on each device you use. With a passkey,
        signing in is one tap, no password to remember.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="passkey" />
        <FlowNodes
          nodes={ui.nodes}
          group="passkey"
          buttonClass="button button-secondary"
          submitLabel="Register a passkey"
          wrapActions
          passOnclick
          passRequired={false}
        />
      </form>
    </section>
  )}

  {hasPassword && (
    <section class="section">
      <p class="section-subtitle">Password (legacy clients only)</p>
      <p class="section-prose">
        Change the password used as a fallback when a passkey isn't
        available.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="password" />
        <FlowNodes
          nodes={ui.nodes}
          group="password"
          buttonClass="button button-secondary"
          submitLabel="Change password"
          wrapActions
          passValue={false}
          defaultAutocomplete="new-password"
        />
      </form>
    </section>
  )}

  {hasTotp && (
    <section class="section">
      <p class="section-subtitle">Authenticator app</p>
      <p class="section-prose">
        Set up a time-based one-time password (TOTP) app such as Google
        Authenticator or 1Password as a second factor. Scan the QR code or
        enter the secret manually, then verify with the six-digit code your
        app shows.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="totp" />
        {nodesByGroup(ui.nodes, 'totp').map((n) => {
          // img node: QR code
          if (n.attributes.node_type === 'img') {
            const a = n.attributes as NodeImageAttributes;
            return (
              <div class="totp-qr">
                <img
                  src={a.src}
                  alt={n.meta?.label?.text ?? 'Authenticator app QR code'}
                  width={a.width ?? 200}
                  height={a.height ?? 200}
                />
              </div>
            );
          }
          // text node: the raw secret for manual entry
          if (n.attributes.node_type === 'text') {
            const a = n.attributes as NodeTextAttributes;
            return (
              <div class="totp-secret">
                <p class="totp-secret-label">{n.meta?.label?.text ?? 'Secret key'}</p>
                <code class="totp-secret-value mono">{a.text?.text ?? ''}</code>
              </div>
            );
          }
          // input nodes (totp_code + submit)
          const inp = asInput(n);
          if (!inp) return null;
          if (inp.type === 'hidden') {
            return <input type="hidden" name={inp.name} value={String(inp.value ?? '')} />;
          }
          if (inp.type === 'submit') {
            return (
              <div class="form-actions">
                <button class="button button-secondary" type="submit" name={inp.name} value={String(inp.value ?? '')}>
                  {n.meta?.label?.text ?? 'Save'}
                </button>
              </div>
            );
          }
          // totp_code text input
          const id = inp.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{n.meta?.label?.text ?? 'Verification code'}</label>
              <input
                id={id}
                name={inp.name}
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                required={inp.required}
                placeholder="123456"
              />
            </div>
          );
        })}
      </form>
    </section>
  )}

  {hasLookupSecret && (
    <section class="section">
      <p class="section-subtitle">Backup codes</p>
      <p class="section-prose">
        Generate single-use backup recovery codes. Store them somewhere safe —
        if you lose access to every other sign-in method, a backup code is the
        last resort.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="lookup_secret" />
        {nodesByGroup(ui.nodes, 'lookup_secret').map((n) => {
          // Bug fix: text nodes carry the actual backup codes in
          // attributes.text.text — FlowNodes/asInput() returns null for
          // node_type:"text", silently dropping them. Render them explicitly
          // so the generated codes are always shown to the user.
          if (n.attributes.node_type === 'text') {
            const a = n.attributes as NodeTextAttributes;
            return (
              <div class="lookup-codes">
                <p class="lookup-codes-label">
                  {n.meta?.label?.text ?? 'Backup codes — save these somewhere safe'}
                </p>
                <code class="lookup-codes-value mono" data-testid="backup-codes">
                  {a.text?.text ?? ''}
                </code>
              </div>
            );
          }
          const inp = asInput(n);
          if (!inp) return null;
          if (inp.type === 'hidden') {
            return <input type="hidden" name={inp.name} value={String(inp.value ?? '')} />;
          }
          if (inp.type === 'submit' || inp.type === 'button') {
            return (
              <div class="form-actions">
                <button
                  class="button button-secondary"
                  type={inp.type}
                  name={inp.name}
                  value={String(inp.value ?? '')}
                >
                  {n.meta?.label?.text ?? 'Generate backup codes'}
                </button>
              </div>
            );
          }
          // Any remaining labeled inputs (e.g. confirm checkbox nodes).
          const id = inp.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{n.meta?.label?.text ?? inp.name}</label>
              <input id={id} name={inp.name} type={inp.type} value={String(inp.value ?? '')} />
            </div>
          );
        })}
      </form>
    </section>
  )}

  {hasWebAuthn && (
    <section class="section">
      <p class="section-subtitle">Security key (legacy 2FA)</p>
      <p class="section-prose">
        Register a hardware security key (YubiKey or similar) as a second
        factor. This is separate from passkeys — use it if you want a
        dedicated physical token alongside your passkey.
      </p>
      <form method="POST" action={ui.action} class="settings-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="method" value="webauthn" />
        {nodesByGroup(ui.nodes, 'webauthn').map((n) => {
          // script nodes are collected by scriptNodes() and rendered at page bottom
          if (n.attributes.node_type === 'script') return null;
          const inp = asInput(n);
          if (!inp) return null;
          if (inp.type === 'hidden') {
            return <input type="hidden" name={inp.name} value={String(inp.value ?? '')} />;
          }
          // safeOnclick validates against the shared KNOWN_TRIGGERS allowlist
          // before emitting window.<fn>(). Never pass inp.onclick raw to the DOM.
          if (inp.type === 'button' || inp.type === 'submit') {
            return (
              <div class="form-actions">
                <button
                  class="button button-secondary"
                  type={inp.type}
                  name={inp.name}
                  value={String(inp.value ?? '')}
                  onclick={safeOnclick(inp)}
                >
                  {n.meta?.label?.text ?? 'Add security key'}
                </button>
              </div>
            );
          }
          // Remove buttons (webauthn_remove) are also submit nodes
          const id = inp.name.replace(/[^a-zA-Z0-9]+/g, '-');
          return (
            <div class="field">
              <label for={id}>{n.meta?.label?.text ?? inp.name}</label>
              <input
                id={id}
                name={inp.name}
                type={inp.type}
                value={inp.value !== undefined ? String(inp.value) : undefined}
                required={inp.required}
              />
            </div>
          );
        })}
      </form>
    </section>
  )}

  <section class="section">
    <p class="section-subtitle">Sessions</p>
    <p class="section-prose">
      Sign out of this device, or revoke every active session at once.
      "Sign out everywhere" cuts your Kratos sessions AND Hydra's
      remembered-login window, so no app can silently re-issue a token.
    </p>
    {signOutError && (
      <div class="notice notice-danger">{signOutError}</div>
    )}
    <form method="POST" action="/auth/settings" class="settings-form">
      <input type="hidden" name="action" value="sign-out-everywhere" />
      <input type="hidden" name="csrf_token" value={csrfSignOut} />
      <div class="form-actions">
        <button class="button button-danger" type="submit">Sign out everywhere</button>
      </div>
    </form>
    {!logoutInfo && (
      <p class="muted text-sm">Local logout endpoint unavailable; the revoke still runs.</p>
    )}
  </section>

  <section class="section">
    <p class="section-subtitle">Membership</p>
    <dl class="kv">
      <div>
        <dt>Username</dt>
        <dd class="mono">{traits.username}</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd class="mono">{traits.email}</dd>
      </div>
      <div>
        <dt>Identity</dt>
        <dd class="kv-chips">
          {identityGroups.length
            ? identityGroups.map((g) => <span class="badge">{g}</span>)
            : <span class="muted text-sm">none</span>}
        </dd>
      </div>
      <div>
        <dt>App access</dt>
        <dd class="kv-chips">
          {accessGroups.length
            ? accessGroups.map((g) => <span class="badge badge-muted">{g}</span>)
            : <span class="muted text-sm">none</span>}
        </dd>
      </div>
    </dl>
  </section>

  <p style="margin-top: var(--space-7);">
    <a href="/" class="back-link mono">Back home</a>
  </p>

  {scripts.map((s) => (
    <script
      src={s.src}
      id={s.id}
      async
      is:inline
      integrity={s.integrity}
      crossorigin={s.crossorigin}
      referrerpolicy={s.referrerpolicy}
      nonce={s.nonce}
    ></script>
  ))}

</Layout>

<style>
  /* Settings forms: column layout, hairline border between fields, labels
   * sit on their own line so checkboxes and selects align. */
  .settings-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
    margin-top: var(--space-3);
  }
  .form-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Passkey section header: subtitle + "recommended" badge on one line. */
  .passkey-subtitle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* TOTP enrollment: QR code centered with a border, secret below it. */
  .totp-qr {
    display: flex;
    justify-content: flex-start;
  }
  .totp-qr img {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: block;
    max-width: 200px;
    height: auto;
  }
  .totp-secret {
    margin-top: var(--space-2);
  }
  .totp-secret-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .totp-secret-value {
    display: block;
    padding: var(--space-2) var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    word-break: break-all;
    color: var(--text);
    user-select: all;
  }

  /* Backup codes display: monospace block, select-all for easy copy. */
  .lookup-codes {
    margin-top: var(--space-2);
  }
  .lookup-codes-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .lookup-codes-value {
    display: block;
    padding: var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text);
    user-select: all;
  }

  /* Key/value membership table without the heaviness of a real table.
   * Hairline rows, mono values, label in muted weight. */
  .kv {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .kv > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .kv dd {
    font-size: var(--text-sm);
    color: var(--text);
  }
  .kv-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .back-link {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .back-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .kv > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
