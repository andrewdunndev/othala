---
// Admin: add a person. One panel: name, email, the apps they can use (every app starts at No access) and a closed
// More options (username, recovery email). POST validates, creates the identity with a verified email
// and files the chosen levels as groups and role overrides, then issues the one-time setup link and code and shows them
// in one card. Nothing is emailed. The browser validates first; the server validates again.

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import AccessRows from '../../../components/AccessRows.astro';
import ManifestNotice from '../../../components/ManifestNotice.astro';
import SetupLink from '../../../components/SetupLink.astro';
import TitleRow from '../../../components/TitleRow.astro';
import { adminContext } from '../../../lib/admin-context';
import { createIdentity, getRecoveryLink } from '../../../lib/admin-api';
import { auditLine, ELEVATED_ROLE_NEEDS_SECOND_FACTOR, EMAIL_RE, ENROLLMENT_TTL, USERNAME_RE } from '../../../lib/admin-actions';
import { holdsElevatedRole } from '../../../lib/gate';
import type { Identity } from '../../../lib/types';
import { accessToStorage, choicesFromForm } from '../../../lib/access-rows';
import { suggestUsername } from '../../../lib/admin-view';
import { signToken, csrfRefusal } from '../../../lib/csrf';
import { DEFAULT_GROUP } from '../../../lib/constants';

const ctx = await adminContext(Astro);
if (ctx instanceof Response) return ctx;
const { adminId, apps, health, dev } = ctx;

interface FormState {
  displayName: string;
  email: string;
  username: string;
  recoveryEmail: string;
}

let form: FormState = { displayName: '', email: '', username: '', recoveryEmail: '' };
let levels: Record<string, string> = {};
const errors: Record<string, string> = {};
let success: { id: string; first: string; url: string; code: string } | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();

  // Verify the per-request CSRF token before any side effect. A dev fixture has no secret to sign with, so it skips the
  // check and writes nothing.
  if (!dev) {
    const bad = csrfRefusal(String(fd.get('csrf_token') ?? ''), adminId, 'create-user');
    if (bad !== null) return new Response(`CSRF: ${bad}`, { status: 403 });
  }

  levels = choicesFromForm(fd);
  const displayName = String(fd.get('displayName') ?? '').trim();
  const email = String(fd.get('email') ?? '').trim();
  form = {
    displayName,
    email,
    username: String(fd.get('username') ?? '').trim().toLowerCase() || suggestUsername(displayName, email),
    recoveryEmail: String(fd.get('recoveryEmail') ?? '').trim(),
  };

  if (!displayName) errors.displayName = 'Enter a name.';
  if (!EMAIL_RE.test(form.email)) errors.email = 'Enter an email address like name@example.com.';
  if (!USERNAME_RE.test(form.username)) errors.username = 'Use lowercase letters, digits and dots: first.last';
  if (form.recoveryEmail && !EMAIL_RE.test(form.recoveryEmail)) errors.recoveryEmail = 'Enter a valid recovery email address.';

  // A new person has no second factor yet, so no level above an app's entry level.
  const manifests = apps.map((a) => a.manifest);
  const access = accessToStorage(manifests, levels, { groups: [DEFAULT_GROUP], roles: {} });
  if (holdsElevatedRole({ metadata_admin: { groups: access.groups, roles: access.roles } } as Identity, manifests)) {
    errors.submit = `${ELEVATED_ROLE_NEEDS_SECOND_FACTOR} Add them at a lower level and raise it after they set one up.`;
  }

  if (Object.keys(errors).length === 0) {
    if (dev) {
      success = {
        id: 'dev-fay',
        first: form.displayName.split(/\s+/)[0],
        url: 'https://auth.example.test/self-service/recovery?flow=fixture&token=fixture',
        code: '123456',
      };
    } else {
      try {
        const created = await createIdentity({
          traits: {
            username: form.username,
            email: form.email,
            displayName: form.displayName,
            recoveryEmail: form.recoveryEmail || undefined,
          },
          metadataAdmin: {
            groups: access.groups,
            ...(Object.keys(access.roles).length ? { roles: access.roles } : {}),
          },
        });
        auditLine(adminId, 'create-user', created.id, 'ok');
        const link = await getRecoveryLink(created.id, ENROLLMENT_TTL);
        success = {
          id: created.id,
          first: form.displayName.split(/\s+/)[0],
          url: link.recovery_link,
          code: link.recovery_code,
        };
      } catch (err) {
        errors.submit = err instanceof Error ? err.message : String(err);
      }
    }
  }
}

let csrfToken = '';
try {
  csrfToken = signToken(adminId, 'create-user');
} catch (err) {
  if (!dev) throw err;
}
const devState = dev ? Astro.url.searchParams.get('dev-state') : null;
const peopleHref = devState ? `/admin/users?dev-state=${devState}` : '/admin/users';
---
<AdminLayout title={success ? `${success.first} is ready` : 'Add person'} description="Add someone to your household." identityId={adminId}>
  <a class="back-link" href={peopleHref}>← People</a>
  <ManifestNotice health={health} />

  {success ? (
    <>
      <TitleRow title={`${success.first} is ready`} lede="Send them this setup link." />
      <div class="panel card-ok" role="status">
        <SetupLink url={success.url} code={success.code} ttl={ENROLLMENT_TTL} name={success.first} />
        <p class="hint">To make {success.first} a household admin, wait until they have set up an authenticator app or security key, then do it from their page.</p>
        <div class="row-actions">
          <a class="button button-secondary" href={devState ? `/admin/users/new?dev-state=${devState}` : '/admin/users/new'}>Add another</a>
          <a class="button button-secondary" href={`/admin/users/${success.id}${devState ? `?dev-state=${devState}` : ''}`}>View {success.first}</a>
        </div>
      </div>
    </>
  ) : (
    <>
      <TitleRow title="Add person" lede="You get a link to send them, so they can choose how they sign in." />
      {errors.submit && <div class="notice notice-danger" role="alert">{errors.submit}</div>}
      <form class="panel" method="POST" enctype="application/x-www-form-urlencoded">
        <input type="hidden" name="csrf_token" value={csrfToken} />
        <div class="form-grid two">
          <div class={`field${errors.displayName ? ' bad' : ''}`}>
            <label for="displayName">Name</label>
            <input id="displayName" name="displayName" type="text" required autocomplete="off" value={form.displayName} aria-describedby={errors.displayName ? 'e-name' : undefined} />
            {errors.displayName && <span class="field-error" id="e-name">{errors.displayName}</span>}
          </div>
          <div class={`field${errors.email ? ' bad' : ''}`}>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="off" value={form.email} aria-describedby={errors.email ? 'e-email' : undefined} />
            {errors.email && <span class="field-error" id="e-email">{errors.email}</span>}
          </div>
        </div>

        <h2 class="subhead">Apps they can use</h2>
        <p class="hint">Everything starts at No access. You can change this any time.</p>
        <AccessRows apps={apps} current={levels} />

        <details class="plain" open={Boolean(errors.username || errors.recoveryEmail)}>
          <summary>More options</summary>
          <div class="form-grid">
            <div class={`field${errors.username ? ' bad' : ''}`}>
              <label for="username">Username</label>
              <input id="username" name="username" type="text" autocomplete="off" pattern="[a-z0-9]+(\.[a-z0-9]+)+" value={form.username} aria-describedby="h-user" />
              <span class="field-hint" id="h-user">Suggested from the name. Lowercase letters, digits and dots: first.last</span>
              {errors.username && <span class="field-error">{errors.username}</span>}
            </div>
            <div class={`field${errors.recoveryEmail ? ' bad' : ''}`}>
              <label for="recoveryEmail">Recovery email</label>
              <input id="recoveryEmail" name="recoveryEmail" type="email" autocomplete="off" value={form.recoveryEmail} aria-describedby="h-rec" />
              <span class="field-hint" id="h-rec">Optional. Where a setup link goes if the main email is lost.</span>
              {errors.recoveryEmail && <span class="field-error">{errors.recoveryEmail}</span>}
            </div>
          </div>
        </details>

        <div class="row-actions">
          <button class="button button-primary" type="submit">Add person</button>
          <a class="button button-secondary" href={peopleHref}>Cancel</a>
        </div>
      </form>
    </>
  )}
</AdminLayout>
