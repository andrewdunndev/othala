---
// Admin: list users.
//
// Pulls every identity from Kratos admin, filters client-side by group
// and search query (kept tiny: ~20 family identities total). Server-side
// rendering reads filter / search params from the URL so deep links and
// reloads stay stable.
//
// `last_authenticated_at` is not in the Identity schema; Kratos exposes
// it via the session list, which is more API-cost than this page wants
// at every render. The column is shown when the identity carries it
// (e.g. via a future enrichment) and falls back to "—" otherwise.

export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { requireAdminSession, listIdentities } from '../../../lib/admin';
import { servingIdentityGroups, servingAccessGroups } from '../../../lib/manifest-store';
import { getGroupRegistry, isIdentityGroup } from '../../../lib/group-registry';
import type { Identity } from '../../../lib/types';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

// access-model Phase 2: split user group chips by the registry's binding-derived
// type, not an `access-` name prefix (docs/access-model.md §10).
const registry = getGroupRegistry();

const url = Astro.url;
const search = (url.searchParams.get('q') ?? '').toLowerCase().trim();
const groupFilters = url.searchParams.getAll('group').filter(Boolean);

let identities: Identity[] = [];
let loadError: string | null = null;
try {
  identities = await listIdentities();
} catch (err) {
  console.error('[othala/admin/users] listIdentities failed:', err);
  loadError = 'Failed to read identity store — check Kratos connectivity.';
}

function matches(i: Identity): boolean {
  const groups = i.metadata_admin?.groups ?? [];
  if (groupFilters.length && !groupFilters.every((g) => groups.includes(g))) return false;
  if (!search) return true;
  const hay = [i.traits?.username, i.traits?.email, i.traits?.displayName]
    .filter(Boolean)
    .map((s) => String(s).toLowerCase())
    .join(' ');
  return hay.includes(search);
}

const filtered = identities.filter(matches);
filtered.sort((a, b) =>
  String(a.traits?.username ?? '').localeCompare(String(b.traits?.username ?? '')),
);

// Serving store, not the strict loader: the group filter is a convenience, and
// a manifest that fails to validate must not take the user directory down with
// it. A stale filter list is worth far more than a 500 here.
const allGroups = [...servingIdentityGroups(), ...servingAccessGroups()];

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
  { href: '/auth/settings',  label: 'Settings' },
];
---
<Layout title="Users — Admin" description="Identity directory.">

  <header class="page-header">
    <p class="page-eyebrow">administration · identities</p>
    <h1 class="page-title">Users</h1>
    <p class="page-lede">
      Every identity in the Kratos store. Use search to find someone,
      or stack group filters to narrow by membership.
    </p>
  </header>

  <nav class="nav-bar" aria-label="Admin">
    {adminNav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  {loadError && (
    <div class="notice notice-danger">Failed to read identity store: {loadError}</div>
  )}

  <section class="users-controls">
    <form method="get" class="users-form">
      <div class="field">
        <label for="q">Search</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="username, email, or display name"
          value={search}
          autocomplete="off"
        />
      </div>

      <div class="field">
        <label>Filter by group</label>
        <p class="field-hint">Multi-select; identity must include all of them.</p>
        <div class="group-grid">
          {allGroups.map((g) => (
            <label class="group-check">
              <input type="checkbox" name="group" value={g} checked={groupFilters.includes(g)} />
              <span class="mono">{g}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="users-actions">
        <button type="submit" class="button button-secondary">Apply</button>
        <a href="/admin/users" class="users-clear mono">Clear</a>
        <span style="flex: 1;"></span>
        <a href="/admin/users/new" class="button button-primary">New user</a>
      </div>
    </form>
  </section>

  <section class="section">
    <p class="section-subtitle">
      {filtered.length} of {identities.length} {identities.length === 1 ? 'identity' : 'identities'}
    </p>

    <table class="users-table">
      <thead>
        <tr>
          <th scope="col">Username</th>
          <th scope="col">Display name</th>
          <th scope="col">Email</th>
          <th scope="col">Groups</th>
          <th scope="col" class="users-th-actions"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        {filtered.map((i) => {
          const groups = i.metadata_admin?.groups ?? [];
          const identityGs = groups.filter((g) => isIdentityGroup(registry, g));
          const accessGs = groups.filter((g) => !isIdentityGroup(registry, g));
          return (
            <tr>
              <td class="users-username">
                <a href={`/admin/users/${i.id}`} class="users-username-link mono">
                  {i.traits?.username ?? '—'}
                </a>
              </td>
              <td>{i.traits?.displayName ?? <span class="muted">—</span>}</td>
              <td class="users-email mono">{i.traits?.email ?? '—'}</td>
              <td>
                <span class="users-chips">
                  {identityGs.map((g) => <span class="badge">{g}</span>)}
                  {accessGs.length > 0 && (
                    <span class="badge badge-muted" title={accessGs.join(', ')}>
                      +{accessGs.length} app
                    </span>
                  )}
                </span>
              </td>
              <td class="users-actions-cell">
                <a href={`/admin/users/${i.id}`} class="users-action mono">view</a>
                <a href={`/admin/users/${i.id}?mode=edit`} class="users-action mono">edit</a>
              </td>
            </tr>
          );
        })}
        {filtered.length === 0 && !loadError && (
          <tr class="users-empty-row"><td colspan="5">No matching identities.</td></tr>
        )}
      </tbody>
    </table>
  </section>

</Layout>

<style>
  /* ── Controls ──
   * Filter form sits above the table inside its own card so the page
   * doesn't read as one continuous slab of input. */
  .users-controls {
    margin-top: var(--space-7);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .users-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .users-form .field-hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: -2px;
  }
  .group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
  }
  .group-check {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .users-actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .users-clear {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .users-clear:hover { color: var(--accent); text-decoration: none; }

  /* ── Table ──
   * Hairline rows. Mono UIDs / emails. Hover slides the cursor row to
   * surface; primary action is the username (which is also the row's
   * implicit anchor). */
  .users-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .users-table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-align: left;
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .users-table tbody td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .users-table tbody tr {
    transition: background var(--duration-fast) var(--ease-out);
  }
  .users-table tbody tr:hover { background: var(--accent-subtle); }

  .users-username-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .users-username-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent-link);
  }
  .users-email { color: var(--text-2); font-size: var(--text-xs); }

  .users-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .users-th-actions { width: 1%; }
  .users-actions-cell { white-space: nowrap; text-align: right; }
  .users-action {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-left: var(--space-3);
  }
  .users-action:hover { color: var(--accent); text-decoration: none; }
  .users-action:first-of-type { margin-left: 0; }

  .users-table tbody tr.users-empty-row td {
    padding: var(--space-5) var(--space-3);
    color: var(--text-muted);
    text-align: center;
    font-size: var(--text-sm);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .users-email { display: none; }
    .users-table thead th:nth-child(3) { display: none; }
    .users-table tbody td:nth-child(3) { display: none; }
  }
</style>
