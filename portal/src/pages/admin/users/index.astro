---
// Admin: people. One clickable row per person with their apps and badges. Past eight people a search box and one Show
// select appear and filter the server-rendered rows live; without script they are a GET form. Attention notices sit
// above the list, only when true.

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ManifestNotice from '../../../components/ManifestNotice.astro';
import TitleRow from '../../../components/TitleRow.astro';
import { adminContext } from '../../../lib/admin-context';
import { listIdentities } from '../../../lib/admin-api';
import {
  attentionItems,
  CHIP_LIMIT,
  FILTER_THRESHOLD,
  PEOPLE_LOAD_ERROR,
  personRows,
  rowMatches,
  showOptions,
} from '../../../lib/admin-view';
import type { Identity } from '../../../lib/types';

const ctx = await adminContext(Astro);
if (ctx instanceof Response) return ctx;
const { apps, health, dev } = ctx;

let identities: Identity[] = [];
let loadError: string | null = null;
if (dev) {
  identities = dev.identities;
} else {
  try {
    identities = await listIdentities();
  } catch (err) {
    console.error('[othala/admin/users] listIdentities failed:', err);
    loadError = PEOPLE_LOAD_ERROR;
  }
}

const rows = personRows(identities, apps);
const attention = attentionItems(rows);
const filtering = rows.length > FILTER_THRESHOLD;
const q = filtering ? (Astro.url.searchParams.get('q') ?? '').trim() : '';
const show = filtering ? (Astro.url.searchParams.get('show') ?? 'all') : 'all';
const options = showOptions(apps.filter((a) => !a.manifest.skipAccessCheck && !a.manifest.accessGroups.includes('everyone')));
const visible = rows.map((r) => ({ row: r, hidden: !rowMatches(r, q, show) }));
const devState = dev ? Astro.url.searchParams.get('dev-state') : null;
const deleted = Astro.url.searchParams.get('deleted') === '1';
---
<AdminLayout title="People" description="Everyone in your household who can sign in." identityId={ctx.adminId}>
  <TitleRow title="People" count={rows.length} lede="Everyone in your household who can sign in.">
    <a slot="action" class="button button-primary" href="/admin/users/new">Add person</a>
  </TitleRow>

  {deleted && <div class="notice notice-success" role="status">Person deleted.</div>}
  {loadError && <div class="notice notice-danger" role="alert">{loadError}</div>}
  <ManifestNotice health={health} />

  {attention.length > 0 && (
    <div class="notice notice-warning attn" role="status">
      <ul>
        {attention.map((item) => (
          <li>
            {item.text}:{' '}
            {item.people.map((p, n) => (
              <>{n > 0 && ', '}<a href={`/admin/users/${p.id}`}>{p.name}</a></>
            ))}
          </li>
        ))}
      </ul>
    </div>
  )}

  {filtering && (
    <form class="filters" method="get" role="search" data-filters>
      {devState && <input type="hidden" name="dev-state" value={devState} />}
      <div class="field">
        <label for="q">Search people</label>
        <input id="q" name="q" type="search" placeholder="Name, username or email" autocomplete="off" value={q} />
      </div>
      <div class="field">
        <label for="show">Show</label>
        <select id="show" name="show">
          {options.map((o) => <option value={o.value} selected={o.value === show}>{o.label}</option>)}
        </select>
      </div>
      <button class="button button-secondary button-sm" type="submit" data-nojs>Search</button>
    </form>
  )}

  {rows.length > 0 && (
    <ul class="people" data-list>
      {visible.map(({ row, hidden }) => (
        <li
          data-row
          hidden={hidden}
          data-admin={row.admin ? '1' : '0'}
          data-off={row.off ? '1' : '0'}
          data-noapps={row.chips.length === 0 ? '1' : '0'}
          data-apps={row.appIds.join(' ')}
          data-text={row.haystack}
        >
          <div class="person-row">
            <div>
              <div class="person-name"><a href={`/admin/users/${row.id}${devState ? `?dev-state=${devState}` : ''}`}>{row.name}</a></div>
              <div class="person-meta">{row.sub}</div>
            </div>
            {row.chips.length === 0 ? (
              <div><span class="empty-note">No apps yet</span></div>
            ) : (
              <ul class="chips">
                {row.chips.map((c, n) => (
                  <li class="chip" hidden={n >= CHIP_LIMIT} data-extra={n >= CHIP_LIMIT ? '' : undefined}>
                    {c.name}{c.top && <> <b>· Admin</b></>}
                  </li>
                ))}
                {row.chips.length > CHIP_LIMIT && (
                  <li><button type="button" class="chip" data-more aria-label={`Show ${row.chips.length - CHIP_LIMIT} more apps`}>+{row.chips.length - CHIP_LIMIT}</button></li>
                )}
              </ul>
            )}
            <div class="badges">
              {row.admin && <span class="badge">Admin</span>}
              {row.off && <span class="badge badge-muted">Sign-in off</span>}
              <span class={`badge ${row.verified ? 'badge-muted' : 'badge-warning'}`}>{row.verified ? 'Verified' : 'Unverified'} email</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}
  {filtering && <p class="empty-note" data-none hidden={visible.some((v) => !v.hidden)}>No one matches.</p>}

  {rows.length <= 1 && !loadError && (
    <div class="panel empty-state">
      <p>Only you so far.</p>
      <a class="button button-primary" href="/admin/users/new">Add person</a>
    </div>
  )}
</AdminLayout>
