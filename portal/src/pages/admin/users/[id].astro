  }
  .cred-note {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    border-left: 1px solid var(--border);
  }
  .cred-enrolled { background: var(--success-subtle); border-color: var(--success); }
  .cred-eviction-note { margin-top: var(--space-2); }
  .admin-marker-row { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-2); }
  .admin-on { color: var(--success, #1a7f37); }
