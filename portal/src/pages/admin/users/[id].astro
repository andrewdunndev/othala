---
// Admin: user detail / edit / actions.
//
// Two modes (`?mode=edit` vs read):
//   - Read: profile, group memberships, Effective Access table, action panel
//   - Edit: same form layout as /admin/users/new, pre-populated, posts to
//           this same URL with `?mode=edit`
//
// This page is also the REPAIR surface for the state refuseNonCanonical
// (src/lib/gate.ts) denies at every app: a stored group name that misses the
// canonical policy gets its own row in both modes, and the save path decides
// it via planGroupSave rather than by composing submitted checkboxes.
//
// The 10 action=<name> POST handlers live in src/lib/admin-actions.ts —
// this page only verifies the per-request CSRF token (action-scoped, so a
// captured token cannot be replayed to a different action) then dispatches.
//
// Effective Access mirrors the consent-service algorithm: per app, look
// up override-or-derive role, render the row + source. Apps the user has
// no access to don't appear (this is the "what can they actually use"
// view, not the catalog).

export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminFormScripts from '../../../components/AdminFormScripts.astro';
import { requireAdminSession, getIdentity } from '../../../lib/admin';
import { ADMIN_ACTIONS, ENROLLMENT_TTL, type ActionResult } from '../../../lib/admin-actions';
import { EVICTABLE_CREDENTIAL_TYPES } from '../../../lib/admin-api';
import { servingManifests } from '../../../lib/manifest-store';
import { computeEffectiveAccess, describeSource, IDENTITY_GROUP_ORDER } from '../../../lib/access';
import { getGroupRegistry, isIdentityGroup } from '../../../lib/group-registry';
import { nonCanonicalGroups } from '../../../lib/gate';
import { signToken, verifyToken, CSRFError } from '../../../lib/csrf';
import type { Identity } from '../../../lib/types';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;
const adminIdentityId = guard.identity?.id ?? '';

const { id } = Astro.params;
if (!id) return new Response('Missing identity id', { status: 400 });

// Serving store, not the strict loader: this page is where an operator grants
// and revokes access, so it has to stay reachable when a manifest is broken.
const manifests = servingManifests();
const registry = getGroupRegistry();
// Identity-group form labels share the canonical order with access.ts.
const IDENTITY_GROUPS = [...IDENTITY_GROUP_ORDER];
// The "App access" checkboxes are the access-BEARING groups derived from the
// registry (a group's type is its binding, not its
// name), each annotated with the app(s) it grants entry to. One checkbox per
// bound access group — multi-group `access:` lists surface every option, and a
// group bound by several apps lists all of them.
const clientNameById = new Map(manifests.map((m) => [m.clientId, m.clientName] as const));
const ACCESS_GROUPS = Array.from(registry.values())
  .filter((e) => e.kinds.has('access'))
  .map((e) => ({
    group: e.name,
    apps: e.accessFor.map((id) => ({ clientId: id, clientName: clientNameById.get(id) ?? id })),
  }))
  .sort((a, b) => a.group.localeCompare(b.group));
let identity: Identity | null = null;
let loadError: string | null = null;

async function reload(): Promise<Identity | null> {
  try {
    return await getIdentity(id!);
  } catch (err) {
    console.error('[othala/admin/users/[id]] getIdentity failed:', err);
    loadError = 'Failed to read identity store — check Kratos connectivity.';
    return null;
  }
}

identity = await reload();

let mode: 'read' | 'edit' = Astro.url.searchParams.get('mode') === 'edit' ? 'edit' : 'read';
let actionResult: ActionResult | null = null;
let formErrors: Record<string, string> = {};

if (Astro.request.method === 'POST' && identity) {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') ?? 'save');

  // HIGH-1: every state-changing admin POST must carry a per-request CSRF
  // token bound to the active admin's identity. Action-scoped tokens (minted
  // with signToken(id, action)) additionally verify that the submitted action
  // matches the one the token was issued for — a captured token from the
  // "issue-recovery" form cannot fire "deactivate".
  //
  // The save / delete actions use identity-only tokens (no action binding)
  // because those forms post to a distinct action value not shared with the
  // multi-button actions panel.
  //
  // The three actions panel buttons (issue-recovery / force-relogin /
  // deactivate / reactivate) share a single form POST, so each gets its own
  // action-scoped token minted at render time.
  const actionScopedActions = new Set(['issue-recovery', 'send-invite-email', 'force-relogin', 'deactivate', 'reactivate', 'grant-admin', 'revoke-admin']);
  try {
    if (actionScopedActions.has(action)) {
      verifyToken(String(fd.get('csrf_token') ?? ''), adminIdentityId, action);
    } else {
      verifyToken(String(fd.get('csrf_token') ?? ''), adminIdentityId);
    }
  } catch (err) {
    if (err instanceof CSRFError) {
      return new Response(`CSRF: ${err.message}`, { status: 403 });
    }
    throw err;
  }

  const handler = ADMIN_ACTIONS[action];
  if (handler) {
    try {
      const outcome = await handler(fd, { id, identity, adminIdentityId, manifests });
      if (outcome instanceof Response) return outcome;
      if (outcome.actionResult) actionResult = outcome.actionResult;
      if (outcome.formErrors) formErrors = outcome.formErrors;
      if (outcome.mode) mode = outcome.mode;
      if (outcome.refetch) identity = await reload();
    } catch (err) {
      actionResult = { kind: 'error', message: err instanceof Error ? err.message : String(err) };
    }
  }
}

const groups = identity?.metadata_admin?.groups ?? [];
// Split membership into identity vs access columns by the registry's
// binding-derived type, NOT by an `access-` name prefix — a group named
// `memories` would otherwise be mis-filed and its access invisible. A group the
// registry types as `identity` lands
// in the identity column; everything else (access/role/unknown) is "access".
// Stored names that miss the canonical policy get their OWN row in both modes.
// Filing them under "access" would be a lie twice over: they grant nothing,
// and they are the reason every app denies this identity (refuseNonCanonical,
// src/lib/gate.ts). Read from the identity, so the row and the save path agree
// on what is actually stored.
const nonCanonical = nonCanonicalGroups(identity);
const nonCanonicalSet = new Set(nonCanonical);
const identityGroupMembership = groups.filter((g) => !nonCanonicalSet.has(g) && isIdentityGroup(registry, g));
const accessGroupMembership = groups.filter((g) => !nonCanonicalSet.has(g) && !isIdentityGroup(registry, g));
const roleOverrides = (identity?.metadata_admin?.roles ?? {}) as Record<string, string>;
const effective = identity ? computeEffectiveAccess(identity, manifests) : [];

// P2: derive credential enrollment display from the identity's credentials
// object. The Kratos admin API returns credentials when `includeCredential`
// is passed (done in getIdentity). Keys present = method enrolled.
// Robust to the field being absent (list-identities doesn't include them).
const CREDENTIAL_METHODS: Array<{ key: string; label: string }> = [
  { key: 'passkey',       label: 'passkey' },
  { key: 'password',      label: 'password' },
  { key: 'totp',          label: 'totp' },
  { key: 'webauthn',      label: 'webauthn' },
  { key: 'lookup_secret', label: 'backup codes' },
];
const credentialMap = identity?.credentials ?? {};

const formValues = {
  username: identity?.traits?.username ?? '',
  email: identity?.traits?.email ?? '',
  displayName: identity?.traits?.displayName ?? '',
  recoveryEmail: identity?.traits?.recoveryEmail ?? '',
  identityGroups: identityGroupMembership,
  accessGroups: accessGroupMembership,
  roleOverrides,
};

// HIGH-1: mint a fresh CSRF token per render. Each <form> on this page
// gets its own token: tokens are single-use, so two forms cannot share
// one. The TTL is 30 min (matches typical admin session of a few
// minutes); a stale page can re-render to refresh.
//
// The three actions panel buttons (issue-recovery, force-relogin,
// deactivate/reactivate) each get an action-scoped token so a captured
// token for one action cannot be replayed to trigger a different one.
const csrfTokenSave = signToken(adminIdentityId);
const csrfTokenDelete = signToken(adminIdentityId);
const csrfTokenIssueRecovery = signToken(adminIdentityId, 'issue-recovery');
const csrfTokenInviteEmail = signToken(adminIdentityId, 'send-invite-email');
const csrfTokenForceRelogin = signToken(adminIdentityId, 'force-relogin');
// Deactivate/reactivate are mutually exclusive at render time; only one
// button will be shown, so only one token is needed.
const csrfTokenDeactivate = identity?.state === 'inactive'
  ? signToken(adminIdentityId, 'reactivate')
  : signToken(adminIdentityId, 'deactivate');
// Admin grant/revoke: mutually exclusive by current marker state.
const isTargetAdmin = identity?.metadata_admin?.admin === true;
const csrfTokenAdminToggle = isTargetAdmin
  ? signToken(adminIdentityId, 'revoke-admin')
  : signToken(adminIdentityId, 'grant-admin');
// One token per credential-remove form: each form is single-use (CSRF token
// is single-use 30-min TTL); credential types are enumerated at render time.
const csrfTokensRemove: Record<string, string> = {};
for (const { key } of CREDENTIAL_METHODS) {
  if (EVICTABLE_CREDENTIAL_TYPES.has(key) && credentialMap[key]) {
    csrfTokensRemove[key] = signToken(adminIdentityId);
  }
}

// The exact bytes the admin pastes into Signal/iMessage. Composed server-side
// so the visible textarea and the copy button carry identical text, and so the
// link and the code can never be sent apart by accident.
const enrollmentShareText =
  actionResult?.kind === 'recovery'
    ? [
        `Set up your account: ${actionResult.url}`,
        ``,
        `Recovery code: ${actionResult.code}`,
        ``,
        `The code works once and expires ${actionResult.expiresAt}.`,
      ].join('\n')
    : '';

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
  { href: '/auth/settings',  label: 'Settings' },
];
---
<Layout title={`${formValues.username || id} — Admin`} description="Identity detail.">
  <header class="page-header">
    <p class="page-eyebrow">administration · identity</p>
    <h1 class="page-title">{formValues.username || id}</h1>
    {formValues.displayName && (
      <p class="page-lede">{formValues.displayName} · <span class="mono">{formValues.email}</span></p>
    )}
  </header>

  <nav class="nav-bar" aria-label="Admin">
    {adminNav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  <section class="stack-lg">
    {loadError && (
      <div class="notice notice-danger">Failed to load identity: {loadError}</div>
    )}

    {actionResult?.kind === 'updated' && (
      <div class="notice notice-success">
        Identity updated.
        {actionResult.removed.length > 0 && (
          <span>
            {' '}Removed unrecognised group(s):{' '}
            <span class="mono">{actionResult.removed.join(', ')}</span>. If this
            person still needs access, confirm the correct group is ticked.
          </span>
        )}
      </div>
    )}
    {actionResult?.kind === 'deactivated' && (
      <div class="notice notice-warning">
        {actionResult.username} marked inactive. Existing sessions revoked.
      </div>
    )}
    {actionResult?.kind === 'reactivated' && (
      <div class="notice notice-success">
        {actionResult.username} restored to active. They will need to log in again.
      </div>
    )}
    {actionResult?.kind === 'recovery' && (
      <div class="notice notice-success stack">
        <p><strong>Enrollment link and code issued.</strong></p>
        <p class="text-sm">
          No email was sent. Send them <strong>both</strong> values yourself,
          out of band (Signal, iMessage). The link opens the enrollment form
          with an empty code field, so the link on its own is a dead end.
        </p>
        <p class="text-sm">
          The code works <strong>once</strong> and the pair is valid for
          {ENROLLMENT_TTL} from issue — it expires
          <span class="mono">{actionResult.expiresAt}</span>. After that, issue
          a fresh pair from this page.
        </p>

        <div class="field">
          <label for="enrollmentShareText">Message to send (link + code)</label>
          <textarea id="enrollmentShareText" rows="5" readonly>{enrollmentShareText}</textarea>
          <div class="copy-actions">
            <button type="button" class="button button-primary button-sm" data-copy="enrollmentShareText">
              Copy link + code
            </button>
          </div>
          <span class="field-hint">
            Together these two values are the credential. Delete the message once they are in.
          </span>
        </div>

        <div class="field">
          <label for="enrollmentUrl">Enrollment link</label>
          <div class="copy-row">
            <input id="enrollmentUrl" type="text" readonly value={actionResult.url} />
            <button type="button" class="button button-secondary button-sm" data-copy="enrollmentUrl">
              Copy
            </button>
          </div>
        </div>

        <div class="field">
          <label for="enrollmentCode">Recovery code</label>
          <div class="copy-row">
            <input id="enrollmentCode" type="text" class="mono" readonly value={actionResult.code} />
            <button type="button" class="button button-secondary button-sm" data-copy="enrollmentCode">
              Copy
            </button>
          </div>
          <span class="field-hint">Sending the link without this is the most common way enrollment dead-ends.</span>
        </div>
      </div>
    )}
    {actionResult?.kind === 'invite-email' && (
      <div class="notice notice-success stack">
        <p>
          <strong>Invite email sent</strong> to <span class="mono">{actionResult.email}</span> via
          the Kratos courier.
        </p>
        <p class="text-sm">
          It carries a recovery <strong>code only</strong> — Kratos's code-recovery template never
          embeds a link with the code, so this message alone can never complete enrollment. Tell
          them where to go separately (the portal's recovery page is a fixed public URL, not a
          secret) — Signal, iMessage, or however you'd already planned to reach them.
        </p>
        <p class="text-sm muted">
          This confirms Kratos accepted the request, not that the mail left the relay — identical
          to what an ordinary "Forgot access?" recovery already promises.
        </p>
      </div>
    )}
    {actionResult?.kind === 'revoked' && (
      <div class="notice notice-success">
        <p>
          <strong>Force re-login complete.</strong>
          Kratos sessions revoked; Hydra login + consent sessions revoked
          (the remembered login is cut){actionResult.result.bestEffortFailures.length ? `; ${actionResult.result.bestEffortFailures.length} best-effort step(s) failed` : ''}.
        </p>
        {actionResult.result.bestEffortFailures.length > 0 && (
          <details>
            <summary class="text-sm">Best-effort failures (the hard cut already landed; these are advisory)</summary>
            <ul class="stack">
              {actionResult.result.bestEffortFailures.map((f) => (
                <li class="mono text-xs">{f.dependency} / {f.step}: {f.error}</li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}
    {actionResult?.kind === 'admin-granted' && (
      <div class="notice notice-success">
        Admin marker granted to <strong>{actionResult.username}</strong>. They will have admin authority on next page load.
      </div>
    )}
    {actionResult?.kind === 'admin-revoked' && (
      <div class="notice notice-warning">
        Admin marker revoked from <strong>{actionResult.username}</strong>.
      </div>
    )}
    {actionResult?.kind === 'credential-removed' && (
      <div class="notice notice-warning">
        <strong>Credential type removed:</strong> all <span class="mono">{actionResult.credType}</span> credentials
        have been deleted for this identity. Issue an enrollment link and code below, and send the
        legitimate user both, so they can re-enroll.
      </div>
    )}
    {actionResult?.kind === 'error' && (
      <div class="notice notice-danger">{actionResult.message}</div>
    )}

    {!identity ? null : mode === 'edit' ? (
      <form method="post" class="stack-lg" novalidate>
        <input type="hidden" name="action" value="save" />
        <input type="hidden" name="csrf_token" value={csrfTokenSave} />

        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            value={formValues.username}
            pattern="[a-z0-9]+(\.[a-z0-9]+)+"
          />
          {formErrors.username && <span class="field-error">{formErrors.username}</span>}
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required value={formValues.email} />
          {formErrors.email && <span class="field-error">{formErrors.email}</span>}
        </div>

        <div class="field">
          <label for="displayName">Display name</label>
          <input id="displayName" name="displayName" type="text" value={formValues.displayName} />
        </div>

        <div class="field">
          <label for="recoveryEmail">Recovery email (optional)</label>
          <input
            id="recoveryEmail"
            name="recoveryEmail"
            type="email"
            value={formValues.recoveryEmail}
            placeholder="alternate@example.com"
          />
          <span class="field-hint">Used for account recovery when the primary email is inaccessible. Leave blank to use the primary email.</span>
          {formErrors.recoveryEmail && <span class="field-error">{formErrors.recoveryEmail}</span>}
        </div>

        <div class="field">
          <label>Identity groups</label>
          <div class="checkbox-grid">
            {IDENTITY_GROUPS.map((g) => (
              <label>
                <input
                  type="checkbox"
                  name="identityGroups"
                  value={g}
                  checked={formValues.identityGroups.includes(g)}
                />
                <span class="mono">{g}</span>
              </label>
            ))}
          </div>
          {formErrors.identityGroups && <span class="field-error">{formErrors.identityGroups}</span>}
        </div>

        <div class="field">
          <label>App access</label>
          <div class="checkbox-grid">
            {ACCESS_GROUPS.map((a) => (
              <label>
                <input
                  type="checkbox"
                  name="accessGroups"
                  value={a.group}
                  checked={formValues.accessGroups.includes(a.group)}
                />
                <span class="mono">{a.group}</span>
                <span class="muted text-xs">
                  {a.apps.length
                    ? `→ ${a.apps.map((app) => app.clientId).join(', ')}`
                    : ''}
                </span>
              </label>
            ))}
          </div>
        </div>

        {/* The repair surface. These names cannot appear in either checkbox
            set above — both are built from vocabularies this codebase owns —
            so without this row they are invisible here and vanish on save.
            Removal is an affirmative tick; leaving one alone keeps it. */}
        {nonCanonical.length > 0 && (
          <div class="field">
            <label>Unrecognised groups</label>
            <p class="notice notice-danger text-sm">
              Stored on this identity but not a canonical group name
              (<code>GROUP_RE</code>, <code>src/lib/access-groups.ts</code>). No write
              path here can produce one, so these were set straight through the Kratos
              admin API. While any is present, <strong>every app denies this person</strong>
              — <code>refuseNonCanonical</code>, <code>src/lib/gate.ts</code>.
            </p>
            <div class="checkbox-grid">
              {nonCanonical.map((g) => (
                <label>
                  <input type="checkbox" name="clearNonCanonical" value={g} />
                  <span class="mono">{g}</span>
                  <span class="muted text-xs">remove</span>
                </label>
              ))}
            </div>
            <span class="field-hint">
              Left unticked, the name is kept and the save is <strong>refused</strong>
              rather than dropping it — the write path validator
              (<code>validateGroups</code>, <code>src/lib/metadata-admin.ts</code>)
              rejects the name too, so it cannot be stored again from here. To restore
              this person's access, tick Remove and pick the correct group above.
            </span>
            {formErrors.nonCanonicalGroups && (
              <span class="field-error">{formErrors.nonCanonicalGroups}</span>
            )}
          </div>
        )}

        <details class="panel">
          <summary class="mono text-sm">Per-app role overrides</summary>
          <div class="stack details-content">
            {manifests.map((m) => (
              <div class="role-row">
                <div>
                  <div class="mono">{m.clientId}</div>
                  <div class="muted text-xs">{m.clientName}</div>
                </div>
                {m.roles.length === 0 ? (
                  <span class="muted text-xs mono">no roles declared</span>
                ) : (
                  <select name={`role:${m.clientId}`}>
                    <option value="">(default)</option>
                    {m.roles.map((r) => (
                      <option
                        value={r.name}
                        selected={formValues.roleOverrides[m.clientId] === r.name}
                      >
                        {r.name}{r.description ? `: ${r.description}` : ''}
                      </option>
                    ))}
                  </select>
                )}
              </div>
            ))}
          </div>
        </details>

        {id === adminIdentityId && (
          <div class="notice notice-warning">
            You're editing your own identity. The <code>admin</code> group is display-only — admin access is the <code>metadata_admin.admin</code> marker, and you can't revoke your own marker here (have another admin do it, or use the shell break-glass).
          </div>
        )}

        <div class="cta-row">
          <button type="submit" class="button button-primary">Save</button>
          <a href={`/admin/users/${id}`} class="button button-secondary">Cancel</a>
        </div>
      </form>
    ) : (
      <section class="stack-lg">
        <section class="panel stack">
          <h2>Profile</h2>
          <dl class="stack dl-grid">
            <dt class="muted text-sm mono">id</dt>
            <dd class="mono text-xs">{identity.id}</dd>
            <dt class="muted text-sm mono">state</dt>
            <dd class="mono text-sm">{identity.state ?? 'active'}</dd>
            <dt class="muted text-sm mono">email</dt>
            <dd class="mono text-sm">{formValues.email}</dd>
            <dt class="muted text-sm mono">recoveryEmail</dt>
            <dd class="mono text-sm">{formValues.recoveryEmail || <span class="muted">(unset)</span>}</dd>
            <dt class="muted text-sm mono">displayName</dt>
            <dd>{formValues.displayName || <span class="muted">(unset)</span>}</dd>
            <dt class="muted text-sm mono">credentials</dt>
            <dd>
              <div class="cred-list">
                {CREDENTIAL_METHODS.map((m) => (
                  credentialMap[m.key] ? (
                    <span class="cred-item">
                      <span class="badge cred-enrolled">{m.label} ✓</span>
                      {EVICTABLE_CREDENTIAL_TYPES.has(m.key) && csrfTokensRemove[m.key] && (
                        <form method="post" class="cred-remove-form">
                          <input type="hidden" name="action" value="remove-credential" />
                          <input type="hidden" name="cred_type" value={m.key} />
                          <input type="hidden" name="csrf_token" value={csrfTokensRemove[m.key]} />
                          <button
                            type="submit"
                            class="button button-danger button-sm"
                            title={`Remove all ${m.label} credentials (lost-device eviction). The user must re-enroll after removal.`}
                          >
                            Remove
                          </button>
                        </form>
                      )}
                      {m.key === 'passkey' && (
                        <span
                          class="cred-note muted text-xs"
                          title="Kratos cannot admin-delete a passkey (upstream limitation). Revoke sessions, then the user self-removes it at /auth/settings — or delete the identity as a last resort."
                        >
                          self-remove only
                        </span>
                      )}
                    </span>
                  ) : (
                    <span class="badge badge-muted">{m.label} —</span>
                  )
                ))}
              </div>
              <p class="cred-eviction-note muted text-xs">
                Remove evicts the credential type (webauthn/totp/backup codes) for lost-device response.
                The user must re-enroll with an enrollment link and code (both, issued from Actions below).
                Password cannot be removed here. Passkeys cannot be admin-deleted (Kratos upstream
                limitation) — the user self-removes the lost device's key at /auth/settings; identity
                deletion is the last resort.
              </p>
            </dd>
          </dl>
          <div class="edit-action">
            <a href={`/admin/users/${id}?mode=edit`} class="button button-secondary">Edit</a>
          </div>
        </section>

        <section class="panel stack">
          <h2>Groups</h2>
          <div>
            <p class="muted text-xs mono">identity</p>
            <div class="badge-row">
              {identityGroupMembership.length
                ? identityGroupMembership.map((g) => <span class="badge">{g}</span>)
                : <span class="muted text-sm">none</span>}
            </div>
          </div>
          <div>
            <p class="muted text-xs mono">access</p>
            <div class="badge-row">
              {accessGroupMembership.length
                ? accessGroupMembership.map((g) => <span class="badge badge-muted">{g}</span>)
                : <span class="muted text-sm">none</span>}
            </div>
          </div>
          {nonCanonical.length > 0 && (
            <div>
              <p class="muted text-xs mono">unrecognised</p>
              <div class="badge-row">
                {nonCanonical.map((g) => <span class="badge badge-danger">{g}</span>)}
              </div>
              <p class="text-xs">
                Not canonical group names, so <strong>every app denies this identity</strong>
                (<code>refuseNonCanonical</code>, <code>src/lib/gate.ts</code>). Repair them
                under <a href={`/admin/users/${id}?mode=edit`}>Edit</a>.
              </p>
            </div>
          )}
        </section>

        <section class="panel stack">
          <h2>Effective access</h2>
          <p class="muted text-xs">
            Per app, the role this user receives at consent time. Mirrors
            the consent service algorithm.
          </p>
          {effective.length === 0 ? (
            <p class="muted text-sm">No app access. Assign a group named in some app's <code>access:</code> binding to grant entry.</p>
          ) : (
            <table class="data-table">
              <thead>
                <tr>
                  <th>App</th>
                  <th>Role</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {effective.map((row) => (
                  <tr>
                    <td>
                      <span class="mono">{row.clientId}</span>
                      <span class="muted text-xs"> {row.clientName}</span>
                    </td>
                    <td><span class="badge">{row.role}</span></td>
                    <td class="muted text-sm mono">{describeSource(row.source)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>

        <section class="panel stack">
          <h2>Actions</h2>
          {/* Each action gets its own action-scoped CSRF token: a captured
              token from one button cannot be replayed to trigger another. */}
          <div class="cta-row">
            <form method="post" class="actions-form">
              <input type="hidden" name="action" value="issue-recovery" />
              <input type="hidden" name="csrf_token" value={csrfTokenIssueRecovery} />
              <button type="submit" class="button button-secondary">
                Issue enrollment link + code
              </button>
            </form>
            <form method="post" class="actions-form">
              <input type="hidden" name="action" value="send-invite-email" />
              <input type="hidden" name="csrf_token" value={csrfTokenInviteEmail} />
              <input
                type="email"
                name="confirmEmail"
                class="invite-confirm-input"
                placeholder="re-type address to confirm"
                aria-label="Re-type the identity's email address to confirm the invite send"
                autocomplete="off"
                required
              />
              <button type="submit" class="button button-secondary" title="Sends a recovery CODE ONLY via the Kratos courier — never a link with the code embedded. The address above must byte-match the one on file, checked server-side.">
                Send invite email
              </button>
            </form>
            <form method="post" class="actions-form">
              <input type="hidden" name="action" value="force-relogin" />
              <input type="hidden" name="csrf_token" value={csrfTokenForceRelogin} />
              <button type="submit" class="button button-secondary">
                Force re-login
              </button>
            </form>
            {identity.state === 'inactive' ? (
              <form method="post" class="actions-form">
                <input type="hidden" name="action" value="reactivate" />
                <input type="hidden" name="csrf_token" value={csrfTokenDeactivate} />
                <button type="submit" class="button button-secondary">
                  Reactivate
                </button>
              </form>
            ) : (
              <form method="post" class="actions-form">
                <input type="hidden" name="action" value="deactivate" />
                <input type="hidden" name="csrf_token" value={csrfTokenDeactivate} />
                <button type="submit" class="button button-secondary">
                  Deactivate
                </button>
              </form>
            )}
          </div>
          <p class="muted text-xs">
            Force re-login revokes Kratos sessions and asks every supported app to log the user out (OIDC back-channel logout). Apps without that capability keep their local session until the per-app cookie expires.
          </p>

          <div class="admin-marker-row">
            <span class="muted text-sm">
              Admin authority:
              {isTargetAdmin
                ? <strong class="admin-on"> granted</strong>
                : <span class="admin-off"> none</span>}
            </span>
            <form method="post" class="actions-form">
              <input type="hidden" name="action" value={isTargetAdmin ? 'revoke-admin' : 'grant-admin'} />
              <input type="hidden" name="csrf_token" value={csrfTokenAdminToggle} />
              <button
                type="submit"
                class={isTargetAdmin ? 'button button-secondary' : 'button button-secondary'}
                title={isTargetAdmin
                  ? 'Revoke admin authority (removes metadata_admin.admin marker).'
                  : 'Grant admin authority (sets metadata_admin.admin=true).'}
              >
                {isTargetAdmin ? 'Revoke admin' : 'Grant admin'}
              </button>
            </form>
          </div>
          <p class="muted text-xs">
            Admin authority is the <code>metadata_admin.admin</code> marker. Grant/revoke is a targeted JSON Patch — groups and roles are not affected. Self-revoke is blocked; use another admin or the shell break-glass. Revoke is blocked if this is the last admin.
          </p>

          <details>
            <summary class="mono text-sm summary-danger">
              Delete identity
            </summary>
            <form method="post" class="stack details-content">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="csrf_token" value={csrfTokenDelete} />
              <p class="text-sm">
                Permanent. Type <span class="mono">{formValues.username}</span> to confirm.
              </p>
              <div class="field">
                <label for="confirm">Confirm username</label>
                <input id="confirm" name="confirm" type="text" autocomplete="off" required />
              </div>
              <button type="submit" class="button button-danger">Delete permanently</button>
            </form>
          </details>
        </section>
      </section>
    )}
  </section>
</Layout>

<AdminFormScripts />

