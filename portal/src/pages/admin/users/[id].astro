---
// Admin: one person, view and edit on one page. Sections save on their own (Apps, Household, Prerequisites, Profile) so
// none can clobber another; sign-in actions and the danger zone use the inline confirm. This is also the REPAIR
// surface for stored groups refuseNonCanonical (gate.ts) denies: the Unrecognised groups card shows each raw string so
// it can be removed. The POST handlers live in src/lib/admin-actions.ts; this page verifies the action-scoped CSRF token
// and dispatches. The result of an action shows once, inside the section the form posted to.

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import AccessRows from '../../../components/AccessRows.astro';
import Ask from '../../../components/Ask.astro';
import ManifestNotice from '../../../components/ManifestNotice.astro';
import SetupLink from '../../../components/SetupLink.astro';
import TitleRow from '../../../components/TitleRow.astro';
import { adminContext } from '../../../lib/admin-context';
import { getIdentity, listIdentities, EVICTABLE_CREDENTIAL_TYPES } from '../../../lib/admin-api';
import { ADMIN_ACTIONS, ENROLLMENT_TTL, type ActionResult } from '../../../lib/admin-actions';
import { bannerFor } from '../../../lib/admin-banner';
import { currentLevel, NO_ACCESS } from '../../../lib/access-rows';
import { emailIsVerified, householdChoices, PEOPLE_LOAD_ERROR, personName, signInMethods, unrecognisedGroups } from '../../../lib/admin-view';
import { isAdminMarker } from '../../../lib/admin-auth';
import { shouldRefuseRecovery } from '../../../lib/access';
import { hasSecondFactor } from '../../../lib/step-up';
import { loadRequirements } from '../../../lib/tiles';
import { signToken, verifyToken, CSRFError } from '../../../lib/csrf';
import type { Identity } from '../../../lib/types';

const ctx = await adminContext(Astro);
if (ctx instanceof Response) return ctx;
const { adminId, apps, health, dev } = ctx;

const { id } = Astro.params;
if (!id) return new Response('Missing identity id', { status: 400 });

const manifests = apps.map((a) => a.manifest);
const requirements = dev
  ? dev.requirements
  : [...loadRequirements().values()].map((r) => ({ name: r.name, title: r.title, why: r.why }));

let identity: Identity | null = null;
let loadError: string | null = null;

async function reload(): Promise<Identity | null> {
  if (dev) return dev.identities.find((i) => i.id === id) ?? null;
  try {
    return await getIdentity(id!);
  } catch (err) {
    console.error('[othala/admin/users/[id]] getIdentity failed:', err);
    loadError = PEOPLE_LOAD_ERROR;
    return null;
  }
}

identity = await reload();
if (dev && !identity) return new Response('Not found', { status: 404 });

let action = '';
let actionResult: ActionResult | null = null;
let formErrors: Record<string, string> = {};

if (Astro.request.method === 'POST' && identity) {
  const fd = await Astro.request.formData();
  action = String(fd.get('action') ?? '');

  // Every state-changing admin POST carries a CSRF token bound to the admin identity and the action.
  try {
    const tokenAction = action === 'remove-credential' ? `remove-${String(fd.get('cred_type') ?? '')}` : action;
    verifyToken(String(fd.get('csrf_token') ?? ''), adminId, tokenAction);
  } catch (err) {
    if (err instanceof CSRFError) {
      return new Response(`CSRF: ${err.message}`, { status: 403 });
    }
    throw err;
  }

  const handler = ADMIN_ACTIONS[action];
  if (dev) {
    actionResult = { kind: 'error', message: 'Fixture data: nothing was saved.' };
  } else if (handler) {
    try {
      const outcome = await handler(fd, { id, identity, adminIdentityId: adminId, manifests, requirements: requirements.map((r) => r.name) });
      if (outcome instanceof Response) return outcome;
      if (outcome.actionResult) actionResult = outcome.actionResult;
      if (outcome.formErrors) formErrors = outcome.formErrors;
      if (outcome.refetch) identity = await reload();
    } catch (err) {
      actionResult = { kind: 'error', message: err instanceof Error ? err.message : String(err) };
    }
  }
}

// Which section an action's result belongs to: the form posts there and the result shows there, once.
const SECTION_OF: Record<string, string> = {
  'save-profile': 'profile',
  'save-access': 'apps',
  'save-household': 'household',
  'grant-admin': 'household',
  'revoke-admin': 'household',
  'set-prerequisites': 'prerequisites',
  'remove-groups': 'groups',
  'mark-verified': 'signin',
  'issue-recovery': 'signin',
  'send-invite-email': 'signin',
  'force-relogin': 'signin',
  'remove-credential': 'signin',
  deactivate: 'danger',
  reactivate: 'danger',
  delete: 'danger',
};
const resultSection = SECTION_OF[action] ?? '';

const who = identity ? personName(identity) : '';
const first = who.split(/\s+/)[0] || who;
const formMessage = Object.values(formErrors).join(' ');
const banner = actionResult
  ? bannerFor(actionResult, action, first)
  : formMessage
    ? { tone: 'danger' as const, text: formMessage }
    : null;
const recovery = actionResult?.kind === 'recovery' ? actionResult : null;

const meta = identity?.metadata_admin;
const username = identity?.traits?.username ?? '';
const email = identity?.traits?.email ?? '';
const isSelf = id === adminId;
const isTargetAdmin = identity ? isAdminMarker(identity) : false;
const isOff = identity?.state === 'inactive';
const verified = identity ? emailIsVerified(identity) : false;
const twoStep = identity ? hasSecondFactor(identity) : false;
const methods = identity ? signInMethods(identity) : [];
const unrecognised = identity ? unrecognisedGroups(identity, manifests) : [];
const currentLevels: Record<string, string> = {};
for (const a of apps) currentLevels[a.clientId] = identity ? currentLevel(a.manifest, meta) : NO_ACCESS;
const households = householdChoices();
const storedGroups = meta?.groups ?? [];
const marked = meta?.prerequisites ?? [];
const roleOverrides = meta?.roles ?? {};

// The last-admin note needs the admin count; a failed read only drops the note, the server still refuses.
let lastAdmin = false;
if (isTargetAdmin && !isOff) {
  try {
    const all = dev ? dev.identities : await listIdentities();
    lastAdmin = all.filter((i) => isAdminMarker(i) && i.state !== 'inactive').length <= 1;
  } catch {
    lastAdmin = false;
  }
}

/** A fresh CSRF token scoped to one action; empty only in a dev fixture without CSRF_SECRET. */
function tok(name: string): string {
  try {
    return signToken(adminId, name);
  } catch (err) {
    if (!dev) throw err;
    return '';
  }
}

const devState = dev ? Astro.url.searchParams.get('dev-state') : null;
const peopleHref = devState ? `/admin/users?dev-state=${devState}` : '/admin/users';
const removable = methods.filter((m) => m.enrolled && EVICTABLE_CREDENTIAL_TYPES.has(m.key));
const roleNote = Object.keys(roleOverrides).length;
---
<AdminLayout title={who || 'Person'} description="One person: apps, household, sign-in." identityId={adminId}>
  <a class="back" href={peopleHref}>People</a>

  {loadError && <div class="notice notice-danger" role="alert">{loadError}</div>}
  <ManifestNotice health={health} />

  {identity && (
    <>
      <TitleRow title={who} lede={email}>
        <div class="badges">
          {isTargetAdmin && <span class="badge">Admin</span>}
          {isOff && <span class="badge badge-muted">Sign-in off</span>}
          <span class={`badge ${twoStep ? '' : 'badge-warning'}`}>Two-step: {twoStep ? 'on' : 'off'}</span>
          <span class={`badge ${verified ? 'badge-muted' : 'badge-warning'}`}>{verified ? 'Verified' : 'Unverified'} email</span>
        </div>
      </TitleRow>

      <details class="plain" id="profile" open={resultSection === 'profile'}>
        <summary>Edit profile</summary>
        <form class="inline-form" method="POST" enctype="application/x-www-form-urlencoded" action="#profile">
          <input type="hidden" name="csrf_token" value={tok('save-profile')} />
          <input type="hidden" name="action" value="save-profile" />
          <div class="form-grid two">
            <div class="field"><label for="displayName">Name</label><input id="displayName" name="displayName" type="text" value={identity.traits?.displayName ?? ''} autocomplete="off" /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" value={email} required autocomplete="off" /></div>
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" value={username} required pattern="[a-z0-9]+(\.[a-z0-9]+)+" autocomplete="off" aria-describedby="h-username" />
              <span class="field-hint" id="h-username">Lowercase letters, digits and dots: first.last</span>
            </div>
            <div class="field">
              <label for="recoveryEmail">Recovery email</label>
              <input id="recoveryEmail" name="recoveryEmail" type="email" value={identity.traits?.recoveryEmail ?? ''} autocomplete="off" aria-describedby="h-recovery" />
              <span class="field-hint" id="h-recovery">Optional. Where a setup link goes if the main email is lost.</span>
            </div>
          </div>
          <div class="row-actions"><button class="button button-primary" type="submit">Save profile</button></div>
        </form>
      </details>
      {resultSection === 'profile' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}

      <div class="stackp">
        <section class="panel" id="apps" aria-labelledby="h-apps">
          <h2 id="h-apps">Apps</h2>
          <p class="hint">Pick what {first} can do in each app.</p>
          {resultSection === 'apps' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
          <form method="POST" enctype="application/x-www-form-urlencoded" action="#apps" data-dirty-form>
            <input type="hidden" name="csrf_token" value={tok('save-access')} />
            <input type="hidden" name="action" value="save-access" />
            <AccessRows apps={apps} current={currentLevels} />
            <div class="row-actions">
              <button class="button button-primary" type="submit" data-save>Save access</button>
              <span class="dirty-note" data-dirty-note></span>
            </div>
          </form>
        </section>

        <section class="panel" id="household" aria-labelledby="h-house">
          <h2 id="h-house">Household</h2>
          <p class="hint">Groups the household uses to share things.</p>
          {resultSection === 'household' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
          <form method="POST" enctype="application/x-www-form-urlencoded" action="#household" data-dirty-form>
            <input type="hidden" name="csrf_token" value={tok('save-household')} />
            <input type="hidden" name="action" value="save-household" />
            {households.map((g) => (
              <label class="check"><input type="checkbox" name="identityGroups" value={g.value} checked={storedGroups.includes(g.value)} /><span>{g.label}</span></label>
            ))}
            <div class="row-actions">
              <button class="button button-primary" type="submit" data-save>Save household</button>
              <span class="dirty-note" data-dirty-note></span>
            </div>
          </form>
          <h3 class="subhead">Household admin</h3>
          <ul class="items">
            <li>
              <div class="item-id">
                <span class="item-name">Household admin</span>
                <span class="item-meta">{isTargetAdmin ? "Can add people, change anyone's access and send setup links." : 'Not an admin.'}</span>
              </div>
              {isTargetAdmin && isSelf && (
                <Ask
                  label="Remove my admin access"
                  action="revoke-admin"
                  token={tok('revoke-admin')}
                  section="household"
                  message="Remove your own admin access? You will lose the Admin link and every admin page straight away."
                  confirmLabel="Remove my admin access"
                  danger
                  match={who}
                  matchLabel={`Type your name, ${who}, to confirm`}
                />
              )}
              {isTargetAdmin && !isSelf && (
                <Ask
                  label="Remove household admin"
                  action="revoke-admin"
                  token={tok('revoke-admin')}
                  section="household"
                  message={`Remove ${first} as household admin? They will no longer be able to add people, change anyone's access or send setup links.`}
                  confirmLabel="Remove admin"
                  danger
                />
              )}
              {!isTargetAdmin && (
                <Ask
                  label="Make household admin"
                  action="grant-admin"
                  token={tok('grant-admin')}
                  section="household"
                  message={`Make ${first} a household admin? They will be able to add people, change anyone's access and send setup links.`}
                  confirmLabel="Make admin"
                  primary
                />
              )}
            </li>
          </ul>
          {!isTargetAdmin && !twoStep && <p class="field-hint">An admin needs an authenticator app or security key first.</p>}
          {lastAdmin && <p class="field-hint">The last admin can't be removed.</p>}
        </section>

        {requirements.length > 0 && (
          <section class="panel" id="prerequisites" aria-labelledby="h-prereq">
            <h2 id="h-prereq">Prerequisites</h2>
            <p class="hint">Mark what {first} has already set up. Tiles show Ready once it is marked.</p>
            {resultSection === 'prerequisites' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
            <form method="POST" enctype="application/x-www-form-urlencoded" action="#prerequisites" data-dirty-form>
              <input type="hidden" name="csrf_token" value={tok('set-prerequisites')} />
              <input type="hidden" name="action" value="set-prerequisites" />
              {requirements.map((r) => (
                <label class="check">
                  <input type="checkbox" name="prerequisite" value={r.name} checked={marked.includes(r.name)} />
                  <span>{r.title} set up{r.why && <small>{r.why}</small>}</span>
                </label>
              ))}
              <div class="row-actions">
                <button class="button button-primary" type="submit" data-save>Save prerequisites</button>
                <span class="dirty-note" data-dirty-note></span>
              </div>
            </form>
          </section>
        )}

        <section class="panel" id="signin" aria-labelledby="h-signin">
          <h2 id="h-signin">Sign-in</h2>
          {resultSection === 'signin' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
          <dl class="kv">
            <div><dt>Two-step</dt><dd>{twoStep ? 'On' : 'Off'}</dd></div>
            {methods.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
          </dl>
          <ul class="items">
            <li>
              <div class="item-id">
                <span class="item-name">Email address</span>
                <span class="item-meta">{email} · {verified ? 'Verified' : 'Unverified'}</span>
              </div>
              {!verified && (
                <Ask
                  label="Mark verified"
                  action="mark-verified"
                  token={tok('mark-verified')}
                  section="signin"
                  message={`Mark ${email} as verified? Only do this if you know the address belongs to ${first}.`}
                  confirmLabel="Mark verified"
                  primary
                />
              )}
            </li>
            <li>
              <div class="item-id">
                <span class="item-name">Setup link</span>
                <span class="item-meta">
                  {shouldRefuseRecovery(identity)
                    ? 'Admins get back in through the console. See the admin recovery runbook.'
                    : `Lets ${first} choose how to sign in again.`}
                </span>
              </div>
              {!shouldRefuseRecovery(identity) && (
                <form method="POST" enctype="application/x-www-form-urlencoded" action="#signin">
                  <input type="hidden" name="csrf_token" value={tok('issue-recovery')} />
                  <input type="hidden" name="action" value="issue-recovery" />
                  <button class="button button-primary button-sm" type="submit">Send setup link</button>
                </form>
              )}
              {recovery && (
                <div class="result" role="status">
                  <div class="notice notice-success">Setup link ready for {first}. Send it to them.</div>
                  <SetupLink url={recovery.url} code={recovery.code} ttl={ENROLLMENT_TTL} name={first} />
                </div>
              )}
              {!shouldRefuseRecovery(identity) && (
                <details class="plain result">
                  <summary>Email a code instead</summary>
                  <form class="confirm" method="POST" enctype="application/x-www-form-urlencoded" action="#signin">
                    <input type="hidden" name="csrf_token" value={tok('send-invite-email')} />
                    <input type="hidden" name="action" value="send-invite-email" />
                    <span>Sends a sign-in code to the address on file. Type it to confirm.</span>
                    <div class="field">
                      <label for="confirmEmail">Email address</label>
                      <input id="confirmEmail" name="confirmEmail" type="text" autocomplete="off" />
                    </div>
                    <button class="button button-secondary button-sm" type="submit">Send invite email</button>
                  </form>
                </details>
              )}
            </li>
            {removable.map((m) => (
              <li>
                <div class="item-id">
                  <span class="item-name">{m.label}</span>
                  <span class="item-meta">Lost it? Remove it, then send a setup link.</span>
                </div>
                <Ask
                  label="Remove"
                  action="remove-credential"
                  token={tok(`remove-${m.key}`)}
                  section="signin"
                  message={`Remove ${m.label.toLowerCase()} for ${first}? They can set it up again with a setup link.`}
                  confirmLabel={`Remove ${m.label.toLowerCase()}`}
                  danger
                >
                  <input type="hidden" name="cred_type" value={m.key} />
                </Ask>
              </li>
            ))}
            <li>
              <div class="item-id">
                <span class="item-name">Sign out everywhere</span>
                <span class="item-meta">Signs {first} out of every device and app.</span>
              </div>
              <Ask
                label="Sign out everywhere"
                action="force-relogin"
                token={tok('force-relogin')}
                section="signin"
                message={`Sign ${first} out of every device? They can sign back in right away.`}
                confirmLabel="Sign out everywhere"
                danger
              />
            </li>
          </ul>
        </section>

        {unrecognised.length > 0 && (
          <section class="panel warn-card" id="groups" aria-labelledby="h-groups">
            <h2 id="h-groups">Unrecognised groups</h2>
            <p class="hint">{first} belongs to a group none of your apps look at. It opens nothing. Remove it to tidy up.</p>
            {resultSection === 'groups' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
            <ul>
              {unrecognised.map((g) => (
                <li>
                  <code>{g}</code>
                  <form method="POST" enctype="application/x-www-form-urlencoded" action="#groups">
                    <input type="hidden" name="csrf_token" value={tok('remove-groups')} />
                    <input type="hidden" name="action" value="remove-groups" />
                    <input type="hidden" name="group" value={g} />
                    <button class="button button-secondary button-sm" type="submit">Remove</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )}

        <details class="danger" id="danger" open={resultSection === 'danger'}>
          <summary>Danger zone</summary>
          {resultSection === 'danger' && banner && <div class={`notice notice-${banner.tone}`} role="status">{banner.text}</div>}
          <ul class="items">
            <li>
              <div class="item-id">
                <span class="item-name">{isOff ? 'Turn sign-in back on' : 'Turn off sign-in'}</span>
                <span class="item-meta">{isOff ? `${first} can sign in again once you turn it on.` : `${first} can't sign in until you turn it back on. Nothing is deleted.`}</span>
              </div>
              {isOff ? (
                <Ask label="Turn sign-in on" action="reactivate" token={tok('reactivate')} section="danger" message={`Turn sign-in back on for ${first}?`} confirmLabel="Turn sign-in on" primary />
              ) : (
                <Ask label="Turn off sign-in" action="deactivate" token={tok('deactivate')} section="danger" message={`Turn off sign-in for ${first}? You can turn it back on later.`} confirmLabel="Turn off sign-in" danger />
              )}
            </li>
            <li>
              <div class="item-id">
                <span class="item-name">Delete person</span>
                <span class="item-meta">
                  {isTargetAdmin ? `Remove ${first} as household admin first.` : `Removes ${first} and their sign-in for good. This can't be undone.`}
                </span>
              </div>
              {!isTargetAdmin && (
                <Ask
                  label="Delete person"
                  action="delete"
                  token={tok('delete')}
                  section="danger"
                  message={`This removes ${first} for good.`}
                  confirmLabel="Delete permanently"
                  danger
                  match={username}
                  matchLabel={`Type ${username} to confirm`}
                />
              )}
            </li>
          </ul>
        </details>

        <details class="tech">
          <summary>Technical details</summary>
          <dl class="kv">
            <div><dt>Id</dt><dd><code>{identity.id}</code></dd></div>
            <div><dt>Username</dt><dd><code>{username}</code></dd></div>
            <div><dt>Groups</dt><dd>{storedGroups.length ? storedGroups.map((g) => <><code>{g}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Role overrides</dt><dd>{roleNote ? Object.entries(roleOverrides).map(([app, role]) => <><code>{app}: {role}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>State</dt><dd><code>{identity.state ?? 'active'}</code></dd></div>
          </dl>
        </details>
      </div>
    </>
  )}
  {!identity && !loadError && <div class="notice notice-danger" role="alert">That person was not found.</div>}
</AdminLayout>
