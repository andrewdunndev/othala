---
// Admin landing.
//
// Three cards: Users / Groups / Apps. Each card shows the live count and
// links to its index page. Counts are computed from Kratos identities and
// the manifest catalog so the home admin always sees the truth, not a
// hard-coded number.
//
// AAL2 enforcement happens in requireAdminSession; pages that fail the
// guard redirect to a refresh login.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { requireAdminSession, listIdentities } from '../../lib/admin';
import { loadClientManifests, knownIdentityGroups, knownAccessGroups } from '../../lib/manifests';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

let userCount = 0;
let loadError: string | null = null;
try {
  const identities = await listIdentities();
  userCount = identities.length;
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

const manifests = loadClientManifests();
const identityGroups = knownIdentityGroups();
const accessGroups = knownAccessGroups();

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
  { href: '/auth/settings',  label: 'Settings' },
];

const cards = [
  { href: '/admin/users',  title: 'Users',  primary: `${userCount}`,           secondary: userCount === 1 ? 'identity' : 'identities' },
  { href: '/admin/groups', title: 'Groups', primary: `${identityGroups.length} / ${accessGroups.length}`, secondary: 'identity / access' },
  { href: '/admin/oauth2', title: 'Apps',   primary: `${manifests.length}`,    secondary: 'OIDC clients' },
];
---
<Layout title="Admin" description="Identity, group, and OIDC client administration.">

  <header class="page-header">
    <p class="page-eyebrow">administration</p>
    <h1 class="page-title">Overview</h1>
    <p class="page-lede">
      Identities, groups, and OIDC clients across the home estate.
      Editing happens here. Source of truth for client config lives in
      the unified per-app <code>&lt;slug&gt;.yaml</code> manifests.
    </p>
  </header>

  <nav class="nav-bar" aria-label="Admin">
    {adminNav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  {loadError && (
    <div class="notice notice-danger">
      Failed to read identity store: {loadError}
    </div>
  )}

  <section class="section">
    <p class="section-subtitle">At a glance</p>
    <div class="card-grid">
      {cards.map((c) => (
        <a class="admin-card panel" href={c.href}>
          <span class="admin-card-primary mono">{c.primary}</span>
          <span class="admin-card-title">{c.title}</span>
          <span class="admin-card-secondary mono">{c.secondary}</span>
          <span class="admin-card-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

</Layout>

<style>
  .admin-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .admin-card:hover { border-color: var(--accent); text-decoration: none; }
  .admin-card-primary {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    color: var(--text);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .admin-card-title {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text);
  }
  .admin-card-secondary {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .admin-card-arrow {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .admin-card:hover .admin-card-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }
</style>
