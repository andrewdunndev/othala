---
// /admin has no page of its own: People is the landing, and anything that needs attention shows there as a notice.
// The admin gate runs first so the redirect cannot be used to probe routes unauthenticated; an unauthorized caller
// gets the same step-up redirect every other /admin/* page returns.

export const prerender = false;

import { requireAdminSession } from '../../lib/admin';

const devFixture = import.meta.env.DEV && Astro.url.searchParams.has('dev-state');
if (!devFixture) {
  const guard = await requireAdminSession(Astro);
  if (guard instanceof Response) return guard;
}

return Astro.redirect(`/admin/users${devFixture ? Astro.url.search : ''}`, 302);
---
