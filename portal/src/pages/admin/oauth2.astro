---
// Admin: OAuth2 clients (read-only). Reads from Hydra admin /admin/clients.
// Source of truth is hydra/clients/*.yaml + apply-clients.sh; this page
// shows the current state.
// Status: skeleton.
export const prerender = false;

import { requireAdminSession, listOAuth2Clients } from '../../lib/admin';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

let clients: any[] = [];
try {
  clients = await listOAuth2Clients() as any[];
} catch (err) {
  // TODO
}
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><title>OAuth2 — Admin — Dunn Family</title></head>
<body class="bg-paper text-ink">
  <main class="mx-auto max-w-4xl p-8">
    <h1 class="text-2xl font-mono">OAuth2 clients</h1>
    <p class="mt-2 text-sm text-secondary">
      Read-only. Manage in hydra/clients/*.yaml then run apply-clients.sh.
    </p>
    <ul class="mt-6 space-y-3">
      {clients.map(c => (
        <li class="border-b border-rules/50 pb-2">
          <div class="font-mono">{c.client_id} — {c.client_name}</div>
          <div class="text-sm text-secondary">{(c.scope ?? '').toString()}</div>
        </li>
      ))}
    </ul>
  </main>
</body>
</html>
