---
// Admin: OAuth2 clients (read-only).
//
// Source of truth is the unified per-app manifests (`<slug>.yaml`) in
// MANIFEST_DIR; the in-app registrar syncs their `oidc:`/`consent:`
// blocks to Hydra. This page renders the loaded manifest set; editing
// happens by changing a manifest, not here.
//
// Editing is by-manifest, not in-page: each card names the source file
// (`<clientId>.yaml`) so the admin knows where to make changes. Roles +
// group_role_map come from the manifest; when an app's manifest has no
// roles block, the table shows "(none)" so the absence is visible.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { requireAdminSession } from '../../lib/admin';
import { loadClientManifests } from '../../lib/manifests';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

const manifests = loadClientManifests();

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
];
---
<Layout title="Apps — Admin" description="OIDC client manifests." nav={adminNav}>
  <main class="stack-lg">
    <header class="page-header">
      <p class="page-eyebrow">administration · oidc clients</p>
      <h1 class="page-title">Apps</h1>
      <p class="page-lede">
        Read-only. Apps are defined by unified <code>&lt;slug&gt;.yaml</code>
        manifests in the manifest directory; edit a manifest and it is
        picked up at runtime — no rebuild.
      </p>
    </header>

    <section class="stack-lg">
      {manifests.map((m) => (
        <article class="panel stack">
          <header style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
            <div>
              <h2 class="mono">{m.clientId}</h2>
              <p class="muted text-sm">{m.clientName}</p>
            </div>
            <p class="muted text-xs mono">
              source: <span class="mono">{m.clientId}.yaml</span>
            </p>
          </header>

          <dl style="display: grid; grid-template-columns: 9rem 1fr; gap: 0.4rem 1rem; font-size: var(--text-sm);">
            <dt class="muted mono">access group</dt>
            <dd><span class="badge badge-muted">{m.accessGroup}</span></dd>

            <dt class="muted mono">grant types</dt>
            <dd class="mono text-xs">{m.grantTypes.join(', ') || '(none)'}</dd>

            <dt class="muted mono">scopes</dt>
            <dd class="mono text-xs">{m.scopes.join(' ') || '(none)'}</dd>

            <dt class="muted mono">audience</dt>
            <dd class="mono text-xs">{m.audience.join(', ') || '(none)'}</dd>

            <dt class="muted mono">redirect uris</dt>
            <dd>
              <ul class="stack mono text-xs" style="list-style: none;">
                {m.redirectUris.map((u) => <li>{u}</li>)}
                {m.redirectUris.length === 0 && <li class="muted">(none)</li>}
              </ul>
            </dd>

            <dt class="muted mono">skip consent</dt>
            <dd class="mono text-xs">{m.skipConsent ? 'true' : 'false'}</dd>
          </dl>

          <div>
            <p class="muted text-xs mono">declared roles</p>
            {m.roles.length === 0 ? (
              <p class="muted text-sm">(none — populate <span class="mono">roles:</span> in the yaml)</p>
            ) : (
              <table class="data-table">
                <thead>
                  <tr><th>name</th><th>description</th></tr>
                </thead>
                <tbody>
                  {m.roles.map((r) => (
                    <tr>
                      <td><span class="badge">{r.name}</span></td>
                      <td class="muted text-sm">{r.description || '(no description)'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>

          <div>
            <p class="muted text-xs mono">group_role_map</p>
            {Object.keys(m.groupRoleMap).length === 0 ? (
              <p class="muted text-sm">(none)</p>
            ) : (
              <table class="data-table">
                <thead>
                  <tr><th>identity group</th><th>default role</th></tr>
                </thead>
                <tbody>
                  {Object.entries(m.groupRoleMap).map(([g, r]) => (
                    <tr>
                      <td><span class="badge">{g}</span></td>
                      <td><span class="badge badge-muted">{r}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>
