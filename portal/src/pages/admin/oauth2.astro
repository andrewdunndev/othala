---
// Admin: apps, read-only. One row per app: icon, name, description, Open, who can use it and its admins. A badge shows
// only for a real problem (a manifest that fails lint, or a client Hydra does not have). Access is changed on the
// person, not here. The raw bindings sit in a closed Technical details disclosure on each row.
// The per-app manifests (`<slug>.yaml`) in MANIFEST_DIR are the source of truth and the registrar syncs them to Hydra.

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import ManifestNotice from '../../components/ManifestNotice.astro';
import TitleRow from '../../components/TitleRow.astro';
import { adminContext } from '../../lib/admin-context';
import { listIdentities } from '../../lib/admin-api';
import { holdersOf, hydraClientIds } from '../../lib/admin-apps';
import { PEOPLE_LOAD_ERROR, personName } from '../../lib/admin-view';
import { isOpenToEveryone } from '../../lib/access-rows';
import { lintManifests } from '../../lib/manifest-lint';
import { buildGroupRegistry, knownGroupNames } from '../../lib/group-registry';
import { IDENTITY_GROUPS } from '../../lib/constants';
import { loadRequirements, safeHref } from '../../lib/tiles';
import type { Identity } from '../../lib/types';

const ctx = await adminContext(Astro);
if (ctx instanceof Response) return ctx;
const { apps, health, dev } = ctx;

let identities: Identity[] = [];
let loadError: string | null = null;
if (dev) {
  identities = dev.identities;
} else {
  try {
    identities = await listIdentities();
  } catch (err) {
    console.error('[othala/admin/oauth2] listIdentities failed:', err);
    loadError = PEOPLE_LOAD_ERROR;
  }
}
const people = identities.map((identity) => ({ identity, name: personName(identity) }));

const manifests = apps.map((a) => a.manifest);
const requirementNames = dev ? dev.requirements.map((r) => r.name) : [...loadRequirements().keys()];
const findings = lintManifests(manifests, knownGroupNames(buildGroupRegistry(manifests, IDENTITY_GROUPS)), requirementNames);
const registered = dev ? new Set(apps.map((a) => a.manifest.clientId).filter((id) => !dev.unsynced.includes(id))) : await hydraClientIds();
const devState = dev ? Astro.url.searchParams.get('dev-state') : null;

const rows = apps.map((app) => {
  const m = app.manifest;
  const problems = findings.filter((f) => f.source === (m.sourcePath || m.clientId));
  const notSynced = registered !== null && !m.presentationOnly && !registered.has(m.clientId);
  return {
    app,
    open: isOpenToEveryone(m),
    holders: holdersOf(app, people),
    problems,
    notSynced,
    href: app.url ? safeHref(app.url) : '',
  };
});
const personHref = (id: string) => `/admin/users/${id}${devState ? `?dev-state=${devState}` : ''}`;
---
<AdminLayout title="Apps" description="What your household can sign in to." identityId={ctx.adminId}>
  <TitleRow title="Apps" count={rows.length} lede="What your household can sign in to." />

  <ManifestNotice health={health} />
  {loadError && <div class="notice notice-danger" role="alert">{loadError}</div>}

  <ul class="app-rows panel">
    {rows.map(({ app, open, holders, problems, notSynced, href }) => (
      <li>
        <div class="app-head">
          <AppIcon tile={app.tile ?? { icon: app.name.slice(0, 2).toUpperCase() }} />
          <div class="app-text">
            <div class="app-name">{app.name}</div>
            <div class="app-desc">{app.description}</div>
          </div>
          {href && <a class="open-link" href={href} rel="noopener" aria-label={`Open ${app.name}`}>Open</a>}
        </div>
        {(problems.length > 0 || notSynced) && (
          <div class="badges" style="margin-top: var(--space-2)">
            {problems.some((p) => p.severity === 'block') && <span class="badge badge-danger">Settings need fixing</span>}
            {problems.some((p) => p.severity === 'warn') && !problems.some((p) => p.severity === 'block') && <span class="badge badge-warning">Settings need a look</span>}
            {notSynced && <span class="badge badge-danger">Not synced to the sign-in service</span>}
          </div>
        )}
        {problems.length > 0 && <p class="item-meta">Something is off in this app's settings. The details are under Technical details.</p>}
        <dl class="app-who">
          <dt>Who can use it</dt>
          <dd>
            {open ? (
              <span class="chip">Everyone</span>
            ) : holders.length > 0 ? (
              <ul class="chips">
                {holders.map((h) => (
                  <li><a class="chip" href={personHref(h.id)}>{h.name}{h.level && <> <b>· {h.level}</b></>}{h.off && <> <span class="stat-note">· sign-in off</span></>}</a></li>
                ))}
              </ul>
            ) : (
              <span class="empty-note">{loadError ? 'Unknown' : 'No one yet'}</span>
            )}
          </dd>
        </dl>
        <details class="tech plain">
          <summary>Technical details</summary>
          <dl class="kv">
            {problems.length > 0 && <div><dt>Problems</dt><dd>{problems.map((p) => <div>{p.message}</div>)}</dd></div>}
            <div><dt>Client id</dt><dd><code>{app.manifest.clientId}</code></dd></div>
            <div><dt>Bound groups</dt><dd>{app.manifest.accessGroups.length ? app.manifest.accessGroups.map((g) => <><code>{g}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Role map</dt><dd>{Object.keys(app.manifest.groupRoleMap).length ? Object.entries(app.manifest.groupRoleMap).map(([g, r]) => <><code>{g}: {r}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Scopes</dt><dd>{app.manifest.scopes.length ? app.manifest.scopes.map((s) => <><code>{s}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Grant types</dt><dd>{app.manifest.grantTypes.length ? app.manifest.grantTypes.map((s) => <><code>{s}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Redirect URIs</dt><dd>{app.manifest.redirectUris.length ? app.manifest.redirectUris.map((u) => <><code>{u}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Audience</dt><dd>{app.manifest.audience.length ? app.manifest.audience.map((u) => <><code>{u}</code>{' '}</>) : 'None'}</dd></div>
            <div><dt>Skip consent</dt><dd><code>{app.manifest.skipConsent ? 'true' : 'false'}</code></dd></div>
            <div><dt>Source file</dt><dd><code>{app.manifest.sourcePath || `${app.slug}.yaml`}</code></dd></div>
          </dl>
        </details>
      </li>
    ))}
  </ul>
  {rows.length === 0 && <div class="panel empty-state"><p>No apps yet.</p></div>}
</AdminLayout>
