---
// /admin/activity is out of scope for the public release: a real activity log (alloy to Loki archival plus a Postgres
// summary table for the in-UI last-100 view) is not shipped. This route redirects to People.
export const prerender = false;

import { requireAdminSession } from '../../lib/admin';

// Keep the admin gate so the redirect can't be used to probe routes unauthenticated; an unauthorized caller gets the
// same refresh-login redirect every other /admin/* page returns.
const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

return Astro.redirect('/admin/users', 302);
---
