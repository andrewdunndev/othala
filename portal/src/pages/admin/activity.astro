---
// /admin/activity has been retired from the shipped product.
//
// A real activity log (alloy → Loki archival + a Postgres summary table
// for the in-UI last-100 view) is out of scope for the public release, so
// the navigable placeholder it used to render was removed rather than
// shipped dead. This route is no longer linked from the admin nav; it
// redirects to the admin overview so any stale bookmark lands somewhere
// live instead of on a dead page.
export const prerender = false;

import { requireAdminSession } from '../../lib/admin';

// Keep the admin gate so the redirect can't be used to probe routes
// unauthenticated; an unauthorized caller gets the same refresh-login
// redirect every other /admin/* page returns.
const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

return Astro.redirect('/admin', 302);
---
