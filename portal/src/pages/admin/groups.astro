---
// Admin: groups overview (read-only).
//
// Two sections:
//   - Identity groups (admin / family / kids / friends + any other group
//     a manifest references via group_role_map). Each card lists members.
//   - Access groups: registry-derived Group → Apps view. A group's type comes
//     from its manifest BINDING, not its name; each card
//     names the apps it grants entry to / maps a role in, and lists members.
//
// Editing happens on the per-user page. This is a navigation aid: spot
// who's in `kids`, who can reach a given app, etc.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ManifestNotice from '../../components/ManifestNotice.astro';
import { requireAdminSession, listIdentities } from '../../lib/admin';
import { servingManifests, servingIdentityGroups, manifestHealth } from '../../lib/manifest-store';
import { getGroupRegistry } from '../../lib/group-registry';
import type { Identity } from '../../lib/types';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

let identities: Identity[] = [];
let loadError: string | null = null;
try {
  identities = await listIdentities();
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

// Manifest reads go through the serving store: a manifest that fails to
// validate falls back to the last known good set instead of 500-ing this page.
// ManifestNotice below makes the fallback visible.
const manifests = servingManifests();
const registry = getGroupRegistry();
const clientNameById = new Map(manifests.map((m) => [m.clientId, m.clientName] as const));
const identityGroups = servingIdentityGroups();
const manifestState = manifestHealth();

// The access section is a registry-driven Group → Apps view. A group's type is
// its BINDING, not its name — so an
// access group named `memories` shows up correctly. Each row names the apps the
// group grants ENTRY to (accessFor) and the apps it maps a ROLE in (roleFor).
const appLabel = (id: string) => clientNameById.get(id) ?? id;
const accessGroups = Array.from(registry.values())
  .filter((e) => e.kinds.has('access') || e.kinds.has('role'))
  .map((e) => ({
    group: e.name,
    grantsAccessTo: e.accessFor.map((id) => ({ clientId: id, clientName: appLabel(id) })),
    grantsRoleIn: e.roleFor.map((id) => ({ clientId: id, clientName: appLabel(id) })),
  }))
  .sort((a, b) => a.group.localeCompare(b.group));

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
  { href: '/auth/settings',  label: 'Settings' },
];

interface MemberRef {
  id: string;
  username: string;
  displayName?: string;
}

function membersOf(group: string): MemberRef[] {
  const out: MemberRef[] = [];
  for (const i of identities) {
    if ((i.metadata_admin?.groups ?? []).includes(group)) {
      out.push({
        id: i.id,
        username: i.traits?.username ?? i.id,
        displayName: i.traits?.displayName,
      });
    }
  }
  out.sort((a, b) => a.username.localeCompare(b.username));
  return out;
}
---
<Layout title="Groups — Admin" description="Identity and access groups.">
  <header class="page-header">
    <p class="page-eyebrow">administration · groups</p>
    <h1 class="page-title">Groups</h1>
    <p class="page-lede">
      Identity groups define who someone is. Access groups define what
      they can reach. Membership is edited per-user.
    </p>
  </header>

  <nav class="nav-bar" aria-label="Admin">
    {adminNav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  {loadError && (
    <div class="notice notice-danger">Failed to read identity store: {loadError}</div>
  )}

  <ManifestNotice health={manifestState} />

  <section class="section">
    <p class="section-subtitle">Identity groups</p>
    <p class="muted text-sm">Who you are. Drives default roles via group_role_map.</p>
    <div class="notice">
      Identity groups are set via the <code>OTHALA_IDENTITY_GROUPS</code> env var (edit + restart to add one). Access groups are derived automatically from app OIDC manifests.
    </div>
    <div class="card-grid">
      {identityGroups.map((g) => {
        const members = membersOf(g);
        return (
          <article class="panel">
            <h2 class="mono">{g}</h2>
            <p class="muted text-xs">{members.length} {members.length === 1 ? 'member' : 'members'}</p>
            <ul class="stack group-member-list">
              {members.map((m) => (
                <li>
                  <a href={`/admin/users/${m.id}`} class="subtle mono text-sm">
                    {m.username}
                  </a>
                  {m.displayName && (
                    <span class="muted text-xs"> {m.displayName}</span>
                  )}
                </li>
              ))}
              {members.length === 0 && (
                <li class="muted text-sm">empty</li>
              )}
            </ul>
            <div class="group-card-footer">
              <a href={`/admin/users?group=${encodeURIComponent(g)}`} class="group-add-link mono text-xs">
                Add member →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section">
    <p class="section-subtitle">Access groups</p>
    <p class="muted text-sm">
      What a group lets you reach. Derived from each app manifest's
      <code>access:</code> binding (entry) and <code>group_role_map</code> (role)
      — a group's type comes from its binding, not its name.
    </p>
    <div class="card-grid">
      {accessGroups.map((a) => {
        const members = membersOf(a.group);
        return (
          <article class="panel">
            <h2 class="mono">{a.group}</h2>
            {a.grantsAccessTo.length > 0 && (
              <p class="muted text-xs">
                grants entry to {a.grantsAccessTo.map((app, i) => (
                  <>{i > 0 ? ', ' : ''}<span class="mono">{app.clientId}</span></>
                ))}
              </p>
            )}
            {a.grantsRoleIn.length > 0 && (
              <p class="muted text-xs">
                maps a role in {a.grantsRoleIn.map((app, i) => (
                  <>{i > 0 ? ', ' : ''}<span class="mono">{app.clientId}</span></>
                ))}
              </p>
            )}
            <p class="muted text-xs">
              {members.length} {members.length === 1 ? 'member' : 'members'}
            </p>
            <ul class="stack group-member-list">
              {members.map((m) => (
                <li>
                  <a href={`/admin/users/${m.id}`} class="subtle mono text-sm">
                    {m.username}
                  </a>
                </li>
              ))}
              {members.length === 0 && (
                <li class="muted text-sm">empty</li>
              )}
            </ul>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .group-member-list { list-style: none; margin-top: var(--space-2); }
  .group-card-footer { margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--border); }
  .group-add-link { color: var(--text-muted); text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; }
  .group-add-link:hover { color: var(--accent); text-decoration: none; }
</style>
