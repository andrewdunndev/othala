---
// Admin: groups overview (read-only).
//
// Two sections:
//   - Identity groups (admin / family / kids / friends + any other group
//     a manifest references via group_role_map). Each card lists members.
//   - Access groups (access-*). Each card names the app it grants entry
//     to and lists members.
//
// Editing happens on the per-user page. This is a navigation aid: spot
// who's in `kids`, who can reach `access-cinema`, etc.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { requireAdminSession, listIdentities } from '../../lib/admin';
import { loadClientManifests, knownIdentityGroups } from '../../lib/manifests';
import type { Identity } from '../../lib/types';

const guard = await requireAdminSession(Astro);
if (guard instanceof Response) return guard;

let identities: Identity[] = [];
let loadError: string | null = null;
try {
  identities = await listIdentities();
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

const manifests = loadClientManifests();
const identityGroups = knownIdentityGroups();
const accessGroups = manifests.map((m) => ({
  group: m.accessGroup,
  clientId: m.clientId,
  clientName: m.clientName,
}));

const adminNav = [
  { href: '/admin',          label: 'Overview' },
  { href: '/admin/users',    label: 'Users' },
  { href: '/admin/groups',   label: 'Groups' },
  { href: '/admin/oauth2',   label: 'Apps' },
];

interface MemberRef {
  id: string;
  username: string;
  displayName?: string;
}

function membersOf(group: string): MemberRef[] {
  const out: MemberRef[] = [];
  for (const i of identities) {
    if ((i.metadata_admin?.groups ?? []).includes(group)) {
      out.push({
        id: i.id,
        username: i.traits?.username ?? i.id,
        displayName: i.traits?.displayName,
      });
    }
  }
  out.sort((a, b) => a.username.localeCompare(b.username));
  return out;
}
---
<Layout title="Groups — Admin" description="Identity and access groups.">
  <header class="page-header">
    <p class="page-eyebrow">administration · groups</p>
    <h1 class="page-title">Groups</h1>
    <p class="page-lede">
      Identity groups define who someone is. Access groups define what
      they can reach. Membership is edited per-user.
    </p>
  </header>

  <nav class="nav-bar" aria-label="Admin">
    {adminNav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  {loadError && (
    <div class="notice notice-danger">Failed to read identity store: {loadError}</div>
  )}

  <section class="section">
    <p class="section-subtitle">Identity groups</p>
    <p class="muted text-sm">Who you are. Drives default roles via group_role_map.</p>
    <div class="card-grid">
      {identityGroups.map((g) => {
        const members = membersOf(g);
        return (
          <article class="panel">
            <h2 class="mono">{g}</h2>
            <p class="muted text-xs">{members.length} {members.length === 1 ? 'member' : 'members'}</p>
            <ul class="stack group-member-list">
              {members.map((m) => (
                <li>
                  <a href={`/admin/users/${m.id}`} class="subtle mono text-sm">
                    {m.username}
                  </a>
                  {m.displayName && (
                    <span class="muted text-xs"> {m.displayName}</span>
                  )}
                </li>
              ))}
              {members.length === 0 && (
                <li class="muted text-sm">empty</li>
              )}
            </ul>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section">
    <p class="section-subtitle">Access groups</p>
    <p class="muted text-sm">What you can reach. One per OIDC client.</p>
    <div class="card-grid">
      {accessGroups.map((a) => {
        const members = membersOf(a.group);
        return (
          <article class="panel">
            <h2 class="mono">{a.group}</h2>
            <p class="muted text-xs">
              grants entry to <span class="mono">{a.clientId}</span> ({a.clientName})
            </p>
            <p class="muted text-xs">
              {members.length} {members.length === 1 ? 'member' : 'members'}
            </p>
            <ul class="stack group-member-list">
              {members.map((m) => (
                <li>
                  <a href={`/admin/users/${m.id}`} class="subtle mono text-sm">
                    {m.username}
                  </a>
                </li>
              ))}
              {members.length === 0 && (
                <li class="muted text-sm">empty</li>
              )}
            </ul>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .group-member-list { list-style: none; margin-top: var(--space-2); }
</style>
