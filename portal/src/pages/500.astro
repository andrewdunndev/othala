---
// 500: Astro's special page for an unhandled exception. The error prop MUST NOT
// reach the client; show a generic branded message and log server-side.

export const prerender = false;

import StatusPage from '../components/StatusPage.astro';
import { REASON_MAP } from '../lib/error-reasons';

interface Props {
  error: unknown;
}

const { error } = Astro.props;

// Server-side log only — never forwarded to the rendered HTML.
console.error('[othala/portal] Unhandled server error:', error);
---
<StatusPage status={500} title={REASON_MAP['server-error'].title} message={REASON_MAP['server-error'].message} />
