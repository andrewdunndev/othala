---
// Per-app detail page rendering the education content sourced from the
// app's unified manifest (the optional sibling `<slug>.md`, read at
// request time via getTile in lib/tiles.ts).
//
// Session-gated like the home page: not in `access-<slug>` group =
// redirect to /auth/error?reason=not-authorised. Admins see every
// app's detail page regardless of access group.
//
// Adding a new app: drop a `<slug>.yaml` (with a `presentation:` block,
// and an optional sibling `<slug>.md`) into MANIFEST_DIR. The route is
// SSR (prerender=false) and resolves the slug at request time via
// getTile, so there is no getStaticPaths and no portal image rebuild
// when manifests change.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getTile } from '../../lib/tiles';
import { getSession } from '../../lib/kratos';
import { isAdminId } from '../../lib/admin-auth';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}

const entry = getTile(slug);
if (!entry) {
  return new Response('App not found', { status: 404 });
}

// Session gate.
const cookie = Astro.request.headers.get('cookie') ?? undefined;
const session = await getSession(cookie).catch(() => null);
if (!session?.active || !session.identity) {
  return Astro.redirect(`/auth/login?return_to=${encodeURIComponent(Astro.url.pathname)}`);
}

// CVP-P1: admin authority is the OTHALA_ADMIN_IDS allowlist keyed on the
// immutable identity id, NOT the (display-only) `admin` group and NOT the
// user-editable email trait. Admins see every app's detail page; everyone
// else needs the per-app access-<slug> group.
const groups = session.identity.metadata_admin?.groups ?? [];
const isAdmin = isAdminId(session.identity.id);
const hasAccess = isAdmin || groups.includes(entry.accessGroup);
if (!hasAccess) {
  return Astro.redirect('/auth/error?reason=not-authorised');
}
---
<Layout title={entry.name} description={entry.description}>
  <article class="app-detail">
    <header class="app-header">
      <p class="app-eyebrow mono">{entry.icon} · {entry.authKind}</p>
      <h1 class="app-title">{entry.name}</h1>
      <p class="app-lede">{entry.description}</p>
      <div class="app-cta">
        <a class="button button-primary" href={entry.url} rel="noopener">Open {entry.name} ↗</a>
        <a class="cta-link mono" href="/">Back to dashboard</a>
      </div>
    </header>

    <section class="app-body">
      <div class="edu-prose" set:html={entry.educationHtml ?? ''} />
    </section>
  </article>
</Layout>

<style>
  .app-detail {
    max-width: 1100px;
    margin: 0 auto;
  }
  .app-header {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }
  .app-eyebrow {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .app-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    margin: var(--space-2) 0 var(--space-3);
  }
  .app-lede {
    font-size: var(--text-lg);
    color: var(--text-2);
    line-height: 1.6;
    max-width: 56ch;
    margin-bottom: var(--space-4);
  }
  .app-cta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .app-body {
    padding: var(--space-6) 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text);
  }
  .app-body :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    margin: var(--space-5) 0 var(--space-2);
  }
  .app-body :global(h3) {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--space-4) 0 var(--space-2);
  }
  .app-body :global(p) {
    margin: var(--space-3) 0;
  }
  .app-body :global(ul),
  .app-body :global(ol) {
    margin: var(--space-3) 0;
    padding-left: var(--space-5);
  }
  .app-body :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--surface);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .app-body :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-3);
    border-radius: var(--radius);
    overflow-x: auto;
  }
  .app-body :global(pre) :global(code) {
    background: transparent;
    padding: 0;
  }
  .app-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .cta-link {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .cta-link:hover { color: var(--accent); text-decoration: none; }
</style>
