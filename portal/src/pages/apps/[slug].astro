---
// Per-app guide page: the same content as the dashboard dialog. The app's optional sibling `<slug>.md` is split into the
// fixed guide outline (lib/tiles.ts), with a prerequisite card above Open when the manifest declares `requires`.
// Session-gated; outside the app's access group redirects to /auth/error?reason=not-authorised, admins see every app.
// SSR resolves the slug per request, so new manifests need no rebuild. In `astro dev`, `?dev-state=post-auth` skips Kratos.

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/AppIcon.astro';
import PrereqCard from '../../components/PrereqCard.astro';
import AppActions from '../../components/AppActions.astro';
import GuideSections from '../../components/GuideSections.astro';
import CopyChips from '../../components/CopyChips.astro';
import HeaderActions from '../../components/HeaderActions.astro';
import {
  getTile,
  loadRequirements,
  requirementsFor,
  splitGuide,
  tileReadiness,
  safeHref,
  userCanSeeTile,
} from '../../lib/tiles';
import { getSession } from '../../lib/kratos';
import { getIdentity } from '../../lib/admin-api';
import { parseIdentity } from '../../lib/identity-facts';
import { devMockIdentity } from '../../lib/dev-mock';
import type { Identity } from '../../lib/types';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}

// Session gate FIRST — check authentication before revealing tile existence.
// An unauthenticated visitor must not be able to distinguish a valid slug from
// an invalid one (enumeration defence: the tile-existence 404 runs only after
// we know the caller is authenticated).
const devIdentity = Astro.url.searchParams.get('dev-state') === 'post-auth' ? devMockIdentity(Astro.url) : null;
let identity: Identity | null = devIdentity;
if (!identity) {
  const cookie = Astro.request.headers.get('cookie') ?? undefined;
  const session = await getSession(cookie).catch(() => null);
  if (!session?.active || !session.identity) {
    return Astro.redirect(`/auth/login?return_to=${encodeURIComponent(Astro.url.pathname)}`);
  }
  // The public whoami does NOT expose metadata_admin, so groups, admin status and prerequisites come from a re-fetch
  // of the FULL identity via the ADMIN API. FAIL-CLOSED: any lookup failure leaves no groups and not admin.
  try {
    identity = await getIdentity(session.identity.id);
  } catch (lookupErr) {
    console.error('[othala/apps] getIdentity failed; denying (no groups):', lookupErr);
  }
}

const entry = getTile(slug);
if (!entry) {
  return new Response('App not found', { status: 404 });
}

// Admin authority is the metadata_admin.admin marker (admin-API-only-writable boolean). Admins see every app's page;
// everyone else needs membership in one of the tile's bound access groups (userCanSeeTile reads the gate's binding).
const groups = parseIdentity(identity).groups;
const isAdmin = parseIdentity(identity).isAdmin;
if (!(isAdmin || userCanSeeTile(entry, groups))) {
  return Astro.redirect('/auth/error?reason=not-authorised');
}

const meta = identity?.metadata_admin;
const requirements = requirementsFor(entry, loadRequirements());
const readiness = tileReadiness(entry, meta?.prerequisites ?? []);
const guide = splitGuide(entry.educationHtml);
---
<Layout title={entry.name} description={entry.description}>
  <Fragment slot="header-actions">
    <HeaderActions identityId={identity?.id} isAdmin={isAdmin} />
  </Fragment>
  <article class="app-detail">
    <a class="back-link" href="/">← Home</a>
    <header class="app-header">
      <div class="app-heading">
        <AppIcon tile={entry} groups={groups} size="lg" />
        <div class="app-header-text">
          <h1 class="app-title">{entry.name}</h1>
          <p class="app-lede">{entry.description}</p>
        </div>
      </div>
      {requirements.length > 0 && (
        <div class="app-prereqs">
          {requirements.map((r) => <PrereqCard requirement={r} ready={readiness === 'ready'} />)}
        </div>
      )}
      <AppActions name={entry.name} href={safeHref(entry.url)} requirements={requirements} ready={readiness === 'ready'} />
    </header>

    <section class="app-body" aria-label={`Guide for ${entry.name}`}>
      <GuideSections guide={guide} topic={entry.name} />
      <CopyChips />
    </section>
  </article>
</Layout>

<style>
  .app-detail {
    max-width: 41.25rem;
    margin: 0 auto;
    padding-bottom: var(--space-7);
  }
  .app-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border);
  }
  .app-heading { display: flex; gap: var(--space-4); align-items: flex-start; }
  .app-header-text { min-width: 0; }
  .app-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-2);
  }
  .app-lede {
    font-size: var(--text-base);
    color: var(--text-2);
    line-height: 1.5;
        margin: 0;
  }
  .app-prereqs {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .app-prereqs :global(.prereq:last-child) { border-bottom: 0; }
  .app-body { padding: var(--space-5) 0; }
  @media (max-width: 640px) {
    .app-title { font-size: var(--text-2xl); }
  }
</style>
