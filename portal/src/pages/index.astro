---
// Session-gated tile dashboard. State A (down): Kratos unreachable, holding panel. State B (pre-auth): hero and Sign In
// CTA. State C (post-auth): greeting and the tiles userCanSeeTile admits against `metadata_admin.groups` (the Admin
// shortcut reads the `metadata_admin.admin` marker instead; see `isAdmin`). Tiles come from the manifests in
// MANIFEST_DIR (lib/tiles.ts). In `astro dev`, `?dev-state=` forces a state without Kratos.

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TileCard from '../components/TileCard.astro';
import AppBadges from '../components/AppBadges.astro';
import PrereqCard from '../components/PrereqCard.astro';
import AppActions from '../components/AppActions.astro';
import GuideSections from '../components/GuideSections.astro';
import CopyChips from '../components/CopyChips.astro';
import {
  loadTiles,
  loadGroups,
  loadRequirements,
  requirementsFor,
  splitGuide,
  tileReadiness,
  safeHref,
  userCanSeeTile,
  type AppTile,
} from '../lib/tiles';
import { devMockIdentity } from '../lib/dev-mock';
import { getSession, isReachable } from '../lib/kratos';
import { getIdentity } from '../lib/admin-api';
import { identityGroups } from '../lib/gate';
import { isAdminMarker } from '../lib/admin-auth';
import HeaderActions from '../components/HeaderActions.astro';
import type { Identity } from '../lib/types';
import { siteName, adminContact } from '../lib/config';

type State = 'down' | 'pre-auth' | 'post-auth';

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const isDev = import.meta.env.DEV;
const devOverride = isDev ? Astro.url.searchParams.get('dev-state') : null;

let state: State = 'pre-auth';
let identity: Identity | null = null;
let downReason = 'Kratos /health/alive unreachable; retrying.';

if (devOverride === 'down' || devOverride === 'pre-auth' || devOverride === 'post-auth') {
  state = devOverride;
  // Mock person for the dev post-auth view; see lib/dev-mock.ts for the group and prerequisite query params.
  if (state === 'post-auth') identity = devMockIdentity(Astro.url);
} else {
  try {
    const session = await getSession(cookie);
    if (session?.active && session.identity) {
      state = 'post-auth';
      // The public whoami omits metadata_admin, so re-fetch the full identity via the admin API for groups; on
      // failure fall back to the whoami identity (no groups, no tiles), never fail-open.
      try {
        identity = await getIdentity(session.identity.id);
      } catch (lookupErr) {
        console.error('[othala/index] getIdentity failed; falling back to whoami (no groups):', lookupErr);
        identity = session.identity;
      }
    }
  } catch (err) {
    const ok = await isReachable();
    state = ok ? 'pre-auth' : 'down';
    if (!ok) console.error('[othala/index] Kratos unreachable:', err);
  }
}

// Enabled tiles from MANIFEST_DIR, sorted by order then name.
const orderedApps = loadTiles();

// Optional groups.yaml registry; an empty Map when absent.
const groupRegistry = loadGroups();

// First-run passkey nudge: getIdentity's includeCredential list already carries `credentials.passkey`; the dismiss
// is remembered per browser in localStorage (inline script below).
const hasPasskeyEnrolled = Boolean(identity?.credentials?.passkey);

const groups = identityGroups(identity);
// Visibility reads the same access binding (accessGroups, OR) as the OIDC entry gate, so a tile shows iff the gate admits.
const visibleTiles =
  state === 'post-auth'
    ? orderedApps.filter((a: AppTile) => userCanSeeTile(a, groups))
    : [];

// Per-tile presentation for this person: prerequisite state (the admin's marks), requirement definitions, the guide
// outline.
const requirementSet = loadRequirements();
const markedPrerequisites = identity?.metadata_admin?.prerequisites ?? [];
const views = new Map(
  visibleTiles.map((t: AppTile) => {
    const requirements = requirementsFor(t, requirementSet);
    return [
      t.slug,
      {
        requirements,
        readiness: tileReadiness(t, markedPrerequisites),
        titles: requirements.map((r) => r.title),
        guide: splitGuide(t.educationHtml),
      },
    ] as const;
  }),
);

// Split visibleTiles into ungrouped and grouped sections, ordered by groups.yaml `order`, else min tile order.
const ungroupedTiles = visibleTiles.filter((t: AppTile) => !t.group);
const groupedTilesMap = new Map<string, AppTile[]>();
for (const tile of visibleTiles.filter((t: AppTile) => !!t.group)) {
  const g = tile.group as string;
  if (!groupedTilesMap.has(g)) groupedTilesMap.set(g, []);
  groupedTilesMap.get(g)!.push(tile);
}
// Group boxes: registry order, else min tile order.
const tileGroups = Array.from(groupedTilesMap.entries())
  .sort(([nameA, tilesA], [nameB, tilesB]) => {
    const orderA = groupRegistry.get(nameA)?.order ?? Math.min(...tilesA.map((t) => t.order));
    const orderB = groupRegistry.get(nameB)?.order ?? Math.min(...tilesB.map((t) => t.order));
    return orderA - orderB;
  })
  .map(([groupName, tiles]) => ({
    groupName,
    tiles,
    meta: groupRegistry.get(groupName),
  }));
// Admin link: the metadata_admin.admin marker of the admin-API identity; /admin itself is gated by
// requireAdminSession. isAdminMarker is false on any error or missing marker, which is fine for cosmetic chrome.
const isAdmin = state === 'post-auth' && isAdminMarker(identity);

const displayName = identity?.traits.displayName || identity?.traits.username || '';
const firstName = displayName.split(' ')[0] || displayName;

// Dev preview: every browser-flow URL the portal hands to Kratos.
const devLinks = [
  { href: '/?dev-state=down',      label: 'State A: down (substrate offline)' },
  { href: '/?dev-state=pre-auth',  label: 'State B: pre-auth (sign in)' },
  { href: '/?dev-state=post-auth', label: 'State C: post-auth (mocked identity)' },
  { href: '/auth/login',           label: 'Login flow' },
  { href: '/auth/settings',        label: 'Settings flow' },
  { href: '/auth/recovery',        label: 'Recovery flow' },
  { href: '/auth/verification',    label: 'Verification flow' },
  { href: '/auth/logout',          label: 'Logout' },
  { href: '/admin',                label: 'Admin (requires AAL2)' },
];
---
<Layout title="Home" description={`Single sign-on for ${siteName}.`} compact={state === 'post-auth'}>

  {state === 'post-auth' && (
    <Fragment slot="header-actions">
      <HeaderActions identityId={identity?.id} isAdmin={isAdmin} />
    </Fragment>
  )}

  {state === 'down' && (
    <PageHero
      title="Auth services starting up"
      lede={`The substrate is offline or unreachable. This page will pick the session back up as soon as it returns. If it persists, contact ${adminContact}.`}
    >
      <p class="holding-tech">{downReason}</p>
    </PageHero>
  )}

  {state === 'pre-auth' && (
    <>
      <PageHero title="Welcome" lede={`Single sign-on for ${siteName}. One sign-in, every app.`}>
        <div class="cta-row">
          <a href="/auth/login" class="button button-primary">Sign in</a>
          <a href="/auth/recovery" class="button button-secondary">Recover access</a>
          <span class="cta-note mono">passkey or password</span>
        </div>
      </PageHero>

      <section class="section">
        <p class="section-subtitle">What's behind this door</p>
        <p class="section-prose">
          A small set of self-hosted services. Photos,
          films, music, books, recipes, files. A handful of tools for
          the people who run the place. Each app respects the same
          identity, so signing in once is enough.
        </p>
        <p class="section-prose">
          If you don't have an account yet, ask whoever invited you.
        </p>
      </section>
    </>
  )}

  {state === 'post-auth' && (
    <>
      <h1 class="greeting">{firstName ? `Hello, ${firstName}.` : 'Welcome back.'} <span class="greeting-sub">Pick an app to open it, or its Guide for setup.</span></h1>

      {!hasPasskeyEnrolled && (
        <div class="passkey-nudge" id="passkey-nudge">
          <p class="passkey-nudge-text">
            Set up a passkey for one-tap sign-in.
            <a href="/auth/settings" class="passkey-nudge-link">Set up now →</a>
          </p>
          <button
            type="button"
            class="passkey-nudge-close mono"
            data-dismiss-passkey-nudge
            aria-label="Dismiss"
          >✕</button>
        </div>
      )}

      <section class="home-apps">
        {visibleTiles.length > 0 ? (
          <>
            {ungroupedTiles.length > 0 && (
              <div class="tile-grid">
                {ungroupedTiles.map((t: AppTile) => {
                  const v = views.get(t.slug)!;
                  return <TileCard tile={t} readiness={v.readiness} requirementTitles={v.titles} />;
                })}
              </div>
            )}
            {tileGroups.map(({ groupName, tiles, meta }) => (
              <div class="tile-group">
                <div class="tile-group-header">
                  <p class="tile-group-title">{meta?.title ?? groupName}</p>
                  {(meta?.description) && (
                    <p class="tile-group-desc">{meta.description}</p>
                  )}
                </div>
                <div class="tile-grid" data-count={tiles.length}>
                  {tiles.map((t: AppTile) => {
                    const v = views.get(t.slug)!;
                    return <TileCard tile={t} readiness={v.readiness} requirementTitles={v.titles} />;
                  })}
                </div>
              </div>
            ))}
          </>
        ) : (
          <p class="section-prose">
            Your account doesn't have any app access yet. Contact {adminContact} to
            enable one.
          </p>
        )}
        <p class="missing-app"><button type="button" class="text-link" id="open-request-form">Missing an app?</button></p>
      </section>

      {/* ── Per-app documentation: one hidden <template> per visible tile, three slots. The dialog script clones
          them into the header (actions), the prerequisite strip and the scrolling guide body. */}
      {visibleTiles.map((t: AppTile) => {
        const v = views.get(t.slug)!;
        return (
          <template
            data-app-edu={t.slug}
            data-app-name={t.name}
            data-app-desc={t.description}
            data-app-icon={t.iconHref ?? ''}
            data-app-bleed={t.iconBleed ? '' : undefined}
            data-app-mono={t.icon}
          >
            <div data-slot="actions">
              <AppActions name={t.name} href={safeHref(t.url)} requirements={v.requirements} ready={v.readiness === 'ready'} />
            </div>
            <div data-slot="prereq">
              {v.requirements.map((r) => (
                <PrereqCard requirement={r} ready={v.readiness === 'ready'} />
              ))}
            </div>
            <div data-slot="body">
              <GuideSections guide={v.guide} />
              <p class="app-modal-more mono"><a href={`/apps/${encodeURIComponent(t.slug)}`}>Open as a page →</a></p>
            </div>
          </template>
        );
      })}

      {/* ── App guide dialog: native <dialog>, so the page behind is inert, Tab stays inside, and Esc closes. Filled at
          open time from the hidden <template data-app-edu> elements above. */}
      <dialog class="app-modal" id="app-modal" aria-labelledby="app-modal-title">
        <div class="app-modal-inner">
          <button class="app-modal-close" type="button" data-close-app-modal aria-label="Close guide">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9m0-9l-9 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
          <header class="app-modal-header">
            <span class="app-modal-icon" data-slot-icon></span>
            <div class="app-modal-header-text">
              <h2 class="app-modal-title" id="app-modal-title"></h2>
              <p class="app-modal-desc"></p>
            </div>
          </header>
          <div class="app-modal-prereq" data-slot-prereq></div>
          <div class="app-modal-actions" data-slot-actions></div>
          <div class="app-modal-body" data-slot-body tabindex="0" role="region" aria-label="Guide"></div>
        </div>
      </dialog>
      <CopyChips />

      {/* ── Request / contact form dialog ─────────────────────────────────
          FUNCTIONAL: the submit POSTs to /api/request, which validates,
          rate-limits, and delivers via the shared courier SMTP. */}
      <dialog class="request-modal" id="request-modal" aria-labelledby="request-modal-title">
        <div class="request-modal-inner">
          <header class="request-modal-header">
            <div>
              <h2 class="request-modal-title" id="request-modal-title">Get in touch</h2>
              <p class="request-modal-desc">Request access, suggest a new app, or report a problem.</p>
            </div>
            <button class="request-modal-close mono" type="button" data-close-request aria-label="Close">✕</button>
          </header>

          <div class="request-modal-body">
            <form class="request-form" id="request-form" method="post" action="/api/request" novalidate>
              <label class="form-field">
                <span class="form-label">Your name</span>
                <input class="form-input" type="text" name="name" autocomplete="name" maxlength="80" required placeholder="e.g. Robin" />
              </label>

              <label class="form-field">
                <span class="form-label">Request type</span>
                <select class="form-select" name="type" required>
                  <option value="">— choose one —</option>
                  <option value="access">Access to an app</option>
                  <option value="new">New app idea</option>
                  <option value="problem">Problem / something broken</option>
                  <option value="other">Other</option>
                </select>
              </label>

              <label class="form-field">
                <span class="form-label">Message</span>
                <textarea class="form-textarea" name="message" rows="5" maxlength="4000" required placeholder="What do you need?"></textarea>
              </label>

              <p class="form-error mono" id="request-error" role="alert" hidden></p>

              <div class="form-actions">
                <button class="button button-primary" type="submit" id="request-submit">Send request</button>
              </div>
            </form>

            <div class="request-thanks" id="request-thanks" hidden>
              <p class="request-thanks-msg">Thanks — your request is on its way to {adminContact}.</p>
              <p class="mono request-thanks-note">You can close this window.</p>
            </div>
          </div>
        </div>
      </dialog>
    </>
  )}

  {isDev && state === 'down' && (
    <section class="dev-preview">
      <p class="section-subtitle">Dev preview · auth flows</p>
      <p class="section-prose">
        Kratos isn't reachable from <code>npm run dev</code>. These links
        exist so the layout work isn't gated on the substrate. Real flows
        will redirect to Kratos in production.
      </p>
      <ul class="dev-list">
        {devLinks.map((l) => (
          <li><a class="dev-link mono" href={l.href}>{l.href}</a><span class="dev-link-meta">{l.label}</span></li>
        ))}
      </ul>
    </section>
  )}

</Layout>

<script is:inline>
  // Request/contact form: a plain <form> that this handler upgrades to a fetch POST against /api/request with inline states.
  (function () {
    var modal = document.getElementById('request-modal');
    var openBtn = document.getElementById('open-request-form');
    var form = document.getElementById('request-form');
    var thanks = document.getElementById('request-thanks');
    var errorEl = document.getElementById('request-error');
    var submitBtn = document.getElementById('request-submit');
    if (!modal || !openBtn || !form) return;

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    openBtn.addEventListener('click', function () {
      clearError();
      if (typeof modal.showModal === 'function') modal.showModal();
    });

    modal.querySelectorAll('[data-close-request]').forEach(function (btn) {
      btn.addEventListener('click', function () { modal.close(); });
    });
    // Backdrop click closes.
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearError();
      if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

      fetch('/api/request', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            return { ok: res.ok, status: res.status, data: data };
          });
        })
        .then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            form.hidden = true;
            if (thanks) thanks.hidden = false;
          } else {
            showError((r.data && r.data.error) || 'Something went wrong. Please try again.');
          }
        })
        .catch(function () {
          showError('Network error — please check your connection and try again.');
        })
        .finally(function () {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send request'; }
        });
    });

    // Reset to the form view when the dialog is fully closed, ready for re-open.
    modal.addEventListener('close', function () {
      setTimeout(function () {
        form.hidden = false;
        if (thanks) thanks.hidden = true;
        clearError();
        form.reset();
      }, 200);
    });
  })();

  // App guide dialog: [data-app-learn] buttons fill it from the hidden <template data-app-edu>. The native <dialog> makes
  // the page behind inert and keeps Tab inside; this script adds the fill, focus return and scroll reset.
  (function () {
    var appModal = document.getElementById('app-modal');
    if (!appModal) return;

    var titleEl = appModal.querySelector('.app-modal-title');
    var descEl = appModal.querySelector('.app-modal-desc');
    var iconEl = appModal.querySelector('[data-slot-icon]');
    var prereqEl = appModal.querySelector('[data-slot-prereq]');
    var actionsEl = appModal.querySelector('[data-slot-actions]');
    var bodyEl = appModal.querySelector('[data-slot-body]');
    var innerEl = appModal.querySelector('.app-modal-inner');
    var opener = null;

    function slot(tpl, name) {
      var el = tpl.content.querySelector('[data-slot="' + name + '"]');
      return el ? el.cloneNode(true) : null;
    }
    function fill(target, node) {
      target.replaceChildren();
      if (node) while (node.firstChild) target.appendChild(node.firstChild);
    }
    function logo(tpl) {
      var span = document.createElement('span');
      span.className = 'app-modal-logo';
      var href = tpl.dataset.appIcon;
      if (href) {
        var img = document.createElement('img');
        img.src = href;
        img.alt = '';
        span.appendChild(img);
        span.dataset.icon = href.split('/').pop().replace(/\.svg$/, '');
        if (tpl.hasAttribute('data-app-bleed')) span.dataset.bleed = '';
      } else {
        span.textContent = tpl.dataset.appMono || '';
        span.classList.add('app-modal-logo-mono');
      }
      return span;
    }

    function openAppModal(slug, from) {
      var tpl = document.querySelector('template[data-app-edu="' + slug + '"]');
      if (!tpl || typeof appModal.showModal !== 'function') return;
      opener = from || null;
      titleEl.textContent = tpl.dataset.appName || slug;
      descEl.textContent = tpl.dataset.appDesc || '';
      iconEl.replaceChildren(logo(tpl));
      fill(actionsEl, slot(tpl, 'actions'));
      fill(prereqEl, slot(tpl, 'prereq'));
      fill(bodyEl, slot(tpl, 'body'));
      prereqEl.hidden = !prereqEl.firstChild;
      appModal.showModal();
      // Scroll positions only take once the dialog is displayed: the body (desktop) and the whole sheet (phone).
      bodyEl.scrollTop = 0;
      innerEl.scrollTop = 0;
    }

    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('[data-app-learn]') : null;
      if (!btn) return;
      openAppModal(btn.dataset.appLearn, btn);
    });

    appModal.querySelectorAll('[data-close-app-modal]').forEach(function (btn) {
      btn.addEventListener('click', function () { appModal.close(); });
    });

    // Backdrop click closes (the click lands on the <dialog> element itself).
    appModal.addEventListener('click', function (e) {
      if (e.target === appModal) appModal.close();
    });

    // Return focus to the Guide button that opened it, then clear the content once the close settles.
    appModal.addEventListener('close', function () {
      if (opener && typeof opener.focus === 'function') opener.focus();
      opener = null;
      setTimeout(function () {
        if (appModal.open) return;
        titleEl.textContent = '';
        descEl.textContent = '';
        iconEl.replaceChildren();
        prereqEl.replaceChildren();
        actionsEl.replaceChildren();
        bodyEl.replaceChildren();
      }, 200);
    });
  })();

  // First-run passkey nudge: dismiss is remembered per browser; the banner stops rendering once a passkey is enrolled.
  (function () {
    var KEY = 'othala-passkey-nudge-dismissed';
    var nudge = document.getElementById('passkey-nudge');
    if (!nudge) return;

    try {
      if (localStorage.getItem(KEY) === '1') {
        nudge.remove();
        return;
      }
    } catch (e) {
      // localStorage unavailable (private mode etc.) — leave the banner
      // showing every visit rather than failing closed on the nudge.
    }

    var closeBtn = nudge.querySelector('[data-dismiss-passkey-nudge]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        nudge.remove();
      });
    }
  })();
</script>

<style>
  /* ── State A: down — technical detail line ── */
  .holding-tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    margin-top: var(--space-3);
  }

  /* First-run passkey nudge: dismissible banner between hero and tile grid, in the accent-subtle surface. */
  .passkey-nudge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border: 1px solid var(--accent);
    background: var(--accent-subtle);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-4);
  }
  .passkey-nudge-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .passkey-nudge-link {
    margin-left: var(--space-2);
    font-weight: 600;
    white-space: nowrap;
  }
  .passkey-nudge-close {
    all: unset;
    cursor: pointer;
    flex-shrink: 0;
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    line-height: 1;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .passkey-nudge-close:hover { color: var(--text); }
  .passkey-nudge-close:focus-visible {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: 2px;
  }

  /* Signed-in home: a one-line greeting, then the apps. */
  .greeting {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 var(--space-4);
  }
  .greeting-sub { font-weight: 400; color: var(--text-2); font-size: var(--text-sm); margin-left: var(--space-2); }
  @media (max-width: 640px) { .greeting-sub { display: none; } .greeting { margin-bottom: var(--space-3); } }
  .missing-app { margin: var(--space-6) 0 0; }
  .text-link {
    all: unset;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .text-link:hover { color: var(--accent); }
  .text-link:focus-visible { outline: 2px solid var(--input-focus, var(--accent)); outline-offset: 3px; }

  /* ── Hero CTA fragments ── */
  /* The sign-out form lays its button out as a sibling of the other CTAs. */
  .cta-form { display: contents; }
  .cta-note {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cta-link {
    color: var(--text-muted);
    font-size: var(--text-xs);
