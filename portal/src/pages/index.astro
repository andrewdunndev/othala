---
// Othala portal — session-gated tile dashboard.
//
// v0.2.0 architecture (Topology B + runtime unified-manifest tiles):
//
// State A (down):     Kratos unreachable. Holding panel: mark + short
//                     message + thin technical line. Reads as "auth
//                     services starting up", not 404.
// State B (pre-auth): Kratos reachable, no session. Hero with mark +
//                     welcome lede + Sign In CTA. Below: a thin section
//                     explaining what's behind the door.
// State C (post-auth): active session. Hero with greeting + section
//                     "your apps" — the tile launcher reads the tiles
//                     via loadTiles (tiles.ts) and filters to entries
//                     whose `accessGroup` the user's
//                     `metadata_admin.groups` contains. Admin shortcut
//                     when the user is in the admin group.
//
// Apps registry = unified per-app manifests read at request time from
// MANIFEST_DIR (see lib/tiles.ts + lib/manifests.ts). Each `<slug>.yaml`
// carries a `presentation:` block (name, description, url, icon,
// access_group, auth_kind, disabled, order); an optional sibling
// `<slug>.md` is the per-app detail-page content at /apps/<slug>. There
// is no build-time content collection, so adding or removing an app is a
// manifest-dir change with no portal image rebuild.
//
// Dev preview: when running `astro dev`, State A also surfaces a small
// panel of every auth flow link. `?dev-state=` lets the developer force
// a state without running Kratos.

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import markSvg from '@dunn.dev/reference/mark/mark.svg?raw';
import { loadTiles, type AppTile } from '../lib/tiles';
import { getSession, isReachable } from '../lib/kratos';
import { isAdminSubject } from '../lib/admin-auth';
import type { Identity } from '../lib/types';
import { siteName, adminContact } from '../lib/config';

type State = 'down' | 'pre-auth' | 'post-auth';

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const isDev = import.meta.env.DEV;
const devOverride = isDev ? Astro.url.searchParams.get('dev-state') : null;

let state: State = 'pre-auth';
let identity: Identity | null = null;
let downReason = 'Kratos /health/alive unreachable; retrying.';

if (devOverride === 'down' || devOverride === 'pre-auth' || devOverride === 'post-auth') {
  state = devOverride;
  if (state === 'post-auth') {
    // Plausible mocked identity so the post-auth view renders something
    // realistic in dev without a Kratos session. Groups match the shipped
    // example manifests (e2e/manifests/) so the dev preview renders tiles
    // out of the box for any adopter — replace these with your own groups.
    identity = {
      id: 'dev-mock',
      traits: { username: 'dev.user', email: 'dev@example.local', displayName: 'Dev User' },
      metadata_admin: {
        groups: [
          'admin', 'family',
          'access-grafana', 'access-audiobookshelf', 'access-jellyfin',
          'access-proxywatch', 'access-statuspage',
        ],
      },
    } as unknown as Identity;
  }
} else {
  try {
    const session = await getSession(cookie);
    if (session?.active && session.identity) {
      state = 'post-auth';
      identity = session.identity;
    }
  } catch (err) {
    const ok = await isReachable();
    state = ok ? 'pre-auth' : 'down';
    if (!ok && err instanceof Error) downReason = err.message;
  }
}

// Apps registry — read at REQUEST time from the unified manifest dir
// (MANIFEST_DIR), the same source the OIDC client loader reads.
// loadTiles() returns enabled tiles sorted by order then name.
const orderedApps = loadTiles();

const groups = identity?.metadata_admin?.groups ?? [];
const visibleTiles =
  state === 'post-auth'
    ? orderedApps.filter((a: AppTile) => groups.includes(a.accessGroup))
    : [];
// B2: the Admin nav affordance follows the OTHALA_ADMIN_SUBJECTS allowlist,
// not the (display-only) `admin` group. The /admin route itself is gated by
// requireAdminSession, also via the allowlist; this just keeps the link
// truthful so a non-admin isn't shown a tile that bounces.
const isAdmin = state === 'post-auth' && isAdminSubject(identity?.traits?.email);
const displayName = identity?.traits.displayName || identity?.traits.username || '';
const firstName = displayName.split(' ')[0] || displayName;

// Dev preview: every browser-flow URL the portal hands to Kratos.
const devLinks = [
  { href: '/?dev-state=down',      label: 'State A: down (substrate offline)' },
  { href: '/?dev-state=pre-auth',  label: 'State B: pre-auth (sign in)' },
  { href: '/?dev-state=post-auth', label: 'State C: post-auth (mocked identity)' },
  { href: '/auth/login',           label: 'Login flow' },
  { href: '/auth/settings',        label: 'Settings flow' },
  { href: '/auth/recovery',        label: 'Recovery flow' },
  { href: '/auth/verification',    label: 'Verification flow' },
  { href: '/auth/logout',          label: 'Logout' },
  { href: '/admin',                label: 'Admin (requires AAL2)' },
];
---
<Layout title="Home" description={`Single sign-on for ${siteName}.`}>

  {state === 'down' && (
    <section class="holding">
      <span class="holding-mark" set:html={markSvg} />
      <p class="holding-eyebrow">{siteName}</p>
      <h1 class="holding-title">Auth services starting up</h1>
      <p class="holding-prose">
        The substrate is offline or unreachable. This page will pick the
        session back up as soon as it returns. If it persists, contact {adminContact}.
      </p>
      <p class="holding-tech">{downReason}</p>
    </section>
  )}

  {state === 'pre-auth' && (
    <>
      <section class="hero">
        <span class="hero-mark" set:html={markSvg} />
        <div>
          <p class="hero-eyebrow">{siteName}</p>
          <p class="rune-greeting" aria-label="door to home">
            <span class="rune">ᛞ</span>
            <span class="rune-arrow" aria-hidden="true">→</span>
            <span class="rune">ᛟ</span>
            <span class="rune-gloss">door to home</span>
          </p>
          <h1 class="hero-title">Welcome back</h1>
          <p class="hero-lede">
            Single sign-on for {siteName}. One sign-in, every app.
          </p>
          <div class="cta-row">
            <a href="/auth/login" class="button button-primary">Sign in</a>
            <span class="cta-note mono">passkey or password</span>
          </div>
        </div>
      </section>

      <section class="section">
        <p class="section-subtitle">What's behind this door</p>
        <p class="section-prose">
          A small set of self-hosted services. Photos,
          films, music, books, recipes, files. A handful of tools for
          the people who run the place. Each app respects the same
          identity, so signing in once is enough.
        </p>
        <p class="section-prose">
          If you don't have an account yet, ask whoever invited you.
          Forgot your password? <a href="/auth/recovery">Recover access</a>.
        </p>
      </section>
    </>
  )}

  {state === 'post-auth' && (
    <>
      <section class="hero">
        <span class="hero-mark" set:html={markSvg} />
        <div>
          <p class="hero-eyebrow">signed in {displayName && (<><span class="hero-eyebrow-sep">·</span><span>{displayName}</span></>)}</p>
          <h1 class="hero-title">{firstName ? `Hello, ${firstName}.` : 'Welcome back.'}</h1>
          <p class="hero-lede">
            Pick up where you left off, or hop into one of the apps below.
          </p>
          <div class="cta-row">
            <button type="button" class="button button-primary" id="open-request-form">
              Request access or suggest an app
            </button>
            {isAdmin && <a href="/admin" class="button button-secondary">Admin</a>}
            <a href="/auth/settings" class="button button-secondary">Account</a>
            <a href="/auth/logout" class="cta-link mono">Sign out</a>
          </div>
        </div>
      </section>

      <section class="section">
        <p class="section-subtitle">Your apps</p>
        {visibleTiles.length > 0 ? (
          <div class="tile-grid">
            {visibleTiles.map((t: AppTile) => (
              <a class="tile" href={t.url}>
                <div class="tile-icon mono">{t.icon}</div>
                <div class="tile-name">{t.name}</div>
                <div class="tile-desc">{t.description}</div>
                <a class="tile-learn mono" href={`/apps/${t.slug}`}>learn more →</a>
              </a>
            ))}
          </div>
        ) : (
          <p class="section-prose">
            Your account doesn't have any app access yet. Contact {adminContact} to
            enable one.
          </p>
        )}
      </section>

      {/* ── Request / contact form dialog ─────────────────────────────────
          FUNCTIONAL: the submit POSTs to /api/request, which validates,
          rate-limits, and delivers via the shared courier SMTP. */}
      <dialog class="request-modal" id="request-modal" aria-labelledby="request-modal-title">
        <div class="request-modal-inner">
          <header class="request-modal-header">
            <div>
              <h2 class="request-modal-title" id="request-modal-title">Get in touch</h2>
              <p class="request-modal-desc">Request access, suggest a new app, or report a problem.</p>
            </div>
            <button class="request-modal-close mono" type="button" data-close-request aria-label="Close">✕</button>
          </header>

          <div class="request-modal-body">
            <form class="request-form" id="request-form" method="post" action="/api/request" novalidate>
              <label class="form-field">
                <span class="form-label">Your name</span>
                <input class="form-input" type="text" name="name" autocomplete="name" maxlength="80" required placeholder="e.g. Ashley" />
              </label>

              <label class="form-field">
                <span class="form-label">Request type</span>
                <select class="form-select" name="type" required>
                  <option value="">— choose one —</option>
                  <option value="access">Access to an app</option>
                  <option value="new">New app idea</option>
                  <option value="problem">Problem / something broken</option>
                  <option value="other">Other</option>
                </select>
              </label>

              <label class="form-field">
                <span class="form-label">Message</span>
                <textarea class="form-textarea" name="message" rows="5" maxlength="4000" required placeholder="What do you need?"></textarea>
              </label>

              <p class="form-error mono" id="request-error" role="alert" hidden></p>

              <div class="form-actions">
                <button class="button button-primary" type="submit" id="request-submit">Send request</button>
              </div>
            </form>

            <div class="request-thanks" id="request-thanks" hidden>
              <p class="request-thanks-msg">Thanks — your request is on its way to {adminContact}.</p>
              <p class="mono request-thanks-note">You can close this window.</p>
            </div>
          </div>
        </div>
      </dialog>
    </>
  )}

  {isDev && state === 'down' && (
    <section class="dev-preview">
      <p class="section-subtitle">Dev preview · auth flows</p>
      <p class="section-prose">
        Kratos isn't reachable from <code>npm run dev</code>. These links
        exist so the layout work isn't gated on the substrate. Real flows
        will redirect to Kratos in production.
      </p>
      <ul class="dev-list">
        {devLinks.map((l) => (
          <li><a class="dev-link mono" href={l.href}>{l.href}</a><span class="dev-link-meta">{l.label}</span></li>
        ))}
      </ul>
    </section>
  )}

</Layout>

<script is:inline>
  // ── Request / contact form (post-auth dashboard) ──────────────────────
  // Progressive enhancement: the <form> has a real method/action so it works
  // without JS; this handler intercepts to POST via fetch and render inline
  // success / error states against the live /api/request endpoint.
  (function () {
    var modal = document.getElementById('request-modal');
    var openBtn = document.getElementById('open-request-form');
    var form = document.getElementById('request-form');
    var thanks = document.getElementById('request-thanks');
    var errorEl = document.getElementById('request-error');
    var submitBtn = document.getElementById('request-submit');
    if (!modal || !openBtn || !form) return;

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    openBtn.addEventListener('click', function () {
      clearError();
      if (typeof modal.showModal === 'function') modal.showModal();
    });

    modal.querySelectorAll('[data-close-request]').forEach(function (btn) {
      btn.addEventListener('click', function () { modal.close(); });
    });
    // Backdrop click closes.
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearError();
      if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

      fetch('/api/request', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            return { ok: res.ok, status: res.status, data: data };
          });
        })
        .then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            form.hidden = true;
            if (thanks) thanks.hidden = false;
          } else {
            showError((r.data && r.data.error) || 'Something went wrong. Please try again.');
          }
        })
        .catch(function () {
          showError('Network error — please check your connection and try again.');
        })
        .finally(function () {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send request'; }
        });
    });

    // Reset to the form view when the dialog is fully closed, ready for re-open.
    modal.addEventListener('close', function () {
      setTimeout(function () {
        form.hidden = false;
        if (thanks) thanks.hidden = true;
        clearError();
        form.reset();
      }, 200);
    });
  })();
</script>

<style>
  /* ── State A: holding panel ──
   * Centered, contained, restrained. Mirrors the hero rhythm but
   * collapses to a single column so the eye lands on the message. */
  .holding {
    max-width: 36rem;
    margin: var(--space-7) auto 0;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: left;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-2) var(--space-5);
    align-items: start;
  }
  .holding-mark {
    grid-row: span 4;
    color: var(--accent);
    width: 64px;
    height: 64px;
  }
  .holding-mark :global(svg) { width: 100%; height: 100%; }
  .holding-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .holding-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    line-height: var(--lh-tight);
  }
  .holding-prose {
    font-size: var(--text-base);
    color: var(--text-2);
    line-height: 1.6;
  }
  .holding-tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  /* ── Hero CTA fragments ── */
  .cta-note {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cta-link {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-left: auto;
  }
  .cta-link:hover { color: var(--accent); text-decoration: none; }
  .hero-eyebrow-sep {
    margin: 0 0.4em;
    color: var(--border);
  }

  /* ── ᛞ→ᛟ greeting (dagaz → othala: door to home) ──
   * The motif the brand is named for. Glyph strokes in --text. */
  .rune-greeting {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-3) 0;
  }
  .rune-greeting .rune {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text);
    line-height: 1;
  }
  .rune-greeting .rune-arrow {
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .rune-greeting .rune-gloss {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* ── Tile grid ──
   * Now richer: each tile carries an icon, name, short description, and
   * a "learn more" link to the per-app detail page rendering the MDX
   * education body. */
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 640px)  { .tile-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px)  { .tile-grid { grid-template-columns: repeat(3, 1fr); } }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .tile:hover {
    border-color: var(--accent);
    color: var(--text);
    text-decoration: none;
  }
  .tile-icon {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .tile-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text);
  }
  .tile-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.4;
  }
  .tile-learn {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: auto;
    align-self: flex-end;
  }
  .tile-learn:hover { color: var(--accent); text-decoration: none; }

  /* ── Dev preview ── */
  .dev-preview {
    margin-top: var(--space-7);
    padding: var(--space-5);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background: transparent;
  }
  .dev-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
  }
  .dev-list li {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .dev-list li:last-child { border-bottom: none; }
  .dev-link {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
  }
  .dev-link:hover { text-decoration: underline; }
  .dev-link-meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .holding { grid-template-columns: 48px 1fr; gap: var(--space-2) var(--space-4); padding: var(--space-5); }
    .holding-mark { width: 48px; height: 48px; }
    .dev-list li { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  /* ── Request / contact form modal ──
   * Adapted from the /preview prototype, trimmed to the post-auth dashboard.
   * Explicit centering — does not rely on inset:0 + margin:auto, which some
   * global dialog rules override. */
  .request-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    max-width: min(560px, 92vw);
    max-height: 85vh;
    width: 100%;
    overflow: auto;
    background: var(--bg, #ffffff);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: 0;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22);
  }
  .request-modal::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
  }
  .request-modal-inner { display: flex; flex-direction: column; }
  .request-modal-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3) var(--space-4);
    align-items: start;
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .request-modal-title {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    margin: 0 0 var(--space-1);
  }
  .request-modal-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.4;
    margin: 0;
  }
  .request-modal-close {
    all: unset;
    cursor: pointer;
    font-size: var(--text-base);
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    line-height: 1;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .request-modal-close:hover { color: var(--text); }
  .request-modal-close:focus-visible {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: 2px;
  }
  .request-modal-body { padding: var(--space-5) var(--space-6); }
  .request-form { display: flex; flex-direction: column; gap: var(--space-4); }
  .form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-label { font-size: var(--text-sm); font-weight: 600; color: var(--text); }
  .form-input,
  .form-select,
  .form-textarea {
    font-family: var(--font-sans, 'IBM Plex Sans', sans-serif);
    font-size: var(--text-base);
    color: var(--text);
    background: var(--bg, #ffffff);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .form-textarea { resize: vertical; }
  .form-error {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--danger, #b3261e);
  }
  .form-actions { display: flex; justify-content: flex-end; padding-top: var(--space-2); }
  .request-thanks { text-align: center; padding: var(--space-6) 0; }
  .request-thanks-msg {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .request-thanks-note { font-size: var(--text-xs); color: var(--text-muted); }
</style>
