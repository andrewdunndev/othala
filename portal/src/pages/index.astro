---
// Othala portal — session-gated tile dashboard.
//
// v0.2.0 architecture (Topology B + runtime unified-manifest tiles):
//
// State A (down):     Kratos unreachable. Holding panel: mark + short
//                     message + thin technical line. Reads as "auth
//                     services starting up", not 404.
// State B (pre-auth): Kratos reachable, no session. Hero with mark +
//                     welcome lede + Sign In CTA. Below: a thin section
//                     explaining what's behind the door.
// State C (post-auth): active session. Hero with greeting + section
//                     "your apps" — the tile launcher reads the tiles
//                     via loadTiles (tiles.ts) and filters to entries
//                     whose `accessGroup` the user's
//                     `metadata_admin.groups` contains. Admin shortcut
//                     when the user is in the admin group.
//
// Apps registry = unified per-app manifests read at request time from
// MANIFEST_DIR (see lib/tiles.ts + lib/manifests.ts). Each `<slug>.yaml`
// carries a `presentation:` block (name, description, url, icon,
// access_group, auth_kind, disabled, order); an optional sibling
// `<slug>.md` is the per-app detail-page content at /apps/<slug>. There
// is no build-time content collection, so adding or removing an app is a
// manifest-dir change with no portal image rebuild.
//
// Dev preview: when running `astro dev`, State A also surfaces a small
// panel of every auth flow link. `?dev-state=` lets the developer force
// a state without running Kratos.

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { loadTiles, loadGroups, safeHref, userCanSeeTile, type AppTile } from '../lib/tiles';
import { getSession, isReachable } from '../lib/kratos';
import { isAdminId } from '../lib/admin-auth';
import type { Identity } from '../lib/types';
import { siteName, adminContact } from '../lib/config';

type State = 'down' | 'pre-auth' | 'post-auth';

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const isDev = import.meta.env.DEV;
const devOverride = isDev ? Astro.url.searchParams.get('dev-state') : null;

let state: State = 'pre-auth';
let identity: Identity | null = null;
let downReason = 'Kratos /health/alive unreachable; retrying.';

if (devOverride === 'down' || devOverride === 'pre-auth' || devOverride === 'post-auth') {
  state = devOverride;
  if (state === 'post-auth') {
    // Plausible mocked identity so the post-auth view renders something
    // realistic in dev without a Kratos session. Groups match the shipped
    // e2e/manifests/ example set so any adopter gets tiles out of the box.
    //
    // Dev affordance: set OTHALA_DEV_MOCK_GROUPS=admin,family,access-foo
    // (comma-separated) to preview any catalog subset without editing code.
    const devGroupsEnv = process.env.OTHALA_DEV_MOCK_GROUPS;
    const mockGroups = devGroupsEnv
      ? devGroupsEnv.split(',').map((g) => g.trim()).filter(Boolean)
      : ['admin', 'family', 'everyone', 'access-grafana', 'access-audiobookshelf', 'access-jellyfin', 'access-proxywatch', 'access-gather-usenet', 'access-gather-torrent'];
    identity = {
      id: 'dev-mock',
      traits: { username: 'dev.user', email: 'dev@example.local', displayName: 'Dev User' },
      metadata_admin: { groups: mockGroups },
    } as unknown as Identity;
  }
} else {
  try {
    const session = await getSession(cookie);
    if (session?.active && session.identity) {
      state = 'post-auth';
      identity = session.identity;
    }
  } catch (err) {
    const ok = await isReachable();
    state = ok ? 'pre-auth' : 'down';
    if (!ok) console.error('[othala/index] Kratos unreachable:', err);
  }
}

// Apps registry — read at REQUEST time from the unified manifest dir
// (MANIFEST_DIR), the same source the OIDC client loader reads.
// loadTiles() returns enabled tiles sorted by order then name.
const orderedApps = loadTiles();

// Group registry — optional groups.yaml in MANIFEST_DIR.
// loadGroups() returns an empty Map when the file is absent.
const groupRegistry = loadGroups();

const groups = identity?.metadata_admin?.groups ?? [];
// access-model Phase 2: tile visibility reads the manifest's access binding
// (accessGroups, OR-semantics) via userCanSeeTile — the SAME field the OIDC
// entry gate uses, so the tile shows iff the gate would admit the user. Kills
// the prior tile-vs-gate dual source (docs/access-model.md §10).
const visibleTiles =
  state === 'post-auth'
    ? orderedApps.filter((a: AppTile) => userCanSeeTile(a, groups))
    : [];

// Partition visibleTiles into ungrouped (no group field) and grouped sections.
// Groups are ordered by: groups.yaml `order` (preferred) → min tile order
// within the group (fallback when a group has no registry entry).
const ungroupedTiles = visibleTiles.filter((t: AppTile) => !t.group);
const groupedTilesMap = new Map<string, AppTile[]>();
for (const tile of visibleTiles.filter((t: AppTile) => !!t.group)) {
  const g = tile.group as string;
  if (!groupedTilesMap.has(g)) groupedTilesMap.set(g, []);
  groupedTilesMap.get(g)!.push(tile);
}
// Sort group boxes: registry order < min-tile-order fallback.
const tileGroups = Array.from(groupedTilesMap.entries())
  .sort(([nameA, tilesA], [nameB, tilesB]) => {
    const orderA = groupRegistry.get(nameA)?.order ?? Math.min(...tilesA.map((t) => t.order));
    const orderB = groupRegistry.get(nameB)?.order ?? Math.min(...tilesB.map((t) => t.order));
    return orderA - orderB;
  })
  .map(([groupName, tiles]) => ({
    groupName,
    tiles,
    meta: groupRegistry.get(groupName),
  }));
// CVP-P1: the Admin nav affordance follows the OTHALA_ADMIN_IDS allowlist
// keyed on the immutable identity id, not the (display-only) `admin` group
// and not the user-editable email trait. The /admin route itself is gated by
// requireAdminSession, also via the ID allowlist; this just keeps the link
// truthful so a non-admin isn't shown a tile that bounces.
const isAdmin = state === 'post-auth' && isAdminId(identity?.id);
const displayName = identity?.traits.displayName || identity?.traits.username || '';
const firstName = displayName.split(' ')[0] || displayName;

// Dev preview: every browser-flow URL the portal hands to Kratos.
const devLinks = [
  { href: '/?dev-state=down',      label: 'State A: down (substrate offline)' },
  { href: '/?dev-state=pre-auth',  label: 'State B: pre-auth (sign in)' },
  { href: '/?dev-state=post-auth', label: 'State C: post-auth (mocked identity)' },
  { href: '/auth/login',           label: 'Login flow' },
  { href: '/auth/settings',        label: 'Settings flow' },
  { href: '/auth/recovery',        label: 'Recovery flow' },
  { href: '/auth/verification',    label: 'Verification flow' },
  { href: '/auth/logout',          label: 'Logout' },
  { href: '/admin',                label: 'Admin (requires AAL2)' },
];
---
<Layout title="Home" description={`Single sign-on for ${siteName}.`}>

  {state === 'down' && (
    <PageHero
      title="Auth services starting up"
      lede={`The substrate is offline or unreachable. This page will pick the session back up as soon as it returns. If it persists, contact ${adminContact}.`}
    >
      <p class="holding-tech">{downReason}</p>
    </PageHero>
  )}

  {state === 'pre-auth' && (
    <>
      <PageHero title="Welcome" lede={`Single sign-on for ${siteName}. One sign-in, every app.`}>
        <div class="cta-row">
          <a href="/auth/login" class="button button-primary">Sign in</a>
          <a href="/auth/recovery" class="button button-secondary">Recover access</a>
          <span class="cta-note mono">passkey or password</span>
        </div>
      </PageHero>

      <section class="section">
        <p class="section-subtitle">What's behind this door</p>
        <p class="section-prose">
          A small set of self-hosted services. Photos,
          films, music, books, recipes, files. A handful of tools for
          the people who run the place. Each app respects the same
          identity, so signing in once is enough.
        </p>
        <p class="section-prose">
          If you don't have an account yet, ask whoever invited you.
        </p>
      </section>
    </>
  )}

  {state === 'post-auth' && (
    <>
      <PageHero
        title={firstName ? `Hello, ${firstName}.` : 'Welcome back.'}
        eyebrow={`signed in${displayName ? ' · ' + displayName : ''}`}
        lede="Pick up where you left off, or hop into one of the apps below."
      >
        <div class="cta-row">
          <button type="button" class="button button-primary" id="open-request-form">
            Request access or suggest an app
          </button>
          {isAdmin && <a href="/admin" class="button button-secondary">Admin</a>}
          <a href="/auth/settings" class="button button-secondary">Account</a>
          <a href="/auth/logout" class="button button-secondary">Sign out</a>
        </div>
      </PageHero>

      <section class="section">
        <p class="section-subtitle">Your apps</p>
        {visibleTiles.length > 0 ? (
          <>
            {ungroupedTiles.length > 0 && (
              <div class="tile-grid">
                {ungroupedTiles.map((t: AppTile) => (
                  <article class="tile">
                    <a class="tile-launch" href={safeHref(t.url)}>
                      {t.iconHref ? (
                        <img class="tile-icon-img" src={t.iconHref} alt="" loading="lazy" />
                      ) : (
                        <div class="tile-icon mono">{t.icon}</div>
                      )}
                      <div class="tile-name">{t.name}</div>
                      <div class="tile-desc">{t.description}</div>
                    </a>
                    <button type="button" class="tile-learn mono" data-app-learn={t.slug}>learn more →</button>
                  </article>
                ))}
              </div>
            )}
            {tileGroups.map(({ groupName, tiles, meta }) => (
              <div class="tile-group">
                <div class="tile-group-header">
                  <p class="tile-group-title">{meta?.title ?? groupName}</p>
                  {(meta?.description) && (
                    <p class="tile-group-desc">{meta.description}</p>
                  )}
                </div>
                <div class="tile-grid">
                  {tiles.map((t: AppTile) => (
                    <article class="tile">
                      <a class="tile-launch" href={safeHref(t.url)}>
                        {t.iconHref ? (
                          <img class="tile-icon-img" src={t.iconHref} alt="" loading="lazy" />
                        ) : (
                          <div class="tile-icon mono">{t.icon}</div>
                        )}
                        <div class="tile-name">{t.name}</div>
                        <div class="tile-desc">{t.description}</div>
                      </a>
                      <button type="button" class="tile-learn mono" data-app-learn={t.slug}>learn more →</button>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </>
        ) : (
          <p class="section-prose">
            Your account doesn't have any app access yet. Contact {adminContact} to
            enable one.
          </p>
        )}
      </section>

      {/* ── Per-app education data: one hidden <template> per visible tile.
          The JS modal reads these to populate the app-modal at open time.
          educationHtml may contain inline SVG (cat-explainer diagrams). */}
      {visibleTiles.map((t: AppTile) => (
        <template
          data-app-edu={t.slug}
          data-app-name={t.name}
          data-app-url={safeHref(t.url)}
          data-app-desc={t.description}
        >
          <Fragment set:html={t.educationHtml ?? ''} />
        </template>
      ))}

      {/* ── App education modal ────────────────────────────────────────────
          Mirrors the request-modal structure: fixed, centered, backdrop,
          Esc + backdrop + × close. Populated at open time from the hidden
          <template data-app-edu> elements above. */}
      <dialog class="app-modal" id="app-modal" aria-labelledby="app-modal-title">
        <div class="app-modal-inner">
          <header class="app-modal-header">
            <div class="app-modal-header-text">
              <h2 class="app-modal-title" id="app-modal-title"></h2>
              <p class="app-modal-desc"></p>
            </div>
            <button class="app-modal-close mono" type="button" data-close-app-modal aria-label="Close">✕</button>
          </header>
          <div class="app-modal-cta">
            <a class="button button-primary app-modal-open-link" href="#" rel="noopener" target="_blank">Open ↗</a>
          </div>
          <div class="app-modal-body">
            <div class="edu-prose app-modal-content"></div>
          </div>
        </div>
      </dialog>

      {/* ── Request / contact form dialog ─────────────────────────────────
          FUNCTIONAL: the submit POSTs to /api/request, which validates,
          rate-limits, and delivers via the shared courier SMTP. */}
      <dialog class="request-modal" id="request-modal" aria-labelledby="request-modal-title">
        <div class="request-modal-inner">
          <header class="request-modal-header">
            <div>
              <h2 class="request-modal-title" id="request-modal-title">Get in touch</h2>
              <p class="request-modal-desc">Request access, suggest a new app, or report a problem.</p>
            </div>
            <button class="request-modal-close mono" type="button" data-close-request aria-label="Close">✕</button>
          </header>

          <div class="request-modal-body">
            <form class="request-form" id="request-form" method="post" action="/api/request" novalidate>
              <label class="form-field">
                <span class="form-label">Your name</span>
                <input class="form-input" type="text" name="name" autocomplete="name" maxlength="80" required placeholder="e.g. Ashley" />
              </label>

              <label class="form-field">
                <span class="form-label">Request type</span>
                <select class="form-select" name="type" required>
                  <option value="">— choose one —</option>
                  <option value="access">Access to an app</option>
                  <option value="new">New app idea</option>
                  <option value="problem">Problem / something broken</option>
                  <option value="other">Other</option>
                </select>
              </label>

              <label class="form-field">
                <span class="form-label">Message</span>
                <textarea class="form-textarea" name="message" rows="5" maxlength="4000" required placeholder="What do you need?"></textarea>
              </label>

              <p class="form-error mono" id="request-error" role="alert" hidden></p>

              <div class="form-actions">
                <button class="button button-primary" type="submit" id="request-submit">Send request</button>
              </div>
            </form>

            <div class="request-thanks" id="request-thanks" hidden>
              <p class="request-thanks-msg">Thanks — your request is on its way to {adminContact}.</p>
              <p class="mono request-thanks-note">You can close this window.</p>
            </div>
          </div>
        </div>
      </dialog>
    </>
  )}

  {isDev && state === 'down' && (
    <section class="dev-preview">
      <p class="section-subtitle">Dev preview · auth flows</p>
      <p class="section-prose">
        Kratos isn't reachable from <code>npm run dev</code>. These links
        exist so the layout work isn't gated on the substrate. Real flows
        will redirect to Kratos in production.
      </p>
      <ul class="dev-list">
        {devLinks.map((l) => (
          <li><a class="dev-link mono" href={l.href}>{l.href}</a><span class="dev-link-meta">{l.label}</span></li>
        ))}
      </ul>
    </section>
  )}

</Layout>

<script is:inline>
  // ── Request / contact form (post-auth dashboard) ──────────────────────
  // Progressive enhancement: the <form> has a real method/action so it works
  // without JS; this handler intercepts to POST via fetch and render inline
  // success / error states against the live /api/request endpoint.
  (function () {
    var modal = document.getElementById('request-modal');
    var openBtn = document.getElementById('open-request-form');
    var form = document.getElementById('request-form');
    var thanks = document.getElementById('request-thanks');
    var errorEl = document.getElementById('request-error');
    var submitBtn = document.getElementById('request-submit');
    if (!modal || !openBtn || !form) return;

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    openBtn.addEventListener('click', function () {
      clearError();
      if (typeof modal.showModal === 'function') modal.showModal();
    });

    modal.querySelectorAll('[data-close-request]').forEach(function (btn) {
      btn.addEventListener('click', function () { modal.close(); });
    });
    // Backdrop click closes.
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearError();
      if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

      fetch('/api/request', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            return { ok: res.ok, status: res.status, data: data };
          });
        })
        .then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            form.hidden = true;
            if (thanks) thanks.hidden = false;
          } else {
            showError((r.data && r.data.error) || 'Something went wrong. Please try again.');
          }
        })
        .catch(function () {
          showError('Network error — please check your connection and try again.');
        })
        .finally(function () {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send request'; }
        });
    });

    // Reset to the form view when the dialog is fully closed, ready for re-open.
    modal.addEventListener('close', function () {
      setTimeout(function () {
        form.hidden = false;
        if (thanks) thanks.hidden = true;
        clearError();
        form.reset();
      }, 200);
    });
  })();

  // ── App education modal (post-auth dashboard) ─────────────────────────
  // Each [data-app-learn] button opens the app-modal and populates it from
  // the matching hidden <template data-app-edu> element. Close on ×,
  // backdrop click, and Esc (native <dialog> behaviour).
  (function () {
    var appModal = document.getElementById('app-modal');
    if (!appModal) return;

    var titleEl = appModal.querySelector('.app-modal-title');
    var descEl  = appModal.querySelector('.app-modal-desc');
    var openLink = appModal.querySelector('.app-modal-open-link');
    var contentEl = appModal.querySelector('.app-modal-content');

    function openAppModal(slug) {
      var tpl = document.querySelector('template[data-app-edu="' + slug + '"]');
      if (!tpl || !contentEl) return;

      if (titleEl) titleEl.textContent = tpl.dataset.appName || slug;
      if (descEl)  descEl.textContent  = tpl.dataset.appDesc  || '';
      if (openLink) {
        openLink.href = tpl.dataset.appUrl || '#';
        openLink.textContent = 'Open ' + (tpl.dataset.appName || slug) + ' ↗';
      }

      // Clone the template content so re-opens always get a fresh copy.
      contentEl.innerHTML = '';
      contentEl.appendChild(tpl.content.cloneNode(true));

      if (typeof appModal.showModal === 'function') appModal.showModal();
    }

    // Delegate click on all [data-app-learn] buttons (covers ungrouped + grouped tiles).
    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest('[data-app-learn]');
      if (!btn) return;
      openAppModal(btn.dataset.appLearn);
    });

    // × close button.
    appModal.querySelectorAll('[data-close-app-modal]').forEach(function (btn) {
      btn.addEventListener('click', function () { appModal.close(); });
    });

    // Backdrop click closes (click lands on the <dialog> element itself).
    appModal.addEventListener('click', function (e) {
      if (e.target === appModal) appModal.close();
    });

    // Clear content when dialog fully closes (keeps DOM tidy; Esc is native).
    appModal.addEventListener('close', function () {
      setTimeout(function () {
        if (contentEl) contentEl.innerHTML = '';
        if (titleEl) titleEl.textContent = '';
        if (descEl)  descEl.textContent  = '';
        if (openLink) { openLink.href = '#'; openLink.textContent = 'Open ↗'; }
      }, 200);
    });
  })();
</script>

<style>
  /* ── State A: down — technical detail line ── */
  .holding-tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    margin-top: var(--space-3);
  }

  /* ── Hero CTA fragments ── */
  .cta-note {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cta-link {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-left: auto;
  }
  .cta-link:hover { color: var(--accent); text-decoration: none; }

  /* ── Tile grid ──
   * Each tile is an <article> with an inner launch anchor (icon+name+desc)
   * and a sibling "learn more" anchor — no nested anchors. */
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    align-items: stretch;
  }
  @media (min-width: 640px)  { .tile-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px)  { .tile-grid { grid-template-columns: repeat(3, 1fr); } }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .tile:hover {
    border-color: var(--accent);
  }
  /* Inner launch anchor wraps icon + name + desc */
  .tile-launch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4) var(--space-3);
    color: var(--text);
    text-decoration: none;
    flex: 1;
    width: 100%;
    height: 100%;
  }
  .tile-launch:hover { text-decoration: none; color: var(--text); }
  .tile-icon {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  /* Full-color icon image — keeps the SVG's own colors, no tinting. */
  .tile-icon-img {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
    flex-shrink: 0;
  }
  .tile-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text);
  }
  .tile-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Reserve height for exactly 2 lines so 1-line and 2-line tiles align */
    min-height: calc(1.4em * 2);
  }
  .tile-learn {
    /* Reset default <button> styles so it looks like the previous <a>. */
    all: unset;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    align-self: flex-end;
    padding: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    min-height: 44px;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border);
    width: 100%;
    justify-content: flex-end;
    box-sizing: border-box;
    margin-top: auto;
  }
  .tile-learn:hover { color: var(--accent); text-decoration: none; }
  .tile-learn:focus-visible {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: -2px;
  }

  /* ── Grouped tile sections ──
   * A lightly-bordered labeled section: heading + description above the
   * tile grid. No background fill so grouped tiles look identical to
   * ungrouped tiles. Border provides the grouping affordance. */
  .tile-group {
    margin-top: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    padding: var(--space-5);
  }
