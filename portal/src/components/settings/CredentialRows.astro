---
// One list of passkeys or security keys inside a Kratos method form: name and added date, a Remove button that opens an
// inline confirm (a script-free checkbox disclosure), and for passkeys a Rename row whose inputs belong to the sibling
// forms the page renders (`form="rename-<n>"`), since forms cannot nest.

import { formatAdded, type CredentialItem } from '../../lib/settings-view';

interface Props {
  items: CredentialItem[];
  kind: 'passkey' | 'webauthn';
  /** "passkey" or "security key": names the thing in labels and the confirm. */
  noun: string;
  /** Shown when a credential has no name. */
  fallbackName: string;
  rename?: boolean;
  /** A refused rename: that credential's row opens on the rename input with the reason underneath. */
  renameError?: { id: string; text: string } | null;
}

const { items, kind, noun, fallbackName, rename = false, renameError = null } = Astro.props as Props;
const removeName = `${kind}_remove`;
---
{items.length > 0 && (
  <ul class="items" data-credentials={kind}>
    {items.map((it, i) => {
      const added = formatAdded(it.addedAt);
      const shown = it.name ?? fallbackName;
      return (
        <li data-credential={kind} data-credential-id={it.id}>
          <div class="item-id">
            <span class="item-name">{shown}</span>
            {added && <span class="item-meta">· added {added}</span>}
          </div>
          {rename && <input type="checkbox" class="disclose cb-rename" id={`rn-${kind}-${i}`} aria-label={`Rename ${noun} ${shown}`} checked={renameError?.id === it.id} />}
          <input type="checkbox" class="disclose cb-remove" id={`rm-${kind}-${i}`} aria-label={`Remove ${noun} ${shown}`} />
          <div class="item-actions">
            {rename && (
              <label for={`rn-${kind}-${i}`} class="button button-secondary button-sm toggle-label lbl-rename">
                <span class="on-closed">Rename</span><span class="on-open">Cancel</span>
              </label>
            )}
            {it.removable ? (
              <label for={`rm-${kind}-${i}`} class="button button-secondary button-sm toggle-label lbl-remove">
                <span class="on-closed">Remove</span><span class="on-open">Keep it</span>
              </label>
            ) : (
              <button type="button" class="button button-secondary button-sm" disabled title="This is your only way to sign in. Add another first.">Remove</button>
            )}
          </div>
          {rename && (
            <div class="panel-row panel-rename">
              <input type="text" form={`rename-${i}`} name="name" maxlength="40" required value={it.name ?? ''} placeholder="e.g. Work laptop" aria-label={`Name for ${noun}`} aria-invalid={renameError?.id === it.id ? 'true' : undefined} aria-describedby={renameError?.id === it.id ? `rename-error-${i}` : undefined} />
              <button type="submit" form={`rename-${i}`} class="button button-primary button-sm">Save name</button>
              {renameError?.id === it.id && <p class="field-error" role="alert" id={`rename-error-${i}`}>{renameError.text}</p>}
            </div>
          )}
          {it.removable && (
            <div class="panel-row panel-remove">
              <span>Remove this {noun}? You won't be able to use it to sign in anymore.</span>
              <button type="submit" name={removeName} value={it.id} class="button button-danger button-sm" aria-label={`Remove ${noun} "${shown}"`}>Remove {noun}</button>
            </div>
          )}
        </li>
      );
    })}
  </ul>
)}
