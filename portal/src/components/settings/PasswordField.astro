---
// The new-password input with the username a password manager files it under. The username input is clipped, not
// `hidden`, `readonly` or `aria-hidden`: managers skip fields with those signals, so they would see a bare password
// field with no account to save it to.
interface Props { username: string; name: string; label: string; required?: boolean }
const { username, name, label, required } = Astro.props as Props;
---
<input id="password-username" type="text" class="sr-only" tabindex="-1" autocomplete="username" aria-label="Username" value={username} />
<div class="field">
  <label for="new-password">{label}</label>
  <input id="new-password" name={name} type="password" autocomplete="new-password" required={required} />
  <slot />
</div>
