---
// The new-password input with a username input before it, the account a password manager files the password under.
// Unnamed, so it is never posted to Kratos.
interface Props { username: string; name: string; label: string; required?: boolean }
const { username, name, label, required } = Astro.props as Props;
---
<input id="password-username" type="text" class="sr-only" tabindex="-1" aria-hidden="true" autocomplete="username" aria-label="Username" value={username} />
<div class="field">
  <label for="new-password">{label}</label>
  <input id="new-password" name={name} type="password" autocomplete="new-password" required={required} />
  <slot />
</div>
