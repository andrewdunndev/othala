---
// Friendly error and not-found page, the single source for error rendering: what happened in a sentence, what to do
// next, and a way home. Never raw errors or stack traces. `status` appears as a small quiet code for support.

import FocusPage from './FocusPage.astro';

interface Props {
  /** HTTP status code, shown small as a reference for whoever helps. */
  status: number;
  title: string;
  /** Human-readable message: what happened and what to do next. */
  message: string;
  /** Machine token for the response; kept as a data attribute for tests, not shown. */
  reason?: string;
  /** Offer sign-in beside Home. */
  signIn?: boolean;
}

const { status, title, message, reason, signIn = true } = Astro.props;
---
<FocusPage title={title} lede={message} tabTitle={`${status} ${title}`}>
  <div class="status-actions" data-reason={reason}>
    <a href="/" class:list={['button', status === 401 ? 'button-secondary' : 'button-primary']} data-astro-reload>Go home</a>
    {signIn && <a href="/auth/login" class:list={['button', status === 401 ? 'button-primary' : 'button-secondary']} data-astro-reload>Sign in</a>}
  </div>
  <p class="status-code">Error {status}</p>
</FocusPage>
