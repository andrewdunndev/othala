---
// An app's logo on a plate: the vendored SVG in its own colors, or the manifest monogram when no file resolves.
// The plate keeps white or transparent logos legible on both themes. Decorative: the app name sits beside it.

import type { AppTile } from '../lib/tiles';

interface Props {
  tile: Pick<AppTile, 'iconHref' | 'icon' | 'iconBleed'>;
  size?: 'sm' | 'md' | 'lg';
}

const { tile, size = 'md' } = Astro.props;
const iconSlug = tile.iconHref?.split('/').pop()?.replace(/\.svg$/, '');
---

<span class:list={['app-icon', `app-icon-${size}`]} data-icon={iconSlug} data-bleed={tile.iconBleed ? '' : undefined} aria-hidden="true">
  {
    tile.iconHref ? (
      <img class="app-icon-img" src={tile.iconHref} alt="" decoding="async" />
    ) : (
      <span class="app-icon-mono mono">{tile.icon}</span>
    )
  }
</span>

<style>
  .app-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    --plate: 2.75rem;
    width: var(--plate);
    height: var(--plate);
    padding: 0.4rem;
    box-sizing: border-box;
  }
  .app-icon-sm {
    --plate: 1.5rem;
    padding: 0.2rem;
    border-radius: var(--radius-sm);
  }
  .app-icon-sm .app-icon-mono { font-size: 0.5rem; letter-spacing: 0; }
  .app-icon-lg {
    --plate: 3.5rem;
    padding: 0.55rem;
  }
  .app-icon-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .app-icon-mono {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
