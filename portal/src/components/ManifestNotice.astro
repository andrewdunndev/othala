---
// The admin-visible half of the manifest fallback: the serving loader (lib/manifest-store.ts) keeps the last working set
// of app settings when a new set fails to load, so every admin page that shows apps mounts this. Plain words up top, the
// raw cause in a closed disclosure. Emits nothing when healthy; never shown to non-admins.

import type { ManifestHealth } from '../lib/manifest-store';

interface Props {
  health: ManifestHealth;
}

const { health } = Astro.props;

const brokenForSeconds =
  health.failingSinceMs === null
    ? 0
    : Math.max(0, Math.round((Date.now() - health.failingSinceMs) / 1000));

function describeDuration(seconds: number): string {
  if (seconds < 60) return 'under a minute';
  if (seconds < 3600) return `${Math.round(seconds / 60)} minutes`;
  return `${Math.round(seconds / 3600)} hours`;
}
---
{health.status === 'stale' && (
  <div class="notice notice-danger">
    <p>
      <strong>Some app changes are not live yet.</strong> The newest app settings could not be read
      for {describeDuration(brokenForSeconds)}, so the {health.serving} <a href="/admin/oauth2">app{health.serving === 1 ? '' : 's'}</a>
      {health.serving === 1 ? 'is' : 'are'} served from the last settings that worked. Signing in keeps working.
      As an admin you can read what went wrong under Technical details, correct that app settings file on the server, and this
      page updates by itself afterwards.
    </p>
    <details class="plain">
      <summary>Technical details</summary>
      <pre class="manifest-cause">{health.error}</pre>
    </details>
  </div>
)}
{health.status === 'unavailable' && (
  <div class="notice notice-danger">
    <p>
      <strong>No apps are loaded.</strong> The app settings could not be read and there is no earlier
      working set, so nobody can sign in to any <a href="/admin/oauth2">app</a> until this is fixed. As an admin you can read what went
      wrong under Technical details, correct that app settings file on the server, and this page updates by itself afterwards.
    </p>
    <details class="plain">
      <summary>Technical details</summary>
      <pre class="manifest-cause">{health.error}</pre>
    </details>
  </div>
)}

<style>
  /* validateClients joins one line per finding with newlines. Preserve those
     breaks, but wrap long lines rather than pushing the admin layout sideways. */
  .manifest-cause {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.8125rem);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
