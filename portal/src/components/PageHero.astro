---
// Hero section for every portal page: the dagaz->othala lockup banner above the
// title and lede, defined once. Props: title (required h1), lede (subtitle),
// eyebrow (small mono label above the title). The slot renders below the lede.

import HeroLockup from './HeroLockup.astro';

interface Props {
  /** The page heading rendered as an <h1>. */
  title: string;
  /** Optional subtitle rendered as a <p class="hero-lede">. */
  lede?: string;
  /** Optional mono eyebrow label rendered above the title. */
  eyebrow?: string;
}

const { title, lede, eyebrow } = Astro.props;
---

<section class="hero hero-banner">
  <HeroLockup />
  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    {lede && <p class="hero-lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  /* Override the two-column site.css .hero grid so the dagaz→othala lockup
   * spans the full width as a banner with the title/lede stacked below. */
  .hero-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  /* hero-content is a plain div; no additional styling needed — the
   * site.css .hero-title / .hero-lede / .hero-eyebrow tokens apply. */
  .hero-content {
    width: 100%;
  }
  /* Phones: a tighter banner so the first app sits in the first screen. */
  @media (max-width: 640px) {
    .hero-banner {
      gap: var(--space-3);
      padding-bottom: var(--space-4);
      margin-bottom: var(--space-4);
    }
    .hero-content :global(.hero-title) { margin-bottom: var(--space-2); }
  }
</style>
