---
// One dashboard tile. The whole card body is a link that launches the app; a separate Guide button opens the
// documentation dialog (index.astro wires [data-app-learn]). Badges show this person's prerequisite state for this person.
// The two controls are siblings, never nested; the launch link covers the card except the Guide button.

import AppIcon from './AppIcon.astro';
import AppBadges from './AppBadges.astro';
import { safeHref, type AppTile, type TileReadiness } from '../lib/tiles';

interface Props {
  tile: AppTile;
  readiness: TileReadiness;
  requirementTitles: string[];
  groups: string[];
}

const { tile, readiness, requirementTitles, groups } = Astro.props;
// A tile whose prerequisite is unmet opens its setup page (the app page leads with the setup step) rather than an
// address that will not load until the person is set up.
const launchHref = readiness === 'needs' ? `/apps/${encodeURIComponent(tile.slug)}` : safeHref(tile.url);
---

<article class="tile" data-slug={tile.slug}>
  <a class="tile-launch" href={launchHref}>
    <AppIcon tile={tile} groups={groups} />
    <span class="tile-text">
      <span class="tile-name">{tile.name}</span>
      {
        readiness === 'needs' ? (
          <AppBadges readiness={readiness} titles={requirementTitles} />
        ) : (
          <span class="tile-desc">{tile.description}</span>
        )
      }
    </span>
  </a>
  <button
    type="button"
    class="tile-guide"
    data-app-learn={tile.slug}
    aria-haspopup="dialog"
    aria-label={`Guide for ${tile.name}`}
  >
    <svg class="tile-guide-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M2.5 3h4.2c.8 0 1.3.4 1.3 1v8.5c0-.6-.5-1-1.3-1H2.5z M13.5 3H9.3c-.8 0-1.3.4-1.3 1v8.5c0-.6.5-1 1.3-1h4.2z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
    </svg>
    <span class="tile-guide-label">Guide</span>
  </button>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--tile-bg, var(--bg));
    border: 1px solid var(--border-strong);
    box-shadow: var(--tile-shadow, none);
    border-radius: var(--radius);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .tile:hover,
  .tile:focus-within {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }
  /* Logo, then name over the full description; the row grows to fit the text. */
  .tile-launch {
    display: flex;
    flex: 1 1 12rem;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }
  .tile-launch:hover { color: var(--text); text-decoration: none; }
  /* The link's ::after stretches over the whole row so every pixel but the Guide pill launches the app. */
  .tile-launch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .tile-launch:focus-visible { outline: none; }
  .tile-launch:focus-visible::after {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: -3px;
  }
  .tile-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tile-name {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .tile-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.45;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .tile-guide {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .tile-guide:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tile-guide:focus-visible {
    outline: 2px solid var(--input-focus, var(--accent));
    outline-offset: 1px;
  }
  /* On phones the pill drops under the text, aligned with it, so the description keeps the full row width. */
  @media (max-width: 30rem) {
    .tile-launch { flex-basis: 100%; }
    .tile-guide { margin-left: calc(3rem + var(--space-3)); }
  }
  @media (pointer: coarse) {
    .tile-guide { min-height: 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile, .tile-guide { transition: none; }
  }
</style>
