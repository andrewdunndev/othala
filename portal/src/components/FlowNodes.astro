---
// Generic Kratos node renderer shared by the recovery, verification and
// settings pages: one dispatch loop per method group emitting hidden inputs,
// buttons (per-call class, optional onclick) and labeled inputs. Attribute
// policy lives in lib/nodes.ts inputProps; pages keep their own copy and
// structure. login.astro is deliberately not a consumer.

import { asInput, inputProps, safeOnclick, specKey, nodeLabel } from '../lib/nodes';
import { noticeRole } from '../lib/journey';
import type { NodeSpecs } from '../lib/nodes';
import type { FlowNode, FlowMessage } from '../lib/types';

interface Props {
  /** The flow's full node array. */
  nodes: FlowNode[];
  /** Which method group to render (code | profile | passkey | password | …). */
  group: FlowNode['group'];
  /** Class applied to submit/button nodes. */
  buttonClass: string;
  /** Fallback label for submit/button nodes when meta.label.text is absent. */
  submitLabel: string;
  /** Fallback label for labeled inputs when meta.label.text is absent (default: the field name). */
  inputLabelFallback?: (name: string) => string;
  /** Wrap submit/button nodes in a <div class="form-actions"> (settings layout). */
  wrapActions?: boolean;
  /** Forward the node's onclick onto the button (passkey trigger). */
  passOnclick?: boolean;
  /** Render the value attribute on labeled inputs, empty-string when absent (off for password fields). */
  passValue?: boolean;
  /** Render the disabled attribute on labeled inputs (profile fields). */
  passDisabled?: boolean;
  /** Render the required attribute on labeled inputs. */
  passRequired?: boolean;
  /** Default autocomplete when the node omits one (e.g. 'new-password'). */
  defaultAutocomplete?: string;
  /** Portal wording and hints per node, keyed by specKey; nodes without an entry render as before. */
  specs?: NodeSpecs;
  /** Wording for a node-level message; default is Kratos's own text. */
  messageText?: (m: FlowMessage) => string;
}

const {
  nodes,
  group,
  buttonClass,
  submitLabel,
  inputLabelFallback = (name: string) => name,
  wrapActions = false,
  passOnclick = false,
  passValue = true,
  passDisabled = false,
  passRequired = true,
  defaultAutocomplete,
  specs = {},
  messageText = (m: FlowMessage) => m.text,
} = Astro.props as Props;

const labelText = (node: FlowNode, fallback: string): string => {
  const a = asInput(node);
  return nodeLabel(a ? specs[specKey(a)] : undefined, node.meta?.label?.text, fallback);
};
---
{nodes
  .filter((n: FlowNode) => n.group === group)
  .map((node: FlowNode) => {
    const a = asInput(node);
    if (!a) return null;

    if (a.type === 'hidden') {
      return <input type="hidden" name={a.name} value={String(a.value ?? '')} />;
    }

    if (a.type === 'submit' || a.type === 'button') {
      // safeOnclick validates against KNOWN_TRIGGERS before emitting
      // window.<fn>(). The passOnclick prop controls whether the handler
      // is forwarded at all (passkey group needs it; password group doesn't).
      const button = (
        <button
          class={specs[specKey(a)]?.class ?? buttonClass}
          formnovalidate={specs[specKey(a)]?.formnovalidate}
          type={a.type}
          name={a.name}
          value={String(a.value ?? '')}
          onclick={passOnclick ? safeOnclick(a) : undefined}
        >
          {labelText(node, submitLabel)}
        </button>
      );
      return wrapActions ? <div class="form-actions">{button}</div> : button;
    }

    // Labeled input. Build the attribute set via the shared inputProps helper,
    // then apply the page's render policy (which optional attrs to surface).
    const props = inputProps(a);
    const spec = specs[specKey(a)];
    const refused = node.messages?.some((m: FlowMessage) => m.type === 'error') ?? false;
    const id = a.name.replace(/[^a-zA-Z0-9]+/g, '-');
    const autocomplete = spec?.autocomplete ?? (props.autocomplete as string | undefined) ?? defaultAutocomplete;
    return (
      <div class="field">
        <label for={id}>{labelText(node, inputLabelFallback(a.name))}</label>
        <input
          id={id}
          name={a.name}
          type={a.type}
          value={passValue ? (refused && spec?.clearOnError ? '' : 'value' in props ? String(props.value) : '') : undefined}
          required={passRequired ? (props.required as boolean | undefined) : undefined}
          disabled={passDisabled ? (props.disabled as boolean | undefined) : undefined}
          autocomplete={autocomplete}
          inputmode={spec?.inputmode}
          placeholder={spec?.placeholder}
          autofocus={spec?.autofocus}
          maxlength={spec?.maxlength}
          pattern={spec?.pattern}
          title={spec?.title}
          aria-invalid={refused ? 'true' : undefined}
          aria-describedby={refused ? `${id}-error` : undefined}
          class={spec?.class}
        />
        {spec?.hint && <div class="field-hint">{spec.hint}</div>}
        {node.messages?.map((m: FlowMessage, i: number) => (
          <div
            id={m.type === 'error' && node.messages?.findIndex((x: FlowMessage) => x.type === 'error') === i ? `${id}-error` : undefined}
            role={noticeRole(m.type)}
            class={`notice notice-${m.type === 'error' ? 'danger' : m.type === 'success' ? 'success' : 'warning'}`}
          >
            {messageText(m)}
          </div>
        ))}
      </div>
    );
  })}
