---
// HeroLockup — the canonical dag → othala brand lockup.
//
// Renders the horizontal SVG row: dag mark → arrow → othala mark, with an
// optional "door to home" gloss line beneath. Used by the pre-auth hero on
// index.astro and by every auth-flow page hero so the brand reads identically
// from first touch through sign-in.
//
// Props
//   gloss  (boolean, default true) — show/hide the "door to home" gloss line.

import dagSvg  from '../marks/dag.svg?raw';
import markSvg from '../marks/mark.svg?raw';

interface Props {
  /** Show the "door to home" gloss beneath the marks. Default true. */
  gloss?: boolean;
}

const { gloss = true } = Astro.props;
---

<div class="hero-lockup" role="img" aria-label="dag to othala — door to home">
  <span class="lockup-mark" set:html={dagSvg} />
  <span class="lockup-arrow" aria-hidden="true">→</span>
  <span class="lockup-mark" set:html={markSvg} />
  {gloss && <p class="lockup-gloss">door to home</p>}
</div>

<style>
  /* Horizontal dag → arrow → othala row.
   * Marks inherit --accent (moss); arrow and gloss are secondary. */
  .hero-lockup {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .lockup-mark {
    display: inline-flex;
    width: 96px;
    height: 96px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .lockup-mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .lockup-arrow {
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1;
  }
  .lockup-gloss {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-left: var(--space-3);
  }
  @media (max-width: 640px) {
    .lockup-mark { width: 64px; height: 64px; }
  }
</style>
