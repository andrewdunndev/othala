---
// The guide body for an app or a requirement: an optional lead, then the fixed outline (What it's for, First time,
// Good to know, Getting help) styled the same for every app. The HTML is already sanitized by lib/tiles.ts, so set:html
// is safe here. Used by the dashboard dialog and by /apps/<slug> and /requirements/<name>.

import type { Guide, GuideSection } from '../lib/tiles';

interface Props {
  guide: Guide;
  /** Shown when the guide has no content at all. */
  emptyNote?: string;
}

const { guide, emptyNote } = Astro.props;
const empty = !guide.lead && guide.sections.length === 0;
---

<div class="guide">
  {guide.lead && <div class="guide-lead guide-prose" set:html={guide.lead} />}
  {
    guide.sections.map((s: GuideSection) => (
      <section class={`guide-sec guide-sec-${s.id}`}>
        <h3 class="guide-sec-title">
          <span class="guide-sec-rule" aria-hidden="true" />
          {s.title}
        </h3>
        <div class="guide-prose" set:html={s.html} />
      </section>
    ))
  }
  {empty && <p class="guide-empty">{emptyNote ?? 'No guide has been written for this app yet.'}</p>}
</div>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text);
  }
  .guide-empty {
    margin: 0;
    padding: var(--space-4);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .guide-lead { font-size: var(--text-lg); color: var(--text-2); line-height: 1.5; }

  .guide-sec-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .guide-sec-rule {
    width: 1.25rem;
    height: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* Prose inside any section */
  .guide-prose > :global(:first-child) { margin-top: 0; }
  .guide-prose > :global(:last-child) { margin-bottom: 0; }
  .guide-prose :global(h3),
  .guide-prose :global(h4) {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    margin: var(--space-4) 0 var(--space-1);
  }
  .guide-prose :global(p) { margin: var(--space-3) 0; }
  .guide-prose :global(ul),
  .guide-prose :global(ol) { margin: var(--space-3) 0; padding-left: var(--space-5); }
  .guide-prose :global(li + li) { margin-top: var(--space-2); }
  .guide-prose :global(a) { color: var(--accent); text-decoration: underline; }
  .guide-prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--surface);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
  /* A copyable chip (see CopyChips): the code sits on the page ground with its own hairline, so it reads apart from
     the step card behind it. */
  .guide :global(.code-chip) {
    display: inline-flex;
    align-items: stretch;
    vertical-align: middle;
    max-width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .guide :global(.code-chip code) {
    background: transparent;
    padding: var(--space-1) var(--space-2);
    overflow-wrap: anywhere;
  }
  .guide :global(.code-copy) {
    flex-shrink: 0;
    min-width: 3.5rem;
    min-height: 2rem;
    padding: 0 var(--space-2);
    background: var(--surface);
    border: 0;
    border-left: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
    cursor: pointer;
  }
  .guide :global(.code-copy:hover) { color: var(--accent); background: var(--accent-subtle); }
  .guide :global(.code-copy:focus-visible) { outline: 2px solid var(--input-focus, var(--accent)); outline-offset: -2px; }
  .guide-prose :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-3);
    border-radius: var(--radius);
    overflow-x: auto;
  }
  .guide-prose :global(pre code) { background: transparent; padding: 0; }
  .guide-prose :global(img) { max-width: 100%; height: auto; }

  /* First time: numbered step cards */
  .guide-sec-first-time .guide-prose :global(ol) {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .guide-sec-first-time .guide-prose :global(ol > li) {
    counter-increment: step;
    position: relative;
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .guide-sec-first-time .guide-prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .guide-sec-first-time .guide-prose :global(li > p) { margin: 0; }
  .guide-sec-first-time .guide-prose :global(li > p + p) { margin-top: var(--space-2); }

  /* Good to know: each nuance is its own item with its own bold lead, set off by hairlines. */
  .guide-sec-good-to-know .guide-prose :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .guide-sec-good-to-know .guide-prose :global(ul > li) {
    margin: 0;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .guide-sec-good-to-know .guide-prose :global(ul > li:last-child) { border-bottom: 0; padding-bottom: 0; }
  .guide-sec-good-to-know .guide-prose :global(li > strong:first-child) { display: block; color: var(--text); }
  .guide-sec-good-to-know .guide-prose :global(li) { color: var(--text-2); }

  /* Getting help: the same type step as the rest, set off by a rule above. */
  .guide-sec-help {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  /* Callout: a markdown blockquote */
  .guide-prose :global(blockquote) {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-subtle);
  }
  .guide-prose :global(blockquote > :first-child) { margin-top: 0; }
  .guide-prose :global(blockquote > :last-child) { margin-bottom: 0; }

  /* Explainer figures (inline SVG in a guide) */
  .guide :global(.cat-explainer) {
    width: 100%;
    box-sizing: border-box;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin: var(--space-4) 0;
    clear: both;
  }
  .guide :global(.cat-explainer svg) { display: block; width: 100%; height: auto; margin: 0; }
  .guide :global(.cat-explainer p) {
    margin: var(--space-3) 0 0;
    padding: 0 var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-2);
    max-width: 70ch;
  }
</style>
