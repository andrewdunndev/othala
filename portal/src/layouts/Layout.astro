---
import '../styles/global.css';
import '../styles/focus.css';
import { ClientRouter } from 'astro:transitions';
import markSvg from '../marks/mark.svg?raw';
import { instanceName } from '../lib/config';

type NavItem = { href: string; label: string };

interface Props {
  title: string;
  description?: string;
  nav?: NavItem[];
  /** When true, footer is suppressed (e.g. focused login screens). */
  bare?: boolean;
  /** Tighter top padding for dashboards that lead with content. */
  compact?: boolean;
  /** Swap form posts and same-page navigations in place (Astro's ClientRouter); native navigation stays the fallback. */
  router?: boolean;
  /** One narrow centred column (first-run and focused pages) under the same top bar. */
  narrow?: boolean;
}

const { title, description, nav, bare = false, compact = false, router = false, narrow = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const here = (href: string) => path === href || path.startsWith(href + '/');
const isHome = title === 'Home';
const pageTitle = isHome ? instanceName : `${title} — ${instanceName}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline>
    (() => {
      // Re-applied after a router swap, which replaces the root element's attributes.
      const apply = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
        } catch {}
      };
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  {router && <ClientRouter />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand" aria-label={instanceName} data-astro-reload>
        <span class="brand-mark" set:html={markSvg} />
        <span class="brand-name">{instanceName}</span>
      </a>
      {nav && nav.length > 0 && (
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item: NavItem) => (
            <a href={item.href} class:list={['nav-link', { active: here(item.href) }]} aria-current={here(item.href) ? 'page' : undefined} data-astro-reload>
              {item.label}
            </a>
          ))}
        </nav>
      )}
      <div class="header-actions"><slot name="header-actions" /></div>
    </div>
  </header>

  <main id="main" tabindex="-1" class:list={['page', { 'page-compact': compact, 'page-narrow': narrow }]}>
    <slot />
  </main>

  {!bare && (
    <footer class="site-footer">
      <div class="footer-inner">
        <span>{instanceName}</span>
        <span class="footer-sep">·</span>
        <a href="https://gitlab.com/dunn.dev/othala" data-astro-reload>repo</a>
        <span class="footer-sep">·</span>
        <a href="https://design.dunn.dev" data-astro-reload>design</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Switch theme">
          <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </footer>
  )}

  <script is:inline>
    (() => {
      // One polite live region for script-driven results (copy done, rows shown). Inside an open modal dialog the rest
      // of the page is inert, so the message goes in the dialog.
      window.announce = (msg) => {
        const host = document.querySelector('dialog[open]') || document.body;
        let el = host.querySelector(':scope > .sr-status');
        if (!el) {
          el = document.createElement('div');
          el.className = 'sr-only sr-status';
          el.setAttribute('role', 'status');
          host.appendChild(el);
        }
        el.textContent = '';
        setTimeout(() => { el.textContent = msg; }, 50);
      };
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        const isDark = () => {
          const current = document.documentElement.dataset.theme;
          return current === 'dark' || (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
        };
        const label = () => btn.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
        label();
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
        });
      }
    })();
  </script>
  {import.meta.env.DEV && (
    <script is:inline>
      (() => {
        const carry = () => {
          const here = new URL(location.href);
          const keep = [...here.searchParams].filter(([k]) => k.startsWith('dev-'));
          if (!keep.length) return;
          document.querySelectorAll('a[href^="/"]').forEach((a) => {
            const u = new URL(a.getAttribute('href'), location.origin);
            for (const [k, v] of keep) if (!u.searchParams.has(k)) u.searchParams.set(k, v);
            a.setAttribute('href', u.pathname + u.search + u.hash);
          });
        };
        carry();
        document.addEventListener('astro:page-load', carry);
      })();
    </script>
  )}
  <script>
    import '../scripts/code-input';
  </script>
</body>
</html>
