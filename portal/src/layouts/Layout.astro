---
// Shared head + body wrapper for all portal pages.
// Imports the design tokens (via @dunn.dev/reference package) and the
// site-level chrome from src/styles/site.css via global.css.
//
// Visual language matches the estate (design.dunn.dev): sticky header
// with mark + brand, optional primary nav, theme toggle storing in
// localStorage, footer with repo link.

import '../styles/global.css';
import markSvg from '@dunn.dev/reference/mark/mark.svg?raw';

interface Props {
  title: string;
  description?: string;
  /** Optional primary nav. Used by admin pages; auth flow pages omit it. */
  nav?: Array<{ href: string; label: string }>;
  /** When true, footer is suppressed (e.g. focused login screens). */
  bare?: boolean;
}

const { title, description, nav, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = title === 'Home';
const pageTitle = isHome ? 'auth.dunn.dev' : `${title} — auth.dunn.dev`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') {
      document.documentElement.dataset.theme = stored;
    }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand" aria-label="auth.dunn.dev">
        <span class="brand-mark" set:html={markSvg} />
        <span class="brand-name">auth.dunn.dev</span>
      </a>
      {nav && nav.length > 0 && (
        <nav class="site-nav" aria-label="Primary">
          {nav.map(item => (
            <a href={item.href} class:list={['nav-link', { active: item.href === path }]}>
              {item.label}
            </a>
          ))}
        </nav>
      )}
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span class="theme-toggle-light" aria-hidden="true">light</span>
        <span class="theme-toggle-sep" aria-hidden="true">/</span>
        <span class="theme-toggle-dark" aria-hidden="true">dark</span>
      </button>
    </div>
  </header>

  <main class="page">
    <slot />
  </main>

  {!bare && (
    <footer class="site-footer">
      <div class="footer-inner">
        <span>dunn.dev family auth</span>
        <span class="footer-sep">·</span>
        <a href="https://gitlab.com/dunn.dev/auth">repo</a>
        <span class="footer-sep">·</span>
        <a href="https://design.dunn.dev">design</a>
      </div>
    </footer>
  )}

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const isDark =
          current === 'dark' ||
          (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    }
  </script>
</body>
</html>
