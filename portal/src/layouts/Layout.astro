---
// Shared head + body wrapper for all portal pages.
// Imports the design tokens (via @dunn.dev/reference package) and the
// site-level chrome from src/styles/site.css via global.css.
//
// Visual language matches the estate (design.dunn.dev): sticky header
// with mark + brand, optional primary nav, theme toggle storing in
// localStorage, footer with repo link.

import '../styles/global.css';
import markSvg from '../marks/mark.svg?raw';
import { siteName } from '../lib/config';

type NavItem = { href: string; label: string };

interface Props {
  title: string;
  description?: string;
  /** Optional primary nav. Used by admin pages; auth flow pages omit it. */
  nav?: NavItem[];
  /** When true, footer is suppressed (e.g. focused login screens). */
  bare?: boolean;
}

const { title, description, nav, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = title === 'Home';
const pageTitle = isHome ? siteName : `${title} — ${siteName}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline>
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') {
      document.documentElement.dataset.theme = stored;
    }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand" aria-label={siteName}>
        <span class="brand-mark" set:html={markSvg} />
        <span class="brand-name">{siteName}</span>
      </a>
      {nav && nav.length > 0 && (
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item: NavItem) => (
            <a href={item.href} class:list={['nav-link', { active: item.href === path }]}>
              {item.label}
            </a>
          ))}
        </nav>
      )}
    </div>
  </header>

  <main class="page">
    <slot />
  </main>

  {!bare && (
    <footer class="site-footer">
      <div class="footer-inner">
        <span>{siteName}</span>
        <span class="footer-sep">·</span>
        <a href="https://gitlab.com/dunn.dev/othala">repo</a>
        <span class="footer-sep">·</span>
        <a href="https://design.dunn.dev">design</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          {/* Sun icon (shown in dark mode — click to go light) */}
          <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          {/* Moon icon (shown in light mode — click to go dark) */}
          <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </footer>
  )}

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const isDark =
          current === 'dark' ||
          (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    }
  </script>
</body>
</html>
