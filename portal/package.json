{
  "name": "@dunn.dev/othala-portal",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && npm run copy:listener && npm run copy:otel && npm run build:admin-runtime && npm run build:register-clients && npm run build:registrar && npm run build:manifest-lint",
    "copy:listener": "cp src/server/listen.mjs dist/server/listen.mjs",
    "copy:otel": "cp src/server/otel.mjs dist/otel.mjs",
    "build:admin-runtime": "esbuild src/server/admin-runtime.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/admin-runtime.mjs",
    "build:register-clients": "esbuild src/server/register-clients-cli.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/register-clients.mjs",
    "build:registrar": "esbuild src/server/registrar.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/registrar.mjs",
    "build:manifest-lint": "esbuild src/server/manifest-lint-cli.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/manifest-lint.mjs",
    "lint:manifests": "MANIFEST_DIR=../e2e/manifests tsx src/server/manifest-lint-cli.ts ../e2e/manifests",
    "check": "astro check",
    "preview": "astro preview",
    "start": "node ./dist/server/listen.mjs",
    "test": "tsx --test scripts/*.test.mjs",
    "purity": "cd .. && bash scripts/check-purity.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@dunn.dev/reference": "^0.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.0",
    "@ory/client-fetch": "^1.22.37",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.0.0",
    "isomorphic-dompurify": "^3.16.0",
    "marked": "^18.0.4",
    "nodemailer": "^9.0.0",
    "tailwindcss": "^4.2.4",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/nodemailer": "8.0.1",
    "esbuild": "0.28.1",
    "fast-check": "4.8.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2"
  }
}
