{
  "name": "@dunn.dev/othala-portal",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && npm run build:listener && npm run copy:otel && npm run build:registrar && npm run build:manifest-lint",
    "build:listener": "esbuild src/server/listen.ts --bundle --format=esm --platform=node --packages=external --external:./entry.mjs --external:./registrar.mjs --outfile=dist/server/listen.mjs",
    "copy:otel": "cp src/server/otel.mjs dist/otel.mjs",
    "build:registrar": "esbuild src/server/registrar.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/registrar.mjs",
    "build:manifest-lint": "esbuild src/server/manifest-lint-cli.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/server/manifest-lint.mjs",
    "lint:manifests": "tsx src/server/manifest-lint-cli.ts ../e2e/manifests",
    "check": "astro check",
    "preview": "astro preview",
    "start": "node ./dist/server/listen.mjs",
    "test": "vitest run",
    "purity": "cd .. && bash scripts/check-purity.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@dunn.dev/reference": "^0.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.41.0",
    "@ory/client-fetch": "^1.22.37",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.0.0",
    "isomorphic-dompurify": "^4.0.0",
    "marked": "^18.0.4",
    "nodemailer": "^10.0.0",
    "tailwindcss": "^4.2.4",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2"
  }
}
