# dunn.dev/othala-portal -- Astro Node SSR for carmine.
#
# Two-stage: UBI 9 nodejs-22 (full image with npm) for build, UBI 9
# nodejs-22-minimal via ci-runtime-node for runtime. Astro Node
# standalone emits an SSR handler at dist/server/entry.mjs; the
# D-listener wrapper dist/server/listen.mjs serves it on the public
# port and stands up a separate loopback admin port (CU1 item 4), so
# no Express/Fastify glue is needed.
#
# v0.2.0 change: OIDC client manifests are read at RUNTIME from a
# mounted directory (/etc/portal/manifests/), not baked into the
# build via manifests-build.mjs. The build context can therefore be
# portal/ alone; hydra/clients/ is no longer needed at build time.
# See portal/src/lib/manifests.ts for the runtime read pattern and
# the source-of-truth chain.
#
# Tile-dashboard MD content (portal/src/content/apps/*.md) IS
# build-time bundled via Astro Content Collections. Adding an app's
# education content is an image rebuild; OIDC manifest edits are not.
#
# CI build context: auth repo root (see .gitlab-ci.yml build-portal job).
# Local build (from auth repo root):
#   podman build -t dunn.dev/othala-portal:lab -f portal/Containerfile .
# Run:
#   podman run --rm -p 8080:8080 \
#     -v ./hydra/clients:/etc/portal/manifests:ro \
#     -e KRATOS_PUBLIC_URL=http://kratos:4433 \
#     -e KRATOS_ADMIN_URL=http://kratos:4434 \
#     -e HYDRA_PUBLIC_URL=http://hydra:4444 \
#     -e HYDRA_ADMIN_URL=http://hydra:4445 \
#     dunn.dev/othala-portal:lab

# Keep in lockstep with the dunn.dev/pipeline component version in
# .gitlab-ci.yml — old catalog image tags get GC'd from the registry
# (2.5.1 vanished and broke the v0.3.0 tag build with "manifest unknown").
# Now tracked by the shared preset's annotated-ARG customManager (see
# dunn.dev/pipeline:renovate-config.json), pointed at the same
# gitlab-tags source as the .gitlab-ci.yml component pins below, and
# grouped with them under the "pipeline catalog" packageRule in
# renovate.json so one MR moves both (coverage added 2026-07-01; every
# earlier catalog roll was manual — the last one was MR !52).
# renovate: datasource=gitlab-tags depName=dunn.dev/pipeline
ARG CATALOG_VERSION=3.1.0

# ----- Stage 1: build -----
# Use upstream UBI 9 nodejs-22 (full image with npm + build tools).
# ci-runtime-node is -minimal and intentionally omits npm.
FROM registry.access.redhat.com/ubi9/nodejs-22:9.8@sha256:4bcc19fdb67a5f0a568375e45eb8e324ecbbc17431944e213786a537092d812f AS build

WORKDIR /src
USER root

# Install deps first for cache friendliness. .npmrc routes
# @dunn.dev/* to the GitLab group npm registry endpoint; anonymous
# access works because reference is in a public group.
COPY portal/package.json portal/package-lock.json portal/.npmrc portal/
RUN cd portal && npm ci

COPY portal/ portal/
# v0.2.0: hydra/clients/ is NOT copied at build time. OIDC manifests
# are read at runtime from /etc/portal/manifests/ (mounted via the
# iac quadlet volume). See portal/src/lib/manifests.ts.

# No build-time host: astro.config.mjs uses a host-agnostic
# security.allowedDomains wildcard, so checkOrigin works behind the reverse
# proxy without baking any deployment host into the image.
RUN cd portal \
    && npm run build \
    && npm prune --omit=dev

# ----- Stage 2: runtime -----
FROM registry.gitlab.com/dunn.dev/pipeline/ci-runtime-node:${CATALOG_VERSION}

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    ADMIN_HOST=127.0.0.1 \
    ADMIN_PORT=4431 \
    # OpenTelemetry bootstrap (PII-safe; src/server/otel.mjs, copied to
    # dist/otel.mjs by `npm run copy:otel`). --import runs it BEFORE
    # listen.mjs so the http instrumentation patches node:http first. The
    # path is relative to WORKDIR /app, where `dist/` is copied below, and
    # its bare @opentelemetry/* imports resolve up to /app/node_modules.
    # No-op unless OTEL_EXPORTER_OTLP_ENDPOINT is set, so this is inert in
    # any deploy without a collector — the SDK never starts.
    NODE_OPTIONS="--import ./dist/otel.mjs"

# ci-runtime-node inherits the `default` user (uid 1001) from
# ubi9/nodejs-22-minimal. COPY as root, then switch to 1001 for
# runtime.
USER root
COPY --from=build --chown=1001:0 /src/portal/dist ./dist
COPY --from=build --chown=1001:0 /src/portal/node_modules ./node_modules
COPY --from=build --chown=1001:0 /src/portal/package.json ./package.json

USER 1001

# Only the public port is EXPOSEd. The admin port (ADMIN_PORT) binds to
# loopback (ADMIN_HOST=127.0.0.1) and is pod-only by design (D-listener,
# CU1 item 4); revoke + recovery-gate routes land on it in CU3.
EXPOSE 8080

# listen.mjs binds the public SSR handler on PORT and the loopback admin mux
# on ADMIN_PORT in one process (see src/server/listen.mjs). Standalone
# entry.mjs is imported by listen.mjs for its exported `handler`, not run
# directly, so it never auto-binds its own server.
CMD ["node", "./dist/server/listen.mjs"]
