# othala-portal: Astro Node SSR.
#
# Build on UBI 10 nodejs-24 (with npm), run on ci-runtime-node's
# nodejs-24-minimal. Deployment content is mounted at runtime, not built in; the
# Ory policy is built in and rendered by dist/server/config.mjs.
#
# Build from the repo root:
#   podman build -t dunn.dev/othala-portal:lab -f portal/Containerfile .
#   podman run --rm -p 8080:8080 \
#     -v ./e2e/content:/etc/othala:ro \
#     dunn.dev/othala-portal:lab

# ----- Stage 1: build -----
# UBI 10 nodejs-24: the runtime image is -minimal and has no npm.
FROM registry.access.redhat.com/ubi10/nodejs-24:10.2@sha256:277dbfef858a1ee91b27f7e22d50bd5ebcedabd499cb5daa924a6b2fcc63259e AS build

WORKDIR /src
USER root

COPY portal/package.json portal/package-lock.json portal/.npmrc portal/
RUN cd portal && npm ci

COPY portal/ portal/
RUN cd portal \
    && npm run build \
    && npm prune --omit=dev

# ----- Stage 2: runtime -----
# Literal pin, not an ARG: the container-publishing standard reads the
# ci-runtime-* reference off this line. It moves with the pipeline component
# pins in .gitlab-ci.yml, since old catalog tags are garbage-collected.
FROM registry.gitlab.com/dunn.dev/pipeline/ci-runtime-node:4.10.0@sha256:f5c9ba73e32e4b5de75778d1ec0b83e1f7a4f3d5bbc961e448c9915cf868eb33

WORKDIR /app

ENV NODE_ENV=production \
    # --import runs the OpenTelemetry bootstrap before listen.mjs so it
    # patches node:http first; it is a no-op unless OTHALA_OTLP_ENDPOINT is set.
    NODE_OPTIONS="--import ./dist/otel.mjs"

USER root
COPY --from=build --chown=1001:0 /src/portal/dist ./dist
COPY --from=build --chown=1001:0 /src/portal/node_modules ./node_modules
COPY --from=build --chown=1001:0 /src/portal/package.json ./package.json

# Ory policy, root-owned and read-only to the app user; `node dist/server/config.mjs render` reads it (POLICY_DIR).
COPY kratos/kratos.yml kratos/identity.schema.json /usr/share/othala/kratos/
COPY kratos/hooks/ /usr/share/othala/kratos/hooks/
COPY kratos/courier/ /usr/share/othala/kratos/courier/
COPY hydra/hydra.yml /usr/share/othala/hydra/

USER 1001

# The admin listener binds PORTAL_ADMIN_BIND_HOST and stays pod-only.
EXPOSE 8080

CMD ["node", "./dist/server/listen.mjs"]
