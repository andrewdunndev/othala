# Phase 1 lab spike .env template.
# Generate values via: bash lab/scripts/gen-secrets.sh > .env
# Then fill DOMAIN manually.

# DNS suffix the lab subdomains live under (auth-lab.${DOMAIN}, keep-lab.${DOMAIN}).
# MUST set before running — no default; e.g. DOMAIN=auth.example.com
DOMAIN=

# ACME / Let's Encrypt email used by Caddy for TLS certificate notifications.
# MUST set before running — e.g. ACME_EMAIL=admin@example.com
ACME_EMAIL=

# Othala instance identity — used for WebAuthn RP display_name, TOTP issuer,
# SMTP From, and page titles. e.g. OTHALA_INSTANCE_NAME="My Othala Lab"
OTHALA_INSTANCE_NAME=Othala

# Postgres
POSTGRES_PASSWORD=
KRATOS_PG_PASS=
HYDRA_PG_PASS=

# Kratos. Both _CURRENT and _PREVIOUS slots carry distinct secrets at
# all times: _CURRENT signs new cookies, _PREVIOUS only verifies. On
# first provision both are fresh sentinels; on rotation _PREVIOUS is
# set to the prior _CURRENT and a fresh _CURRENT is minted. Empty
# _PREVIOUS is a deploy-time error (Kratos / Hydra reject empty list
# entries). See docs/runbooks/cookie-rotation.md.
KRATOS_COOKIE_SECRET_CURRENT=
KRATOS_COOKIE_SECRET_PREVIOUS=
KRATOS_CIPHER_SECRET_CURRENT=
KRATOS_CIPHER_SECRET_PREVIOUS=

# Hydra
HYDRA_SYSTEM_SECRET=
HYDRA_COOKIE_SECRET_CURRENT=
HYDRA_COOKIE_SECRET_PREVIOUS=
HYDRA_PAIRWISE_SALT=

# Reference Kratos UI (lab-only; production drops kratos-ui)
KRATOS_UI_COOKIE_SECRET=
KRATOS_UI_CSRF_SECRET=

# LDAP bridge (compose-ldap.yml only)
KRATOS_BRIDGE_ADMIN_TOKEN=

# Portal CSRF (HIGH-1)
CSRF_SECRET=

# Recovery-gate webhook auth (MEDIUM-2)
RECOVERY_GATE_SECRET=

# LDAP bridge admin endpoint bearer (MEDIUM-5)
LDAP_BRIDGE_ADMIN_BEARER=

# OIDC client secrets
KEEP_CLIENT_SECRET=
