# Lab Caddyfile: routes Hydra public, Kratos public, consent service,
# and per-app stubs through the custom dunn.dev/caddy-estate image with
# cloudflare DNS-01.

{
	email admin@dunn.dev
}

# auth.dunn.dev: routes Kratos public, Hydra public, and the consent service.
auth.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Hydra OAuth2 endpoints — /oauth2/*, /.well-known/*, /userinfo
	@hydra path /oauth2/* /.well-known/* /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# Consent service — /login, /consent, /healthz
	@consent path /login /consent /healthz
	handle @consent {
		reverse_proxy consent:4477
	}

	# Everything else → Kratos public (self-service flows, sessions, etc.)
	reverse_proxy kratos:4433
}

# OIDC-native apps — plain reverse proxy
keep.{$DOMAIN} {
	import /etc/caddy/snippets/oidc-app.caddy
	import oidc-app vaultwarden 80
}

larder.{$DOMAIN} {
	import /etc/caddy/snippets/oidc-app.caddy
	import oidc-app mealie 9000
}

listen.{$DOMAIN} {
	import /etc/caddy/snippets/oidc-app.caddy
	import oidc-app audiobookshelf 80
}

memory.{$DOMAIN} {
	import /etc/caddy/snippets/oidc-app.caddy
	import oidc-app immich-server 2283
}

# LDAP-bound app — Jellyfin
cinema.{$DOMAIN} {
	import /etc/caddy/snippets/ldap-app.caddy
	import ldap-app jellyfin 8096
}

# Forward-auth app — Navidrome (with Subsonic API bypass)
tune.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@subsonic path /rest/* /share/*
	handle @subsonic {
		reverse_proxy navidrome:4533
	}

	handle {
		import /etc/caddy/snippets/forward-auth.caddy
		import forward-auth navidrome 4533
	}
}
