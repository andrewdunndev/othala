# LEGACY Phase 1+ lab spike Caddyfile (Topology A shape).
#
# This file is preserved as historical evidence of the Phase 3 GREEN
# lab run. Production (Topology B) consolidates everything on a single
# auth-lab subdomain — home-lab disappears. The QEMU-CI lab that
# replaces this static compose will mirror Topology B; see the issue
# at docs/qemu-ci-lab-followup.md.
#
# Hosts (legacy):
#   auth-lab.{$DOMAIN}  — Kratos public + Hydra public + consent UI mux
#   home-lab.{$DOMAIN}  — Astro portal (carmine-equivalent in lab)
#   keep-lab.{$DOMAIN}  — Vaultwarden, sample OIDC consumer
#
# Path multiplexing on auth-lab: /login is overloaded between Kratos and
# Hydra (login_challenge handoff). Disambiguated by query param. The
# portal owns /auth/*, /admin/*. WebFinger is NOT served here — Topology B
# moves it to the dunn.dev apex (Cloudflare Pages function), since
# Tailscale requires it at `${email-domain}/.well-known/webfinger`.
#
# Order of handlers matters: most specific first, since handle blocks are
# evaluated top-down and the first match wins.

{
	email admin@dunn.dev
}

auth-lab.{$DOMAIN} {
	# Kratos serves /.well-known/ory/webauthn.js for WebAuthn ceremonies.
	# Must come before kratos_ui (which matches *.js) and hydra (which
	# matches /.well-known/*).
	@kratos_wellknown path /.well-known/ory/*
	handle @kratos_wellknown {
		reverse_proxy kratos:4433
	}

	# WebFinger is NOT served here — Tailscale requires it at the email
	# domain root (`${domain}/.well-known/webfinger`), not on the IdP
	# subdomain. Production serves it from a Cloudflare Pages function
	# on the dunn.dev apex repo. See docs/decision.md "Tailscale WebFinger".

	# /login with a login_challenge is the Hydra handoff to the consent
	# service (our own dunn.dev/consent service). /login without the
	# query param is the Kratos UI login flow and falls through to the
	# kratos_ui handler below.
	@consent_login {
		path /login
		query login_challenge=*
	}
	handle @consent_login {
		reverse_proxy consent:4477
	}

	# Consent service owns /consent and /logout (Hydra calls them with
	# challenge query params). No Kratos counterpart at these paths.
	#
	# MEDIUM-1: only :4477 (public mux) is reachable from Caddy. The
	# admin mux on :4478 (/admin/*, /webhooks/*) is pod-internal; this
	# file MUST NOT route any /admin/* or /webhooks/* upstream.
	@consent_other path /consent /consent/* /logout /logout/*
	handle @consent_other {
		reverse_proxy consent:4477
	}

	# Hydra public OAuth2/OIDC endpoints (well-known/openid-config etc.)
	@hydra path /oauth2/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# Portal owns the user-facing auth flow pages and admin UI.
	@portal_pages path /auth/* /admin /admin/*
	handle @portal_pages {
		reverse_proxy portal:8080
	}

	# Kratos UI paths (login without login_challenge, registration, settings, etc.)
	# Lab keeps the reference Kratos UI for compatibility while the Astro
	# portal stabilises. Production drops kratos-ui entirely.
	@kratos_ui {
		path / /login /registration /verification /recovery /settings /welcome /home /error
		path /assets/* /static/*
		path *.css *.js *.svg *.png *.ico *.woff *.woff2 *.ttf
	}
	handle @kratos_ui {
		reverse_proxy kratos-ui:3000
	}

	# Everything else: Kratos public (self-service flows API, sessions, identities)
	reverse_proxy kratos:4433
}

home-lab.{$DOMAIN} {
	reverse_proxy portal:8080
}

keep-lab.{$DOMAIN} {
	reverse_proxy vaultwarden:80
}
