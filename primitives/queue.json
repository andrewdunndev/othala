    {"id": "p0-spine", "milestone": "M0", "rows": ["m0-twins", "m0-deps"], "globs": ["rust/Cargo.toml", "rust/Cargo.lock", "rust/justfile", "rust/crates.sh", "rust/canary.sh", "rust/canary/*", "rust/clippy.toml", "rust/deny.toml", "rust/*/gates.json", "rust/*/deps.txt", "rust/deps.txt", ".gitlab-ci.yml", "primitives/*"], "deps": ["p0-base"], "state": "landed", "model": "opus", "title": "Per-crate gate data, the ownership check, the queue and just score"},
