# Copy to othala.env. Values only; secrets go in secrets.env (DEPLOY.md). `check` refuses an unknown OTHALA_* name.
OTHALA_PUBLIC_URL=https://sso.example.org
OTHALA_APEX=example.org
OTHALA_INSTANCE_NAME=Example Household
OTHALA_CONTACT_RECIPIENT=admin@example.org
# The internal-network addresses compose.yml gives each service.
KRATOS_ADMIN_BIND_HOST=10.200.11.10
HYDRA_ADMIN_BIND_HOST=10.200.11.11
PORTAL_ADMIN_BIND_HOST=10.200.11.12
# OTHALA_OTLP_ENDPOINT=collector:4318
