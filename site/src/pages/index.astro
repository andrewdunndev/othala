---
import Layout from '../layouts/Layout.astro';
import Hero from '@dunn.dev/reference/chrome/Hero.astro';
import SectionLabel from '@dunn.dev/reference/chrome/SectionLabel.astro';
import Split from '@dunn.dev/reference/chrome/Split.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { sections } from '../lib/sections';

const manifestKeep = /^(presentation|presentation\.(name|url|access.*)|oidc|oidc\.(client_id|redirect_uris.*)|consent|consent\.group_role_map.*)$/;
const manifest = (() => {
  const out: string[] = [];
  const path: string[] = [];
  for (const line of readFileSync(resolve(process.cwd(), '../e2e/manifests/grafana.yaml'), 'utf-8').split('\n')) {
    if (!line.trim() || line.trim().startsWith('#')) continue;
    const depth = (line.length - line.trimStart().length) / 2;
    const key = line.trim().match(/^([\w-]+):/)?.[1];
    if (key) path.splice(depth, path.length, key);
    const at = key ? path.join('.') : path.slice(0, depth).join('.') + '.-';
    if (!manifestKeep.test(at)) continue;
    if (depth === 0 && out.length) out.push('');
    out.push(line);
  }
  return out.join('\n');
})();

const steps = [
  {
    eyebrow: '01 · sign in',
    title: 'One passkey, every app',
    body: 'Kratos runs the passkey ceremony once. Every app that speaks OIDC sends people to Hydra, and the portal answers Hydra\'s login and consent challenges for all of them.',
  },
  {
    eyebrow: '02 · decide',
    title: 'Groups decide the rest',
    body: 'Each app\'s manifest names one group that grants entry and maps others to roles. The portal admits on the first and puts the role in the token.',
  },
  {
    eyebrow: '03 · gate',
    title: 'Apps without OIDC still ask',
    body: 'For an app that cannot redirect, the edge asks the portal about each request before it is proxied, and gets back allow or deny.',
  },
];

const entryPoints = [
  {
    href: '/architecture/',
    label: 'Architecture',
    desc: 'How Kratos, Hydra, the portal and the edge fit together, told through six diagrams and the reasoning between them.',
  },
  ...sections.map(s => ({ href: s.href, label: s.label, desc: s.lede })),
  {
    href: 'https://gitlab.com/dunn.dev/othala',
    label: 'Source',
    desc: 'The code, the tests and the decisions log this site is a reading copy of.',
    external: true,
  },
];

const ov1Label = 'A family member opens an app through the edge proxy (1); an OIDC app sends them to Hydra to authorize (2); Hydra hands the login and consent challenges to the portal (3), which checks the passkey session with Kratos (4) and returns an id_token carrying their groups through Hydra to the app (5); for an app with no OIDC the edge asks the portal to allow or deny each request (6); and the admin manages people on the portal\'s internal listener only (7).';
---
<Layout description="Othala is one family's single sign-on: one passkey for every app in the house, groups that decide what each person can do, and the login, consent and access-gate code Ory leaves to the integrator.">
  <Hero title="Othala">
    <p>
      Othala is one family's single sign-on. One passkey gets each person
      into every app in the house, and their groups decide what they can
      do there.
    </p>
    <p>
      Ory Kratos and Hydra hold identity and issue tokens; Othala is the
      login, consent and access-gate code Ory leaves to the integrator,
      published as a worked example.
    </p>
    <Fragment slot="actions">
      <a class="cta-primary" href="/guides/golden-path/">Golden path</a>
      <a class="cta-secondary" href="/architecture/">Architecture</a>
    </Fragment>
    <figure class="shots" slot="aside">
      <div>
        <svg viewBox="318 132 484 496" preserveAspectRatio="xMidYMid meet" role="img" aria-label="The Othala sign-in page from the end-to-end test lab, with a single passkey button as the primary way in."><image href="/captures/sign-in.png" width="1120" height="760" /></svg>
        <figcaption>1 · passkey sign-in</figcaption>
      </div>
      <div>
        <svg viewBox="22 208 540 404" preserveAspectRatio="xMinYMin meet" role="img" aria-label="The dashboard a signed-in person lands on in the test lab: one tile per app their groups admit them to."><image href="/captures/dashboard.png" width="1120" height="760" /></svg>
        <figcaption>2 · every app they can open</figcaption>
      </div>
    </figure>
  </Hero>

  <figure class="cat-explainer figure-pair figure-full">
    <svg class="figure-wide" viewBox="24 28 1288 404" role="img" aria-label={ov1Label} font-family="'IBM Plex Sans', system-ui, sans-serif">
      <defs>
        <marker id="oth-ov1-arrow" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto"><path d="M0,0 L10,4 L0,8 Z" fill="var(--text-2)"/></marker>
        <marker id="oth-ov1-deny" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto"><path d="M0,0 L10,4 L0,8 Z" fill="var(--danger)"/></marker>
      </defs>
      <text x="40" y="52" font-family="'IBM Plex Mono', monospace" font-size="11" letter-spacing="0.12em" fill="var(--text-muted)"><tspan fill="var(--accent)">WHY</tspan>  ONE PASSKEY AND ONE SET OF GROUPS FOR EVERY APP; ORY SUPPLIES IDENTITY AND TOKENS, OTHALA THE DECISIONS</text>
      <g font-family="'IBM Plex Mono', monospace" font-size="10" letter-spacing="0.14em" fill="var(--text-muted)">
        <text x="40" y="78">ACTORS</text>
        <text x="316" y="194">OTHALA</text>
        <text x="330" y="78">OUTSIDE</text>
      </g>
      <rect x="300" y="172" width="560" height="252" rx="10" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
      <path d="M336,88 H1294 a6,6 0 0 1 6,6 V334 a6,6 0 0 1 -6,6 H966 a6,6 0 0 1 -6,-6 V152 H336 a6,6 0 0 1 -6,-6 V94 a6,6 0 0 1 6,-6 Z" fill="var(--surface)" stroke="var(--border)"/>
      <g fill="none" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#oth-ov1-arrow)">
        <path d="M220,120 H330"/>
        <path d="M980,266 H830"/>
        <path d="M640,266 H510"/>
        <path d="M420,316 V352"/>
        <path d="M830,298 H980"/>
        <path d="M220,280 H330"/>
      </g>
      <path d="M420,152 V244" fill="none" stroke="var(--danger)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#oth-ov1-deny)"/>
      <g font-family="'IBM Plex Mono', monospace" font-size="10" fill="var(--text-2)" stroke="var(--bg)" stroke-width="4" paint-order="stroke">
        <text x="275" y="112" text-anchor="middle">1 opens an app</text>
        <text x="905" y="258" text-anchor="middle">2 authorize</text>
        <text x="575" y="258" text-anchor="middle">3 challenges</text>
        <text x="428" y="338">4 passkey</text>
        <text x="905" y="314" text-anchor="middle">5 id_token, groups</text>
        <text x="275" y="272" text-anchor="middle">7 manages people</text>
        <text x="275" y="298" text-anchor="middle">internal listener</text>
        <text x="430" y="202" fill="var(--danger)">6 forward-auth:</text>
        <text x="430" y="216" fill="var(--danger)">allow or deny</text>
      </g>
      <g text-anchor="middle">
        <rect x="40" y="88" width="180" height="64" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="130" y="116" font-size="16" font-weight="600" fill="var(--text)">Family member</text>
        <text x="130" y="137" font-family="'IBM Plex Mono', monospace" font-size="12" fill="var(--text-2)">browser, passkey</text>
        <rect x="40" y="248" width="180" height="64" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="130" y="276" font-size="16" font-weight="600" fill="var(--text)">Admin</text>
        <text x="130" y="297" font-family="'IBM Plex Mono', monospace" font-size="12" fill="var(--text-2)">household admin</text>
        <text x="815" y="116" font-size="16" font-weight="600" fill="var(--text)">Edge proxy</text>
        <text x="815" y="137" font-family="'IBM Plex Mono', monospace" font-size="12" fill="var(--text-2)">Caddy, in front of every app</text>
        <rect x="330" y="244" width="180" height="72" rx="6" fill="var(--accent)"/>
        <text x="420" y="274" font-size="16" font-weight="600" fill="var(--accent-contrast)">Portal</text>
        <text x="420" y="295" font-family="'IBM Plex Mono', monospace" font-size="12" fill="var(--accent-contrast)" opacity="0.85">login, consent, gate</text>
        <rect x="640" y="244" width="190" height="72" rx="6" fill="var(--bg)" stroke="var(--text-2)"/>
        <text x="735" y="274" font-size="16" font-weight="600" fill="var(--text)">Hydra</text>
        <text x="735" y="295" font-family="'IBM Plex Mono', monospace" font-size="12" fill="var(--text-2)">OIDC tokens</text>
        <rect x="330" y="352" width="130" height="56" rx="6" fill="var(--bg)" stroke="var(--text-2)"/>
        <text x="395" y="376" font-size="16" font-weight="600" fill="var(--text)">Kratos</text>
        <text x="395" y="396" font-family="'IBM Plex Mono', monospace" font-size="11" fill="var(--text-2)">sessions</text>
        <rect x="980" y="244" width="140" height="72" rx="6" fill="var(--bg)" stroke="var(--border)"/>
        <text x="1050" y="274" font-size="16" font-weight="600" fill="var(--text)">OIDC apps</text>
        <text x="1050" y="295" font-family="'IBM Plex Mono', monospace" font-size="11" fill="var(--text-2)">sign in by redirect</text>
        <rect x="1140" y="244" width="140" height="72" rx="6" fill="var(--bg)" stroke="var(--border)"/>
        <text x="1210" y="274" font-size="16" font-weight="600" fill="var(--text)">No-OIDC apps</text>
        <text x="1210" y="295" font-family="'IBM Plex Mono', monospace" font-size="11" fill="var(--text-2)">gated at the edge</text>
      </g>
    </svg>
    <svg class="figure-narrow" viewBox="8 16 324 588" role="img" aria-label={ov1Label} font-family="'IBM Plex Sans', system-ui, sans-serif">
      <defs>
        <marker id="oth-ov1n-arrow" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="7" refX="9" refY="3.5" orient="auto"><path d="M0,0 L9,3.5 L0,7 Z" fill="var(--text-2)"/></marker>
        <marker id="oth-ov1n-deny" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="7" refX="9" refY="3.5" orient="auto"><path d="M0,0 L9,3.5 L0,7 Z" fill="var(--danger)"/></marker>
      </defs>
      <g font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing="0.08em" fill="var(--text-muted)">
        <text x="24" y="34"><tspan fill="var(--accent)">WHY</tspan>  ONE PASSKEY AND ONE SET OF GROUPS</text>
        <text x="24" y="48">FOR EVERY APP; ORY SUPPLIES IDENTITY</text>
        <text x="24" y="62">AND TOKENS, OTHALA THE DECISIONS</text>
      </g>
      <g font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing="0.14em" fill="var(--text-muted)">
        <text x="24" y="88">ACTORS</text>
        <text x="28" y="254">OTHALA</text>
        <text x="24" y="454">OUTSIDE</text>
      </g>
      <rect x="16" y="236" width="308" height="196" rx="10" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
      <g fill="none" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#oth-ov1n-arrow)">
        <path d="M92,140 V172"/>
        <path d="M248,140 V262"/>
        <path d="M72,350 V310"/>
        <path d="M244,310 V350"/>
        <path d="M72,462 V394"/>
        <path d="M120,394 V462"/>
      </g>
      <path d="M92,216 V262" fill="none" stroke="var(--danger)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#oth-ov1n-deny)"/>
      <g font-family="'IBM Plex Mono', monospace" font-size="9" fill="var(--text-2)" stroke="var(--bg)" stroke-width="3" paint-order="stroke">
        <text x="100" y="160">1</text>
        <text x="64" y="334" text-anchor="end">3</text>
        <text x="252" y="334">4</text>
        <text x="64" y="432" text-anchor="end">2</text>
        <text x="128" y="432">5</text>
        <text x="256" y="178">7 internal</text>
        <text x="256" y="190">listener</text>
        <text x="100" y="244" fill="var(--danger)">6</text>
      </g>
      <g text-anchor="middle">
        <rect x="24" y="96" width="136" height="44" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="92" y="123" font-size="13" font-weight="600" fill="var(--text)">Family member</text>
        <rect x="180" y="96" width="136" height="44" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="248" y="123" font-size="13" font-weight="600" fill="var(--text)">Admin</text>
        <rect x="24" y="172" width="136" height="44" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="92" y="199" font-size="13" font-weight="600" fill="var(--text)">Edge proxy</text>
        <rect x="32" y="262" width="276" height="48" rx="6" fill="var(--accent)"/>
        <text x="170" y="283" font-size="13" font-weight="600" fill="var(--accent-contrast)">Portal</text>
        <text x="170" y="300" font-family="'IBM Plex Mono', monospace" font-size="9" fill="var(--accent-contrast)" opacity="0.85">login, consent, gate</text>
        <rect x="32" y="350" width="128" height="44" rx="6" fill="var(--bg)" stroke="var(--text-2)"/>
        <text x="96" y="377" font-size="13" font-weight="600" fill="var(--text)">Hydra</text>
        <rect x="180" y="350" width="128" height="44" rx="6" fill="var(--bg)" stroke="var(--text-2)"/>
        <text x="244" y="377" font-size="13" font-weight="600" fill="var(--text)">Kratos</text>
        <rect x="32" y="462" width="128" height="44" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="96" y="489" font-size="13" font-weight="600" fill="var(--text)">OIDC apps</text>
        <rect x="180" y="462" width="128" height="44" rx="6" fill="var(--surface)" stroke="var(--border)"/>
        <text x="244" y="489" font-size="13" font-weight="600" fill="var(--text)">No-OIDC apps</text>
      </g>
      <g font-family="'IBM Plex Mono', monospace" font-size="9" fill="var(--text-2)">
        <text x="24" y="548">1 opens an app</text>
        <text x="24" y="564">2 authorize</text>
        <text x="24" y="580">3 challenges</text>
        <text x="24" y="596">4 passkey session</text>
        <text x="180" y="548">5 id_token, groups</text>
        <text x="180" y="564" fill="var(--danger)">6 allow or deny</text>
      </g>
    </svg>
    <p>Ory holds identity and issues tokens; Othala's portal makes every decision in between, from login and consent to the access gate.</p>
  </figure>

  <section class="section">
    <SectionLabel label="How it works" />
    <div class="tile-grid">
      {steps.map(s => (
        <div class="tile">
          <p class="tile-eyebrow">{s.eyebrow}</p>
          <h2 class="tile-headline">{s.title}</h2>
          <p class="tile-prose">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionLabel label="One file per app" meta="e2e/manifests/grafana.yaml, abridged" />
    <Split>
      <p class="section-prose">
        Every app Othala fronts is one manifest file: what its tile says,
        which OAuth2 client Hydra sees, and which group grants entry versus
        which grants a role. Adding an app is a file drop, not an image
        rebuild.
      </p>
      <p class="section-prose">
        The whole thing is public because most of what makes an Ory
        integration hard has no complete worked example in the open. This
        one keeps the reasoning next to the code: read it, copy it, lift a
        file out whole. It is not a pitch: no roadmap, no adoption path, one
        maintainer.
      </p>
      <pre slot="aside" class="code-block">{manifest}</pre>
    </Split>
  </section>

  <section class="section">
    <SectionLabel label="Where next" />
    <div class="tile-grid">
      {entryPoints.map(e => (
        <a href={e.href} class="tile" rel={e.external ? 'external' : undefined}>
          <h2 class="tile-headline">{e.label}{e.external ? ' ↗' : ''}</h2>
          <p class="tile-prose">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  :global(.hero-aside:has(> .shots)) { align-self: stretch; display: flex; }
  .shots { flex: 1; display: grid; grid-template-columns: 0.95fr 1.35fr; gap: var(--space-4); margin: 0; }
  .shots > div { display: flex; flex-direction: column; min-width: 0; }
  .shots svg { flex: 1 1 0; min-height: 15rem; width: 100%; display: block; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  @media (max-width: 900px) { .shots svg { flex: none; height: auto; min-height: 0; } }
  .shots figcaption { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.06em; text-transform: uppercase; margin-top: var(--space-2); }
</style>
