---
import Layout from '../layouts/Layout.astro';
import Hero from '@dunn.dev/reference/chrome/Hero.astro';
import SectionLabel from '@dunn.dev/reference/chrome/SectionLabel.astro';
import Split from '@dunn.dev/reference/chrome/Split.astro';
import Ov1 from '../figures/ov1.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { sections } from '../lib/sections';

const manifestKeep = /^(presentation|presentation\.(name|url|access.*)|oidc|oidc\.(client_id|redirect_uris.*)|consent|consent\.group_role_map.*)$/;
const manifest = (() => {
  const out: string[] = [];
  const path: string[] = [];
  for (const line of readFileSync(resolve(process.cwd(), '../e2e/content/apps/grafana.yaml'), 'utf-8').split('\n')) {
    if (!line.trim() || line.trim().startsWith('#')) continue;
    const depth = (line.length - line.trimStart().length) / 2;
    const key = line.trim().match(/^([\w-]+):/)?.[1];
    if (key) path.splice(depth, path.length, key);
    const at = key ? path.join('.') : path.slice(0, depth).join('.') + '.-';
    if (!manifestKeep.test(at)) continue;
    if (depth === 0 && out.length) out.push('');
    out.push(line);
  }
  return out.join('\n');
})();

const steps = [
  {
    eyebrow: '01 · sign in',
    title: 'One passkey, every app',
    body: 'Kratos runs the passkey ceremony once. Every app that speaks OIDC sends people to Hydra, and the portal answers Hydra\'s login and consent challenges for all of them.',
  },
  {
    eyebrow: '02 · decide',
    title: 'Groups decide the rest',
    body: 'Each app\'s manifest names one group that grants entry and maps others to roles. The portal admits on the first and puts the role in the token.',
  },
  {
    eyebrow: '03 · gate',
    title: 'Apps without OIDC still ask',
    body: 'For an app that cannot redirect, the edge asks the portal about each request before it is proxied, and gets back allow or deny.',
  },
];

const entryPoints = [
  {
    href: '/architecture/',
    label: 'Architecture',
    desc: 'How Kratos, Hydra, the portal and the edge fit together, told through six diagrams and the reasoning between them.',
  },
  ...sections.map(s => ({ href: s.href, label: s.label, desc: s.lede })),
  {
    href: 'https://gitlab.com/dunn.dev/othala',
    label: 'Source',
    desc: 'The code, the tests and the decisions log this site is a reading copy of.',
    external: true,
  },
];

---
<Layout description="Othala is one family's single sign-on: one passkey for every app in the house, groups that decide what each person can do, and the login, consent and access-gate code Ory leaves to the integrator.">
  <Hero title="Othala">
    <p>
      Othala is one family's single sign-on. One passkey gets each person
      into every app in the house, and their groups decide what they can
      do there.
    </p>
    <p>
      Ory Kratos and Hydra hold identity and issue tokens; Othala is the
      login, consent and access-gate code Ory leaves to the integrator,
      published as a worked example.
    </p>
    <Fragment slot="actions">
      <a class="cta-primary" href="/guides/per-app-oidc/">Per-app OIDC</a>
      <a class="cta-secondary" href="/architecture/">Architecture</a>
    </Fragment>
    <figure class="captures" slot="aside" style="--captures-cols:0.95fr 1.35fr">
      <div>
        <svg viewBox="318 132 484 496" role="img" aria-label="The Othala sign-in page from the end-to-end test lab, with a single passkey button as the primary way in."><svg x="318" y="132" width="484" height="496" viewBox="318 132 484 496"><image href="/captures/sign-in.png" width="1120" height="760" /></svg></svg>
        <figcaption>1 · passkey sign-in</figcaption>
      </div>
      <div>
        <svg viewBox="22 208 540 404" role="img" aria-label="The dashboard a signed-in person lands on in the test lab: one tile per app their groups admit them to."><svg x="22" y="208" width="540" height="404" viewBox="22 208 540 404"><image href="/captures/dashboard.png" width="1120" height="760" /></svg></svg>
        <figcaption>2 · every app they can open</figcaption>
      </div>
    </figure>
  </Hero>

  <figure class="cat-explainer figure-pair figure-full">
    <Ov1 />
    <p>Ory holds identity and issues tokens; Othala's portal makes every decision in between, from login and consent to the access gate.</p>
  </figure>

  <section class="section">
    <SectionLabel label="How it works" />
    <div class="tile-grid">
      {steps.map(s => (
        <div class="tile">
          <p class="tile-eyebrow">{s.eyebrow}</p>
          <h2 class="tile-headline">{s.title}</h2>
          <p class="tile-prose">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionLabel label="One file per app" meta="e2e/content/apps/grafana.yaml, abridged" />
    <Split>
      <p class="section-prose">
        Every app Othala fronts is one manifest file: what its tile says,
        which OAuth2 client Hydra sees, and which group grants entry versus
        which grants a role. Adding an app is a file drop, not an image
        rebuild.
      </p>
      <p class="section-prose">
        The whole thing is public because most of what makes an Ory
        integration hard has no complete worked example in the open. This
        one keeps the reasoning next to the code: read it, copy it, lift a
        file out whole. It is not a pitch: no roadmap, no adoption path, one
        maintainer.
      </p>
      <pre slot="aside" class="code-block">{manifest}</pre>
    </Split>
  </section>

  <section class="section">
    <SectionLabel label="Where next" />
    <div class="tile-grid">
      {entryPoints.map(e => (
        <a href={e.href} class="tile" rel={e.external ? 'external' : undefined}>
          <h2 class="tile-headline">{e.label}{e.external ? ' ↗' : ''}</h2>
          <p class="tile-prose">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
