---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve, join } from 'node:path';
import { sections, docLinkMap, type SectionPage } from '../lib/sections';
import { renderMarkdown, cardBlurb, anchorHeadings } from '../lib/render';

type IndexProps = {
  kind: 'index';
  label: string;
  lede: string;
  cards: { href: string; label: string; blurb: string; external?: boolean }[];
};
type DocProps = {
  kind: 'doc';
  label: string;
  sectionHref: string;
  sectionLabel: string;
  html: string;
  headings: { slug: string; text: string }[];
};

export function getStaticPaths() {
  const contentRoot = resolve(process.cwd(), 'src/content/docs');
  const map = docLinkMap();
  const paths: { params: { slug: string }; props: IndexProps | DocProps }[] = [];

  for (const section of sections) {
    const leaves = section.pages.filter((p: SectionPage) => p.file);
    const cardPages = section.pages.filter((p: SectionPage) => p.file || p.external);

    paths.push({
      params: { slug: section.href.replace(/^\/|\/$/g, '') },
      props: {
        kind: 'index',
        label: section.label,
        lede: section.lede,
        cards: cardPages.map((p: SectionPage) => ({
          href: p.href,
          label: p.label,
          blurb: p.blurb ?? (p.file ? cardBlurb(readFileSync(join(contentRoot, p.file), 'utf-8')) : ''),
          external: !!p.external,
        })),
      } satisfies IndexProps,
    });

    for (const p of leaves) {
      const raw = readFileSync(join(contentRoot, p.file!), 'utf-8');
      const { html, headings } = anchorHeadings(renderMarkdown(raw, map));
      paths.push({
        params: { slug: p.href.replace(/^\/|\/$/g, '') },
        props: {
          kind: 'doc',
          label: p.label,
          sectionHref: section.href,
          sectionLabel: section.label,
          html,
          headings,
        } satisfies DocProps,
      });
    }
  }
  return paths;
}

const props = Astro.props as IndexProps | DocProps;
---
{props.kind === 'index' ? (
  <Layout title={props.label} description={props.lede}>
    <header class="page-header">
      <p class="page-eyebrow">Othala</p>
      <h1 class="page-title">{props.label}</h1>
      <p class="page-lede">{props.lede}</p>
    </header>
    <section class="section">
      <div class="tile-grid">
        {props.cards.map(c => (
          <a href={c.href} class="tile" rel={c.external ? 'external' : undefined}>
            <h2 class="tile-headline">{c.label}{c.external ? ' ↗' : ''}</h2>
            <p class="tile-prose">{c.blurb}</p>
          </a>
        ))}
      </div>
    </section>
  </Layout>
) : (
  <Layout title={props.label} headings={props.headings}>
    <a href={props.sectionHref} class="page-eyebrow page-eyebrow-link">← {props.sectionLabel}</a>
    <article set:html={props.html} />
  </Layout>
)}
