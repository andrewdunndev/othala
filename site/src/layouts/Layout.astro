---
import '../styles/global.css';
import ProjectLayout from '@dunn.dev/reference/chrome/ProjectLayout.astro';
import markSvg from '../mark.svg?raw';
import { sections, sectionForPath, extraNav } from '../lib/sections';

interface Props {
  title?: string;
  description?: string;
  headings?: { slug: string; text: string }[];
  progress?: boolean;
}

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<ProjectLayout
  {...Astro.props}
  siteName="othala.dunn.dev"
  tagline="Othala: Ory for your home"
  mark={markSvg}
  nav={[...extraNav, ...sections]}
  repoUrl="https://gitlab.com/dunn.dev/othala"
  section={sectionForPath(path)}
>
  <slot />
</ProjectLayout>
