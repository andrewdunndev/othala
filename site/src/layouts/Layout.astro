---
import '../styles/global.css';
import '../styles/site-local.css';
import { sections, sectionForPath, extraNav } from '../lib/sections';

interface Props {
  title: string;
  description?: string;
  /** Page headings for the on-page TOC; shown from three up. */
  headings?: { slug: string; text: string }[];
  progress?: boolean;
}

const { title, description, headings = [], progress = false } = Astro.props;
const pageTitle = title === 'Home' || title === 'othala'
  ? 'othala.dunn.dev'
  : `${title} — othala.dunn.dev`;

// The othala rune ᛟ (home / inheritance), stroked with currentColor so
// it inherits --accent from the header. Kept in sync geometrically with
// the repo favicon.svg / mark.
const markSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" role="img" aria-label="othala rune">
  <g fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round">
    <line x1="32" y1="8" x2="48" y2="24"/>
    <line x1="48" y1="24" x2="32" y2="40"/>
    <line x1="32" y1="40" x2="16" y2="24"/>
    <line x1="16" y1="24" x2="32" y2="8"/>
    <line x1="32" y1="40" x2="18" y2="56"/>
    <line x1="32" y1="40" x2="46" y2="56"/>
  </g>
  <circle cx="32" cy="24" r="2.75" fill="currentColor"/>
</svg>`;

const nav = [...extraNav, ...sections.map(s => ({ href: s.href, label: s.label }))];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.replace(/\/$/, '');
  return path === base || path.startsWith(base + '/');
};

// Sidebar — present inside a section. Groups pages by optional `group`.
const currentSection = sectionForPath(path);
const sidebarGroups: { heading: string | null; pages: typeof sections[number]['pages'] }[] = [];
if (currentSection) {
  const lead: typeof currentSection.pages = [];
  const byGroup = new Map<string, typeof currentSection.pages>();
  for (const p of currentSection.pages) {
    if (!p.group) lead.push(p);
    else {
      if (!byGroup.has(p.group)) byGroup.set(p.group, []);
      byGroup.get(p.group)!.push(p);
    }
  }
  if (lead.length > 0) sidebarGroups.push({ heading: null, pages: lead });
  for (const [heading, pages] of byGroup) sidebarGroups.push({ heading, pages });
}
const isPageActive = (href: string) => path === href.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  <script is:inline>
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') {
      document.documentElement.dataset.theme = stored;
    }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-mark" set:html={markSvg} />
        <span class="brand-name">othala.dunn.dev</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        {nav.map(item => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
        <a href="https://gitlab.com/dunn.dev/othala" class="nav-link nav-link-external" rel="external">
          Source
        </a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span class="theme-toggle-light" aria-hidden="true">light</span>
        <span class="theme-toggle-sep" aria-hidden="true">/</span>
        <span class="theme-toggle-dark" aria-hidden="true">dark</span>
      </button>
    </div>
    {progress && <div class="scroll-progress" aria-hidden="true"></div>}
  </header>

  <main class="page">
    <div class="page-content">
      {currentSection ? (
        <div class="split split-wide">
          <div class="split-main">
            <slot />
          </div>
          <div class="split-aside">
            <aside class="section-sidebar" aria-label={`${currentSection.label} navigation`}>
              <p class="section-sidebar-heading">{currentSection.label}</p>
              {sidebarGroups.map(group => (
                <>
                  {group.heading && <p class="section-sidebar-group">{group.heading}</p>}
                  <ul class="section-sidebar-list">
                    {group.pages.map(p => (
                      <li>
                        <a href={p.href} rel={p.external ? 'external' : undefined} class:list={['section-sidebar-link', { active: isPageActive(p.href) }]}>
                          {p.label}{p.external ? ' ↗' : ''}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </aside>
            {headings.length >= 3 && (
              <aside class="section-sidebar section-toc" aria-label="On this page">
                <p class="section-sidebar-heading">On this page</p>
                <ul class="section-sidebar-list">
                  {headings.map(h => (
                    <li><a href={`#${h.slug}`} class="section-sidebar-link">{h.text}</a></li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </div>
      ) : (
        <slot />
      )}
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>othala.dunn.dev — Othala: Ory for your home</span>
      <span class="footer-sep">·</span>
      <a href="https://gitlab.com/dunn.dev/othala">repo</a>
    </div>
  </footer>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    }
  </script>
</body>
</html>
