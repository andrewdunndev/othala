# Othala — runtime environment contract
# =============================================================================
# Othala ships ONE container image; an instance is defined entirely by the env
# below (no rebuild to re-point). Copy to `.env`, fill in, and supply to the
# portal + Ory configs (which expand ${ENV} natively) and the Caddy edge.
#
# Source of truth per environment:
#   - this file        — the documented CONTRACT (placeholders only)
#   - e2e/             — the runnable example: gen-secrets.sh generates dev
#                        secrets, validate.sh renders the configs and runs the
#                        whole stack on the reserved test domain othala.test
#   - production       — supplied by the operator's secret store (sops), NEVER
#                        committed; the SECRETS block below must come from there
#
# `required` = no default; the app/Ory will fail closed if it is unset.

# ── Instance identity (set per deployment) ───────────────────────────────────
OTHALA_PUBLIC_URL=https://auth.example.com   # required. Public FQDN / OIDC issuer (no trailing slash)
OTHALA_CORS_ALLOWED_ORIGINS=https://auth.example.com   # required. Comma-separated, UNQUOTED, no spaces.
                                              #   Hydra CORS allowlist (render var; hydra/hydra.yml only).
                                              #   Browser SPA clients (e.g. oCIS Web) fetch Hydra's
                                              #   discovery/token endpoints directly from their OWN
                                              #   origin — that origin must be listed here too. Default:
                                              #   just OTHALA_PUBLIC_URL's value (single-origin, matches
                                              #   pre-extensibility behavior).
OTHALA_PUBLIC_HOST=auth.example.com          # required. Caddy site address — host only, no scheme
OTHALA_TRUSTED_PROXIES=                       # required. CIDRs of the proxies in front of Caddy (space-separated), so the rate limit
                                              #   keys on the real client; empty when Caddy faces clients directly
OTHALA_APEX=example.com                       # required. Registrable parent → Kratos cookie domain.
                                              #   One-way once passkeys enroll; pick deliberately.

# ── WebAuthn / passkeys (one-way once enrolled — confirm before first use) ────
OTHALA_WEBAUTHN_RP_ID=example.com                       # required for WebAuthn. Registrable parent domain
OTHALA_WEBAUTHN_RP_ORIGINS=https://auth.example.com     # required for WebAuthn. Single origin slot

# ── Branding / copy (safe neutral defaults; override to taste) ───────────────
OTHALA_SITE_NAME=Othala                       # title / header / footer brand. default 'Othala'
OTHALA_INSTANCE_NAME=Othala                   # TOTP issuer / WebAuthn RP name / SMTP From name. default → SITE_NAME
OTHALA_ADMIN_CONTACT=your administrator       # shown to locked-out users. default 'your administrator'

# ── Identity model ───────────────────────────────────────────────────────────
OTHALA_DEFAULT_SCHEMA_ID=default              # Kratos schema_id for portal-created identities. default 'default'
OTHALA_DEFAULT_GROUP=everyone                 # fallback access group for tiles with no explicit access_group. default 'everyone'
OTHALA_IDENTITY_GROUPS=admin                  # comma-separated, ordered; 'admin' is always first; default group appended automatically. default 'admin'
# OTHALA_ADMIN_IDS is retired — admin authority is the metadata_admin marker set via the Kratos admin API; the deploy preflight asserts no env allowlist is present.

# ── Password policy (operator knobs; overridable for offline/test environments) ─
OTHALA_HIBP_ENABLED=true           # set false for air-gapped / e2e environments (avoids network call)
OTHALA_PASSWORD_MIN_LENGTH=12      # minimum password length; default 12 per Ory recommendation

# ── Email — recovery/verification courier + dashboard contact form ───────────
# One SMTP relay serves both Kratos courier mail and the contact/request form.
OTHALA_SMTP_CONNECTION_URI=smtps://user:pass@smtp.example.com:465  # required. smtps://(465) or smtp://(587); user/pass URL-encoded
OTHALA_SMTP_FROM_ADDRESS=noreply@example.com  # From: address for outbound mail
OTHALA_CONTACT_RECIPIENT=                      # required in production. contact-form inbox address

# ── Service URLs / hosts (in-cluster; defaults usually fine in compose) ──────
KRATOS_PUBLIC_URL=https://auth.example.com    # = OTHALA_PUBLIC_URL in single-FQDN (Topology B)
HYDRA_PUBLIC_URL=https://auth.example.com     # = OTHALA_PUBLIC_URL in single-FQDN
KRATOS_ADMIN_URL=http://kratos:4434
KRATOS_ADMIN_HOST=kratos
KRATOS_ADMIN_BIND_HOST=                       # required. Interface Kratos' admin listener binds. Use an address on
HYDRA_ADMIN_BIND_HOST=                        # the internal network the edge is NOT attached to (Hydra's likewise);
                                              #   never 0.0.0.0 on a network shared with other services. The
                                              #   e2e harness uses 0.0.0.0 on its isolated test network only.
CONSENT_HOST=othala
KRATOS_PG_HOST=postgres-kratos
HYDRA_PG_HOST=postgres-hydra

# ── SECRETS — supply from your secret store (sops/Vault); NEVER commit real values
KRATOS_COOKIE_SECRET_CURRENT=
KRATOS_CIPHER_SECRET_CURRENT=
KRATOS_PG_PASS=
HYDRA_SYSTEM_SECRET=
HYDRA_COOKIE_SECRET_CURRENT=
HYDRA_PG_PASS=
RECOVERY_GATE_SECRET=
CSRF_SECRET=                        # signs CSRF tokens for the self-service flow posts
SMTP_USER=
SMTP_PASS=
CF_API_TOKEN=                      # Caddy ACME DNS-01 (Cloudflare); swap the dns provider if not CF
ACME_EMAIL=                        # Caddy ACME contact
