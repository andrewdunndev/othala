# Othala: runtime environment contract
# =============================================================================
# One container image; an instance is defined entirely by the env below. Copy to `.env`,
# fill in, and supply it to the portal, the Ory configs (rendered by scripts/render-config.sh)
# and the Caddy edge. Everything else (service hosts and ports, manifest dir, default group,
# password policy, admin freshness) is fixed in the image and the shipped configs.
#
#   - this file  the documented contract (placeholders only)
#   - e2e/       the runnable example: gen-secrets.sh and validate.sh run the whole stack
#   - production secrets come from the operator's secret store, never committed
#
# Every name outside Optional is required: unset in production, it fails the portal at boot, the Ory
# config render, or the service that reads it.

# ── Identity (set per deployment, all required) ──────────────────────────────
OTHALA_PUBLIC_URL=https://auth.example.com    # Public URL and OIDC issuer, no trailing slash. Also the Caddy site address.
OTHALA_APEX=example.com                       # Registrable parent: Kratos cookie domain and WebAuthn RP id.
                                              #   One-way once passkeys enroll; pick deliberately.
OTHALA_INSTANCE_NAME=Othala                   # Brand name, TOTP issuer, WebAuthn RP name, SMTP From name.
OTHALA_CONTACT_RECIPIENT=                     # Inbox the dashboard request form mails to.
KRATOS_ADMIN_BIND_HOST=                       # Interface Kratos' and Hydra's admin listeners bind: an address on
HYDRA_ADMIN_BIND_HOST=                        #   an internal network the edge is NOT attached to, never a
                                              #   wildcard on a network shared with other services.
PORTAL_ADMIN_BIND_HOST=                       # Portal admin-port bind: the address othala resolves to on the internal network
                                              #   (Kratos webhooks call http://othala:4431); never a wildcard.

# ── Secrets: from your secret store, never committed ─────────────────────────
KRATOS_PG_PASS=                               # Postgres role passwords, URL-safe.
HYDRA_PG_PASS=
POSTGRES_PASSWORD=                            # Postgres superuser, used by the postgres service only.
KRATOS_COOKIE_SECRET_CURRENT=
KRATOS_CIPHER_SECRET_CURRENT=
HYDRA_SYSTEM_SECRET=
HYDRA_COOKIE_SECRET_CURRENT=
RECOVERY_GATE_SECRET=                         # At least 32 bytes. Guards the Kratos webhooks.
CSRF_SECRET=                                  # At least 32 bytes. Signs the admin and flow form tokens.
OTHALA_SMTP_CONNECTION_URI=smtps://user:pass@smtp.example.com:465   # One relay for Kratos mail and the request form; user and pass URL-encoded.
<SLUG>_CLIENT_SECRET=                         # One per OIDC app manifest, e.g. GRAFANA_CLIENT_SECRET.
CF_API_TOKEN=                                 # Caddy ACME DNS-01 (Cloudflare); swap the dns provider if not CF.

# ── Optional ─────────────────────────────────────────────────────────────────
# OTHALA_OTLP_ENDPOINT=alloy:4318             # host:port, plaintext HTTP. Unset means tracing is off.
