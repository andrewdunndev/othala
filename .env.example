# Lab .env example. Copy to .env and fill in real values.
# Do NOT commit .env (gitignored).

# --- GCP lab VM ---
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-east1-b

# --- Domain ---
# Lab uses test.dunn.dev; production uses dunn.dev.
DOMAIN=test.dunn.dev

# --- Cloudflare ---
# DNS-01 ACME for *.test.dunn.dev. Token needs Zone:DNS:Edit on dunn.dev.
CF_API_TOKEN=cf_token_here

# --- Authentik bootstrap ---
AUTHENTIK_PG_PASS=change-me-postgres-password
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-bootstrap-api-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@dunn.dev

# API token is generated automatically by deploy.sh via ak create_admin_token
# and saved to .ak-token. No need to set manually.

# --- Caddy admin-path basicauth ---
# Generate via: make bcrypt   (prompts for password, outputs bcrypt hash)
# Stored bcrypt hash must escape $ as $$ in env files for Caddy to read it correctly.
ADMIN_BCRYPT_HASH=

# --- Test user password (set via scripts/set-passwords.sh) ---
TEST_USER_PASSWORD=bench-test-pass

# --- App OIDC client secrets ---
# Authentik blueprints use these as the client_secret values for each provider.
KEEP_CLIENT_SECRET=bench-keep-secret
LARDER_CLIENT_SECRET=bench-larder-secret
LISTEN_CLIENT_SECRET=bench-listen-secret
IMMICH_CLIENT_SECRET=bench-immich-secret

# --- Immich postgres ---
IMMICH_PG_PASS=bench-immich-pg
