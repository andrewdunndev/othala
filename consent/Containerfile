# consent service — small Go HTTP server, co-located with Hydra on carmine.

ARG GO_VERSION=1.22
ARG ALPINE_VERSION=3.19

FROM docker.io/library/golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder

WORKDIR /build

COPY go.mod go.sum* ./
COPY *.go ./

RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o consent .

FROM docker.io/library/alpine:${ALPINE_VERSION}

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/consent /usr/bin/consent

EXPOSE 4477

ENTRYPOINT ["/usr/bin/consent"]
