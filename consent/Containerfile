# consent service -- small Go HTTP server, co-located with Hydra on carmine.
#
# Two-stage: ci-go builder produces a static binary, ci-runtime-go
# (UBI 9 micro) runtime ships only the binary. Pinned to the dunn.dev
# pipeline catalog version; Renovate-watched.

ARG CATALOG_VERSION=2.5.1

FROM registry.gitlab.com/dunn.dev/pipeline/ci-go:${CATALOG_VERSION} AS builder

WORKDIR /build

COPY go.mod go.sum* ./
COPY *.go ./

RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o consent .

FROM registry.gitlab.com/dunn.dev/pipeline/ci-runtime-go:${CATALOG_VERSION}

COPY --from=builder /build/consent /usr/bin/consent

# Public listener (login/consent/logout handlers behind Caddy).
EXPOSE 4477
# Admin listener (recovery-gate webhook + revoke-user, pod-internal only).
EXPOSE 4478

ENTRYPOINT ["/usr/bin/consent"]
