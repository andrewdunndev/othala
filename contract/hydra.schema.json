{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunn.dev/othala/contract/hydra.schema.json",
  "type": "object",
  "required": ["urls"],
  "properties": {
    "serve": {"type": "object", "properties": {"admin": {"type": "object", "properties": {"port": {"const": 4445}}}}},
    "urls": {
      "type": "object",
      "required": ["login", "consent", "logout", "error", "device"],
      "properties": {
        "login": {"type": "string", "pattern": "^https?://[^/]+/oauth2/login$"},
        "consent": {"type": "string", "pattern": "^https?://[^/]+/oauth2/consent$"},
        "logout": {"type": "string", "pattern": "^https?://[^/]+/oauth2/logout$"},
        "error": {"type": "string", "pattern": "^https?://[^/]+/auth/error$"},
        "device": {
          "type": "object",
          "properties": {
            "verification": {"type": "string", "pattern": "^https?://[^/]+/device/verify$"},
            "success": {"type": "string", "pattern": "^https?://[^/]+/device/done$"}
          },
          "required": ["verification", "success"]
        }
      }
    }
  }
}
