{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunn.dev/othala/contract/kratos.schema.json",
  "type": "object",
  "required": ["serve", "selfservice", "identity"],
  "$defs": {
    "webhook": {
      "type": "object",
      "properties": {
        "hook": {"const": "web_hook"},
        "config": {
          "type": "object",
          "properties": {
            "method": {"const": "POST"},
            "auth": {
              "type": "object",
              "properties": {
                "type": {"const": "api_key"},
                "config": {"type": "object", "properties": {"in": {"const": "header"}, "name": {"const": "Authorization"}, "value": {"type": "string", "pattern": "^Bearer \\S+$"}}, "required": ["in", "name", "value"]}
              },
              "required": ["type", "config"]
            }
          },
          "required": ["url", "method", "auth"]
        }
      },
      "required": ["hook", "config"]
    }
  },
  "properties": {
    "serve": {
      "type": "object",
      "properties": {
        "public": {"type": "object", "properties": {"port": {"const": 4433}}},
        "admin": {"type": "object", "properties": {"base_url": {"type": "string", "pattern": "^http://kratos:4434/?$"}, "port": {"const": 4434}, "host": {"type": "string"}}, "required": ["base_url"]}
      },
      "required": ["admin"]
    },
    "selfservice": {
      "type": "object",
      "properties": {
        "flows": {
          "type": "object",
          "properties": {
            "error": {"type": "object", "required": ["ui_url"], "properties": {"ui_url": {"type": "string", "pattern": "/auth/error$"}}},
            "settings": {
              "type": "object",
              "required": ["ui_url", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "/auth/settings$"},
                "after": {
                  "type": "object",
                  "properties": {
                    "passkey": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [{"contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/passkey-prune"}}}}}}]
                        }
                      }
                    },
                    "webauthn": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [
                            {
                              "contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/second-factor-gate?method=webauthn"}}}}}
                            }
                          ]
                        }
                      }
                    },
                    "totp": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [
                            {
                              "contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/second-factor-gate?method=totp"}}}}}
                            }
                          ]
                        }
                      }
                    },
                    "profile": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [
                            {"contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/profile-gate"}}}}}},
                            {"contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/profile-sessions"}}}}}}
                          ]
                        }
                      }
                    }
                  },
                  "required": ["passkey", "webauthn", "totp", "profile"]
                }
              }
            },
            "recovery": {
              "type": "object",
              "required": ["ui_url", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "/auth/recovery$"},
                "after": {
                  "type": "object",
                  "required": ["hooks"],
                  "properties": {
                    "hooks": {
                      "type": "array",
                      "allOf": [{"contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/recovery-gate"}}}}}}]
                    }
                  }
                }
              }
            },
            "verification": {"type": "object", "required": ["ui_url"], "properties": {"ui_url": {"type": "string", "pattern": "/auth/verification$"}}},
            "login": {
              "type": "object",
              "required": ["ui_url", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "/auth/login$"},
                "after": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [{"contains": {"type": "object", "$ref": "#/$defs/webhook", "properties": {"config": {"type": "object", "properties": {"url": {"const": "http://othala:4431/admin/login-code-gate"}}}}}}]
                        }
                      }
                    }
                  },
                  "required": ["code"]
                }
              }
            },
            "registration": {"type": "object", "required": ["ui_url"], "properties": {"ui_url": {"type": "string", "pattern": "/auth/registration$"}}}
          },
          "required": ["error", "settings", "recovery", "verification", "login", "registration"]
        }
      },
      "required": ["flows"]
    },
    "session": {
      "type": "object",
      "properties": {"whoami": {"type": "object", "properties": {"required_aal": {"const": "aal1"}}}, "cookie": {"type": "object", "properties": {"name": {"const": "ory_kratos_session"}, "domain": {"type": "string"}}}}
    },
    "identity": {
      "type": "object",
      "properties": {
        "default_schema_id": {"const": "family"},
        "schemas": {"type": "array", "contains": {"type": "object", "properties": {"id": {"const": "family"}, "url": {"type": "string", "pattern": "(^|/)identity\\.schema\\.json$"}}, "required": ["id", "url"]}}
      },
      "required": ["default_schema_id", "schemas"]
    }
  }
}
