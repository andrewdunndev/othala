{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunn.dev/othala/contract/kratos.schema.json",
  "type": "object",
  "required": ["selfservice", "identity"],
  "$defs": {
    "oneOrTwo": {"type": "array", "minItems": 1, "maxItems": 2},
    "webhook": {
      "type": "object",
      "properties": {
        "hook": {"const": "web_hook"},
        "config": {
          "type": "object",
          "properties": {
            "method": {"const": "POST"},
            "auth": {
              "type": "object",
              "properties": {
                "type": {"const": "api_key"},
                "config": {
                  "type": "object",
                  "properties": {
                    "in": {"const": "header"},
                    "name": {"const": "Authorization"},
                    "value": {"type": "string", "pattern": "^Bearer \\S+$"}
                  },
                  "required": ["in", "name", "value"]
                }
              },
              "required": ["type", "config"]
            },
            "response": {"type": "object", "properties": {"parse": {"const": false}}, "required": ["ignore", "parse"]},
            "body": {"const": "file:///etc/config/kratos/hooks/recovery-gate.jsonnet"}
          },
          "required": ["url", "method", "auth", "can_interrupt", "response", "body"]
        }
      },
      "required": ["hook", "config"]
    },
    "hook_passkey_prune": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/passkey-prune"},
                "can_interrupt": {"const": false},
                "response": {"type": "object", "properties": {"ignore": {"const": true}}}
              }
            }
          }
        }
      ]
    },
    "hook_second_factor_gate_webauthn": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/second-factor-gate?method=webauthn"},
                "can_interrupt": {"const": true},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    },
    "hook_second_factor_gate_totp": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/second-factor-gate?method=totp"},
                "can_interrupt": {"const": true},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    },
    "hook_profile_gate": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/profile-gate"},
                "can_interrupt": {"const": true},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    },
    "hook_profile_sessions": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/profile-sessions"},
                "can_interrupt": {"const": false},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    },
    "hook_recovery_gate": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/recovery-gate"},
                "can_interrupt": {"const": true},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    },
    "hook_login_code_gate": {
      "allOf": [
        {"$ref": "#/$defs/webhook"},
        {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "url": {"const": "http://othala:4431/admin/login-code-gate"},
                "can_interrupt": {"const": true},
                "response": {"type": "object", "properties": {"ignore": {"const": false}}}
              }
            }
          }
        }
      ]
    }
  },
  "not": {"required": ["oauth2_provider"]},
  "properties": {
    "secrets": {"type": "object", "properties": {"cookie": {"$ref": "#/$defs/oneOrTwo"}, "cipher": {"$ref": "#/$defs/oneOrTwo"}}},
    "serve": {
      "type": "object",
      "properties": {
        "public": {"type": "object", "properties": {"port": {"const": 4433}}},
        "admin": {"type": "object", "properties": {"port": {"const": 4434}}}
      }
    },
    "selfservice": {
      "type": "object",
      "properties": {
        "flows": {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "required": ["ui_url"],
              "properties": {"ui_url": {"type": "string", "pattern": "^https?://[^/]+/auth/error$"}}
            },
            "settings": {
              "type": "object",
              "required": ["ui_url", "privileged_session_max_age", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "^https?://[^/]+/auth/settings$"},
                "privileged_session_max_age": {"const": "5m"},
                "required_aal": {"const": "highest_available"},
                "after": {
                  "type": "object",
                  "properties": {
                    "passkey": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {"hooks": {"type": "array", "contains": {"$ref": "#/$defs/hook_passkey_prune"}}}
                    },
                    "webauthn": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {"hooks": {"type": "array", "contains": {"$ref": "#/$defs/hook_second_factor_gate_webauthn"}}}
                    },
                    "totp": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {"hooks": {"type": "array", "contains": {"$ref": "#/$defs/hook_second_factor_gate_totp"}}}
                    },
                    "profile": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {
                        "hooks": {
                          "type": "array",
                          "allOf": [
                            {"contains": {"$ref": "#/$defs/hook_profile_gate"}},
                            {"contains": {"$ref": "#/$defs/hook_profile_sessions"}}
                          ]
                        }
                      }
                    }
                  },
                  "required": ["passkey", "webauthn", "totp", "profile"]
                }
              }
            },
            "recovery": {
              "type": "object",
              "required": ["ui_url", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "^https?://[^/]+/auth/recovery$"},
                "after": {
                  "type": "object",
                  "required": ["hooks"],
                  "properties": {"hooks": {"type": "array", "contains": {"$ref": "#/$defs/hook_recovery_gate"}}}
                }
              }
            },
            "verification": {
              "type": "object",
              "required": ["ui_url"],
              "properties": {"ui_url": {"type": "string", "pattern": "^https?://[^/]+/auth/verification$"}}
            },
            "login": {
              "type": "object",
              "required": ["ui_url", "after"],
              "properties": {
                "ui_url": {"type": "string", "pattern": "^https?://[^/]+/auth/login$"},
                "after": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "object",
                      "required": ["hooks"],
                      "properties": {"hooks": {"type": "array", "contains": {"$ref": "#/$defs/hook_login_code_gate"}}}
                    }
                  },
                  "required": ["code"]
                }
              }
            },
            "registration": {"type": "object", "properties": {"enabled": {"const": false}}, "required": ["enabled"]}
          },
          "required": ["error", "settings", "recovery", "verification", "login", "registration"]
        },
        "methods": {"type": "object", "properties": {"code": {"type": "object", "properties": {"mfa_enabled": {"const": false}}}}}
      },
      "required": ["flows"]
    },
    "session": {
      "type": "object",
      "properties": {
        "whoami": {"type": "object", "properties": {"required_aal": {"const": "aal1"}}, "required": ["required_aal"]},
        "cookie": {"type": "object", "properties": {"name": {"const": "ory_kratos_session"}}}
      },
      "required": ["whoami"]
    },
    "identity": {
      "type": "object",
      "properties": {
        "default_schema_id": {"const": "family"},
        "schemas": {
          "type": "array",
          "contains": {"type": "object", "properties": {"id": {"const": "family"}}, "required": ["id"]},
          "items": {
            "if": {"type": "object", "properties": {"id": {"const": "family"}}, "required": ["id"]},
            "then": {
              "type": "object",
              "properties": {"url": {"const": "file:///etc/config/kratos/identity.schema.json"}},
              "required": ["url"]
            }
          }
        }
      },
      "required": ["default_schema_id", "schemas"]
    }
  }
}
