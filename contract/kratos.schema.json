{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunn.dev/othala/contract/kratos.schema.json",
  "type": "object",
  "required": [
    "serve",
    "selfservice",
    "identity"
  ],
  "$defs": {
    "webhook": {
      "type": "object",
      "required": [
        "hook",
        "config"
      ],
      "properties": {
        "hook": {
          "const": "web_hook"
        },
        "config": {
          "type": "object",
          "required": [
            "url",
            "method",
            "auth"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "auth": {
              "type": "object",
              "required": [
                "type",
                "config"
              ],
              "properties": {
                "type": {
                  "const": "api_key"
                },
                "config": {
                  "type": "object",
                  "required": [
                    "in",
                    "name",
                    "value"
                  ],
                  "properties": {
                    "in": {
                      "const": "header"
                    },
                    "name": {
                      "const": "Authorization"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^Bearer \\S+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "serve": {
      "type": "object",
      "required": [
        "admin"
      ],
      "properties": {
        "public": {
          "type": "object",
          "properties": {
            "port": {
              "const": 4433
            }
          }
        },
        "admin": {
          "type": "object",
          "required": [
            "base_url"
          ],
          "properties": {
            "base_url": {
              "type": "string",
              "pattern": "^http://kratos:4434/?$"
            },
            "port": {
              "const": 4434
            },
            "host": {
              "type": "string"
            }
          }
        }
      }
    },
    "selfservice": {
      "type": "object",
      "required": [
        "flows"
      ],
      "properties": {
        "flows": {
          "type": "object",
          "required": [
            "error",
            "settings",
            "recovery",
            "verification",
            "login",
            "registration"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "ui_url"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/error$"
                }
              }
            },
            "settings": {
              "type": "object",
              "required": [
                "ui_url",
                "after"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/settings$"
                },
                "after": {
                  "type": "object",
                  "properties": {
                    "passkey": {
                      "type": "object",
                      "required": [
                        "hooks"
                      ],
                      "properties": {
                        "hooks": {
                          "allOf": [
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/passkey-prune"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    "webauthn": {
                      "type": "object",
                      "required": [
                        "hooks"
                      ],
                      "properties": {
                        "hooks": {
                          "allOf": [
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/second-factor-gate?method=webauthn"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    "totp": {
                      "type": "object",
                      "required": [
                        "hooks"
                      ],
                      "properties": {
                        "hooks": {
                          "allOf": [
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/second-factor-gate?method=totp"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "hooks"
                      ],
                      "properties": {
                        "hooks": {
                          "allOf": [
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/profile-gate"
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/profile-sessions"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "passkey",
                    "webauthn",
                    "totp",
                    "profile"
                  ]
                }
              }
            },
            "recovery": {
              "type": "object",
              "required": [
                "ui_url",
                "after"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/recovery$"
                },
                "after": {
                  "type": "object",
                  "required": [
                    "hooks"
                  ],
                  "properties": {
                    "hooks": {
                      "allOf": [
                        {
                          "contains": {
                            "$ref": "#/$defs/webhook",
                            "properties": {
                              "config": {
                                "properties": {
                                  "url": {
                                    "const": "http://othala:4431/admin/recovery-gate"
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            "verification": {
              "type": "object",
              "required": [
                "ui_url"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/verification$"
                }
              }
            },
            "login": {
              "type": "object",
              "required": [
                "ui_url",
                "after"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/login$"
                },
                "after": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "object",
                      "required": [
                        "hooks"
                      ],
                      "properties": {
                        "hooks": {
                          "allOf": [
                            {
                              "contains": {
                                "$ref": "#/$defs/webhook",
                                "properties": {
                                  "config": {
                                    "properties": {
                                      "url": {
                                        "const": "http://othala:4431/admin/login-code-gate"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "registration": {
              "type": "object",
              "required": [
                "ui_url"
              ],
              "properties": {
                "ui_url": {
                  "type": "string",
                  "pattern": "/auth/registration$"
                }
              }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "whoami": {
          "type": "object",
          "properties": {
            "required_aal": {
              "const": "aal1"
            }
          }
        },
        "cookie": {
          "type": "object",
          "properties": {
            "name": {
              "const": "ory_kratos_session"
            },
            "domain": {
              "type": "string"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "default_schema_id",
        "schemas"
      ],
      "properties": {
        "default_schema_id": {
          "const": "family"
        },
        "schemas": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "url"
            ],
            "properties": {
              "id": {
                "const": "family"
              },
              "url": {
                "type": "string",
                "pattern": "(^|/)identity\\.schema\\.json$"
              }
            }
          }
        }
      }
    }
  }
}
