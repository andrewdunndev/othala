# dunn.dev/othala-util -- one-shot operator container.
#
# v0.1.4: this image carries the small toolchain (curl + jq + yq +
# apply-clients.sh) needed to register OIDC client manifests with the
# auth-hydra admin API on carmine. The Hydra admin port is
# auth.network-internal — invoking apply-clients from the operator
# workstation wouldn't reach it — so we run apply-clients inside a
# container on the auth.network instead.
#
# Use as a one-shot quadlet (Type=oneshot, RemainAfterExit=false) or
# via `podman run --rm --network=auth …`. Designed to be idempotent;
# each invocation walks /etc/util/manifests/*.yaml and creates-or-
# updates each Hydra client.
#
# Why a separate image, not bolted into consent or portal:
# - Bootstrap concerns separate from runtime app concerns.
# - Tiny image (UBI minimal + 3 tools) — no Node/Go runtime.
# - Reusable for future ops scripts (manifest dumps, identity
#   bulk-imports, hydra debugging).
#
# Local build:
#   podman build -t dunn.dev/othala-util:lab -f util/Containerfile .
# Local run (against the lab compose stack):
#   podman run --rm --network=auth_default \
#     -v $(pwd)/hydra/clients:/etc/util/manifests:ro \
#     -e HYDRA_ADMIN_URL=http://auth-hydra:4445 \
#     -e KEEP_CLIENT_SECRET=... \
#     dunn.dev/othala-util:lab apply-clients

ARG CATALOG_VERSION=2.5.0

# UBI 9 minimal carries microdnf + a tiny package set, enough for
# curl + jq + yq install at build time. The pipeline catalog's
# ci-runtime-* are too narrow (-go is for Go binaries, -node for
# Astro). Use UBI 9 minimal directly.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

# Tools:
# - curl: HTTP POST/PUT/GET against Hydra admin API
# - jq:   JSON shaping (Hydra request/response bodies)
# - yq:   YAML → JSON conversion for manifest yamls (kislyuk python-yq;
#         install via pip)
# - bash: the apply-clients.sh script
# - python3 + pip: yq's Python runtime
RUN microdnf install -y --nodocs \
        bash \
        curl \
        jq \
        python3 \
        python3-pip \
        ca-certificates \
    && pip3 install --no-cache-dir yq \
    && microdnf clean all \
    && rm -rf /var/cache/yum

# Bundle apply-clients.sh into the image at a stable path. The
# operator passes the manifest dir + per-client secrets via volume +
# env at podman run / quadlet time.
COPY util/apply-clients.sh /usr/local/bin/apply-clients
RUN chmod 0755 /usr/local/bin/apply-clients

# Default working dir is where apply-clients reads manifests from.
# The iac quadlet mounts /var/srv/auth/consent/manifests/ (shared with
# the consent service) here. Lab mounts hydra/clients/ directly.
ENV CLIENTS_DIR=/etc/util/manifests
WORKDIR /work

# No ENTRYPOINT — caller specifies (apply-clients, or any other tool
# in /usr/local/bin). Default CMD is the one-shot apply-clients.
CMD ["/usr/local/bin/apply-clients"]
