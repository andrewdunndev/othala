# Custom Caddy image for the dunn.dev estate.
#
# Built directly from upstream Caddy + plugin Go modules with `go build`.
# No xcaddy, no helper tool: same pattern as basef builds ZFS/NVIDIA from
# source. The build is one main.go that imports the modules we want, plus
# `go mod tidy` and `go build`.
#
# Single plugin: caddy-dns/cloudflare for DNS-01 ACME on *.dunn.dev.
# Forward-auth is handled by the Authentik proxy outpost (built into
# Authentik), so no second plugin is needed in this image.

ARG GO_VERSION=1.22
ARG ALPINE_VERSION=3.19

FROM docker.io/library/golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder

ARG CADDY_VERSION=v2.8.4
ARG CADDY_DNS_CLOUDFLARE_VERSION=v0.2.1

WORKDIR /build

# main.go imports Caddy core + cloudflare DNS plugin as side-effect imports.
# Caddy registers each module in init(); calling caddycmd.Main() boots the
# server with all of them available.
RUN <<'EOF'
cat > main.go << 'GO'
package main

import (
	caddycmd "github.com/caddyserver/caddy/v2/cmd"

	// Standard Caddy modules (reverse_proxy, file_server, basicauth, rate_limit, etc.)
	_ "github.com/caddyserver/caddy/v2/modules/standard"

	// DNS-01 ACME via Cloudflare
	_ "github.com/caddy-dns/cloudflare"
)

func main() {
	caddycmd.Main()
}
GO
EOF

RUN go mod init dunn.dev/caddy-estate
RUN go get github.com/caddyserver/caddy/v2@${CADDY_VERSION}
RUN go get github.com/caddy-dns/cloudflare@${CADDY_DNS_CLOUDFLARE_VERSION}
RUN go mod tidy

# Static binary; CGO disabled so the runtime image can be alpine.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o caddy .

FROM docker.io/library/alpine:${ALPINE_VERSION}

RUN apk add --no-cache ca-certificates mailcap

COPY --from=builder /build/caddy /usr/bin/caddy
COPY --from=builder /build/go.mod /build/go.sum /usr/share/caddy-estate/

# Sanity-check the cloudflare plugin is loaded.
RUN /usr/bin/caddy list-modules 2>/dev/null | \
	grep 'dns.providers.cloudflare' >/dev/null || \
	(echo "plugin verification failed" && exit 1)

EXPOSE 80 443 443/udp

ENTRYPOINT ["/usr/bin/caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
