# Reusable Caddy snippet — admin path session-check
#
# Usage in a per-app Caddyfile:
#   import admin-session
#   reverse_proxy app:1234
#
# CRITICAL DESIGN NOTE: This snippet only checks "user has a Kratos session
# (any AAL)." It does NOT enforce AAL2 step-up.
#
# AAL2 enforcement on /admin/* lives at the Astro SSR page layer. The
# admin page reads session.authenticator_assurance_level from the whoami
# response and redirects to /self-service/login?refresh=true&aal=aal2 if
# the session is below aal2.
#
# Why not Caddy: Kratos AAL is a JSON body field, not an HTTP status code.
# forward_auth is binary 2xx/non-2xx, so it can't conditionally gate on
# AAL info. App-layer enforcement is the documented Ory pattern.

(admin-session) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Verify the request has a valid Kratos session
	forward_auth kratos:4433 {
		uri /sessions/whoami
		copy_headers X-Kratos-Authenticated-Identity-Id

		@unauthorized status 401 403
		handle_response @unauthorized {
			redir {env.OTHALA_PUBLIC_URL}/auth/login?return_to={http.request.uri} 302
		}
	}
	# Strip spoofable inbound identity headers before the caller's reverse_proxy
	# forwards the request to the upstream. This snippet does not own the
	# reverse_proxy block (the caller does), so request_header is used here to
	# mutate the request in-place for all subsequent handlers in the same site
	# block. X-Kratos-Authenticated-Identity-Id is safe after this point because
	# copy_headers above re-sets it from the authoritative whoami response.
	request_header -X-Kratos-Authenticated-Identity-Id
	request_header -X-Kratos-Groups
	request_header -X-Remote-User
	request_header -X-Remote-Groups
	request_header -X-Remote-Email
	request_header -X-Remote-Name
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Groups
	request_header -X-Forwarded-Email
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Email

	# After this snippet, the surrounding Caddyfile block does its own
	# reverse_proxy to the upstream. The upstream (typically the Astro
	# admin app) is responsible for the AAL2 step-up check.
}
