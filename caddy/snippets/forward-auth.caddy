# Reusable Caddy snippet — forward-auth via Kratos /sessions/whoami
#
# Usage in a per-app Caddyfile:
#   import forward-auth navidrome 4533
#
# Caddy's built-in forward_auth directive calls Kratos to verify the user's
# session. If valid (200 from whoami), proxies to the upstream with identity
# headers. If invalid (401), redirects to the home portal login.
#
# Per-app group enforcement (e.g., access-tune required for tune.dunn.dev)
# is performed at the app layer reading the X-Kratos-Groups header,
# OR via a small wrapper service if the app doesn't support header-based
# authz. Caddy alone cannot conditionally gate on JSON-body claims.
#
# Args:
#   $1 = upstream container name
#   $2 = upstream port

(forward-auth) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	forward_auth kratos:4433 {
		uri /sessions/whoami
		copy_headers X-Kratos-Authenticated-Identity-Id

		# Kratos /sessions/whoami returns 200 with full session JSON if
		# valid, 401 if not. Caddy treats non-2xx as "not authorized"
		# and falls through to the handle_response below.
		@unauthorized status 401 403
		handle_response @unauthorized {
			redir {env.OTHALA_PUBLIC_URL}/auth/login?return_to={http.request.uri.path}&domain={http.request.host} 302
		}
	}

	reverse_proxy {args[0]}:{args[1]} {
		# Strip Cookie header before forwarding to upstream so the
		# Kratos session cookie doesn't leak into app logs.
		header_up -Cookie
	}
}
