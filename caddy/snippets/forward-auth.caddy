# Reusable Caddy snippet — forward-auth through the portal's /api/forward-auth
#
# Usage in a per-app Caddyfile:
#   import forward-auth audiobookshelf 13378 audiobookshelf-access
#
# Caddy's built-in forward_auth directive calls the portal, which checks the
# Kratos session and the identity's membership of the required group
# server-side, and injects the verified identity id
# (X-Kratos-Authenticated-Identity-Id) into the proxied request. Inbound
# identity headers are stripped (see the request_header and header_up lines
# below), so a client cannot spoof one.
#
# Status contract: portal/src/pages/api/forward-auth.ts. Only a 401 redirects
# to login; a 403 or 503 is returned as is, since redirecting a refusal or an
# outage loops the visitor through login. An omitted $3 arrives empty and is
# refused with 403, so a copy without it fails closed.
#
# Args:
#   $1 = upstream container name
#   $2 = upstream port
#   $3 = required group, e.g. audiobookshelf-access

(forward-auth) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# route runs its handlers in the order written. Outside it, Caddy sorts
	# directives by its default order, which puts forward_auth before
	# request_header: the strip would then run after copy_headers and delete
	# the verified id. Written order here: strip the inbound id, verify the
	# session and group and copy the id from the response, then proxy.
	route {
		# Drop any client-supplied identity id before the auth call, so the
		# only value that can reach the upstream is the one copy_headers takes
		# from the portal response.
		request_header -X-Kratos-Authenticated-Identity-Id

		forward_auth othala:8080 {
			uri /api/forward-auth?group={args[2]}
			copy_headers X-Kratos-Authenticated-Identity-Id

			# return_to must be ABSOLUTE. A path-only value resolves against
			# the portal's own host, so the user lands back on the portal
			# instead of the service they were trying to reach — which defeats
			# the apex wildcard in kratos.yml `allowed_return_urls`. Scheme and
			# host are taken from the request being gated.
			#
			# That allowlist, not this snippet, is what bounds the value: a
			# request carrying a Host outside the apex yields a return_to Kratos
			# refuses, and the user is sent to `default_browser_return_url`
			# instead — degraded, never an off-apex redirect.
			@unauthorized status 401
			handle_response @unauthorized {
				redir {env.OTHALA_PUBLIC_URL}/auth/login?return_to={http.request.scheme}://{http.request.host}{http.request.uri.path} 302
			}
		}

		reverse_proxy {args[0]}:{args[1]} {
			# Forward-auth upstreams get no cookies: this strips every
			# cookie, the Kratos session cookie included.
			header_up -Cookie

			# Strip spoofable inbound identity headers before they reach the
			# upstream. Caddy forward_auth does NOT strip headers the client
			# sends; only copy_headers-sourced values are trusted. A logged-in
			# user could otherwise inject X-Kratos-Groups: admin (or any
			# equivalent) and pass per-app group checks at the app layer.
			#
			# X-Kratos-Authenticated-Identity-Id is stripped by request_header
			# ahead of forward_auth in this route and set from the portal
			# response by copy_headers, so it is deliberately not removed here.
			header_up -X-Kratos-Groups
			header_up -X-Remote-User
			header_up -X-Remote-Groups
			header_up -X-Remote-Email
			header_up -X-Remote-Name
			header_up -X-Forwarded-User
			header_up -X-Forwarded-Groups
			header_up -X-Forwarded-Email
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Groups
			header_up -X-Auth-Request-Email
		}
	}
}
