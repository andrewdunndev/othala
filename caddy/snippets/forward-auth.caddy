# Reusable Caddy snippet — forward-auth via Kratos /sessions/whoami
#
# Usage in a per-app Caddyfile:
#   import forward-auth audiobookshelf 13378
#
# Caddy's built-in forward_auth directive calls Kratos to verify the user's
# session. If valid (200 from whoami), proxies to the upstream with identity
# headers. If invalid (401), redirects to the home portal login.
#
# This snippet establishes ONLY that a valid Kratos session exists and
# injects the trusted identity id from whoami (X-Kratos-Authenticated-Identity-Id).
# It does NOT pass group claims: whoami does not emit them, and inbound
# identity headers are stripped (see header_up lines below) so a client
# cannot spoof group membership.
#
# Per-app GROUP enforcement must be done one of two ways:
#   (a) OIDC apps: use the portal's OIDC access-gate (audience/scope claims
#       from Hydra carry authoritative group membership).
#   (b) Non-OIDC apps needing group checks: add a dedicated forward_auth
#       endpoint that resolves group membership server-side via the Kratos
#       admin API and returns 200/401/403/503 — never trust a passed header.
#       That endpoint is portal/src/pages/api/forward-auth.ts; its header
#       comment is the status contract. 503 is not decoration: it is what
#       separates "the identity provider did not answer" from "you are
#       refused", so an edge can keep an outage out of its redirect arm.
#
# Args:
#   $1 = upstream container name
#   $2 = upstream port

(forward-auth) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	forward_auth kratos:4433 {
		uri /sessions/whoami
		copy_headers X-Kratos-Authenticated-Identity-Id

		# Kratos /sessions/whoami returns 200 with full session JSON if
		# valid, 401 if not. Caddy treats non-2xx as "not authorized"
		# and falls through to the handle_response below. 403 is listed
		# too because getSession (portal/src/lib/kratos.ts) treats both
		# the same way: "e.response.status === 401 || e.response.status
		# === 403" → a null session.
		#
		# 503 is deliberately absent, and must stay absent in any edge
		# copied from this snippet. handle_response below redirects to
		# the portal's login flow; matching 503 into that arm would send
		# a visitor to the login page of the very portal that just failed
		# to answer, and bounce them there on every retry — the infinite
		# login loop the four-status contract in
		# portal/src/pages/api/forward-auth.ts exists to prevent. An
		# outage must stay a flat error, not a redirect.
		#
		# return_to must be ABSOLUTE. A path-only value resolves against
		# the portal's own host, so the user lands back on the portal
		# instead of the service they were trying to reach — which defeats
		# the apex wildcard in kratos.yml `allowed_return_urls`. Scheme and
		# host are taken from the request being gated.
		#
		# That allowlist, not this snippet, is what bounds the value: a
		# request carrying a Host outside the apex yields a return_to Kratos
		# refuses, and the user is sent to `default_browser_return_url`
		# instead — degraded, never an off-apex redirect.
		@unauthorized status 401 403
		handle_response @unauthorized {
			redir {env.OTHALA_PUBLIC_URL}/auth/login?return_to={http.request.scheme}://{http.request.host}{http.request.uri.path} 302
		}
	}

	reverse_proxy {args[0]}:{args[1]} {
		# Strip the Kratos session cookie before forwarding to upstream
		# so it doesn't leak into app logs.
		header_up -Cookie

		# Strip spoofable inbound identity headers before they reach the
		# upstream. Caddy forward_auth does NOT strip headers the client
		# sends; only copy_headers-sourced values are trusted. A logged-in
		# user could otherwise inject X-Kratos-Groups: admin (or any
		# equivalent) and bypass per-app group enforcement at the app layer.
		#
		# X-Kratos-Authenticated-Identity-Id is re-added from whoami by the
		# copy_headers directive above (belt-and-suspenders: strip then re-set
		# from the auth response so the value is always authoritative).
		header_up -X-Kratos-Authenticated-Identity-Id
		header_up -X-Kratos-Groups
		header_up -X-Remote-User
		header_up -X-Remote-Groups
		header_up -X-Remote-Email
		header_up -X-Remote-Name
		header_up -X-Forwarded-User
		header_up -X-Forwarded-Groups
		header_up -X-Forwarded-Email
		header_up -X-Auth-Request-User
		header_up -X-Auth-Request-Groups
		header_up -X-Auth-Request-Email
	}
}
