# Reusable Caddy snippet — OIDC-native app
#
# Usage in a per-app Caddyfile:
#   import oidc-app grafana 3000
#
# TLS via DNS-01 + a plain reverse_proxy. The app handles its own OIDC
# redirect to Hydra; Caddy is just the reverse proxy + TLS terminator.
#
# The app keeps its own cookies; only the Kratos session cookie is removed
# before forwarding, so it never reaches the upstream or its logs. Caddy has
# no single-cookie delete, so a regexp replace on the Cookie header does it.
#
# Args:
#   $1 = upstream container name
#   $2 = upstream port

(oidc-app) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	request_header Cookie "\s*ory_kratos_session=[^;]*;?\s*" ""
	reverse_proxy {args[0]}:{args[1]}
}
