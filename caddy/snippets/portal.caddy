# Reusable Caddy snippet — Astro Node SSR portal mux for carmine.
#
# Topology B (v0.1.4): the portal serves auth.dunn.dev exclusively.
# The Hydra consent service shares auth.dunn.dev for OAuth2/OIDC
# handlers (/login with login_challenge, /consent, /logout). Path
# discipline is essential because both upstreams reply on the same
# host.
#
# home.dunn.dev was the Topology A user-facing host; dropped in v0.1.4.
# The tile dashboard now lives at auth.dunn.dev/ (session-gated).
#
# Single Caddyfile block expected at the carmine top-level:
#
#   auth.dunn.dev {
#     import portal-tls
#     import auth-mux
#   }
#
# `portal-tls` here just standardises the DNS-01 ACME issuer.
#
# `auth-mux` does the path split. Order matters: most specific first.
# Anything matching the portal goes to the portal pod; everything else
# falls through to the consent service or Kratos public.
#
# NOTE: WebFinger is NOT served from this snippet. RFC 7033 + Tailscale
# require WebFinger at `${email-domain}/.well-known/webfinger` (the
# apex), not on the IdP subdomain. dunn.dev/.well-known/webfinger is
# served by a Cloudflare Pages function on the dunn.dev apex repo.

(portal-tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

(auth-mux) {
	# WebAuthn ceremony script Kratos hosts under /.well-known/ory/*.
	# Must come before any /.well-known/* generic match.
	@kratos_wellknown path /.well-known/ory/*
	handle @kratos_wellknown {
		reverse_proxy kratos:4433
	}

	# Hydra-flagged login (login_challenge present) -> consent service.
	@hydra_login {
		path /login
		query login_challenge=*
	}
	handle @hydra_login {
		reverse_proxy consent:4477
	}

	# Hydra consent + logout (no Kratos counterpart at these exact paths).
	@hydra_other path /consent /consent/* /logout /logout/*
	handle @hydra_other {
		reverse_proxy consent:4477
	}

	# Hydra public OAuth2/OIDC endpoints.
	@hydra path /oauth2/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# Portal owns the user-facing auth flow pages and the admin UI.
	# These are SSR pages on the portal Node server.
	@portal_pages path /auth/* /admin /admin/*
	handle @portal_pages {
		reverse_proxy portal:8080
	}

	# Everything else on auth.dunn.dev goes to Kratos public
	# (self-service flow API, sessions/whoami, etc.).
	reverse_proxy kratos:4433
}
