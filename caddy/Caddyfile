# Worked Caddyfile for one Othala instance (an adopter example, not a drop-in deploy file).
# Site address: $OTHALA_PUBLIC_HOST. TLS: DNS-01 via caddy-dns/cloudflare and CF_API_TOKEN; swap the
# tls block for another solver. Upstreams: kratos:4433, hydra:4444, othala:8080.
# The default backend is the app so static assets (/_astro/*, favicon, manifest) keep their
# Content-Type; /oauth2/{login,consent,logout} are app challenge handlers. rate_limit is mholt/caddy-ratelimit.

{
	order rate_limit before basicauth
}

{$OTHALA_PUBLIC_HOST} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Hydra public OAuth2 surface + OIDC discovery.
	@hydra path /oauth2/auth /oauth2/token /oauth2/revoke /oauth2/sessions/logout /oauth2/fallbacks/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# App-owned Hydra challenge handlers.
	@portal_challenges path /oauth2/login /oauth2/consent /oauth2/logout
	handle @portal_challenges {
		# XFF overwrite: see the default backend below.
		reverse_proxy othala:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Kratos browser endpoints. Rate-limited per client IP against email-bombing via repeated
	# sign-in code requests.
	@kratos path /.well-known/ory/* /self-service/* /sessions/* /schemas/*
	handle @kratos {
		rate_limit {
			zone othala_selfservice {
				key    {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy kratos:4433
	}

	# Default -> the app (UI, pages, static assets). Overwrite any client-supplied X-Forwarded-For
	# with the socket peer: @astrojs/node reads the leftmost entry, so a spoofed prefix would land
	# in a fresh rate-limit bucket on every request.
	reverse_proxy othala:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
