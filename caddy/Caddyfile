# Production Caddyfile for an Othala instance.
#
# The site address is read from $OTHALA_PUBLIC_HOST (e.g. "dag.dunn.dev").
# Set it in the Caddy systemd environment or compose env block. Do not
# hard-code a hostname here — this file is part of the OSS distribution.
#
# TLS is issued via DNS-01 ACME using the caddy-dns/cloudflare plugin and
# a Cloudflare API token in CF_API_TOKEN. Remove the tls block if you use
# a different ACME solver or terminate TLS upstream.
#
# Routing shape (fix for Phase-B finding 2026-06-03):
#   The default backend is the Othala app (othala:8080) so that static assets
#   (/_astro/*, manifest.webmanifest, favicon.ico) are served correctly.
#   Kratos browser paths and the Hydra OAuth2 surface are matched first and
#   routed to their respective upstreams. Routing the default to Kratos (the
#   previous production shape) caused static assets to 404 or be served with
#   the wrong Content-Type, resulting in an unstyled UI.
#
# Kratos container: kratos:4433
# Hydra container:  hydra:4444
# App container:    othala:8080
#
# Operator note: the /oauth2/login, /oauth2/consent, and /oauth2/logout paths
# are Hydra challenge handlers served by the converged app, not Hydra itself.
# They are matched explicitly so they don't fall into the @hydra block.

{$OTHALA_PUBLIC_HOST} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Hydra public OAuth2 surface + OIDC discovery.
	@hydra path /oauth2/auth /oauth2/token /oauth2/revoke /oauth2/fallbacks/* /.well-known/openid-configuration /.well-known/jwks.json /userinfo
	handle @hydra {
		reverse_proxy hydra:4444
	}

	# The converged app owns the Hydra login/consent/logout challenge handlers.
	# Matched before the app default so they are explicit and auditable.
	@portal_challenges path /oauth2/login /oauth2/consent /oauth2/logout
	handle @portal_challenges {
		reverse_proxy othala:8080
	}

	# Kratos browser endpoints: well-known ceremony scripts, self-service flow
	# APIs, session endpoints, and identity schemas.
	@kratos path /.well-known/ory/* /self-service/* /sessions/* /schemas/*
	handle @kratos {
		reverse_proxy kratos:4433
	}

	# Default -> the app: portal UI, /auth/* + /admin/* pages, AND static
	# assets (/_astro/*, favicon.ico, manifest.webmanifest). The app is the
	# catch-all; routing the default to Kratos mis-serves static assets.
	reverse_proxy othala:8080
}
