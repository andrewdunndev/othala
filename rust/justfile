set shell := ["bash", "-euo", "pipefail", "-c"]

store_modules := "testkit/src/store.rs testkit/src/fixture.rs base/tests/conformance.rs"

default:
    @just --list

all: fmt lint confine twins test wasm thumb msrv deny api mutants rows

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# F9: the receipt mint and the secret read stay in the modules CONTRACT.md names
confine:
    @bad=$(grep -rlE '(allow|expect)\([^)]*clippy::disallowed_methods' --include='*.rs' . | sed 's|^\./||' | grep -vxF -f <(tr ' ' '\n' <<< "{{store_modules}}") || true); [ -z "$bad" ] || { echo "$bad"; echo "disallowed_methods silenced outside store modules"; exit 1; }

test:
    cargo test --workspace --all-features

ledger:
    cargo test -p base --test ledger

# each Type case and its compiling twin differ in exactly one line
twins:
    @for f in base/tests/ui/fail/*.rs; do t=base/tests/ui/pass/${f##*/}; [ -f "${f%.rs}.stderr" ] || { echo "$f: no .stderr"; exit 1; }; n=$(diff "$f" "$t" | grep -c '^<' || true); [ "$n" = 1 ] || { echo "$f: $n lines differ from its twin"; exit 1; }; done

# skips and test args live in .cargo/mutants.toml
mutants:
    cargo mutants --package base --test-workspace=false --no-shuffle

wasm:
    cargo build -p base --target wasm32-unknown-unknown --no-default-features
    cargo build -p base --target wasm32-unknown-unknown --all-features

thumb:
    cargo build -p base --target thumbv7em-none-eabi --no-default-features
    cargo build -p base --target thumbv7em-none-eabi --features rand_core,serde

msrv:
    cargo +1.85.0 check -p base --all-features

deny:
    cargo deny check bans licenses sources

# public-API snapshot over rustdoc JSON (cargo-public-api needs openssl, absent on the build host)
api nightly="nightly-2026-11-24":
    cargo +{{nightly}} rustdoc -p base --all-features -- -Z unstable-options --output-format json
    jq -r -f api.jq target/doc/base.json > base/public-api.txt
    git diff --exit-code base/public-api.txt

fuzz seconds="600":
    cd base/fuzz && cargo +nightly fuzz run b64url_decode corpus/b64url_decode -- -max_total_time={{seconds}}

# rule 5.1 numbers for base (production: src/ above each test module)
rows:
    @echo "production lines: $(awk '/^#\[cfg\(test\)\]/{nextfile} {n++} END{print n}' base/src/*.rs)"
    @echo "test lines: $(( $(awk '/^#\[cfg\(test\)\]/{t=1} t{n++} END{print n}' base/src/*.rs) + $(cat base/tests/*.rs base/fuzz/property.rs base/fuzz/fuzz_targets/*.rs | wc -l) )) (+ $(cat base/tests/ui/*/*.rs | wc -l) ledger case lines, testkit $(cat testkit/src/*.rs | wc -l))"
    @echo "contract lines: $(grep -cE '^- [TROBN][0-9]+ ' base/CONTRACT.md)"
    @echo "vector cases: $(grep -oE 'rfc4648/test-vectors.json.*cases = [0-9]+' vectors/SOURCES.toml | grep -oE '[0-9]+$') (RFC 4648 section 10; BASE64 ones checked)"
    @echo "public items: $(grep -cE '^pub ' base/public-api.txt 2>/dev/null || echo 'n/a: run just api')"
