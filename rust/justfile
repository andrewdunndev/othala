set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

all: lock fmt lint canary twins test doc wasm thumb msrv deny deps api mutants rows

# a manifest change without its lock change fails here, before anything builds
lock:
    cargo metadata --locked --format-version 1 > /dev/null

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# each published crate: every lint level, deny-list lint and clippy.toml path is an error there (CONTRACT B4 to B6)
canary:
    ./canary.sh base

test:
    cargo test --workspace --all-features

doc:
    RUSTDOCFLAGS="-D warnings" cargo doc -p base -p store -p testkit --all-features --no-deps

ledger:
    cargo test -p base --all-features --test ledger

# each Type case and its compiling twin differ in one line and in one token; no twin without a case
twins:
    #!/usr/bin/env bash
    set -euo pipefail
    tok() { grep -oE '[A-Za-z_][A-Za-z0-9_]*|[0-9]+|[^[:space:][:alnum:]_]' "$1"; }
    for t in base/tests/ui/pass/*.rs; do [ -f "base/tests/ui/fail/${t##*/}" ] || { echo "$t: no fail case"; exit 1; }; done
    for f in base/tests/ui/fail/*.rs; do
        t=base/tests/ui/pass/${f##*/}
        [ -f "${f%.rs}.stderr" ] && [ -f "$t" ] || { echo "$f: no .stderr or no twin"; exit 1; }
        lines=$(diff "$f" "$t" | grep -c '^[<>]' || true)
        toks=$(diff <(tok "$f") <(tok "$t") | grep -c '^[<>]' || true)
        [ "$lines" = 2 ] && [ "$toks" = 2 ] || { echo "$f: $lines lines and $toks tokens differ from its twin"; exit 1; }
    done

# the mutants each package yields after .cargo/mutants.toml's skips; raise them as code grows
base_floor := "137"
store_floor := "28"
testkit_floor := "115"

# skips and test args live in .cargo/mutants.toml; store's and testkit's mutants are caught by the workspace's tests;
# each run must reach its floor of mutants with none missed or timed out, so a filter that empties it fails
mutants:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target/mutants/base target/mutants/store target/mutants/testkit
    cargo mutants --package base --test-package base,wipe --no-shuffle --output target/mutants/base
    cargo mutants --package store --test-workspace=true --no-shuffle --output target/mutants/store
    cargo mutants --package testkit --test-workspace=true --no-shuffle --output target/mutants/testkit
    for c in base:{{base_floor}} store:{{store_floor}} testkit:{{testkit_floor}}; do
        jq -e --argjson floor "${c#*:}" '.total_mutants >= $floor and .missed == 0 and .timeout == 0' \
            "target/mutants/${c%:*}/mutants.out/outcomes.json" > /dev/null || { echo "mutants ${c%:*}: under the floor of ${c#*:}, or missed or timed out"; exit 1; }
    done

wasm:
    cargo build -p base --target wasm32-unknown-unknown --no-default-features
    cargo build -p base --target wasm32-unknown-unknown --all-features

thumb:
    cargo build -p base --target thumbv7em-none-eabi --no-default-features
    cargo build -p base --target thumbv7em-none-eabi --features rand_core,serde

msrv:
    cargo +1.89.0 check --workspace --all-features --all-targets --locked

deny:
    cargo deny check advisories bans licenses sources

# each member's direct runtime dependencies, every feature on, are the ones deps.txt lists for it
deps:
    #!/usr/bin/env bash
    set -euo pipefail
    for c in $(cargo metadata --locked --no-deps --format-version 1 | jq -r '.packages[].name' | sort); do
        cargo tree --locked -p "$c" -e normal --all-features --depth 1 --prefix none --format '{p}' | tail -n +2 | cut -d' ' -f1 | sed "s/^/$c /"
    done | sort -u | diff deps.txt -

# public-API snapshot over rustdoc JSON (cargo-public-api needs openssl, absent on the build host)
api nightly="nightly-2026-11-24":
    cargo +{{nightly}} rustdoc -p base --all-features -- -Z unstable-options --output-format json
    jq -r -f api.jq target/doc/base.json > base/public-api.txt
    git diff --exit-code base/public-api.txt

fuzz seconds="600":
    cd base/fuzz && cargo +nightly fuzz run b64url_decode corpus/b64url_decode -- -max_total_time={{seconds}}

# the scoreboard for base (production: src/ above each file's test module); mutant counts are from the last `just mutants`
rows:
    #!/usr/bin/env bash
    set -euo pipefail
    split() { awk -v want="$1" 'FNR == 1 { t = 0 } /^#\[cfg\(test\)\]/ { t = 1 } t == want { n++ } END { print n }' base/src/*.rs; }
    prod=$(split 0)
    unit=$(split 1)
    it=$(cat base/tests/*.rs base/fuzz/property.rs base/fuzz/fuzz_targets/*.rs | wc -l | tr -d ' ')
    contract=$(grep -cE '^- [TROBN][0-9]+ ' base/CONTRACT.md)
    per() { awk -v a="$1" -v b="$contract" 'BEGIN { printf "%.1f", a / b }'; }
    echo "production lines: $prod ($(per "$prod") per contract line)"
    echo "test lines: $((unit + it)) ($(per $((unit + it))) per contract line; unit $unit, tests and fuzz $it; + $(cat base/tests/ui/*/*.rs | wc -l | tr -d ' ') ledger case lines; testkit $(cat testkit/src/*.rs | wc -l | tr -d ' '); store $(cat store/src/*.rs store/tests/*.rs | wc -l | tr -d ' '))"
    echo "contract lines: $contract"
    echo "vector cases: $(grep -oE 'rfc4648/test-vectors.json.*cases = [0-9]+' vectors/SOURCES.toml | grep -oE '[0-9]+$') (RFC 4648 section 10; BASE64 ones checked)"
    for c in base store testkit; do
        o=target/mutants/$c/mutants.out/outcomes.json
        if [ -f "$o" ]; then
            # skipped: the mutants the config's filters remove, however they are written
            all=$(cargo mutants --list --no-config --package "$c" | wc -l)
            kept=$(cargo mutants --list --package "$c" | wc -l)
            jq -r --arg c "$c" --arg skipped "$((all - kept))" \
                '"mutants \($c): \(.caught) caught, \(.missed) missed, \(.timeout) timed out, \(.unviable) unviable of \(.total_mutants); \($skipped) skipped by .cargo/mutants.toml"' "$o"
        else
            echo "mutants $c: not run (just mutants)"
        fi
    done
    echo "public items: $(grep -vcE '^(impl|attr) ' base/public-api.txt) ($(grep -vE '^(impl|attr) ' base/public-api.txt | cut -d' ' -f1 | sort | uniq -c | awk '{printf "%s%s %s", sep, $1, $2; sep=", "}'))"
