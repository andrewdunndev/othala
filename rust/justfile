set shell := ["bash", "-euo", "pipefail", "-c"]

# every per-crate recipe reads <crate>/gates.json through crates.sh; a new crate edits nothing outside its directory
target := env("CARGO_TARGET_DIR", "target")

default:
    @just --list

# the pre-merge set, and the only list of it: CI's jobs call these recipes and re-type nothing
gate: gate-rust claims vectors

# the gates that run on CI's ci-rust image, which has no node or python3; claims and vectors run on theirs
gate-rust: (tool-pins "jq") lock queue fmt lint canary twins test doc wasm thumb msrv deny deps api

# the slow gates, run on a schedule and on main: the per-crate mutation floors, the scoreboard they feed, the features-off jose run and the fuzz targets; `just gate-slow <crate> <k>/<n>` runs shard k of n (cargo-mutants' own, k from 0) of one crate's mutants and, in shard 0, the rest of its share (CI runs the jobs `slow-plan` lists), and with no argument runs everything unsharded
gate-slow crate="" shard="": (tool-pins)
    #!/usr/bin/env bash
    set -euo pipefail
    c="{{crate}}"; shard="{{shard}}"
    if [ -n "$c" ]; then
        units=$(just slow-units)
        grep -qx "$c" <<< "$units" || { echo "gate-slow: '$c' is not one of: $(tr '\n' ' ' <<< "$units")"; exit 1; }
    fi
    if [ -z "$c" ] || ./crates.sh | jq -e --arg c "$c" 'select(.name == $c and .mutants)' > /dev/null; then just mutants "$c" "$shard"; fi
    [ -z "$shard" ] || [ "${shard%%/*}" = 0 ] || exit 0
    just rows "$c"
    if [ -z "$c" ] || [ "$c" = jose ]; then just mutants-off; fi
    just fuzz 600 "$c"

# the crates the slow gates run, derived: each with a mutants floor or a fuzz target
slow-units:
    #!/usr/bin/env bash
    set -euo pipefail
    ./crates.sh | jq -r '.name' | while read -r c; do
        if ./crates.sh | jq -e --arg c "$c" 'select(.name == $c and .mutants)' > /dev/null || [ -d "$c/fuzz" ]; then echo "$c"; fi
    done

# the child pipeline of CI's check-rust-scheduled: one job per crate shard, each `just gate-slow <crate> <k>/<n>`. A crate's shard count is the one number below; size it so a shard fits well under the job's 3h at CI speed (about 7x a local MUTANTS_JOBS=6 run)
slow-plan:
    #!/usr/bin/env bash
    set -euo pipefail
    declare -A shards=([jose]=8)
    echo "include: [{local: .gitlab/rust.yml}]"
    echo "stages: [verify]"
    just slow-units | while read -r c; do
        n=${shards[$c]:-1}
        for ((k = 0; k < n; k++)); do
            printf '\nslow-%s-%sof%s:\n  extends: .slow\n  variables:\n    CRATE: %s\n    SHARD: %s/%s\n' "$c" "$k" "$n" "$c" "$k" "$n"
        done
    done

# a manifest change without its lock change fails here, before anything builds
lock:
    cargo metadata --locked --format-version 1 > /dev/null

# queue.json and rows.json are well formed and agree
queue:
    ../primitives/check.sh

# every CONTRACT.md claim names a proof, every test ref resolves to a test, row, ui case, vector or fuzz target with its replayed corpus, each pending ref gives its reason, and a quoted mutants floor is gates.json's
claims:
    command -v node > /dev/null || { echo 'claims: node is not on PATH; mise.toml pins it, so run under `mise x --`'; exit 1; }
    node canary/claims.mjs

# the vector oracle's gate, offline: every derive script reproduces its committed files, SOURCES.toml's hashes and counts match, every WebAuthn step or section a vector cites exists and each quoted passage is in its step, and webauthn-ext passes (rust/vectors/justfile check)
vectors:
    command -v python3 > /dev/null || { echo 'vectors: python3 is not on PATH; the gate needs python 3.11 or newer'; exit 1; }
    python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || { echo 'vectors: python3 is older than 3.11 (tomllib)'; exit 1; }
    command -v node > /dev/null || { echo 'vectors: node is not on PATH; mise.toml pins it, so run under `mise x --`'; exit 1; }
    {{ just_executable() }} --justfile vectors/justfile check

# fail when this branch touches a path outside the item's globs, or any oracle path
own item:
    ../primitives/own.sh {{item}}

# one line per oracle row, then per-milestone totals
score:
    ../primitives/score.sh

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# each published crate: every lint level, deny-list lint and clippy.toml path is an error there (CONTRACT B4 to B6)
canary:
    ./canary.sh

test:
    cargo test --workspace --all-features

doc:
    #!/usr/bin/env bash
    set -euo pipefail
    pkgs=$(./crates.sh | jq -r 'select(.doc) | "-p \(.name)"')
    # shellcheck disable=SC2086 # pkgs is a -p flag list
    RUSTDOCFLAGS="-D warnings" cargo doc $pkgs --all-features --no-deps

ledger:
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r 'select(.ui) | .name')
    for c in $crates; do cargo test -p "$c" --all-features --test ledger; done

# each Type case and its compiling twin differ in one line and in one token; no twin without a case
twins:
    #!/usr/bin/env bash
    set -euo pipefail
    tok() { grep -oE '[A-Za-z_][A-Za-z0-9_]*|[0-9]+|[^[:space:][:alnum:]_]' "$1"; }
    crates=$(./crates.sh | jq -r 'select(.ui) | .name')
    for c in $crates; do
        for t in "$c"/tests/ui/pass/*.rs; do [ -f "$c/tests/ui/fail/${t##*/}" ] || { echo "$t: no fail case"; exit 1; }; done
        for f in "$c"/tests/ui/fail/*.rs; do
            t=$c/tests/ui/pass/${f##*/}
            [ -f "${f%.rs}.stderr" ] && [ -f "$t" ] || { echo "$f: no .stderr or no twin"; exit 1; }
            lines=$(diff "$f" "$t" | grep -c '^[<>]' || true)
            toks=$(diff <(tok "$f") <(tok "$t") | grep -c '^[<>]' || true)
            [ "$lines" = 2 ] && [ "$toks" = 2 ] || { echo "$f: $lines lines and $toks tokens differ from its twin"; exit 1; }
        done
    done

# the cargo-mutants version ../mise.toml pins, for CI's cargo install
mutants-pin:
    @sed -n 's|^"github:sourcefrog/cargo-mutants" = "\([0-9][0-9.]*\)"$|\1|p' ../mise.toml

# the cargo-deny version ../mise.toml pins, for CI's cargo install
deny-pin:
    @sed -n 's|^"github:EmbarkStudios/cargo-deny" = "\([0-9][0-9.]*\)"$|\1|p' ../mise.toml

# the installed cargo-mutants, cargo-deny and jq must be the versions ../mise.toml pins; CI installs by the same pin and is graded here
tool-pins *tools="cargo-mutants jq cargo-deny":
    #!/usr/bin/env bash
    set -euo pipefail
    for t in {{tools}}; do
        case "$t" in
            cargo-mutants) key='"github:sourcefrog\/cargo-mutants"'; have=$(cargo mutants --version | sed -n 's/^cargo-mutants \([0-9][0-9.]*\).*/\1/p') ;;
            cargo-deny) key='"github:EmbarkStudios\/cargo-deny"'; have=$(cargo deny --version | sed -n 's/^cargo-deny \([0-9][0-9.]*\).*/\1/p') ;;
            jq) key='jq'; have=$(jq --version | sed -n 's/^jq-\([0-9][0-9.]*\).*/\1/p') ;;
            *) echo "tool-pins: unknown tool $t"; exit 1 ;;
        esac
        want=$(sed -n "s/^$key = \"\([0-9][0-9.]*\)\"\$/\1/p" "../mise.toml")
        [ -n "$want" ] || { echo "tool-pins: mise.toml has no pin for $t"; exit 1; }
        [ "$want" = "$have" ] || { echo "$t ${have:-unknown} is installed, mise.toml pins $want"; exit 1; }
    done

# each run (the whole crate, or shard k of n with cargo-mutants' own k from 0) catches something and misses or times out nothing, so a filter that empties it fails; skips are in .cargo/mutants.toml. cargo-mutants exits 2 for a missed and 3 for a timed-out mutant, 0 otherwise: those three reach the outcomes check below, any other exit is its own failure
mutants crate="" shard="": (tool-pins "cargo-mutants" "jq")
    #!/usr/bin/env bash
    set -euo pipefail
    sharding=()
    if [ -n "{{shard}}" ]; then
        [ -n "{{crate}}" ] || { echo "mutants: a shard needs a crate"; exit 1; }
        [[ "{{shard}}" =~ ^(0|[1-9][0-9]*)/([1-9][0-9]*)$ ]] && [ "${BASH_REMATCH[1]}" -lt "${BASH_REMATCH[2]}" ] || { echo "mutants: shard '{{shard}}' is not k/n with 0 <= k < n"; exit 1; }
        sharding=(--shard "{{shard}}")
    fi
    runs=$(./crates.sh | jq -r --arg c "{{crate}}" 'select(.mutants and ($c == "" or .name == $c)) | "\(.name) \(.mutants.tests // [] | join(","))"')
    [ -n "$runs" ] || { echo "mutants: no crate with a mutants floor matches '{{crate}}'"; exit 1; }
    while read -r c tests; do
        if [ -n "$tests" ]; then scope=(--test-package "$tests"); else scope=(--test-workspace=true); fi
        mkdir -p "{{target}}/mutants/$c"
        jobs=$(nproc); [ "$jobs" -le "${MUTANTS_JOBS:-4}" ] || jobs=${MUTANTS_JOBS:-4}
        rc=0
        env -u CARGO_TARGET_DIR cargo mutants --package "$c" "${scope[@]}" --jobs "$jobs" --no-shuffle --minimum-test-timeout 60 "${sharding[@]}" --output "{{target}}/mutants/$c" < /dev/null || rc=$?
        case $rc in 0 | 2 | 3) ;; *) echo "mutants $c: cargo mutants exited $rc"; exit "$rc" ;; esac
        jq -e '.caught > 0 and .missed == 0 and .timeout == 0' \
            "{{target}}/mutants/$c/mutants.out/outcomes.json" > /dev/null || { echo "mutants $c: nothing caught, or a mutant missed or timed out"; exit 1; }
    done <<< "$runs"

# the features-off run of the jose files whose refusals are dead code with all features on: it skips only when the jose crate is absent, fails when a listed file is missing, and the floor is the caught count of a real run
mutants-off floor="5": (tool-pins "cargo-mutants" "jq")
    #!/usr/bin/env bash
    set -euo pipefail
    [ -d jose ] || { echo "mutants-off: no jose crate, skipped"; exit 0; }
    files=(jose/src/jws/header.rs jose/src/jws/json.rs jose/src/jwe/envelope.rs)
    for f in "${files[@]}"; do
        [ -f "$f" ] || { echo "mutants-off: $f is missing"; exit 1; }
    done
    out="{{target}}/mutants/jose-off"
    jobs=$(nproc); [ "$jobs" -le "${MUTANTS_JOBS:-4}" ] || jobs=${MUTANTS_JOBS:-4}
    mkdir -p "$out"
    env -u CARGO_TARGET_DIR cargo mutants -p jose --no-config --no-default-features --jobs "$jobs" --no-shuffle --minimum-test-timeout 60 --output "$out" \
        "${files[@]/#/--file=}" --re "supported|replace == with != in Jw[se]<'a>::parse_json" -- -- --skip ledger < /dev/null
    jq -e --argjson floor "{{floor}}" '.caught >= $floor and .missed == 0 and .timeout == 0' \
        "$out/mutants.out/outcomes.json" > /dev/null || { echo "mutants-off: under the floor of {{floor}}, or missed or timed out"; exit 1; }

# the pre-merge mutation gate: `just mutants <crate>` (the whole crate) for each crate the commits since the merge base with origin/main change; a change to justfile, crates.sh, ../mise.toml, .cargo/ or any gates.json, to Cargo.toml, Cargo.lock, rust-toolchain.toml or vectors/ runs every floored crate; a change under a crate named in a run's `tests` (or, with no `tests` key, under any crate's tests/) runs that crate; a changed jose also runs mutants-off; a floor that dropped or vanished since the merge base fails unless a commit says `floor-lowered: <crate> <reason>`; no merge base is an error, not a skip
mutants-changed base="origin/main": (tool-pins "cargo-mutants" "jq")
    #!/usr/bin/env bash
    set -euo pipefail
    mb=$(git merge-base "{{base}}" HEAD) || { echo "mutants-changed: no merge base with {{base}}"; exit 1; }
    [ -n "$mb" ] || { echo "mutants-changed: no merge base with {{base}}"; exit 1; }
    [ -z "$(git status --porcelain -- .)" ] || echo "mutants-changed: warning: uncommitted changes are not judged, only commits since ${mb:0:8}" >&2
    files=$(git diff --no-renames --name-only --relative "$mb" HEAD -- .)
    top=$(git diff --no-renames --name-only "$mb" HEAD)
    msgs=$(git log --format=%B "$mb..HEAD")
    # a floor is held against the merge base's, so a branch cannot lower its own
    while read -r c; do
        [ -n "$c" ] || continue
        git show "$mb:./$c/gates.json" | ./crates.sh --floor || { echo "mutants-changed: $c's merge-base mutants.floor must be a non-negative integer"; exit 1; }
        old=$(git show "$mb:./$c/gates.json" | jq -r '.mutants.floor // empty')
        [ -n "$old" ] || continue
        if git cat-file -e "HEAD:./$c/gates.json" 2> /dev/null; then
            git show "HEAD:./$c/gates.json" | ./crates.sh --floor || { echo "mutants-changed: $c's mutants.floor must be a non-negative integer"; exit 1; }
            new=$(git show "HEAD:./$c/gates.json" | jq -r '.mutants.floor // empty')
        else
            new=""
        fi
        if [ -z "$new" ] || [ "$new" -lt "$old" ]; then
            grep -qE "^floor-lowered: $c .+" <<< "$msgs" || { echo "mutants-changed: $c's floor went from $old to ${new:-nothing}; a commit must say 'floor-lowered: $c <reason>'"; exit 1; }
        fi
    done < <(git ls-tree --name-only "$mb" -- . | tr -d / | while read -r d; do git cat-file -e "$mb:./$d/gates.json" 2> /dev/null && echo "$d"; done)
    runs=$(./crates.sh | jq -r 'select(.mutants) | "\(.name) \(.mutants.tests // [] | join(","))"')
    touched() { grep -q "^$1/" <<< "$files"; }
    all=0
    grep -qE '^(justfile|crates\.sh|Cargo\.toml|Cargo\.lock|rust-toolchain\.toml|\.cargo/|vectors/|[^/]+/gates\.json$)' <<< "$files" && all=1
    grep -qx 'mise\.toml' <<< "$top" && all=1
    anytests=0
    grep -qE '^[^/]+/tests/' <<< "$files" && anytests=1
    plan=""
    while read -r c tests; do
        hit=$all
        touched "$c" && hit=1
        [ -z "$tests" ] && [ "$anytests" = 1 ] && hit=1
        for t in ${tests//,/ }; do [ "$t" != "$c" ] && touched "$t" && hit=1; done
        [ "$hit" = 1 ] && plan="$plan$c"$'\n'
    done <<< "$runs"
    [ -n "$plan" ] || { echo "mutants-changed: no crate with a mutants floor changed since $mb"; exit 0; }
    while read -r c; do
        [ -n "$c" ] || continue
        just mutants "$c"
    done <<< "$plan"
    if grep -qx jose <<< "$plan"; then just mutants-off; fi

# a quick pre-check, not the gate: cargo mutants --in-diff on each crate this branch changes, none missed or timed out
mutants-diff base="origin/main": (tool-pins "cargo-mutants" "jq")
    #!/usr/bin/env bash
    set -euo pipefail
    mb=$(git merge-base "{{base}}" HEAD) || { echo "mutants-diff: no merge base with {{base}}"; exit 1; }
    [ -n "$mb" ] || { echo "mutants-diff: no merge base with {{base}}"; exit 1; }
    files=$(git diff --no-renames --name-only --relative "$mb" -- .)
    runs=$(./crates.sh | jq -r 'select(.mutants) | "\(.name) \(.mutants.tests // [] | join(","))"')
    n=0
    while read -r c tests; do
        grep -q "^$c/" <<< "$files" || continue
        n=1
        if [ -n "$tests" ]; then scope=(--test-package "$tests"); else scope=(--test-workspace=true); fi
        rm -rf "{{target}}/mutants/$c"; mkdir -p "{{target}}/mutants/$c"
        git diff --no-renames --relative "$mb" -- "$c/" > "{{target}}/mutants/$c.diff"
        jobs=$(nproc); [ "$jobs" -le "${MUTANTS_JOBS:-4}" ] || jobs=${MUTANTS_JOBS:-4}
        env -u CARGO_TARGET_DIR cargo mutants --package "$c" "${scope[@]}" --jobs "$jobs" --no-shuffle --minimum-test-timeout 60 --in-diff "{{target}}/mutants/$c.diff" --output "{{target}}/mutants/$c" < /dev/null
        out="{{target}}/mutants/$c/mutants.out/outcomes.json"
        if [ ! -f "$out" ]; then echo "mutants-diff $c: the diff holds no mutant"; continue; fi
        jq -e '.missed == 0 and .timeout == 0' "$out" > /dev/null || { echo "mutants-diff $c: a mutant was missed or timed out"; exit 1; }
    done <<< "$runs"
    [ "$n" = 1 ] || echo "mutants-diff: no crate with a mutants floor changed since $mb"

wasm: (build "wasm32-unknown-unknown")

thumb: (build "thumbv7em-none-eabi")

# each feature set a crate's gates.json lists for this target builds
build triple:
    #!/usr/bin/env bash
    set -euo pipefail
    builds=$(./crates.sh | jq -r --arg t "{{triple}}" '.name as $c | .targets[$t][]? | "\($c) \(.)"')
    [ -n "$builds" ] || { echo "build: no crate lists {{triple}}"; exit 1; }
    while read -r c args; do
        # shellcheck disable=SC2086 # args is a feature-flag list
        cargo build -p "$c" --target "{{triple}}" $args < /dev/null
    done <<< "$builds"

msrv:
    cargo +1.89.0 check --workspace --all-features --all-targets --locked

# deny.toml is the policy; bans.allow is appended from every member's name and the crates its gates.json allows
deny: (tool-pins "cargo-deny")
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{target}}"
    { cat deny.toml; ./crates.sh | jq -rs '"allow = [\([.[] | .name, .allow[]?] | unique | map("{ name = \"\(.)\" }") | join(", "))]"'; } > "{{target}}/deny.toml"
    cargo deny --config "{{target}}/deny.toml" check advisories bans licenses sources

# each member's direct runtime dependencies, every feature on, are the ones its deps.txt lists (no file: none)
deps:
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r .name)
    for c in $crates; do
        cargo tree --locked -p "$c" -e normal --all-features --depth 1 --prefix none --format '{p}' | tail -n +2 | cut -d' ' -f1 | sort -u |
            diff <(cat "$c/deps.txt" 2> /dev/null) - || { echo "deps $c: not what $c/deps.txt lists"; exit 1; }
    done

# public-API snapshot over rustdoc JSON (cargo-public-api needs openssl, absent on the build host)
api nightly="nightly-2026-11-24":
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r 'select(.api) | .name')
    for c in $crates; do
        cargo +{{nightly}} rustdoc -p "$c" --all-features -- -Z unstable-options --output-format json
        jq -r -f api.jq "{{target}}/doc/${c//-/_}.json" > "$c/public-api.txt"
        git ls-files --error-unmatch "$c/public-api.txt" > /dev/null
        git diff --exit-code -- "$c/public-api.txt"
    done

fuzz seconds="600" crate="":
    #!/usr/bin/env bash
    set -euo pipefail
    for t in {{ if crate == "" { "*" } else { crate } }}/fuzz/fuzz_targets/*.rs; do
        [ -e "$t" ] || continue
        n=$(basename "$t" .rs)
        (cd "${t%/fuzz_targets/*}" && cargo +nightly fuzz run "$n" "corpus/$n" -- -max_total_time={{seconds}})
    done

# the scoreboard per crate (production: src/ above each file's test module); mutant counts are from the last `just mutants`
rows crate="":
    #!/usr/bin/env bash
    set -euo pipefail
    while read -r c vectors; do
        split() { find "$c/src" -name '*.rs' -print0 | sort -z | xargs -0r awk -v want="$1" 'FNR == 1 { t = 0 } /^#\[cfg\(test\)\]/ { t = 1 } t == want { n++ } END { print n + 0 }'; }
        prod=$(split 0)
        unit=$(split 1)
        it=$(find "$c" \( -path "$c/tests/*" -o -path "$c/fuzz/*" \) -name '*.rs' -not -path '*/ui/*' -not -path '*/target/*' -print0 | xargs -0r cat | wc -l | tr -d ' ')
        ui=$(find "$c" -path "$c/tests/ui/*" -name '*.rs' -print0 | xargs -0r cat | wc -l | tr -d ' ')
        contract=$(grep -scE '^- [TROBN][0-9]+ ' "$c/CONTRACT.md" || true)
        per() { awk -v a="$1" -v b="$contract" 'BEGIN { if (b > 0) printf " (%.1f per contract line)", a / b }'; }
        cases=$(awk -v want=" $vectors " '/^\[source\."/ { s = $0; gsub(/^\[source\."|"\]$/, "", s); seen = 0 }
            /^cases = / && !seen && index(want, " " s " ") { n += $3; seen = 1 } END { print n + 0 }' vectors/SOURCES.toml)
        echo "$c production lines: $prod$(per "$prod")"
        echo "$c test lines: $((unit + it))$(per $((unit + it))) (unit $unit, tests and fuzz $it, ledger cases $ui)"
        echo "$c contract lines: ${contract:-0}"
        echo "$c vector cases: $cases (${vectors:-none})"
        o={{target}}/mutants/$c/mutants.out/outcomes.json
        if [ -f "$o" ]; then
            # skipped: the mutants the config's filters remove, however they are written
            all=$(cargo mutants --list --no-config --package "$c" < /dev/null | wc -l)
            kept=$(cargo mutants --list --package "$c" < /dev/null | wc -l)
            jq -r --arg c "$c" --arg skipped "$((all - kept))" \
                '"\($c) mutants: \(.caught) caught, \(.missed) missed, \(.timeout) timed out, \(.unviable) unviable of \(.total_mutants); \($skipped) skipped by .cargo/mutants.toml"' "$o"
        fi
        if [ -f "$c/public-api.txt" ]; then
            echo "$c public items: $(grep -vcE '^(impl|attr) ' "$c/public-api.txt") ($(grep -vE '^(impl|attr) ' "$c/public-api.txt" | cut -d' ' -f1 | sort | uniq -c | awk '{printf "%s%s %s", sep, $1, $2; sep=", "}'))"
        fi
    done < <(./crates.sh | jq -r --arg c "{{crate}}" 'select($c == "" or .name == $c) | "\(.name) \(.vectors // [] | join(" "))"')
