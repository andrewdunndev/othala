set shell := ["bash", "-euo", "pipefail", "-c"]

# every per-crate recipe reads <crate>/gates.json through crates.sh; a new crate edits nothing outside its directory
target := env("CARGO_TARGET_DIR", "target")

default:
    @just --list

all: lock queue fmt lint canary twins test doc wasm thumb msrv deny deps api mutants rows

# a manifest change without its lock change fails here, before anything builds
lock:
    cargo metadata --locked --format-version 1 > /dev/null

# queue.json and rows.json are well formed and agree
queue:
    ../primitives/check.sh

# fail when this branch touches a path outside the item's globs, or any oracle path
own item:
    ../primitives/own.sh {{item}}

# one line per oracle row, then per-milestone totals
score:
    ../primitives/score.sh

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# each published crate: every lint level, deny-list lint and clippy.toml path is an error there (CONTRACT B4 to B6)
canary:
    ./canary.sh

test:
    cargo test --workspace --all-features

doc:
    #!/usr/bin/env bash
    set -euo pipefail
    pkgs=$(./crates.sh | jq -r 'select(.doc) | "-p \(.name)"')
    # shellcheck disable=SC2086 # pkgs is a -p flag list
    RUSTDOCFLAGS="-D warnings" cargo doc $pkgs --all-features --no-deps

ledger:
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r 'select(.ui) | .name')
    for c in $crates; do cargo test -p "$c" --all-features --test ledger; done

# each Type case and its compiling twin differ in one line and in one token; no twin without a case
twins:
    #!/usr/bin/env bash
    set -euo pipefail
    tok() { grep -oE '[A-Za-z_][A-Za-z0-9_]*|[0-9]+|[^[:space:][:alnum:]_]' "$1"; }
    crates=$(./crates.sh | jq -r 'select(.ui) | .name')
    for c in $crates; do
        for t in "$c"/tests/ui/pass/*.rs; do [ -f "$c/tests/ui/fail/${t##*/}" ] || { echo "$t: no fail case"; exit 1; }; done
        for f in "$c"/tests/ui/fail/*.rs; do
            t=$c/tests/ui/pass/${f##*/}
            [ -f "${f%.rs}.stderr" ] && [ -f "$t" ] || { echo "$f: no .stderr or no twin"; exit 1; }
            lines=$(diff "$f" "$t" | grep -c '^[<>]' || true)
            toks=$(diff <(tok "$f") <(tok "$t") | grep -c '^[<>]' || true)
            [ "$lines" = 2 ] && [ "$toks" = 2 ] || { echo "$f: $lines lines and $toks tokens differ from its twin"; exit 1; }
        done
    done

# each run catches at least its gates.json floor (unviable mutants do not count) with none missed or timed out, so a filter that empties it fails; skips are in .cargo/mutants.toml
mutants crate="":
    #!/usr/bin/env bash
    set -euo pipefail
    runs=$(./crates.sh | jq -r --arg c "{{crate}}" 'select(.mutants and ($c == "" or .name == $c)) | "\(.name) \(.mutants.floor) \(.mutants.tests // [] | join(","))"')
    [ -n "$runs" ] || { echo "mutants: no crate with a mutants floor matches '{{crate}}'"; exit 1; }
    while read -r c floor tests; do
        if [ -n "$tests" ]; then scope=(--test-package "$tests"); else scope=(--test-workspace=true); fi
        mkdir -p "{{target}}/mutants/$c"
        cargo mutants --package "$c" "${scope[@]}" --no-shuffle --output "{{target}}/mutants/$c" < /dev/null
        jq -e --argjson floor "$floor" '.caught >= $floor and .missed == 0 and .timeout == 0' \
            "{{target}}/mutants/$c/mutants.out/outcomes.json" > /dev/null || { echo "mutants $c: under the floor of $floor, or missed or timed out"; exit 1; }
    done <<< "$runs"

wasm: (build "wasm32-unknown-unknown")

thumb: (build "thumbv7em-none-eabi")

# each feature set a crate's gates.json lists for this target builds
build triple:
    #!/usr/bin/env bash
    set -euo pipefail
    builds=$(./crates.sh | jq -r --arg t "{{triple}}" '.name as $c | .targets[$t][]? | "\($c) \(.)"')
    [ -n "$builds" ] || { echo "build: no crate lists {{triple}}"; exit 1; }
    while read -r c args; do
        # shellcheck disable=SC2086 # args is a feature-flag list
        cargo build -p "$c" --target "{{triple}}" $args < /dev/null
    done <<< "$builds"

msrv:
    cargo +1.89.0 check --workspace --all-features --all-targets --locked

# deny.toml is the policy; bans.allow is appended from every member's name and the crates its gates.json allows
deny:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{target}}"
    { cat deny.toml; ./crates.sh | jq -rs '"allow = [\([.[] | .name, .allow[]?] | unique | map("{ name = \"\(.)\" }") | join(", "))]"'; } > "{{target}}/deny.toml"
    cargo deny --config "{{target}}/deny.toml" check advisories bans licenses sources

# each member's direct runtime dependencies, every feature on, are the ones its deps.txt lists (no file: none)
deps:
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r .name)
    for c in $crates; do
        cargo tree --locked -p "$c" -e normal --all-features --depth 1 --prefix none --format '{p}' | tail -n +2 | cut -d' ' -f1 | sort -u |
            diff <(cat "$c/deps.txt" 2> /dev/null) - || { echo "deps $c: not what $c/deps.txt lists"; exit 1; }
    done

# public-API snapshot over rustdoc JSON (cargo-public-api needs openssl, absent on the build host)
api nightly="nightly-2026-11-24":
    #!/usr/bin/env bash
    set -euo pipefail
    crates=$(./crates.sh | jq -r 'select(.api) | .name')
    for c in $crates; do
        cargo +{{nightly}} rustdoc -p "$c" --all-features -- -Z unstable-options --output-format json
        jq -r -f api.jq "{{target}}/doc/${c//-/_}.json" > "$c/public-api.txt"
        git ls-files --error-unmatch "$c/public-api.txt" > /dev/null
        git diff --exit-code -- "$c/public-api.txt"
    done

fuzz seconds="600":
    #!/usr/bin/env bash
    set -euo pipefail
    for t in */fuzz/fuzz_targets/*.rs; do
        n=$(basename "$t" .rs)
        (cd "${t%/fuzz_targets/*}" && cargo +nightly fuzz run "$n" "corpus/$n" -- -max_total_time={{seconds}})
    done

# the scoreboard per crate (production: src/ above each file's test module); mutant counts are from the last `just mutants`
rows:
    #!/usr/bin/env bash
    set -euo pipefail
    while read -r c vectors; do
        split() { find "$c/src" -name '*.rs' -print0 | sort -z | xargs -0r awk -v want="$1" 'FNR == 1 { t = 0 } /^#\[cfg\(test\)\]/ { t = 1 } t == want { n++ } END { print n + 0 }'; }
        prod=$(split 0)
        unit=$(split 1)
        it=$(find "$c" \( -path "$c/tests/*" -o -path "$c/fuzz/*" \) -name '*.rs' -not -path '*/ui/*' -not -path '*/target/*' -print0 | xargs -0r cat | wc -l | tr -d ' ')
        ui=$(find "$c" -path "$c/tests/ui/*" -name '*.rs' -print0 | xargs -0r cat | wc -l | tr -d ' ')
        contract=$(grep -scE '^- [TROBN][0-9]+ ' "$c/CONTRACT.md" || true)
        per() { awk -v a="$1" -v b="$contract" 'BEGIN { if (b > 0) printf " (%.1f per contract line)", a / b }'; }
        cases=$(awk -v want=" $vectors " '/^\[source\."/ { s = $0; gsub(/^\[source\."|"\]$/, "", s); seen = 0 }
            /^cases = / && !seen && index(want, " " s " ") { n += $3; seen = 1 } END { print n + 0 }' vectors/SOURCES.toml)
        echo "$c production lines: $prod$(per "$prod")"
        echo "$c test lines: $((unit + it))$(per $((unit + it))) (unit $unit, tests and fuzz $it, ledger cases $ui)"
        echo "$c contract lines: ${contract:-0}"
        echo "$c vector cases: $cases (${vectors:-none})"
        o={{target}}/mutants/$c/mutants.out/outcomes.json
        if [ -f "$o" ]; then
            # skipped: the mutants the config's filters remove, however they are written
            all=$(cargo mutants --list --no-config --package "$c" < /dev/null | wc -l)
            kept=$(cargo mutants --list --package "$c" < /dev/null | wc -l)
            jq -r --arg c "$c" --arg skipped "$((all - kept))" \
                '"\($c) mutants: \(.caught) caught, \(.missed) missed, \(.timeout) timed out, \(.unviable) unviable of \(.total_mutants); \($skipped) skipped by .cargo/mutants.toml"' "$o"
        fi
        if [ -f "$c/public-api.txt" ]; then
            echo "$c public items: $(grep -vcE '^(impl|attr) ' "$c/public-api.txt") ($(grep -vE '^(impl|attr) ' "$c/public-api.txt" | cut -d' ' -f1 | sort | uniq -c | awk '{printf "%s%s %s", sep, $1, $2; sep=", "}'))"
        fi
    done < <(./crates.sh | jq -r '"\(.name) \(.vectors // [] | join(" "))"')
