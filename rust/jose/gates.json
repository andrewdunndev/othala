    "rfc7520-jwe",
    "rfc7520-jwe-cases",
    "rfc7638",
    "rfc8037",
    "rfc8725-derived",
    "jose-derived"
  ],
  "allow": [
    "aead",
    "aes",
    "aes-gcm",
    "aes-kw",
    "base16ct",
    "cbc",
