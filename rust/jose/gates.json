{
  "published": true,
  "doc": true,
  "ui": true,
  "api": true,
  "targets": {
    "wasm32-unknown-unknown": [
      "--no-default-features",
      "--all-features"
    ],
    "thumbv7em-none-eabi": [
      "--no-default-features",
      "--all-features"
